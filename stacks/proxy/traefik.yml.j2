{# Plantilla: Ansible genera traefik.yml (rol andamio) con group_vars/all.yml. #}
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
accessLog: {}            # una línea por petición en stdout (para Loki, Fase 6)

ping: {}                 # endpoint de salud para el healthcheck

api:
  dashboard: true
  insecure: true         # dashboard en :8080, publicado solo en 127.0.0.1

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
{% if andamio_tls == 'cloudflare' %}
      # Por defecto, todo *.{{ andamio_domain }} usa un solo certificado comodín (DNS-01, ADR 0016):
      # una app nueva tiene HTTPS al instante, sin pedir un certificado propio.
      tls:
        certResolver: cf
        domains:
          - main: {{ andamio_domain }}
            sans: ["*.{{ andamio_domain }}"]
{% elif andamio_tls == 'custom' %}
      # Certificado propio (comercial o Cloudflare Origin): dynamic/tls.yml lo carga desde
      # /certs y es el certificado por defecto. Nadie lo renueva solo: bin/andamio certificado.
      tls: {}
{% else %}
      # Un certificado de Let's Encrypt por app (HTTP-01, puerto 80): no necesita cuenta
      # en ningún proveedor de DNS. Cada nombre queda en los registros públicos de
      # certificados, también el de las apps privadas (con Cloudflare, un comodín lo evita).
      tls:
        certResolver: le
{% endif %}
      middlewares:
        - security-headers@file   # para todas las apps públicas
        - retry@file              # deploys sin caída: reintenta si un backend desaparece

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true               # recarga en caliente al cambiar los archivos
  docker:
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false   # solo se publica lo que tenga traefik.enable=true
    network: proxy

certificatesResolvers:
{% if andamio_tls == 'cloudflare' %}
  # {{ andamio_domain }}: DNS-01 con un token de Cloudflare limitado a esa zona (CF_DNS_API_TOKEN,
  # cifrado en stacks/proxy/secrets.sops.env). Permite el comodín *.{{ andamio_domain }}.
  cf:
    acme:
      email: {{ andamio_acme_email }}
      storage: /acme/acme-cf.json
      dnsChallenge:
        provider: cloudflare
        resolvers: ["1.1.1.1:53", "1.0.0.1:53"]
  # HTTP-01: dominios fuera de la zona de Cloudflare (p. ej. un dominio anterior que redirige).
{% elif andamio_tls == 'http' %}
  # Let's Encrypt por HTTP-01: Traefik responde el desafío en el puerto 80 (por eso el
  # firewall lo deja abierto aunque todo redirija a HTTPS).
{% else %}
  # Con certificado propio, le solo atiende los dominios propios de las apps (domains:).
{% endif %}
  le:
    acme:
      email: {{ andamio_acme_email }}
      storage: /acme/acme.json
      httpChallenge:
        entryPoint: web

metrics:
  prometheus:
    entryPoint: traefik        # :8080, solo accesible por la red de Docker y 127.0.0.1
    addRoutersLabels: true     # métricas por router (por app)

serversTransport:
  forwardingTimeouts:
    dialTimeout: 3s            # por defecto 30 s: un backend que ya no existe colgaba la petición
