{# Plantilla: Ansible genera dynamic/middlewares.yml (rol andamio) con group_vars/all.yml. #}
http:
  middlewares:
    vpn-only:
      ipAllowList:
        sourceRange:
          - 10.8.0.0/24        # clientes WireGuard
          - 172.16.0.0/12      # contenedores (p. ej. Uptime Kuma revisando Grafana)
          - {{ andamio_server_ip }}/32    # el propio VPS (push del backup a Kuma)

    security-headers:
      headers:
        stsSeconds: 31536000           # HSTS: 1 año
        stsIncludeSubdomains: true
        frameDeny: true
        contentTypeNosniff: true
        referrerPolicy: strict-origin-when-cross-origin
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        customResponseHeaders:
          Server: ""                   # vacío = quitar la cabecera
          X-Powered-By: ""

    # Por IP de origen (andamio_rate_*). Quien se pasa recibe 429 hasta que baja el ritmo.
    rate-limit:
      rateLimit:
        average: {{ andamio_rate_average }}
        period: 1s
        burst: {{ andamio_rate_burst }}

    retry:
      retry:
        attempts: 3              # reintenta en otro backend si falla la conexión
        initialInterval: 100ms
