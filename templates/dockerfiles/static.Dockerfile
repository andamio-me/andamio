#es: Generado por andamio para un sitio estático. Es tuyo: cámbialo lo que necesites.
#es: nginx sin root, escuchando en el {{PORT}}.
#en: Generated by andamio for a static site. It's yours: change whatever you need.
#en: nginx without root, listening on {{PORT}}.
FROM nginxinc/nginx-unprivileged:alpine
#es: Parches del sistema que la imagen base aún no trae.
#en: System patches the base image doesn't have yet.
USER root
RUN apk upgrade --no-cache
USER 101
COPY --chown=nginx:nginx . /usr/share/nginx/html
EXPOSE {{PORT}}
