#es: Generado por andamio para una app Node ({{PM}}). Es tuyo: cámbialo lo que necesites.
#es: Etapas: deps → build → test (CI la corre antes de desplegar) → prod (sin devDependencies)
#es: → imagen final, sin npm/yarn/corepack (no se usan en producción y Trivy los marcaría).
#en: Generated by andamio for a Node app ({{PM}}). It's yours: change whatever you need.
#en: Stages: deps → build → test (CI runs it before deploying) → prod (no devDependencies)
#en: → final image, without npm/yarn/corepack (unused in production, and Trivy would flag them).
FROM node:{{NODE}}-alpine AS deps
WORKDIR /app
{{PM_SETUP}}COPY {{MANIFESTS}} ./
RUN {{INSTALL}}

FROM deps AS build
COPY . .
{{BUILD}}
{{TEST}}
FROM build AS prod
{{PRUNE}}

FROM node:{{NODE}}-alpine
#es: Parches del sistema que la imagen base aún no trae.
#en: System patches the base image doesn't have yet.
RUN apk upgrade --no-cache && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
      /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*
WORKDIR /app
ENV NODE_ENV=production PORT={{PORT}} PATH=/app/node_modules/.bin:$PATH
COPY --from=prod --chown=node:node /app /app
USER node
EXPOSE {{PORT}}
CMD ["sh", "-c", "exec {{START}}"]
