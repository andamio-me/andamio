#es: Generado por andamio para una app Python. Es tuyo: cámbialo lo que necesites.
#es: Etapas: build (entorno virtual) → test (CI la corre antes de desplegar) → prod (sin pip)
#es: → imagen final, sin pip ni setuptools (no se usan en producción y Trivy los marcaría).
#en: Generated by andamio for a Python app. It's yours: change whatever you need.
#en: Stages: build (virtualenv) → test (CI runs it before deploying) → prod (no pip)
#en: → final image, without pip or setuptools (unused in production, and Trivy would flag them).
FROM python:{{PY}}-slim AS build
WORKDIR /app
RUN python -m venv /venv
ENV PATH=/venv/bin:$PATH PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
{{INSTALL}}
{{TEST}}
FROM build AS prod
RUN pip uninstall -y pip setuptools wheel || true

FROM python:{{PY}}-slim
#es: Parches del sistema que la imagen base aún no trae.
#en: System patches the base image doesn't have yet.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*; \
    python -m pip uninstall -y pip setuptools wheel || true; \
    rm -rf /usr/local/lib/python3*/ensurepip; \
    useradd --system --uid 10001 --no-create-home app
WORKDIR /app
ENV PATH=/venv/bin:$PATH PYTHONUNBUFFERED=1 PORT={{PORT}}
COPY --from=prod /venv /venv
COPY --from=prod --chown=app:app /app /app
USER app
EXPOSE {{PORT}}
CMD ["sh", "-c", "exec {{START}}"]
