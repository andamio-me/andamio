#es: Generado por andamio para una app Go. Es tuyo: cámbialo lo que necesites.
#es: Etapas: build → test (CI la corre antes de desplegar) → binario estático → imagen final
#es: distroless (sin shell ni gestor de paquetes) con usuario sin root.
#en: Generated by andamio for a Go app. It's yours: change whatever you need.
#en: Stages: build → test (CI runs it before deploying) → static binary → final distroless
#en: image (no shell, no package manager) with a non-root user.
FROM golang:{{GO}}-alpine AS build
WORKDIR /src
COPY go.mod {{GOSUM}}./
RUN go mod download
COPY . .

FROM build AS test
RUN go vet ./... && go test ./...

FROM build AS bin
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /server {{PKG}}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=bin /server /server
ENV PORT={{PORT}}
EXPOSE {{PORT}}
ENTRYPOINT ["/server"]
