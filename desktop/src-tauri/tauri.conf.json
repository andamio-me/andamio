{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "andamio",
  "version": "0.2.0",
  "identifier": "me.andamio.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "andamio",
    "category": "DeveloperTool",
    "shortDescription": "El panel de andamio en su propia ventana",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0N0IyREFDMEM4QkE2RjkKUldUNXBvc01yQzE3Vkp3OGVqdFdnUThlK01WemoyQ1ZiK1MvOU51bm5ocUZmSjlkaUM3bGVabzIK",
      "endpoints": [
        "https://github.com/andamio-me/andamio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
