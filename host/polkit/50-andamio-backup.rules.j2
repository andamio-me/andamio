// Permite al usuario de operación (el bot) iniciar SOLO el servicio de backup.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "andamio-backup.service" &&
      action.lookup("verb") == "start" &&
      subject.user == "{{ andamio_user }}") {
    return polkit.Result.YES;
  }
});
