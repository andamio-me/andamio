[Unit]
Description=Bot de Telegram de andamio (/system)
Wants=network-online.target
After=network-online.target docker.service

[Service]
User={{ andamio_user }}
EnvironmentFile=/etc/andamio/telegram.env
ExecStart=/srv/andamio/infra/scripts/telegram-bot.sh
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
