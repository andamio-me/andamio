[Unit]
Description=Bot de Telegram del homelab (/system)
Wants=network-online.target
After=network-online.target docker.service

[Service]
User={{ homelab_user }}
EnvironmentFile=/etc/homelab/telegram.env
ExecStart=/srv/homelab/infra/scripts/telegram-bot.sh
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
