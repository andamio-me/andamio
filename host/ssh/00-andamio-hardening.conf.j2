# Endurecimiento SSH de andamio.
# Prefijo 00- para leerse antes que cualquier otro: en sshd gana el PRIMER valor.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
AllowUsers {{ andamio_user }}
# Llaves personales en ~/.ssh/authorized_keys; las de deploy de cada app (con
# comando forzado) en /etc/ssh/deploy_keys/<usuario>, generado por Ansible.
AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/deploy_keys/%u
