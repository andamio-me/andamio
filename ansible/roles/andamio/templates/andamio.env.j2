# Generado por Ansible desde group_vars/all.yml: no editar aquí.
# Valores NO secretos de este servidor, para los scripts (backup, WireGuard, ...).
ANDAMIO_USER={{ andamio_user }}
ANDAMIO_DOMAIN={{ andamio_domain }}
ANDAMIO_SERVER_IP={{ andamio_server_ip }}
ANDAMIO_GITHUB_OWNER={{ andamio_github_owner }}
ANDAMIO_DASHBOARD_APP={{ andamio_dashboard_app }}
# Idioma de los mensajes del servidor (deploys desde CI incluidos): el de quien aplica.
ANDAMIO_LANG={{ lookup('ansible.builtin.env', 'ANDAMIO_LANG') or 'en' }}
