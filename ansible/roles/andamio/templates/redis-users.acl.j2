# GENERADO por Ansible (rol andamio). Solo hashes SHA-256, nunca contraseñas.
# Cada app: solo claves y canales "<app>:*", sin comandos de administración.
user default on #{{ andamio_redis_default_hash }} ~* &* +@all
{% for u in andamio_redis_users | default([]) %}
user {{ u.name }} on #{{ u.hash }} ~{{ u.name }}:* &{{ u.name }}:* +@all -@admin -@dangerous +info
{% endfor %}
