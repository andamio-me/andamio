{# Imagen en el registro (andamio_registry) = el repo de la app (app.repo, o dueño/nombre). Con
   varias apps en un repo (dir: en app.yml), cada una tiene la suya: dueño/<nombre de la app>. #}
{% set repo_path = app.repo | default(andamio_github_owner ~ '/' ~ app.name) | lower -%}
{% set image = app.image | default((andamio_registry | default('ghcr.io')) ~ '/'
               ~ ((repo_path.split('/')[0] ~ '/' ~ app.name) if app.dir is defined else repo_path)) -%}
{% set apex = app.host == '@' -%}
{# Dominio raíz (host "@"): sirve DOMAIN y www.DOMAIN; el router toma el nombre de la app. Con
   path: (p. ej. /api, el back bajo el dominio del front) también: dos apps comparten el host. #}
{% set router = app.name if apex or app.path is defined else app.host -%}
{# Con path:, solo esas rutas. Traefik prefiere la regla más larga: gana sobre la del front. #}
{% set path_rule = (' && PathPrefix(`' ~ app.path ~ '`)') if app.path is defined else '' -%}
{# Middlewares del router: solo VPN (access: vpn) y CORS (cors: [orígenes]). #}
{% set mws = (['vpn-only@file'] if app.access | default('vpn') == 'vpn' else [])
             + ([router ~ '-cors@docker'] if app.cors | default([]) else []) -%}
{% set domains = app.domains | default([]) -%}
{# Carpetas persistentes (volumes: en app.yml): /srv/andamio/data/apps/<app>/<nombre>, dentro
   del backup. scripts/app-volumes.sh las crea y se las da al usuario de la imagen. #}
{% set volumes = app.volumes | default([]) -%}
# {{ app.name }}: GENERADO desde app.yml por ansible/apps.yml. No editar a mano.
# TAG (hash del commit) y los secretos vienen de .env (solo en el servidor).
services:
  app:
    image: {{ image }}:${TAG:?falta TAG en .env}
    restart: unless-stopped
    env_file: .env
    environment:
      APP_VERSION: ${TAG}
{% if volumes %}
    volumes:
{% for v in volumes %}
      - /srv/andamio/data/apps/{{ app.name }}/{{ v.strip('/') | replace('/', '-') }}:{{ v }}
{% endfor %}
{% endif %}
    networks:
      - proxy
{% for net in app.networks | default([]) %}
      - {{ net }}
{% endfor %}
    labels:
      - traefik.enable=true
      - traefik.docker.network=proxy
{% if apex %}
{# Sin path: la misma regla de siempre (un cambio de texto recrearía el contenedor). #}
      - traefik.http.routers.{{ router }}.rule={{ '(' if path_rule }}Host(`${DOMAIN}`) || Host(`www.${DOMAIN}`){{ ')' if path_rule }}{{ path_rule }}
{% else %}
      - traefik.http.routers.{{ router }}.rule=Host(`{{ app.host }}.${DOMAIN}`){{ path_rule }}
{% endif %}
      - traefik.http.routers.{{ router }}.entrypoints=websecure
{% if mws %}
      - traefik.http.routers.{{ router }}.middlewares={{ mws | join(',') }}
{% endif %}
      - traefik.http.services.{{ router }}.loadbalancer.server.port={{ app.port }}
{% if domains %}
      # Dominios propios (domains: en app.yml): otro router, con su certificado de Let's
      # Encrypt por HTTP-01 (el comodín del servidor no los cubre). Mismas protecciones.
      - traefik.http.routers.{{ router }}.service={{ router }}
      - traefik.http.routers.{{ router }}-own.rule={{ '(' if path_rule }}{% for d in domains %}Host(`{{ d }}`){{ ' || ' if not loop.last }}{% endfor %}{{ ')' if path_rule }}{{ path_rule }}

      - traefik.http.routers.{{ router }}-own.entrypoints=websecure
      - traefik.http.routers.{{ router }}-own.tls.certresolver=le
      - traefik.http.routers.{{ router }}-own.service={{ router }}
{% if mws %}
      - traefik.http.routers.{{ router }}-own.middlewares={{ mws | join(',') }}
{% endif %}
{% endif %}
{% if app.cors | default([]) %}
      # CORS (cors: en app.yml): solo estos orígenes pueden llamar a la app desde un navegador.
      - traefik.http.middlewares.{{ router }}-cors.headers.accesscontrolalloworiginlist={{ app.cors | join(',') }}
      - traefik.http.middlewares.{{ router }}-cors.headers.accesscontrolallowmethods=GET,POST,PUT,PATCH,DELETE,OPTIONS
      - traefik.http.middlewares.{{ router }}-cors.headers.accesscontrolallowheaders=Authorization,Content-Type
      - traefik.http.middlewares.{{ router }}-cors.headers.accesscontrolmaxage=600
      - traefik.http.middlewares.{{ router }}-cors.headers.addvaryheader=true
{% endif %}
{% if app.health is defined %}
      # deploy-app.sh consulta esta ruta (HTTP, desde el host) antes de dar la versión por sana.
      - andamio.health={{ app.health }}
{% endif %}
    security_opt: [no-new-privileges:true]
    mem_limit: {{ app.resources.mem }}
    memswap_limit: {{ app.resources.mem }}
    cpus: {{ app.resources.cpus }}
    pids_limit: {{ app.resources.pids }}
{% if app.worker is defined %}

  # Worker: la misma imagen con otro proceso. Sin Traefik. Con heartbeat: true, su
  # salud es un latido (toca /tmp/heartbeat cada pocos segundos; si se cuelga, deja de
  # hacerlo). Sin él, deploy-app.sh lo da por sano si arranca y no se reinicia.
  worker:
    image: {{ image }}:${TAG:?falta TAG en .env}
    command: {{ app.worker.command | to_json }}
    restart: unless-stopped
    env_file: .env
    environment:
      APP_VERSION: ${TAG}
{% if volumes %}
    volumes:
{% for v in volumes %}
      - /srv/andamio/data/apps/{{ app.name }}/{{ v.strip('/') | replace('/', '-') }}:{{ v }}
{% endfor %}
{% endif %}
{% if app.networks | default([]) %}
    networks: [{{ app.networks | join(', ') }}]
{% endif %}
{% if app.worker.heartbeat | default(false) %}
    healthcheck:
      test: ["CMD-SHELL", "test -f /tmp/heartbeat && [ $$(( $$(date +%s) - $$(stat -c %Y /tmp/heartbeat) )) -lt 60 ]"]
      interval: 15s
      timeout: 3s
      retries: 3
      start_period: 20s
{% endif %}
    security_opt: [no-new-privileges:true]
    mem_limit: {{ app.worker.mem | default('256m') }}
    memswap_limit: {{ app.worker.mem | default('256m') }}
    cpus: {{ app.worker.cpus | default(0.25) }}
    pids_limit: 100
{% endif %}
{% if app.migrate | default(false) %}

  # Migraciones: deploy-app.sh las corre antes de cada deploy. migrate: true usa una
  # imagen aparte (etapa "migrate" del Dockerfile); migrate: {command: ...} corre ese
  # comando con la misma imagen de la app (p. ej. "python manage.py migrate").
  migrate:
{% if app.migrate is mapping %}
    image: {{ image }}:${TAG:?falta TAG en .env}
    command: {{ app.migrate.command | to_json }}
{% else %}
    image: {{ image }}-migrate:${TAG:?falta TAG en .env}
{% endif %}
    profiles: [migrate]
    env_file: .env
    networks: [data]
    security_opt: [no-new-privileges:true]
    restart: "no"
{% endif %}

networks:
  proxy:
    external: true
{% for net in app.networks | default([]) %}
  {{ net }}:
    external: true
{% endfor %}
