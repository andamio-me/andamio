#!/usr/bin/env bash
# Mini-PaaS de andamio: `bin/andamio app ...` llama a este script. Se usa desde tu máquina.
#
#   andamio app create <nombre> [--repo dueño/repo] [--public] [--db] [--redis] [--host <sub>|@] [--mem 256m]
#   andamio app secret set|rm <nombre> <CLAVE>      andamio app secret list <nombre>
#   andamio app list | logs <nombre> | rollback <nombre> | destroy <nombre>
#
# create: repo propio (--repo) o desde andamio_app_template, apps/<nombre>/app.yml, secretos y llave de
# deploy (apps.yml), commit + push de andamio y configuración del servidor.
# Idioma: ANDAMIO_LANG (o LANG) que empiece con "es" = español; si no, inglés.
set -euo pipefail

INFRA=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
LNG=en; [[ ${ANDAMIO_LANG:-${LANG:-}} == es* ]] && LNG=es
export ANDAMIO_LANG=$LNG    # bin/forge y ansible/hl lo heredan
L() { if [ "$LNG" = es ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
# La configuración de este servidor vive en un solo lugar: ansible/group_vars/all.yml.
cfg() { python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1]))[sys.argv[2]])' \
  "$INFRA/ansible/group_vars/all.yml" "$1"; }
OWNER=$(cfg andamio_github_owner)
DOMAIN=$(cfg andamio_domain)
# Este repo en GitHub (dueño/nombre), de andamio_repo: ahí vive el workflow app-build.yml.
INSTANCE_REPO=$(cfg andamio_repo | sed -E 's#^[^:]+:##; s#\.git$##')
# Plantilla para apps nuevas sin --repo (opcional: andamio_app_template en la config).
# El servidor: alias SSH = primer host de ansible/inventory.yml (~/.ssh/config lo resuelve).
SERVER=$(python3 -c 'import sys, yaml; print(next(iter(yaml.safe_load(open(sys.argv[1]))["all"]["children"]["andamio"]["hosts"])))'   "$INFRA/ansible/inventory.yml")
TEMPLATE=$(python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1])).get("andamio_app_template") or "")' \
  "$INFRA/ansible/group_vars/all.yml")
PROJECTS=$HOME/projects
export PATH=$HOME/.local/bin:$PATH

die() { echo "✗ $*" >&2; exit 1; }
# Todo lo de GitHub (o la forja que sea) pasa por bin/forge.
forge() { "$INFRA/bin/forge" "$@"; }
step() { printf '\n==> %s\n' "$*"; }
usage() {
  L "  andamio app create <nombre> [--repo dueño/repo] [--port 3000] [--health /ruta]
                             [--public] [--db] [--redis] [--host <sub>|@] [--mem 256m]
                             [--domain api.suempresa.com] [--cors https://miapp.vercel.app]
  andamio app secret set <nombre> <CLAVE>    (el valor se pide oculto, o por un pipe)
  andamio app secret rm <nombre> <CLAVE>
  andamio app secret list <nombre>           (solo los nombres)
  andamio app list
  andamio app stop|start <nombre>            (apagarla sin borrar nada / volver)
  andamio app domain add|rm|list <nombre> [api.suempresa.com]   (dominio propio, además del tuyo)
  andamio app cors add|rm|list <nombre> [https://miapp.vercel.app]   (frontend en otro lado)
  andamio app logs <nombre>
  andamio app rollback <nombre>
  andamio app destroy <nombre>
" "  andamio app create <name> [--repo owner/repo] [--port 3000] [--health /path]
                           [--public] [--db] [--redis] [--host <sub>|@] [--mem 256m]
                           [--domain api.mycompany.com] [--cors https://myapp.vercel.app]
  andamio app secret set <name> <KEY>        (the value is asked hidden, or read from a pipe)
  andamio app secret rm <name> <KEY>
  andamio app secret list <name>             (names only)
  andamio app list
  andamio app stop|start <name>              (turn it off without deleting anything / back on)
  andamio app domain add|rm|list <name> [api.mycompany.com]   (your own domain, besides the server's)
  andamio app cors add|rm|list <name> [https://myapp.vercel.app]   (frontend hosted elsewhere)
  andamio app logs <name>
  andamio app rollback <name>
  andamio app destroy <name>
"
  exit 1
}
confirm() { local ok; read -rp "$1 [$(L s y)/N] " ok; [[ $ok =~ ^[sSyY]$ ]] || die "$(L Cancelado Cancelled)"; }
# URL pública de un host: "@" es el dominio raíz.
app_url() { if [ "$1" = "@" ]; then echo "https://$DOMAIN"; else echo "https://$1.$DOMAIN"; fi; }
valid_name() {
  [[ $1 =~ ^[a-z][a-z0-9-]{1,28}[a-z0-9]$ ]] \
    || die "$(L "Nombre inválido: minúsculas, números y guiones (3-30)" "Invalid name: lowercase letters, digits and hyphens (3-30)")"
}
no_uncommitted() {
  git -C "$INFRA" diff --quiet && git -C "$INFRA" diff --cached --quiet \
    || die "$(L "Este repo tiene cambios sin commitear; súbelos o descártalos antes" "This repo has uncommitted changes; push or discard them first")"
}

app_create() {
  local name=${1:-}; shift || true
  [ -n "$name" ] || usage
  valid_name "$name"
  local access=vpn db=false redis=false host=$name mem=256m repo="" port=3000 port_set="" health=""
  local domains=() origins=()
  local missing; missing=$(L "falta el valor de" "missing value for")
  while [ $# -gt 0 ]; do
    case $1 in
      --public) access=public ;;
      --db) db=true ;;
      --redis) redis=true ;;
      --host) host=${2:?$missing --host}; shift ;;
      --mem) mem=${2:?$missing --mem}; shift ;;
      --repo) repo=${2:?$missing --repo}; shift ;;       # repo existente (cualquier lenguaje)
      --port) port=${2:?$missing --port}; port_set=$port; shift ;;
      --health) health=${2:?$missing --health}; shift ;;
      --domain) domains+=("$(valid_domain "${2:?$missing --domain}")"); shift ;;
      --cors) origins+=("$(valid_origin "${2:?$missing --cors}")"); shift ;;
      *) die "$(L "Opción desconocida" "Unknown option"): $1" ;;
    esac
    shift
  done
  [[ $host == "@" || $host =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] \
    || die "$(L "Host inválido: $host (subdominio o @ para el dominio raíz)" "Invalid host: $host (subdomain, or @ for the root domain)")"
  [[ $mem =~ ^[0-9]+[mg]$ ]] || die "$(L "Memoria inválida: $mem (ej. 256m, 1g)" "Invalid memory: $mem (e.g. 256m, 1g)")"
  [[ $port =~ ^[0-9]{2,5}$ ]] || die "$(L "Puerto inválido" "Invalid port"): $port"
  [[ -z $health || $health =~ ^/[A-Za-z0-9._/-]*$ ]] \
    || die "$(L "Ruta de salud inválida: $health (ej. /healthz)" "Invalid health path: $health (e.g. /healthz)")"
  [[ -z $repo || $repo =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] \
    || die "$(L "Repo inválido: $repo (dueño/nombre)" "Invalid repo: $repo (owner/name)")"

  local dir=$INFRA/apps/$name
  [ -e "$dir" ] && die "$(L "Ya existe" "Already exists"): $dir"
  grep -rqsE "^host: \"?$host\"?( |$)" "$INFRA"/apps/*/app.yml \
    && die "$(L "El host '$host' ya lo usa otra app" "Host '$host' is already used by another app")"
  [ -z "$repo" ] && [ -e "$PROJECTS/$name" ] && die "$(L "Ya existe" "Already exists"): $PROJECTS/$name"
  [ -n "$repo" ] || [ -n "$TEMPLATE" ] \
    || die "$(L "Indica el repo de tu app con --repo dueño/nombre (o define andamio_app_template en la config)" \
               "Give your app's repo with --repo owner/name (or set andamio_app_template in the config)")"
  no_uncommitted
  forge auth-ok || die "$(L "Tu CLI de $(forge name) no tiene sesión iniciada" "Your $(forge name) CLI isn't logged in") ($(forge tools | cut -f2))"
  [ -z "$repo" ] || forge repo-exists "$repo" \
    || die "$(L "No existe $repo en $(forge name) (o no tienes acceso)" "$repo doesn't exist on $(forge name) (or you have no access)")"

  # El repo de la app, clonado aparte: Dockerfile (si falta, se propone uno) y CI.
  local work=""
  if [ -n "$repo" ]; then
    work=$(mktemp -d)
    # shellcheck disable=SC2064   # el temporal se fija ahora, a propósito
    trap "rm -rf '$work'" EXIT
    step "$(L "Revisando el repo $repo" "Checking the repo $repo")"
    git clone -q --depth 1 "$(forge clone-url "$repo")" "$work/repo" \
      || die "$(L "No pude clonar $repo por SSH" "Couldn't clone $repo over SSH")"
    "$INFRA/bin/andamio" _scaffold "$work/repo" "$port_set" "$work/out"
    local p; p=$(sed -n 's/^port=//p' "$work/out")
    # Sin --port: el del Dockerfile generado, o el EXPOSE del que ya tenía.
    if [ -z "$port_set" ] && [ -z "$p" ] && [ -f "$work/repo/Dockerfile" ]; then
      p=$(grep -m1 -oiE '^EXPOSE +[0-9]+' "$work/repo/Dockerfile" | grep -oE '[0-9]+' || true)
    fi
    port=${p:-$port}
  fi

  echo "App:      $name"
  echo "Repo:     ${repo:-$OWNER/$name ($(L "nuevo, desde" "new, from") $TEMPLATE)}"
  echo "URL:      $(app_url "$host")  ($access)"
  echo "$(L Recursos Resources): PostgreSQL=$db Redis=$redis RAM=$mem  $(L puerto port)=$port${health:+  $(L salud health)=$health}"
  confirm "$(L "¿Crear?" "Create?")"

  if [ -z "$repo" ]; then
    step "$(L "Repo $OWNER/$name desde la plantilla" "Repo $OWNER/$name from the template")"
    forge repo-create "$OWNER/$name" "$TEMPLATE"
    git clone -q "$(forge clone-url "$OWNER/$name")" "$PROJECTS/$name"
  fi

  step "apps/$name/app.yml"
  mkdir -p "$dir"
  local nets=""
  { $db || $redis; } && nets="data"
  # La imagen de migraciones (Prisma, plantilla) necesita la base: sin --db no hay
  # migrate. Un repo existente declara sus migraciones a mano en app.yml si las tiene.
  local migrate=$db; [ -n "$repo" ] && migrate=false
  cat > "$dir/app.yml" <<EOF
# $(L "Creada con" "Created with"): andamio app create $name. $(L "compose.yaml se genera de aquí" "compose.yaml is generated from this") (ansible/apps.yml).
name: $name
${repo:+repo: $repo
}host: "$host"
port: $port
${health:+health: $health
}access: $access
networks: [${nets}]
migrate: $migrate
db: $db
redis: $redis
resources:
  mem: $mem
  cpus: 0.5
  pids: 200
EOF
  [ ${#domains[@]} -gt 0 ] && yaml_list "$dir/app.yml" domains "${domains[@]}"
  [ ${#origins[@]} -gt 0 ] && yaml_list "$dir/app.yml" cors "${origins[@]}"
  for d in "${domains[@]}"; do dns_check "$d"; done

  step "$(L "Secretos, llave de deploy y compose" "Secrets, deploy key and compose") (ansible/apps.yml)"
  (cd "$INFRA/ansible" && ansible-playbook apps.yml | grep -E 'msg|fatal|ok=')
  [ -f "$dir/deploy_key.pub" ] \
    || die "$(L "No se creó la llave de deploy (¿el repo existe y tienes permiso en $(forge name)?)" \
               "The deploy key wasn't created (does the repo exist, and do you have permission on $(forge name)?)")"

  step "$(L "Commit y push de este repo" "Commit and push this repo")"
  git -C "$INFRA" add "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $name (andamio app create)"
  git -C "$INFRA" push -q

  step "$(L "Servidor: .env, base, Redis y llave de deploy (pide tu contraseña de sudo)" \
            "Server: .env, database, Redis and deploy key (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply

  # El CI de la app usa el pipeline de ESTE repo: si es privado, la forja exige permitirlo.
  [ "$(forge ci-allow-reuse "$INSTANCE_REPO")" = cambiado ] \
    && step "$(L "Permití que tus repos usen el pipeline de $INSTANCE_REPO" "Allowed your repos to use $INSTANCE_REPO's pipeline")"

  local vpn=""; [ "$access" = vpn ] && vpn="  ($(L "con la VPN" "over the VPN"))"
  if [ -n "$repo" ]; then
    push_pipeline "$work/repo" "$repo" "$name"
    echo
    L "  Desde ahora cada push a main despliega. Tu app:" "  From now on every push to main deploys. Your app:"
    echo " $(app_url "$host")$vpn"
    return
  fi

  echo
  L "✓ $name lista. Primer deploy:" "✓ $name ready. First deploy:"
  cat <<EOF

    cd $PROJECTS/$name
    git commit --allow-empty -m "$(L "primer deploy" "first deploy")" && git push
    $INFRA/bin/forge ci-watch
  $(L Luego Then): $(app_url "$host")$vpn
EOF
}

# Sube al repo de la app lo que le falte para desplegarse: el Dockerfile generado y el
# pipeline (.github/workflows/andamio.yml), en un commit, por SSH (con tu llave: el token
# de gh no necesita permiso de workflows). Pregunta antes; el push dispara el primer deploy.
push_pipeline() {  # push_pipeline <clon> <dueño/repo> <app>
  local dir=$1 repo=$2 name=$3
  # Versión fija del pipeline: el último tag app-build-v*, o el último commit que lo cambió.
  local sha; sha=$(git -C "$INFRA" rev-list -n1 "$(git -C "$INFRA" describe --tags --abbrev=0 --match 'app-build-v*' 2> /dev/null)" 2> /dev/null \
    || git -C "$INFRA" log -1 --format=%H -- .github/workflows/app-build.yml)
  if ! grep -rqs "workflows/app-build.yml@" "$dir/.github/workflows"; then
    mkdir -p "$dir/.github/workflows"
    forge ci-snippet "$INSTANCE_REPO" "$sha" > "$dir/.github/workflows/andamio.yml"
  fi
  if [ ! -f "$dir/Dockerfile" ]; then
    echo
    L "! $repo no tiene Dockerfile: sin él no hay qué desplegar. Agrégalo y, junto con este
  archivo en .github/workflows/andamio.yml, haz push:" "! $repo has no Dockerfile: without it there's nothing to deploy. Add one and push it
  along with this file at .github/workflows/andamio.yml:"
    printf '\n%s\n' "$(cat "$dir/.github/workflows/andamio.yml")"
    return
  fi
  local changes; changes=$(git -C "$dir" status --porcelain --untracked-files=all | awk '{print "    " $2}')
  if [ -z "$changes" ]; then
    echo "✓ $(L "$repo ya tiene Dockerfile y pipeline: el próximo push despliega" "$repo already has a Dockerfile and the pipeline: the next push deploys")"
    return
  fi
  echo
  L "Para desplegarse, $repo necesita:" "To deploy, $repo needs:"; echo; echo "$changes"
  local ok; read -rp "$(L "¿Los subo a $repo? (commit en main y push: arranca el primer deploy) [S/n] " \
                           "Push them to $repo? (commit on main and push: starts the first deploy) [Y/n] ")" ok < /dev/tty
  if [[ $ok =~ ^[nN] ]]; then
    local keep=$HOME/andamio-$name; rm -rf "$keep"; mkdir -p "$keep"
    (cd "$dir" && git status --porcelain --untracked-files=all | awk '{print $2}' | xargs -I{} cp --parents {} "$keep/")
    L "No subí nada. Los archivos quedaron en $keep: cópialos a tu repo y haz push." \
      "Nothing pushed. The files are in $keep: copy them into your repo and push."; echo
    return
  fi
  git -C "$dir" add -A
  git -C "$dir" commit -qm "$(L "andamio: Dockerfile y pipeline de deploy" "andamio: Dockerfile and deploy pipeline")"
  git -C "$dir" push -q origin HEAD \
    || die "$(L "$repo rechazó el push (¿main protegida?). Sube esos archivos con un PR." "$repo rejected the push (protected main?). Add those files through a PR.")"
  echo "✓ $(L "Subido a $repo: primer deploy en curso" "Pushed to $repo: first deploy running")"
  step "$(L "Primer deploy (tests, escaneo, build y deploy)" "First deploy (tests, scan, build and deploy)")"
  forge ci-watch "$repo" "$(git -C "$dir" rev-parse HEAD)" || { L "! El deploy falló: el detalle está arriba." "! The deploy failed: details above."; echo; }
}

# andamio app stop|start: el estado vive en app.yml (stopped: true), así sobrevive a
# `hl aplicar` y un push no la despliega mientras esté detenida.
app_state() {  # app_state <stop|start> <nombre>
  local want=$1 name=${2:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || die "$(L "No existe la app" "No such app"): $name"
  no_uncommitted
  if [ "$want" = stop ]; then
    grep -qx 'stopped: true' "$f" && die "$(L "$name ya está detenida" "$name is already stopped")"
    echo "stopped: true" >> "$f"
  else
    grep -qx 'stopped: true' "$f" || die "$(L "$name no está detenida" "$name isn't stopped")"
    sed -i '/^stopped: true$/d' "$f"
  fi
  git -C "$INFRA" add "apps/$name/app.yml"
  git -C "$INFRA" commit -qm "feat(apps): $want $name (andamio app $want)"
  git -C "$INFRA" push -q
  step "$(L "Servidor (pide tu contraseña de sudo)" "Server (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply
  echo
  local host; host=$(awk '$1 == "host:" {gsub(/"/, "", $2); print $2}' "$f")
  if [ "$want" = stop ]; then
    L "⏸ $name detenida. Sus datos, base, secretos y dominio siguen ahí; un push no la despliega.
  Para volver: andamio app start $name" "⏸ $name stopped. Its data, database, secrets and domain are kept; a push won't deploy it.
  To bring it back: andamio app start $name"
  else
    L "▶ $name en marcha otra vez: $(app_url "$host")" "▶ $name running again: $(app_url "$host")"
  fi
  echo
}

# Dominios propios (domains:) y CORS (cors:) de una app: listas en su app.yml.
valid_domain() {
  local d=${1,,}
  [[ $d =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$ ]] \
    || die "$(L "Dominio inválido: $1 (ej. api.suempresa.com)" "Invalid domain: $1 (e.g. api.mycompany.com)")"
  [ "$d" = "$DOMAIN" ] && die "$(L "$d es el dominio del servidor: usa --host @" "$d is the server's domain: use --host @")"
  local sub=${d%".$DOMAIN"}
  if [ "$sub" != "$d" ] && [[ $sub != *.* ]]; then
    die "$(L "$d es un subdominio directo de este servidor: usa --host $sub" "$d is a direct subdomain of this server: use --host $sub")"
  fi
  echo "$d"
}
valid_origin() {
  local o=${1,,}; o=${o%/}
  [ "$o" = "*" ] && die "$(L "\"*\" dejaría que cualquier sitio use tu API desde el navegador de tus usuarios: pon los orígenes exactos" \
                            "\"*\" would let any site use your API from your users' browsers: list the exact origins")"
  [[ $o =~ ^https?://[a-z0-9.-]+(:[0-9]{1,5})?$ ]] \
    || die "$(L "Origen inválido: $1 (ej. https://miapp.vercel.app, sin ruta)" "Invalid origin: $1 (e.g. https://myapp.vercel.app, no path)")"
  echo "$o"
}
# Avisa si el DNS del dominio no apunta a este servidor (Let's Encrypt fallaría).
dns_check() {
  local ip; ip=$(cfg andamio_server_ip)
  if python3 -c 'import socket,sys; sys.exit(sys.argv[2] not in {a[4][0] for a in socket.getaddrinfo(sys.argv[1], None, socket.AF_INET)})' "$1" "$ip" 2> /dev/null; then
    echo "✓ $1 → $ip"
  else
    L "! $1 todavía no apunta a $ip. Crea en su DNS un registro A: $1 → $ip
  Mientras no apunte, Let's Encrypt rechaza el certificado (y limita los intentos fallidos)." \
      "! $1 doesn't point to $ip yet. Create an A record in its DNS: $1 → $ip
  Until it does, Let's Encrypt rejects the certificate (and rate-limits failed attempts)."
    echo
    confirm "$(L "¿Agregarlo igual?" "Add it anyway?")"
  fi
}
# yaml_list <app.yml> <clave> [valores...]: reescribe esa lista (vacía = la quita).
yaml_list() {
  local f=$1 key=$2; shift 2
  python3 - "$f" "$key" "$@" <<'PY'
import re, sys
f, key, values = sys.argv[1], sys.argv[2], sys.argv[3:]
text = re.sub(rf"(?m)^{key}:.*\n", "", open(f).read())
if values:
    text = text.rstrip("\n") + f"\n{key}: [{', '.join(values)}]\n"
open(f, "w").write(text)
PY
}
yaml_get() {  # yaml_get <app.yml> <clave>: un valor por línea
  python3 -c 'import sys, yaml; print("\n".join(yaml.safe_load(open(sys.argv[1])).get(sys.argv[2]) or []))' "$1" "$2"
}
app_list_edit() {  # app_list_edit <domains|cors> <add|rm|list> <app> [valor]
  local key=$1 sub=${2:-} name=${3:-} value=${4:-}
  [ -n "$sub" ] && [ -n "$name" ] || usage
  valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || die "$(L "No existe la app" "No such app"): $name"
  local current; current=$(yaml_get "$f" "$key")
  if [ "$sub" = list ]; then
    [ -n "$current" ] && sed 's/^/  /' <<< "$current" || L "  (ninguno)" "  (none)"; echo
    return
  fi
  [[ $sub == add || $sub == rm ]] && [ -n "$value" ] || usage
  if [ "$key" = domains ]; then value=$(valid_domain "$value"); else value=$(valid_origin "$value"); fi
  no_uncommitted
  local items=(); [ -n "$current" ] && mapfile -t items <<< "$current"
  if [ "$sub" = add ]; then
    printf '%s\n' "${items[@]}" | grep -qx "$value" && die "$(L "$name ya tiene $value" "$name already has $value")"
    items+=("$value")
    [ "$key" = domains ] && dns_check "$value"
  else
    printf '%s\n' "${items[@]}" | grep -qx "$value" || die "$(L "$name no tiene $value" "$name doesn't have $value")"
    mapfile -t items < <(printf '%s\n' "${items[@]}" | grep -vx "$value" || true)
  fi
  yaml_list "$f" "$key" "${items[@]}"
  step "$(L "Compose de $name (ansible/apps.yml)" "$name's compose (ansible/apps.yml)")"
  (cd "$INFRA/ansible" && ansible-playbook apps.yml | grep -E 'fatal|ok=')
  git -C "$INFRA" add "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $name $key $sub $value"
  git -C "$INFRA" push -q
  step "$(L "Servidor (pide tu contraseña de sudo)" "Server (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply
  echo
  if [ "$key" = domains ] && [ "$sub" = add ]; then
    L "✓ https://$value → $name (su certificado de Let's Encrypt se pide en el primer acceso)" \
      "✓ https://$value → $name (its Let's Encrypt certificate is requested on first access)"
  else
    L "✓ $name: $key $sub $value" "✓ $name: $key $sub $value"
  fi
  echo
}

# Secretos de ejecución de una app (apps/<app>/secrets.sops.env -> .env en el servidor).
# El valor nunca va en la línea de comandos: se escribe oculto o llega por un pipe.
RESERVED="DOMAIN DATABASE_URL REDIS_URL TAG"   # los pone andamio
app_secret() {
  local sub=${1:-} name=${2:-} key=${3:-}
  [ -n "$sub" ] && [ -n "$name" ] || usage
  valid_name "$name"
  local rel=apps/$name/secrets.sops.env
  [ -f "$INFRA/apps/$name/app.yml" ] || die "$(L "No existe la app" "No such app"): $name"
  [ -f "$INFRA/$rel" ] || die "$(L "Falta $rel (se crea con andamio app create)" "$rel is missing (andamio app create creates it)")"
  if [ "$sub" = list ]; then
    (cd "$INFRA" && sops decrypt --input-type dotenv --output-type dotenv "$rel") | grep -oE '^[A-Za-z_][A-Za-z0-9_]*' \
      | while read -r k; do
          if [[ " $RESERVED " == *" $k "* ]]; then echo "  $k  ($(L "lo pone andamio" "set by andamio"))"; else echo "  $k"; fi
        done
    return
  fi
  [[ $sub == set || $sub == rm ]] || usage
  [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] \
    || die "$(L "Nombre inválido: MAYÚSCULAS, números y _ (ej. ANTHROPIC_API_KEY)" "Invalid name: UPPERCASE, digits and _ (e.g. ANTHROPIC_API_KEY)")"
  [[ " $RESERVED " == *" $key "* ]] \
    && die "$(L "$key lo pone andamio: no se cambia a mano" "andamio sets $key: it isn't changed by hand")"
  no_uncommitted

  local value=""
  if [ "$sub" = set ]; then
    if [ -t 0 ]; then
      read -rsp "$(L "Valor de $key para $name (no se ve al escribir): " "Value of $key for $name (hidden while typing): ")" value; echo
    else
      value=$(cat)   # por pipe: cat clave.txt | andamio app secret set ...
    fi
    [ -n "$value" ] || die "$(L "El valor está vacío" "The value is empty")"
    [[ $value != *$'\n'* ]] || die "$(L "El valor tiene que ser una sola línea" "The value must be a single line")"
  fi

  local tmp; tmp=$(mktemp -d); chmod 700 "$tmp"
  # shellcheck disable=SC2064   # el temporal se fija ahora, a propósito
  trap "shred -u '$tmp'/* 2> /dev/null; rm -rf '$tmp'" EXIT
  (cd "$INFRA" && sops decrypt --input-type dotenv --output-type dotenv "$rel") > "$tmp/actual"
  if [ "$sub" = rm ] && ! grep -q "^$key=" "$tmp/actual"; then
    die "$(L "$name no tiene $key" "$name doesn't have $key")"
  fi
  local verb; verb=$(L "actualizado" "updated"); grep -q "^$key=" "$tmp/actual" || verb=$(L "agregado" "added")
  [ "$sub" = rm ] && verb=$(L "quitado" "removed")
  # El valor llega a awk por el entorno (V), nunca como argumento.
  K=$key V=$value MODE=$sub awk '
    BEGIN { k = ENVIRON["K"] "=" }
    index($0, k) == 1 { if (ENVIRON["MODE"] == "set" && !done) { print k ENVIRON["V"]; done = 1 }; next }
    { print }
    END { if (ENVIRON["MODE"] == "set" && !done) print k ENVIRON["V"] }' "$tmp/actual" > "$tmp/nuevo"
  unset value
  (cd "$INFRA" && sops encrypt --input-type dotenv --output-type dotenv --filename-override "$rel" "$tmp/nuevo") > "$tmp/cifrado"
  mv "$tmp/cifrado" "$INFRA/$rel"
  echo "✓ $key $verb ($rel, $(L cifrado encrypted))"

  step "$(L "Commit y push (solo el nombre, nunca el valor)" "Commit and push (only the name, never the value)")"
  git -C "$INFRA" add "$rel"
  git -C "$INFRA" commit -qm "secret($name): $sub $key"
  git -C "$INFRA" push -q

  step "$(L "Servidor: .env de $name y reinicio de la app (pide tu contraseña de sudo)" \
            "Server: $name's .env and app restart (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply
}

app_list() {
  printf '%-22s %-40s %-7s %s\n' APP URL "$(L ACCESO ACCESS)" "$(L ESTADO STATUS)"
  local status; status=$(ssh -n "$SERVER" "docker ps --format '{{.Names}} {{.Status}}'")
  for f in "$INFRA"/apps/*/app.yml; do
    local name host access st
    name=$(basename "$(dirname "$f")")
    host=$(awk '$1 == "host:" {gsub(/"/, "", $2); print $2}' "$f"); access=$(awk '$1 == "access:" {print $2}' "$f")
    st=$(grep -E "^$name-app-[0-9]+ " <<< "$status" | cut -d' ' -f2- || true)
    grep -qx 'stopped: true' "$f" && st="⏸ $(L detenida stopped)"
    printf '%-22s %-40s %-7s %s\n' "$name" "$(app_url "$host")" "${access:-vpn}" "${st:-$(L "sin desplegar" "not deployed")}"
  done
}

app_logs() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  ssh -t "$SERVER" "docker logs -f --tail 100 \$(docker ps -q --filter name=^$name-app- | head -1)"
}

app_rollback() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  # Penúltimo deploy exitoso, leído de la tabla deployments de la app.
  local prev
  prev=$(ssh -n "$SERVER" "cd /srv/andamio/infra/apps/$name && url=\$(grep '^DATABASE_URL=' .env | cut -d= -f2-) && \
    docker run --rm --network data postgres:18.6-alpine psql -tA \"\$url\" -c \
    \"SELECT commit_sha || ' ' || version FROM deployments WHERE status = 'success' ORDER BY id DESC OFFSET 1 LIMIT 1\"")
  [ -n "$prev" ] || die "$(L "No hay un deploy exitoso anterior para volver" "There's no previous successful deploy to go back to")"
  read -r sha version <<< "$prev"
  confirm "$(L "¿Volver $name a $version (${sha:0:7})?" "Roll $name back to $version (${sha:0:7})?")"
  ssh -n "$SERVER" "/srv/andamio/infra/scripts/deploy-app.sh $name $sha $version"
}

app_destroy() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  local dir=$INFRA/apps/$name
  [ -f "$dir/app.yml" ] || die "$(L "No existe la app" "No such app"): $name"
  [ "$name" = "$(python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1])).get("andamio_dashboard_app") or "")' \
      "$INFRA/ansible/group_vars/all.yml")" ] \
    && die "$(L "$name es tu dashboard (andamio_dashboard_app): no se destruye con este comando" \
               "$name is your dashboard (andamio_dashboard_app): this command doesn't destroy it")"
  no_uncommitted

  L "Esto DESTRUYE la app $name:
  - sus contenedores (web y worker) en el servidor
  - su base y su usuario de PostgreSQL (antes: respaldo en /srv/andamio/archive/, que entra en restic)
  - sus claves y su usuario de Redis
  - apps/$name en este repo (revoca su llave de deploy y la quita del registro)
No toca: el repo de la app, sus imágenes en el registro ni $PROJECTS/$name.
" "This DESTROYS the app $name:
  - its containers (web and worker) on the server
  - its PostgreSQL database and user (first backed up to /srv/andamio/archive/, which restic includes)
  - its Redis keys and user
  - apps/$name in this repo (revokes its deploy key and removes it from the registry)
Left alone: the app's repo, its images in the registry and $PROJECTS/$name.
"
  local ok; read -rp "$(L "Para confirmar, escribe el nombre de la app: " "To confirm, type the app's name: ")" ok
  [ "$ok" = "$name" ] || die "$(L Cancelado Cancelled)"

  step "$(L "Servidor: respaldo, contenedores, base y Redis" "Server: backup, containers, database and Redis")"
  ssh "$SERVER" bash -s -- "$name" "$LNG" <<'REMOTE'
set -euo pipefail
name=$1; LNG=$2; cd "/srv/andamio/infra/apps/$name"
L() { if [ "$LNG" = es ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }
dbname=""; role=""
url=$(grep '^DATABASE_URL=' .env 2>/dev/null | cut -d= -f2- || true)
if [ -n "$url" ]; then
  dbname=${url##*/}; role=$(sed -E 's#^postgres(ql)?://([^:]+):.*#\2#' <<< "$url")
  [[ $dbname =~ ^[a-z0-9_]+$ && $role =~ ^[a-z0-9_]+$ ]] || { L "DATABASE_URL inesperada; no sigo" "Unexpected DATABASE_URL; stopping"; exit 1; }
  install -d -m 700 /srv/andamio/archive
  out=/srv/andamio/archive/$name-$(date +%Y%m%d-%H%M%S).sql.gz
  docker run --rm --network data postgres:18.6-alpine pg_dump "$url" | gzip > "$out"
  [ "$(gunzip -c "$out" | wc -c)" -gt 0 ] || { L "El respaldo quedó vacío; no sigo" "The backup came out empty; stopping"; exit 1; }
  L "Respaldo: $out ($(du -h "$out" | cut -f1))" "Backup: $out ($(du -h "$out" | cut -f1))"
fi
L "Apagando contenedores" "Stopping containers"
# TAG de relleno: una app nunca desplegada no tiene TAG y compose se negaría a leer el archivo.
TAG=destroy docker compose --profile migrate down --remove-orphans
if [ -n "$dbname" ]; then
  docker exec -i postgres sh -c 'psql -v ON_ERROR_STOP=1 -q -U "$POSTGRES_USER" -d postgres' <<SQL
DROP DATABASE IF EXISTS "$dbname" WITH (FORCE);
DROP ROLE IF EXISTS "$role";
SQL
  L "PostgreSQL: base $dbname y usuario $role borrados" "PostgreSQL: database $dbname and user $role dropped"
fi
if grep -q '^REDIS_URL=' .env 2>/dev/null; then
  n=$(docker exec redis sh -c "redis-cli --no-auth-warning --scan --pattern '$name:*' | xargs -r redis-cli --no-auth-warning DEL | awk '{s += \$1} END {print s + 0}'")
  L "Redis: $n claves borradas (el usuario se quita al aplicar andamio)" "Redis: $n keys deleted (the user is removed when andamio is applied)"
fi
rm -f .env
REMOTE

  step "$(L "Quitar apps/$name de este repo" "Removing apps/$name from this repo")"
  git -C "$INFRA" rm -rq "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $(L destruir destroy) $name (andamio app destroy)"
  git -C "$INFRA" push -q

  step "$(L "Servidor: revocar llave, quitar del registro y de Redis (pide tu contraseña de sudo)" \
            "Server: revoke the key, remove it from the registry and from Redis (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply

  echo
  L "✓ $name destruida. Si ya no quieres su repo, archívalo (o bórralo, irreversible) en
  $(forge name): $OWNER/$name" "✓ $name destroyed. If you no longer want its repo, archive it (or delete it, irreversible) on
  $(forge name): $OWNER/$name"
  echo
}

[ "${1:-}" = app ] || usage
shift
case ${1:-} in
  create) shift; app_create "$@" ;;
  list) app_list ;;
  logs) shift; app_logs "$@" ;;
  rollback) shift; app_rollback "$@" ;;
  destroy) shift; app_destroy "$@" ;;
  secret) shift; app_secret "$@" ;;
  stop|start) app_state "$@" ;;
  domain) shift; app_list_edit domains "$@" ;;
  cors) shift; app_list_edit cors "$@" ;;
  *) usage ;;
esac
