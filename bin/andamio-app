#!/usr/bin/env bash
# Mini-PaaS de andamio: `bin/andamio app ...` llama a este script. Se usa desde tu máquina.
#
#   andamio app create <nombre> [--repo dueño/repo] [--public] [--db] [--mysql] [--redis] [--host <sub>|@] [--mem 256m]
#                      [--dir backend] [--path /api]   (varias apps en un repo; ver usage)
#   andamio app secret set|rm <nombre> <CLAVE>      andamio app secret list <nombre>
#   andamio app secret import <nombre> <.env|->     (varias de una vez)
#   andamio app list | info <nombre> | set <nombre> --mem 512m | logs <nombre> | rollback <nombre> | destroy <nombre>
#
# create: repo propio (--repo) o desde andamio_app_template, apps/<nombre>/app.yml, secretos y llave de
# deploy (apps.yml), commit + push de andamio y configuración del servidor.
# Idioma: ANDAMIO_LANG (o LANG) que empiece con "es" = español; si no, inglés.
set -euo pipefail

INFRA=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
LNG=en; [[ ${ANDAMIO_LANG:-${LANG:-}} == es* ]] && LNG=es
export ANDAMIO_LANG=$LNG    # bin/forge y ansible/hl lo heredan
L() { if [ "$LNG" = es ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
# La configuración de este servidor vive en un solo lugar: ansible/group_vars/all.yml.
cfg() { python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1]))[sys.argv[2]])' \
  "$INFRA/ansible/group_vars/all.yml" "$1"; }
OWNER=$(cfg andamio_github_owner)
DOMAIN=$(cfg andamio_domain)
# Este repo en GitHub (dueño/nombre), de andamio_repo: ahí vive el workflow app-build.yml.
INSTANCE_REPO=$(cfg andamio_repo | sed -E 's#^[^:]+:##; s#\.git$##')
# Con varios servidores, a cuál va este comando (lo decide la carpeta donde estás).
COPIES="${XDG_CONFIG_HOME:-$HOME/.config}/andamio/copias"
if [ -f "$COPIES" ] && [ "$(grep -c . "$COPIES")" -gt 1 ] && [ $# -ge 2 ]; then
  printf '\033[2m→ %s: %s · %s %s   (%s)\033[0m\n' "$(L Servidor Server)" "$DOMAIN" "$(L copia copy)" "$INFRA" \
    "$(L "otro: cd a su carpeta, o andamio use" "another: cd into its folder, or andamio use")" >&2
fi
# Plantilla para apps nuevas sin --repo (opcional: andamio_app_template en la config).
# El servidor: alias SSH = primer host de ansible/inventory.yml (~/.ssh/config lo resuelve).
SERVER=$(python3 -c 'import sys, yaml; print(next(iter(yaml.safe_load(open(sys.argv[1]))["all"]["children"]["servers"]["hosts"])))'   "$INFRA/ansible/inventory.yml")
TEMPLATE=$(python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1])).get("andamio_app_template") or "")' \
  "$INFRA/ansible/group_vars/all.yml")
PROJECTS=$HOME/projects
export PATH=$HOME/.local/bin:$PATH

die() { echo "✗ $*" >&2; exit 1; }
# La app no está en esta copia: decir a qué servidor apunta y qué apps tiene (¿otra carpeta?).
no_app() {
  local a apps=""
  for a in "$INFRA"/apps/*/app.yml; do [ -f "$a" ] && apps+="$(basename "$(dirname "$a")") "; done
  die "$(L "No existe la app $1 en esta copia ($INFRA, servidor $SERVER, $DOMAIN). Sus apps: ${apps:-ninguna}
  ¿Es de otro servidor? Corre el comando desde la carpeta de esa copia de andamio." \
           "No app $1 in this copy ($INFRA, server $SERVER, $DOMAIN). Its apps: ${apps:-none}
  Is it on another server? Run the command from that andamio copy's folder.")"
}
# Todo lo de GitHub (o la forja que sea) pasa por bin/forge.
forge() { "$INFRA/bin/forge" "$@"; }
# El repo de una app y, si comparte el repo con otras (dir: en app.yml), su workflow: sus
# corridas son solo las de ese archivo.
app_ci() {  # app_ci <app.yml> <nombre>  ->  "dueño/repo rama [andamio-<nombre>.yml]"
  python3 - "$1" "$2" "$OWNER" <<'PY'
import sys, yaml
f, name, owner = sys.argv[1:]
a = yaml.safe_load(open(f)) or {}
print(a.get("repo") or f"{owner}/{name}", a.get("branch") or "main", f"andamio-{name}.yml" if a.get("dir") else "")
PY
}
step() { printf '\n==> %s\n' "$*"; }
# Las etapas de una acción larga, para el panel (que las muestra como progreso y las esconde de la
# salida). En la terminal no se imprimen.
stage() { [ "${ANDAMIO_ASSUME:-}" = default ] && printf '::stage %s\n' "$1"; return 0; }
usage() {
  L "  andamio app create <nombre> [--repo dueño/repo] [--port 3000] [--health /ruta]
                             [--public] [--db] [--mysql] [--redis] [--host <sub>|@] [--mem 256m]
                             [--domain api.suempresa.com] [--cors https://miapp.vercel.app] [--volume /data]
                             [--env-file .env.produccion]   (variables para el primer deploy; - = stdin)
                             [--branch production]   (la rama que despliega; sin decirla, la principal del repo)
                             [--dir backend [--context .] [--watch packages/]] [--path /api]
                               (varias apps en un repo: su carpeta, desde dónde se construye, qué más
                                dispara su deploy y, opcional, una ruta bajo el host de otra app)
  andamio app source <nombre> [--dir backend] [--context .|-] [--watch-add packages/] [--watch-rm …]
                                             (de dónde sale una de varias apps de un repo)
  andamio app secret set <nombre> <CLAVE> [--later]   (el valor se pide oculto, o por un pipe;
                                             --later: guarda sin aplicar, para juntar varios)
  andamio app secret import <nombre> <.env|-> [--later]   (varias de una vez: CLAVE=valor por línea;
                                             - = stdin; agrega o reemplaza, un solo reinicio)
  andamio app secret rm <nombre> <CLAVE>
  andamio app secret list <nombre>           (solo los nombres)
  andamio app apply [<nombre>]               (aplica lo pendiente en el servidor: un reinicio)
  andamio app list
  andamio app info <nombre>                  (su configuración y cómo está ahora: estado, RAM, versión)
  andamio app set <nombre> [--mem 512m] [--cpus 1] [--port 8080] [--health /ruta] [--public|--vpn]
                                             (cambiarla sin editar app.yml: un reinicio, sin deploy)
  andamio app stop|start <nombre>            (apagarla sin borrar nada / volver)
  andamio app domain add|rm|list <nombre> [api.suempresa.com]   (dominio propio, además del tuyo)
  andamio app cors add|rm|list <nombre> [https://miapp.vercel.app]   (frontend en otro lado)
  andamio app volume add|rm|list <nombre> [/data]   (carpeta que persiste entre deploys, con backup)
  andamio app cron add <nombre> '<horario>' '<comando>' [--name limpiar]   (tarea programada, ej. '0 3 * * *')
  andamio app cron list|rm|run|runs <nombre> [<tarea>]   (verlas, quitar una, correrla ya, sus últimas corridas)
  andamio app cron edit <nombre> <tarea> [--schedule '<horario>'] [--command '<comando>']
  andamio app ci-update [<nombre>]           (el pipeline de tus apps, a la versión de andamio actual)
  andamio app retry <nombre>                 (reintenta su último deploy, si falló)
  andamio app logs <nombre> [--worker]
  andamio app restart <nombre>               (reinicia sus contenedores, misma versión)
  andamio app deploy <nombre>                (despliega de nuevo lo último de main que salió bien, sin push)
  andamio app rollback <nombre> [<commit>]   (volver a un deploy anterior; sin commit, al penúltimo)
  andamio app restore <nombre> [<respaldo>|latest]   (su base y carpetas, como en ese respaldo)
  andamio app revert <nombre> <commit>       (deshace un cambio de su configuración: RAM, dominios, tareas...)
  andamio app sql <nombre> ['SELECT ...']    (su base, de SOLO LECTURA: psql o una consulta)
  andamio app destroy <nombre>
" "  andamio app create <name> [--repo owner/repo] [--port 3000] [--health /path]
                           [--public] [--db] [--mysql] [--redis] [--host <sub>|@] [--mem 256m]
                           [--domain api.mycompany.com] [--cors https://myapp.vercel.app] [--volume /data]
                           [--env-file .env.production]   (variables for the first deploy; - = stdin)
                           [--branch production]   (the branch that deploys; by default the repo's main one)
                           [--dir backend [--context .] [--watch packages/]] [--path /api]
                             (several apps in one repo: its folder, where it's built from, what else
                              triggers its deploy and, optionally, a path under another app's host)
  andamio app source <name> [--dir backend] [--context .|-] [--watch-add packages/] [--watch-rm …]
                                             (where one of several apps in a repo comes from)
  andamio app secret set <name> <KEY> [--later]   (the value is asked hidden, or read from a pipe;
                                             --later: save without applying, to batch several)
  andamio app secret import <name> <.env|-> [--later]   (several at once: KEY=value per line;
                                             - = stdin; adds or replaces, a single restart)
  andamio app secret rm <name> <KEY>
  andamio app secret list <name>             (names only)
  andamio app apply [<name>]                 (applies what's pending on the server: one restart)
  andamio app list
  andamio app info <name>                    (its configuration and how it's doing now: status, RAM, version)
  andamio app set <name> [--mem 512m] [--cpus 1] [--port 8080] [--health /path] [--public|--vpn]
                                             (change it without editing app.yml: a restart, no deploy)
  andamio app stop|start <name>              (turn it off without deleting anything / back on)
  andamio app domain add|rm|list <name> [api.mycompany.com]   (your own domain, besides the server's)
  andamio app cors add|rm|list <name> [https://myapp.vercel.app]   (frontend hosted elsewhere)
  andamio app volume add|rm|list <name> [/data]   (folder that persists across deploys, backed up)
  andamio app cron add <name> '<schedule>' '<command>' [--name cleanup]   (scheduled task, e.g. '0 3 * * *')
  andamio app cron list|rm|run|runs <name> [<task>]   (see them, remove one, run it now, its last runs)
  andamio app cron edit <name> <task> [--schedule '<schedule>'] [--command '<command>']
  andamio app ci-update [<name>]             (your apps' pipeline, to the current andamio version)
  andamio app retry <name>                   (retries its last deploy, if it failed)
  andamio app logs <name> [--worker]
  andamio app restart <name>                 (restarts its containers, same version)
  andamio app deploy <name>                  (deploys main's latest successful build again, no push)
  andamio app rollback <name> [<commit>]     (back to an earlier deploy; no commit: the one before)
  andamio app restore <name> [<backup>|latest]   (its database and folders, as in that backup)
  andamio app revert <name> <commit>         (undoes a change to its configuration: RAM, domains, tasks...)
  andamio app sql <name> ['SELECT ...']      (its database, READ-ONLY: psql or one query)
  andamio app destroy <name>
"
  exit 1
}
# ask <pregunta> <s|n>: sí o no con flechas (el mismo menú que `andamio`); 0 = sí. Lee de la
# terminal aunque la entrada venga de un pipe. Ctrl+C corta el comando entero, no solo la pregunta.
ask() {
  local rc=0
  if (: < /dev/tty) 2> /dev/null; then
    "$INFRA/bin/andamio" _ask "$1" "$2" < /dev/tty || rc=$?
  else
    "$INFRA/bin/andamio" _ask "$1" "$2" || rc=$?
  fi
  [ "$rc" = 130 ] && exit 130
  return "$rc"
}
# confirm <pregunta> [VARIABLE]: sí o no (por defecto no). Con VARIABLE=1 en el entorno, el panel
# ya lo confirmó en la página: sigue sin preguntar (y lo dice).
confirm() {
  if [ -n "${2:-}" ] && [ "${!2:-}" = 1 ]; then
    echo "$1 $(L "sí (lo confirmaste en el panel)" "yes (you confirmed it in the panel)")"
    return 0
  fi
  ask "$1" n || die "$(L Cancelado Cancelled)"
}
# URL pública de un host: "@" es el dominio raíz.
app_url() { if [ "$1" = "@" ]; then echo "https://$DOMAIN"; else echo "https://$1.$DOMAIN"; fi; }
valid_name() {
  [[ $1 =~ ^[a-z][a-z0-9-]{1,28}[a-z0-9]$ ]] \
    || die "$(L "Nombre inválido: minúsculas, números y guiones (3-30)" "Invalid name: lowercase letters, digits and hyphens (3-30)")"
}
# Sube tu copia. Si GitHub tiene commits que tu copia no (un PR mergeado allá, Dependabot), los trae
# y pone los tuyos encima, y vuelve a subir. Si los dos cambiaron lo mismo, no adivina: deshace el
# intento y dice cómo resolverlo.
push_infra() {
  git -C "$INFRA" push -q 2> /dev/null && return 0
  echo "  $(L "GitHub tiene cambios que tu copia no: los traigo y pongo los tuyos encima" "GitHub has changes your copy doesn't: fetching them and putting yours on top")"
  if ! git -C "$INFRA" pull -q --rebase 2> /dev/null; then
    git -C "$INFRA" rebase --abort 2> /dev/null || true
    die "$(L "Tu copia y GitHub cambiaron lo mismo. Resuélvelo en $INFRA (git pull) y vuelve a correr el comando." \
             "Your copy and GitHub changed the same thing. Resolve it in $INFRA (git pull) and run the command again.")"
  fi
  push_infra
}

no_uncommitted() {
  git -C "$INFRA" diff --quiet && git -C "$INFRA" diff --cached --quiet \
    || die "$(L "Este repo tiene cambios sin commitear; súbelos o descártalos antes" "This repo has uncommitted changes; push or discard them first")"
}

app_create() {
  local name=${1:-}; shift || true
  [ -n "$name" ] || usage
  valid_name "$name"
  local access=vpn db=false redis=false mysql=false host=$name mem=256m repo="" port=3000 port_set="" health="" env_file=""
  local domains=() origins=() volumes=() watch=() appdir="" context="" path="" branch=""
  local missing; missing=$(L "falta el valor de" "missing value for")
  while [ $# -gt 0 ]; do
    case $1 in
      --public) access=public ;;
      --db) db=true ;;
      --mysql | --mariadb) mysql=true ;;   # MariaDB (compatible con MySQL): MYSQL_URL y DB_* de Laravel
      --redis) redis=true ;;
      --host) host=${2:?$missing --host}; shift ;;
      --mem) mem=${2:?$missing --mem}; shift ;;
      --repo) repo=${2:?$missing --repo}; shift ;;       # repo existente (cualquier lenguaje)
      --port) port=${2:?$missing --port}; port_set=$port; shift ;;
      --health) health=${2:?$missing --health}; shift ;;
      --domain) domains+=("$(valid_domain "${2:?$missing --domain}")"); shift ;;
      --cors) origins+=("$(valid_origin "${2:?$missing --cors}")"); shift ;;
      --volume) volumes+=("$(valid_volume "${2:?$missing --volume}")"); shift ;;
      --env-file) env_file=${2:?$missing --env-file}; shift ;;   # variables para el primer deploy (- = stdin)
      # Varias apps en un repo (front y back): la carpeta de esta, desde dónde se construye, qué
      # carpetas disparan su deploy y, opcional, una ruta bajo el dominio de otra (/api).
      --dir) appdir=$(valid_dir "${2:?$missing --dir}"); shift ;;
      --context) context=$(valid_dir "${2:?$missing --context}" root); shift ;;
      --watch) watch+=("$(valid_watch "${2:?$missing --watch}")"); shift ;;
      --path) path=${2:?$missing --path}; shift ;;
      --branch) branch=${2:?$missing --branch}; shift ;;   # la rama que despliega (sin decirla: la principal del repo)
      *) die "$(L "Opción desconocida" "Unknown option"): $1" ;;
    esac
    shift
  done
  [[ $host == "@" || $host =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] \
    || die "$(L "Host inválido: $host (subdominio o @ para el dominio raíz)" "Invalid host: $host (subdomain, or @ for the root domain)")"
  [[ $mem =~ ^[0-9]+[mg]$ ]] || die "$(L "Memoria inválida: $mem (ej. 256m, 1g)" "Invalid memory: $mem (e.g. 256m, 1g)")"
  [[ $port =~ ^[0-9]{2,5}$ ]] || die "$(L "Puerto inválido" "Invalid port"): $port"
  [[ -z $health || $health =~ ^/[A-Za-z0-9._/-]*$ ]] \
    || die "$(L "Ruta de salud inválida: $health (ej. /healthz)" "Invalid health path: $health (e.g. /healthz)")"
  # Las variables (--env-file): se leen una vez a una carpeta privada (se borra al salir) y se
  # revisan antes de tocar nada. Los valores nunca se muestran.
  local envtmp=""
  if [ -n "$env_file" ]; then
    envtmp=$(mktemp -d); chmod 700 "$envtmp"
    CLEANUP="${CLEANUP:-} $envtmp"
    # shellcheck disable=SC2064   # la lista se fija ahora, a propósito
    trap "rm -rf ${CLEANUP}" EXIT
    if [ "$env_file" = - ]; then cat > "$envtmp/in"; else
      [ -r "$env_file" ] || die "$(L "No puedo leer $env_file" "Can't read $env_file")"
      cat -- "$env_file" > "$envtmp/in"
    fi
    envfile_check "$envtmp/in"
  fi
  [[ -z $repo || $repo =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] \
    || die "$(L "Repo inválido: $repo (dueño/nombre)" "Invalid repo: $repo (owner/name)")"
  [[ -z $branch || ( $branch =~ ^[A-Za-z0-9._/-]{1,100}$ && $branch != *..* ) ]] \
    || die "$(L "Rama inválida: $branch" "Invalid branch: $branch")"
  [[ -z $path || $path =~ ^/[a-z0-9._-]+(/[a-z0-9._-]+)*$ ]] \
    || die "$(L "Ruta inválida: $path (ej. /api)" "Invalid path: $path (e.g. /api)")"
  if [ -z "$appdir" ] && { [ -n "$context" ] || [ ${#watch[@]} -gt 0 ]; }; then
    die "$(L "--context y --watch van con --dir (la carpeta de la app)" "--context and --watch go with --dir (the app's folder)")"
  fi
  [ -z "$appdir" ] || [ -n "$repo" ] || die "$(L "--dir va con --repo (el repo donde está esa carpeta)" "--dir goes with --repo (the repo that has that folder)")"

  local dir=$INFRA/apps/$name
  [ -e "$dir" ] && die "$(L "Ya existe" "Already exists"): $dir"
  host_free "$host" "$path"
  [ -z "$repo" ] && [ -e "$PROJECTS/$name" ] && die "$(L "Ya existe" "Already exists"): $PROJECTS/$name"
  [ -n "$repo" ] || [ -n "$TEMPLATE" ] \
    || die "$(L "Indica el repo de tu app con --repo dueño/nombre (o define andamio_app_template en la config)" \
               "Give your app's repo with --repo owner/name (or set andamio_app_template in the config)")"
  no_uncommitted
  forge auth-ok || die "$(L "Tu CLI de $(forge name) no tiene sesión iniciada" "Your $(forge name) CLI isn't logged in") ($(forge tools | cut -f2))"
  [ -z "$repo" ] || forge repo-exists "$repo" \
    || die "$(L "No existe $repo en $(forge name) (o no tienes acceso)" "$repo doesn't exist on $(forge name) (or you have no access)")"
  # GitHub no deja que un repo público use un workflow de un repo privado (este, que guarda
  # tu configuración): el deploy fallaría sin logs. Mejor avisar antes de tocar nada.
  if [ -n "$repo" ] && ! forge repo-private "$repo" && forge repo-private "$INSTANCE_REPO"; then
    die "$(L "$repo es público y el pipeline vive en $INSTANCE_REPO, que es privado: $(forge name) no deja que un repo público lo use.
  Haz privado el repo de tu app (gh repo edit $repo --visibility private) y vuelve a correr." \
             "$repo is public and the pipeline lives in $INSTANCE_REPO, which is private: $(forge name) doesn't let a public repo use it.
  Make your app's repo private (gh repo edit $repo --visibility private) and run again.")"
  fi

  # La contraseña de sudo al principio (el panel ya la pidió): así no te la pide a mitad de camino.
  [ "${ANDAMIO_ASSUME:-}" = default ] || "$INFRA/bin/andamio" _sudo

  # El repo de la app, clonado aparte: Dockerfile (si falta, se propone uno) y CI.
  local work=""
  if [ -n "$repo" ]; then
    work=$(mktemp -d)
    CLEANUP="${CLEANUP:-} $work"
    # shellcheck disable=SC2064   # la lista se fija ahora, a propósito
    trap "rm -rf ${CLEANUP}" EXIT
    stage review
    step "$(L "Revisando el repo $repo" "Checking the repo $repo")"
    # La rama que despliega: la principal del repo (main, production…), o --branch.
    [ -n "$branch" ] || branch=$(forge default-branch "$repo")
    git clone -q --depth 1 --branch "$branch" "$(forge clone-url "$repo")" "$work/repo" \
      || die "$(L "No pude clonar la rama $branch de $repo por SSH" "Couldn't clone branch $branch of $repo over SSH")"
    # Con --dir, la app es esa carpeta: ahí van el Dockerfile y la revisión.
    local src=$work/repo${appdir:+/$appdir}
    [ -d "$src" ] || die "$(L "$repo no tiene la carpeta $appdir" "$repo has no folder $appdir")"
    # Sin --dir, y la raíz no es una app pero el repo tiene varias: decir cuáles, en vez de adivinar.
    if [ -z "$appdir" ]; then
      local many; many=$("$INFRA/bin/andamio" _folders "$src")
      [ -z "$many" ] || die "$(L "$repo tiene varias apps y la raíz no es una. Elige cuál con --dir:" \
                                 "$repo has several apps and its root isn't one. Pick which with --dir:")
$many"
    fi
    "$INFRA/bin/andamio" _scaffold "$src" "$port_set" "$work/out"
    local p; p=$(sed -n 's/^port=//p' "$work/out")
    # Sin --port: el del Dockerfile generado, o el EXPOSE del que ya tenía.
    if [ -z "$port_set" ] && [ -z "$p" ] && [ -f "$src/Dockerfile" ]; then
      p=$(grep -m1 -oiE '^EXPOSE +[0-9]+' "$src/Dockerfile" | grep -oE '[0-9]+' || true)
    fi
    port=${p:-$port}
    # Lo que haría fallar el primer deploy o perder datos, antes de registrar nada.
    local pre=0
    "$INFRA/bin/andamio" _precheck "$src" "$port" "$([ ${#volumes[@]} -gt 0 ] && echo 1 || echo 0)" || pre=$?
    [ "$pre" -le 2 ] || exit "$pre"
    if [ "$pre" = 2 ]; then
      confirm "$(L "Hay algo grave arriba. ¿Seguir igual? (mejor corrígelo, haz push y vuelve a correr)" \
                   "There's something serious above. Go on anyway? (better fix it, push and run again)")" ANDAMIO_PRECHECK_OK
    fi
  fi

  echo "App:      $name"
  echo "Repo:     ${repo:-$OWNER/$name ($(L "nuevo, desde" "new, from") $TEMPLATE)}${branch:+  ($(L rama branch) $branch)}"
  echo "URL:      $(app_url "$host")$path  ($access)"
  [ -z "$appdir" ] || echo "$(L Carpeta Folder):  $appdir${context:+  ($(L "se construye desde" "built from") $context)}  ·  $(L "despliega si cambia" "deploys when it changes"): $appdir ${watch[*]:-}"
  echo "$(L Recursos Resources): PostgreSQL=$db MariaDB=$mysql Redis=$redis RAM=$mem  $(L puerto port)=$port${health:+  $(L salud health)=$health}"
  [ ${#volumes[@]} -eq 0 ] || echo "$(L "Carpetas persistentes" "Persistent folders"): ${volumes[*]}"
  confirm "$(L "¿Crear?" "Create?")" ANDAMIO_CREATE_OK

  if [ -z "$repo" ]; then
    step "$(L "Repo $OWNER/$name desde la plantilla" "Repo $OWNER/$name from the template")"
    forge repo-create "$OWNER/$name" "$TEMPLATE"
    git clone -q "$(forge clone-url "$OWNER/$name")" "$PROJECTS/$name"
  fi

  stage register
  step "apps/$name/app.yml"
  mkdir -p "$dir"
  local nets=""
  { $db || $redis || $mysql; } && nets="data"
  # La imagen de migraciones (Prisma, plantilla) necesita la base: sin --db no hay
  # migrate. Un repo existente declara sus migraciones a mano en app.yml si las tiene.
  local migrate=$db; [ -n "$repo" ] && migrate=false
  # La rama que despliega, solo si no es main (la de siempre).
  local deploy_branch=""; [ -n "$branch" ] && [ "$branch" != main ] && deploy_branch=$branch
  cat > "$dir/app.yml" <<EOF
# $(L "Creada con" "Created with"): andamio app create $name. $(L "compose.yaml se genera de aquí" "compose.yaml is generated from this") (ansible/apps.yml).
name: $name
${repo:+repo: $repo
}${deploy_branch:+branch: $deploy_branch
}host: "$host"
port: $port
${health:+health: $health
}${appdir:+dir: $appdir
}${context:+context: $context
}${path:+path: $path
}access: $access
networks: [${nets}]
migrate: $migrate
db: $db
mysql: $mysql
redis: $redis
resources:
  mem: $mem
  cpus: 0.5
  pids: 200
EOF
  [ ${#domains[@]} -gt 0 ] && yaml_list "$dir/app.yml" domains "${domains[@]}"
  [ ${#origins[@]} -gt 0 ] && yaml_list "$dir/app.yml" cors "${origins[@]}"
  [ ${#volumes[@]} -gt 0 ] && yaml_list "$dir/app.yml" volumes "${volumes[@]}"
  [ ${#watch[@]} -gt 0 ] && yaml_list "$dir/app.yml" watch "${watch[@]}"
  for d in "${domains[@]}"; do dns_check "$d"; done

  step "$(L "Secretos, llave de deploy y compose" "Secrets, deploy key and compose") (ansible/apps.yml)"
  (cd "$INFRA/ansible" && ansible-playbook apps.yml -e "andamio_only_app=$name" | grep -E 'msg|fatal|ok=')
  [ -f "$dir/deploy_key.pub" ] \
    || die "$(L "No se creó la llave de deploy (¿el repo existe y tienes permiso en $(forge name)?)" \
               "The deploy key wasn't created (does the repo exist, and do you have permission on $(forge name)?)")"

  if [ -n "$envtmp" ]; then
    step "$(L "Variables de entorno (--env-file), cifradas en apps/$name/secrets.sops.env" \
              "Environment variables (--env-file), encrypted in apps/$name/secrets.sops.env")"
    secrets_merge "apps/$name/secrets.sops.env" "$envtmp/in"
  fi

  step "$(L "Commit y push de este repo" "Commit and push this repo")"
  git -C "$INFRA" add "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $name (andamio app create)"
  push_infra

  stage server
  step "$(L "Servidor: .env, base, Redis y llave de deploy (pide tu contraseña de sudo)" \
            "Server: .env, database, Redis and deploy key (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply "$name" --registry   # el registro de apps y esta app; nada más

  # El CI de la app usa el pipeline de ESTE repo: si es privado, la forja exige permitirlo.
  [ "$(forge ci-allow-reuse "$INSTANCE_REPO")" = cambiado ] \
    && step "$(L "Permití que tus repos usen el pipeline de $INSTANCE_REPO" "Allowed your repos to use $INSTANCE_REPO's pipeline")"

  local vpn=""; [ "$access" = vpn ] && vpn="  ($(L "con la VPN" "over the VPN"))"
  if [ -n "$repo" ]; then
    stage pipeline
    BRANCH=${branch:-main} APPDIR=$appdir CONTEXT=$context WATCH="${watch[*]:-}" push_pipeline "$work/repo" "$repo" "$name"
    echo
    if [ -n "$appdir" ]; then
      L "  Desde ahora cada push a ${branch:-main} que toque $appdir ${watch[*]:-}despliega. Tu app:" \
        "  From now on every push to ${branch:-main} touching $appdir ${watch[*]:-}deploys. Your app:"
    else
      L "  Desde ahora cada push a ${branch:-main} despliega. Tu app:" "  From now on every push to ${branch:-main} deploys. Your app:"
    fi
    echo " $(app_url "$host")$path$vpn"
    return
  fi

  echo
  L "✓ $name lista. Primer deploy:" "✓ $name ready. First deploy:"
  cat <<EOF

    cd $PROJECTS/$name
    git commit --allow-empty -m "$(L "primer deploy" "first deploy")" && git push
    $INFRA/bin/forge ci-watch
  $(L Luego Then): $(app_url "$host")$vpn
EOF
}

# Sube al repo de la app lo que le falte para desplegarse: el Dockerfile generado y el
# pipeline (.github/workflows/andamio.yml), en un commit, por SSH (con tu llave: el token
# de gh no necesita permiso de workflows). Pregunta antes; el push dispara el primer deploy.
push_pipeline() {  # push_pipeline <clon> <dueño/repo> <app>
  local dir=$1 repo=$2 name=$3
  # Versión fija del pipeline: el último tag app-build-v*, o el último commit que lo cambió.
  local sha; sha=$(git -C "$INFRA" rev-list -n1 "$(git -C "$INFRA" describe --tags --abbrev=0 --match 'app-build-v*' 2> /dev/null)" 2> /dev/null \
    || git -C "$INFRA" log -1 --format=%H -- .github/workflows/app-build.yml)
  # Una de varias apps del repo (APPDIR): su propio archivo, andamio-<app>.yml.
  local wfile=andamio.yml snippet=(--branch "${BRANCH:-main}")
  if [ -n "${APPDIR:-}" ]; then
    wfile=andamio-$name.yml
    snippet+=(--app "$name" --dir "$APPDIR" ${CONTEXT:+--context "$CONTEXT"})
    local w; for w in ${WATCH:-}; do snippet+=(--watch "$w"); done
  fi
  if [ -n "${APPDIR:-}" ] && [ ! -f "$dir/.github/workflows/$wfile" ]; then
    mkdir -p "$dir/.github/workflows"
    forge ci-snippet "$INSTANCE_REPO" "$sha" "${snippet[@]}" > "$dir/.github/workflows/$wfile"
  elif [ -z "${APPDIR:-}" ] && ! grep -rqs "workflows/app-build.yml@" "$dir/.github/workflows"; then
    mkdir -p "$dir/.github/workflows"
    forge ci-snippet "$INSTANCE_REPO" "$sha" "${snippet[@]}" > "$dir/.github/workflows/andamio.yml"
  else
    # Ya trae pipeline, pero puede ser de otra copia de andamio (otro servidor, una prueba) o de
    # otra versión: se pone al día con esta, y así el push de abajo dispara el primer deploy.
    forge ci-repin "$dir" "$INSTANCE_REPO" "$sha" > /dev/null
  fi
  if [ ! -f "$dir/${APPDIR:+$APPDIR/}Dockerfile" ]; then
    echo
    L "! $repo no tiene Dockerfile: sin él no hay qué desplegar. Agrégalo y, junto con este
  archivo en .github/workflows/$wfile, haz push:" "! $repo has no Dockerfile: without it there's nothing to deploy. Add one and push it
  along with this file at .github/workflows/$wfile:"
    printf '\n%s\n' "$(cat "$dir/.github/workflows/$wfile")"
    return
  fi
  local changes; changes=$(git -C "$dir" status --porcelain --untracked-files=all | awk '{print "    " $2}')
  if [ -z "$changes" ]; then
    echo "✓ $(L "$repo ya tiene Dockerfile y pipeline: el próximo push despliega" "$repo already has a Dockerfile and the pipeline: the next push deploys")"
    return
  fi
  echo
  L "Para desplegarse, $repo necesita:" "To deploy, $repo needs:"; echo; echo "$changes"
  if ! ask "$(L "¿Los subo a $repo? (commit en ${BRANCH:-main} y push: arranca el primer deploy)" \
                "Push them to $repo? (commit on ${BRANCH:-main} and push: starts the first deploy)")" s; then
    local keep=$HOME/andamio-$name; rm -rf "$keep"; mkdir -p "$keep"
    (cd "$dir" && git status --porcelain --untracked-files=all | awk '{print $2}' | xargs -I{} cp --parents {} "$keep/")
    L "No subí nada. Los archivos quedaron en $keep: cópialos a tu repo y haz push." \
      "Nothing pushed. The files are in $keep: copy them into your repo and push."; echo
    return
  fi
  git -C "$dir" add -A
  git -C "$dir" commit -qm "$(L "andamio: Dockerfile y pipeline de deploy" "andamio: Dockerfile and deploy pipeline")"
  if ! git -C "$dir" push -q origin HEAD 2> "$dir/.push-err"; then
    # La rama exige PRs (o está protegida): los mismos archivos van en un PR. Al mergearlo, despliega.
    local prb="andamio/pipeline-$name" url
    git -C "$dir" push -q -f origin "HEAD:refs/heads/$prb" \
      || die "$(L "$repo rechazó el push a ${BRANCH:-main} y a una rama nueva: $(tail -1 "$dir/.push-err")" "$repo rejected the push to ${BRANCH:-main} and to a new branch: $(tail -1 "$dir/.push-err")")"
    url=$(L "Agrega lo que $name necesita para desplegarse con andamio (Dockerfile y/o pipeline). Al mergearlo arranca su primer deploy." \
            "Adds what $name needs to deploy with andamio (Dockerfile and/or pipeline). Merging it starts its first deploy." \
          | forge pr-create "$repo" "${BRANCH:-main}" "$prb" "andamio: $(L "deploy de" "deploy of") $name") \
      || die "$(L "Subí la rama $prb, pero no pude abrir el PR: ábrelo a mano hacia ${BRANCH:-main}" "Pushed branch $prb, but couldn't open the PR: open it by hand into ${BRANCH:-main}")"
    echo "✓ $(L "${BRANCH:-main} solo acepta PRs: abrí uno con esos archivos" "${BRANCH:-main} only takes PRs: opened one with those files")"
    echo "  $url"
    L "  Mergéalo y arranca el primer deploy (lo ves en el panel, en Deploys)." "  Merge it and the first deploy starts (see it in the panel, under Deploys)."; echo
    return 0
  fi
  echo "✓ $(L "Subido a $repo: primer deploy en curso" "Pushed to $repo: first deploy running")"
  # Desde el panel no se espera aquí (varios minutos con la ventana tomada): la app muestra su
  # primer deploy en vivo. En la terminal, se sigue como siempre.
  if [ "${ANDAMIO_ASSUME:-}" = default ]; then
    stage deploy
    echo "✓ $(L "Primer deploy en curso: lo ves en vivo en la app" "First deploy running: watch it live in the app")"
    return 0
  fi
  step "$(L "Primer deploy (tests, escaneo, build y deploy)" "First deploy (tests, scan, build and deploy)")"
  forge ci-watch "$repo" "$(git -C "$dir" rev-parse HEAD)" ${APPDIR:+--workflow "$wfile"} || { L "! El deploy falló (la causa, arriba). Arréglalo y haz push: cada push lo vuelve a intentar." "! The deploy failed (cause above). Fix it and push: every push tries again."; echo; }
}

# andamio app stop|start: el estado vive en app.yml (stopped: true), así sobrevive a
# `hl aplicar` y un push no la despliega mientras esté detenida.
app_state() {  # app_state <stop|start> <nombre>
  local want=$1 name=${2:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  no_uncommitted
  if [ "$want" = stop ]; then
    grep -qx 'stopped: true' "$f" && die "$(L "$name ya está detenida" "$name is already stopped")"
    echo "stopped: true" >> "$f"
  else
    grep -qx 'stopped: true' "$f" || die "$(L "$name no está detenida" "$name isn't stopped")"
    sed -i '/^stopped: true$/d' "$f"
  fi
  git -C "$INFRA" add "apps/$name/app.yml"
  git -C "$INFRA" commit -qm "feat(apps): $want $name (andamio app $want)"
  push_infra
  step "$(L "Servidor (pide tu contraseña de sudo)" "Server (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply "$name" --registry   # esta app y el registro (su "detenida")
  echo
  local host; host=$(awk '$1 == "host:" {gsub(/"/, "", $2); print $2}' "$f")
  if [ "$want" = stop ]; then
    L "⏸ $name detenida. Sus datos, base, secretos y dominio siguen ahí; un push no la despliega.
  Para volver: andamio app start $name" "⏸ $name stopped. Its data, database, secrets and domain are kept; a push won't deploy it.
  To bring it back: andamio app start $name"
  else
    L "▶ $name en marcha otra vez: $(app_url "$host")" "▶ $name running again: $(app_url "$host")"
  fi
  echo
}

# Dominios propios (domains:) y CORS (cors:) de una app: listas en su app.yml.
# Una carpeta del repo de la app (relativa, sin ..): --dir, --context, --watch. Con "root",
# también la raíz (".").
valid_dir() {
  local d=${1%/}
  [ "${2:-}" = root ] && [ "$d" = . ] && { echo .; return; }
  [[ $d =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ && $d != *..* && $d != . ]] \
    || die "$(L "Carpeta inválida: $1 (relativa al repo, ej. backend o apps/web)" "Invalid folder: $1 (relative to the repo, e.g. backend or apps/web)")"
  echo "$d"
}

# Una ruta que dispara el deploy (--watch): una carpeta (packages/), un archivo (package.json) o un
# patrón (config/*.yml). Relativa al repo, sin .. ni espacios.
valid_watch() {
  local w=${1#/}
  [[ $w =~ ^[A-Za-z0-9._*/-]+$ && $w != *..* && -n $w ]] \
    || die "$(L "Ruta inválida: $1 (ej. packages/, package.json o config/*.yml)" "Invalid path: $1 (e.g. packages/, package.json or config/*.yml)")"
  echo "$w"
}

# Un host (subdominio) es de una sola app, salvo que se repartan rutas: el front en / y el back
# en /api. Dos apps no pueden tener el mismo host y la misma ruta (o las dos sin ruta).
host_free() {  # host_free <host> [ruta]
  python3 - "$LNG" "$1" "${2:-}" "$INFRA"/apps/*/app.yml <<'PY' || exit 1
import sys, yaml
lng, host, path, files = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
L = lambda es, en: es if lng == "es" else en
for f in files:
    try:
        a = yaml.safe_load(open(f)) or {}
    except OSError:
        continue
    if str(a.get("host", "")) == host and str(a.get("path") or "") == path:
        who = a.get("name", f)
        sys.exit("✗ " + L(f"El host '{host}'{' con la ruta ' + path if path else ''} ya lo usa otra app ({who})",
                          f"Host '{host}'{' with path ' + path if path else ''} is already used by another app ({who})")
                 + ("" if path else L(" (otra app puede ir en una ruta del mismo host: --path /api)",
                                      " (another app can take a path on the same host: --path /api)")))
PY
}

valid_domain() {
  local d=${1,,}
  [[ $d =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$ ]] \
    || die "$(L "Dominio inválido: $1 (ej. api.suempresa.com)" "Invalid domain: $1 (e.g. api.mycompany.com)")"
  [ "$d" = "$DOMAIN" ] && die "$(L "$d es el dominio del servidor: usa --host @" "$d is the server's domain: use --host @")"
  local sub=${d%".$DOMAIN"}
  if [ "$sub" != "$d" ] && [[ $sub != *.* ]]; then
    die "$(L "$d es un subdominio directo de este servidor: usa --host $sub" "$d is a direct subdomain of this server: use --host $sub")"
  fi
  echo "$d"
}
valid_origin() {
  local o=${1,,}; o=${o%/}
  [ "$o" = "*" ] && die "$(L "\"*\" dejaría que cualquier sitio use tu API desde el navegador de tus usuarios: pon los orígenes exactos" \
                            "\"*\" would let any site use your API from your users' browsers: list the exact origins")"
  [[ $o =~ ^https?://[a-z0-9.-]+(:[0-9]{1,5})?$ ]] \
    || die "$(L "Origen inválido: $1 (ej. https://miapp.vercel.app, sin ruta)" "Invalid origin: $1 (e.g. https://myapp.vercel.app, no path)")"
  echo "$o"
}
# Una carpeta persistente: ruta absoluta dentro del contenedor, nunca una del sistema.
valid_volume() {
  local v=${1%/}
  [[ $v =~ ^(/[A-Za-z0-9._-]+)+$ && $v != *..* ]] \
    || die "$(L "Carpeta inválida: $1 (ruta absoluta dentro del contenedor, ej. /data o /app/uploads)" \
               "Invalid folder: $1 (absolute path inside the container, e.g. /data or /app/uploads)")"
  [[ $v =~ ^/(bin|boot|dev|etc|lib|lib64|proc|root|run|sbin|sys|usr|var/run)(/|$) ]] \
    && die "$(L "$v es una carpeta del sistema: usa una propia (ej. /data)" "$v is a system folder: use your own (e.g. /data)")"
  echo "$v"
}
# Avisa si el DNS del dominio no apunta a este servidor (Let's Encrypt fallaría).
dns_check() {
  local ip; ip=$(cfg andamio_server_ip)
  if python3 -c 'import socket,sys; sys.exit(sys.argv[2] not in {a[4][0] for a in socket.getaddrinfo(sys.argv[1], None, socket.AF_INET)})' "$1" "$ip" 2> /dev/null; then
    echo "✓ $1 → $ip"
  else
    L "! $1 todavía no apunta a $ip. Crea en su DNS un registro A: $1 → $ip
  Mientras no apunte, Let's Encrypt rechaza el certificado (y limita los intentos fallidos)." \
      "! $1 doesn't point to $ip yet. Create an A record in its DNS: $1 → $ip
  Until it does, Let's Encrypt rejects the certificate (and rate-limits failed attempts)."
    echo
    # Desde el panel: ya lo viste y marcaste "agregarlo igual" (ANDAMIO_DNS_OK=1).
    if [ "${ANDAMIO_DNS_OK:-}" = 1 ]; then
      L "  Agregado igual (lo confirmaste en el panel)." "  Added anyway (you confirmed it in the panel)."; echo
    else
      confirm "$(L "¿Agregarlo igual?" "Add it anyway?")"
    fi
  fi
}
# yaml_list <app.yml> <clave> [valores...]: reescribe esa lista (vacía = la quita).
yaml_list() {
  local f=$1 key=$2; shift 2
  python3 - "$f" "$key" "$@" <<'PY'
import re, sys
f, key, values = sys.argv[1], sys.argv[2], sys.argv[3:]
text = re.sub(rf"(?m)^{key}:.*\n", "", open(f).read())
if values:
    text = text.rstrip("\n") + f"\n{key}: [{', '.join(values)}]\n"
open(f, "w").write(text)
PY
}
yaml_get() {  # yaml_get <app.yml> <clave>: un valor por línea
  python3 -c 'import sys, yaml; print("\n".join(yaml.safe_load(open(sys.argv[1])).get(sys.argv[2]) or []))' "$1" "$2"
}
app_list_edit() {  # app_list_edit <domains|cors|volumes> <add|rm|list> <app> [valor]
  local key=$1 sub=${2:-} name=${3:-} value=${4:-}
  [ -n "$sub" ] && [ -n "$name" ] || usage
  valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  local current; current=$(yaml_get "$f" "$key")
  if [ "$sub" = list ]; then
    [ -n "$current" ] && sed 's/^/  /' <<< "$current" || L "  (ninguno)" "  (none)"; echo
    return
  fi
  [[ $sub == add || $sub == rm ]] && [ -n "$value" ] || usage
  case $key in
    domains) value=$(valid_domain "$value") ;;
    volumes) value=$(valid_volume "$value") ;;
    *) value=$(valid_origin "$value") ;;
  esac
  no_uncommitted
  local items=(); [ -n "$current" ] && mapfile -t items <<< "$current"
  if [ "$sub" = add ]; then
    printf '%s\n' "${items[@]}" | grep -qx "$value" && die "$(L "$name ya tiene $value" "$name already has $value")"
    items+=("$value")
    [ "$key" = domains ] && dns_check "$value"
  else
    printf '%s\n' "${items[@]}" | grep -qx "$value" || die "$(L "$name no tiene $value" "$name doesn't have $value")"
    mapfile -t items < <(printf '%s\n' "${items[@]}" | grep -vx "$value" || true)
  fi
  yaml_list "$f" "$key" "${items[@]}"
  step "$(L "Compose de $name (ansible/apps.yml)" "$name's compose (ansible/apps.yml)")"
  (cd "$INFRA/ansible" && ansible-playbook apps.yml -e "andamio_only_app=$name" | grep -E 'fatal|ok=')
  git -C "$INFRA" add "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $name $key $sub $value"
  push_infra
  step "$(L "Servidor (pide tu contraseña de sudo)" "Server (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply "$name"   # solo esta app
  echo
  if [ "$key" = domains ] && [ "$sub" = add ]; then
    L "✓ https://$value → $name (su certificado de Let's Encrypt se pide en el primer acceso)" \
      "✓ https://$value → $name (its Let's Encrypt certificate is requested on first access)"
  elif [ "$key" = volumes ] && [ "$sub" = add ]; then
    L "✓ $value de $name persiste entre deploys y entra en el backup diario" \
      "✓ $name's $value persists across deploys and is in the daily backup"
  elif [ "$key" = volumes ]; then
    L "✓ $name ya no monta $value. Sus archivos siguen en el servidor (los borra app destroy)" \
      "✓ $name no longer mounts $value. Its files stay on the server (app destroy removes them)"
  else
    L "✓ $name: $key $sub $value" "✓ $name: $key $sub $value"
  fi
  echo
}

# Un archivo KEY=VALUE (como un .env) para --env-file: nombres válidos, ninguno de los que pone
# andamio. Si algo está mal dice la línea, nunca el valor.
envfile_check() {
  python3 - "$1" "$RESERVED" "$LNG" <<'PY' || exit 1
import re, sys
path, reserved, lng = sys.argv[1], sys.argv[2].split(), sys.argv[3]
L = lambda es, en: es if lng == "es" else en
for n, line in enumerate(open(path, encoding="utf-8", errors="replace").read().splitlines(), 1):
    s = line.strip()
    if not s or s.startswith("#"):
        continue
    s = s.removeprefix("export ").strip()
    key = s.split("=", 1)[0].strip()
    if "=" not in s or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
        sys.exit("✗ " + L(f"Línea {n}: va CLAVE=valor (MAYÚSCULAS, números y _)", f"Line {n}: it goes KEY=value (UPPERCASE, digits and _)"))
    if key in reserved:
        sys.exit("✗ " + L(f"Línea {n}: {key} lo pone andamio", f"Line {n}: andamio sets {key}"))
PY
}

# secrets_merge <apps/x/secrets.sops.env> <archivo KEY=VALUE>: agrega o reemplaza esas variables,
# cifradas. Descifra en una carpeta privada que se borra; los valores nunca se muestran.
secrets_merge() {
  local rel=$1 src=$2 tmp added; tmp=$(mktemp -d); chmod 700 "$tmp"
  (cd "$INFRA" && sops decrypt --input-type dotenv --output-type dotenv "$rel") > "$tmp/actual"
  added=$(python3 - "$tmp/actual" "$src" "$tmp/nuevo" <<'PY'
import sys
cur, new, out = sys.argv[1:]
given = {}
for line in open(new, encoding="utf-8", errors="replace").read().splitlines():
    s = line.strip()
    if s and not s.startswith("#"):
        k, v = s.removeprefix("export ").strip().split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
            v = v[1:-1]   # KEY="valor" como en un .env
        given[k.strip()] = v
print(" ".join(given))   # solo los nombres
lines = []
for line in open(cur).read().splitlines():
    k = line.split("=", 1)[0]
    lines.append(f"{k}={given.pop(k)}" if k in given else line)
lines += [f"{k}={v}" for k, v in given.items()]
open(out, "w").write("\n".join(lines) + "\n")
PY
)
  (cd "$INFRA" && sops encrypt --input-type dotenv --output-type dotenv --filename-override "$rel" "$tmp/nuevo") > "$tmp/cifrado"
  mv "$tmp/cifrado" "$INFRA/$rel"
  echo "✓ $(L "Agregadas" "Added"): $added"
  shred -u "$tmp"/* 2> /dev/null; rm -rf "$tmp"
}

# Secretos de ejecución de una app (apps/<app>/secrets.sops.env -> .env en el servidor).
# El valor nunca va en la línea de comandos: se escribe oculto o llega por un pipe.
RESERVED="DOMAIN DATABASE_URL MYSQL_URL REDIS_URL TAG"   # los pone andamio
app_secret() {
  local sub=${1:-} name=${2:-} key=${3:-} later=false
  [ "${4:-}" = --later ] && later=true
  [ -n "$sub" ] && [ -n "$name" ] || usage
  valid_name "$name"
  local rel=apps/$name/secrets.sops.env
  [ -f "$INFRA/apps/$name/app.yml" ] || no_app "$name"
  [ -f "$INFRA/$rel" ] || die "$(L "Falta $rel (se crea con andamio app create)" "$rel is missing (andamio app create creates it)")"
  if [ "$sub" = list ]; then
    (cd "$INFRA" && sops decrypt --input-type dotenv --output-type dotenv "$rel") | grep -oE '^[A-Za-z_][A-Za-z0-9_]*' \
      | while read -r k; do
          if [[ " $RESERVED " == *" $k "* ]]; then echo "  $k  ($(L "lo pone andamio" "set by andamio"))"; else echo "  $k"; fi
        done
    return
  fi
  if [ "$sub" = import ]; then
    secret_import "$name" "$rel" "$key" "$later"
    return
  fi
  [[ $sub == set || $sub == rm ]] || usage
  [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] \
    || die "$(L "Nombre inválido: MAYÚSCULAS, números y _ (ej. ANTHROPIC_API_KEY)" "Invalid name: UPPERCASE, digits and _ (e.g. ANTHROPIC_API_KEY)")"
  [[ " $RESERVED " == *" $key "* ]] \
    && die "$(L "$key lo pone andamio: no se cambia a mano" "andamio sets $key: it isn't changed by hand")"
  no_uncommitted

  local value=""
  if [ "$sub" = set ]; then
    if [ -t 0 ]; then
      read -rsp "$(L "Valor de $key para $name (no se ve al escribir): " "Value of $key for $name (hidden while typing): ")" value; echo
    else
      value=$(cat)   # por pipe: cat clave.txt | andamio app secret set ...
    fi
    [ -n "$value" ] || die "$(L "El valor está vacío" "The value is empty")"
    [[ $value != *$'\n'* ]] || die "$(L "El valor tiene que ser una sola línea" "The value must be a single line")"
  fi

  local tmp; tmp=$(mktemp -d); chmod 700 "$tmp"
  # shellcheck disable=SC2064   # el temporal se fija ahora, a propósito
  trap "shred -u '$tmp'/* 2> /dev/null; rm -rf '$tmp'" EXIT
  (cd "$INFRA" && sops decrypt --input-type dotenv --output-type dotenv "$rel") > "$tmp/actual"
  if [ "$sub" = rm ] && ! grep -q "^$key=" "$tmp/actual"; then
    die "$(L "$name no tiene $key" "$name doesn't have $key")"
  fi
  local verb; verb=$(L "actualizado" "updated"); grep -q "^$key=" "$tmp/actual" || verb=$(L "agregado" "added")
  [ "$sub" = rm ] && verb=$(L "quitado" "removed")
  # El valor llega a awk por el entorno (V), nunca como argumento.
  K=$key V=$value MODE=$sub awk '
    BEGIN { k = ENVIRON["K"] "=" }
    index($0, k) == 1 { if (ENVIRON["MODE"] == "set" && !done) { print k ENVIRON["V"]; done = 1 }; next }
    { print }
    END { if (ENVIRON["MODE"] == "set" && !done) print k ENVIRON["V"] }' "$tmp/actual" > "$tmp/nuevo"
  unset value
  (cd "$INFRA" && sops encrypt --input-type dotenv --output-type dotenv --filename-override "$rel" "$tmp/nuevo") > "$tmp/cifrado"
  mv "$tmp/cifrado" "$INFRA/$rel"
  echo "✓ $key $verb ($rel, $(L cifrado encrypted))"

  step "$(L "Commit y push (solo el nombre, nunca el valor)" "Commit and push (only the name, never the value)")"
  git -C "$INFRA" add "$rel"
  git -C "$INFRA" commit -qm "secret($name): $sub $key"
  push_infra

  if [ "$later" = true ]; then
    L "  Guardado, sin aplicar. Cuando termines con los cambios: andamio app apply $name" \
      "  Saved, not applied. When you're done with your changes: andamio app apply $name"; echo
    return 0
  fi
  app_apply "$name"
}

# Varias variables de una vez (un .env, o por stdin: el panel). Se revisan todas antes de tocar
# nada (nombres, ninguna de las que pone andamio), se cifran juntas: un commit y un reinicio.
# Los valores nunca se muestran ni van al commit: solo los nombres.
secret_import() {
  local name=$1 rel=$2 src=${3:-} later=$4
  [ -n "$src" ] || usage
  no_uncommitted
  local tmp; tmp=$(mktemp -d); chmod 700 "$tmp"
  # shellcheck disable=SC2064   # el temporal se fija ahora, a propósito
  trap "shred -u '$tmp'/* 2> /dev/null; rm -rf '$tmp'" EXIT
  if [ "$src" = - ]; then cat > "$tmp/in"; else
    [ -r "$src" ] || die "$(L "No puedo leer $src" "Can't read $src")"
    cat -- "$src" > "$tmp/in"
  fi
  envfile_check "$tmp/in"
  grep -qE '^[[:space:]]*(export[[:space:]]+)?[A-Z][A-Z0-9_]*[[:space:]]*=' "$tmp/in" \
    || die "$(L "No hay variables: va una CLAVE=valor por línea" "No variables: one KEY=value per line")"
  local out names
  out=$(secrets_merge "$rel" "$tmp/in")
  echo "$out ($rel, $(L cifradas encrypted))"
  names=${out#*: }

  step "$(L "Commit y push (solo los nombres, nunca los valores)" "Commit and push (only the names, never the values)")"
  git -C "$INFRA" add "$rel"
  git -C "$INFRA" commit -qm "secret($name): import $names"
  push_infra

  if [ "$later" = true ]; then
    L "  Guardadas, sin aplicar. Cuando termines con los cambios: andamio app apply $name" \
      "  Saved, not applied. When you're done with your changes: andamio app apply $name"; echo
    return 0
  fi
  app_apply "$name"
}

# Aplica en el servidor lo pendiente (secretos, dominios, CORS...): una contraseña, un reinicio.
# Con <app>: si su último deploy falló (típico: le faltaba una variable), ofrece reintentarlo.
app_apply() {
  local name=${1:-} repo run
  if [ -n "$name" ]; then
    valid_name "$name"
    [ -f "$INFRA/apps/$name/app.yml" ] || no_app "$name"
    # Cambios a mano en su app.yml: regenerar su compose y guardarlos antes de aplicar.
    if [ -n "$(git -C "$INFRA" status --porcelain -- "apps/$name")" ]; then
      step "$(L "Compose de $name (cambiaste su app.yml)" "$name's compose (you changed its app.yml)")"
      (cd "$INFRA/ansible" && ansible-playbook apps.yml -e "andamio_only_app=$name" | grep -E 'fatal|ok=')
      git -C "$INFRA" add "apps/$name"
      git -C "$INFRA" commit -qm "feat(apps): $name: cambios en app.yml"
    fi
  fi
  no_uncommitted
  # El servidor baja la configuración del repo: lo que esté sin subir, se sube antes.
  [ -z "$(git -C "$INFRA" log --oneline '@{u}..' 2> /dev/null)" ] || push_infra
  step "$(L "Servidor: aplicar los cambios${name:+ de $name} (pide tu contraseña de sudo)" \
            "Server: apply the changes${name:+ to $name} (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply ${name:+"$name"}   # con app: solo esa (segundos)

  [ -n "$name" ] || return 0
  if [ "${2:-}" = cron ]; then   # una tarea no toca la app: ni reinicio ni deploy
    L "✓ Tareas de $name al día en el servidor." "✓ $name's tasks up to date on the server."; echo
    return 0
  fi
  # Una variable no cambia la imagen: no hace falta un deploy, basta el reinicio que ya hizo.
  local host url
  host=$(awk '$1 == "host:" {gsub(/"/, "", $2); print $2}' "$INFRA/apps/$name/app.yml")
  if [ "$host" = "@" ]; then url="https://$DOMAIN"; else url="https://${host:-$name}.$DOMAIN"; fi
  if grep -qx 'stopped: true' "$INFRA/apps/$name/app.yml"; then
    L "✓ Guardado. $name está detenida: lo tomará al volver (andamio app start $name)." \
      "✓ Saved. $name is stopped: it'll pick it up when it's back (andamio app start $name)."; echo
  else
    L "✓ $name ya corre con los cambios (reiniciada, sin deploy: la imagen es la misma): $url" \
      "✓ $name now runs with the changes (restarted, no deploy needed: same image): $url"; echo
  fi
  repo=$(python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1])).get("repo") or "")' "$INFRA/apps/$name/app.yml")
  [ -n "$repo" ] || return 0
  run=$(forge ci-last-failed "$repo" 2> /dev/null || true)
  [ -n "$run" ] || return 0
  ask "$(L "El último deploy de $name falló. ¿Lo reintento ahora, con los cambios?" \
           "$name's last deploy failed. Retry it now, with the changes?")" s || return 0
  step "$(L "Reintentando el deploy" "Retrying the deploy")"
  forge ci-rerun "$repo" "$run" || { L "! Volvió a fallar (la causa, arriba)." "! It failed again (cause above)."; echo; }
}

# El pipeline de cada app está fijado a una versión (SHA) de app-build.yml de esta copia: así
# un cambio aquí no rompe apps sin aviso. Esto lo pone al día en el repo de cada app.
app_ci_update() {
  local name=${1:-} names=() n repo sha change tmp skip=" [skip ci]"
  if [ -n "$name" ]; then
    valid_name "$name"
    [ -f "$INFRA/apps/$name/app.yml" ] || no_app "$name"
    names=("$name")
  else
    for n in "$INFRA"/apps/*/app.yml; do [ -f "$n" ] && names+=("$(basename "$(dirname "$n")")"); done
  fi
  [ ${#names[@]} -gt 0 ] || die "$(L "No hay apps" "No apps")"
  # La versión que ya está en GitHub (la que el pipeline de las apps puede usar).
  git -C "$INFRA" fetch -q origin main
  sha=$(git -C "$INFRA" rev-parse origin/main)
  L "Pipeline: $INSTANCE_REPO @ ${sha:0:8}" "Pipeline: $INSTANCE_REPO @ ${sha:0:8}"; echo
  ask "$(L "¿Desplegar cada app ahora con el pipeline nuevo? Si no, lo usa en su próximo push" \
           "Deploy each app now with the new pipeline? Otherwise it's used on its next push")" n && skip=""
  for n in "${names[@]}"; do
    local br wf; read -r repo br wf <<< "$(app_ci "$INFRA/apps/$n/app.yml" "$n")"
    tmp=$(mktemp -d)
    if ! git clone -q --depth 1 --branch "$br" "$(forge clone-url "$repo")" "$tmp/r" 2> /dev/null; then
      L "  ! $n: no pude clonar $repo ($br)" "  ! $n: couldn't clone $repo ($br)"; echo; rm -rf "$tmp"; continue
    fi
    change=$(forge ci-repin "$tmp/r" "$INSTANCE_REPO" "$sha")
    if [ -z "$change" ]; then
      L "  ✓ $n: ya está al día" "  ✓ $n: already up to date"; echo
    else
      git -C "$tmp/r" add -A .github/workflows
      git -C "$tmp/r" commit -qm "andamio: pipeline ${change%% *} -> ${sha:0:8}$skip"
      if git -C "$tmp/r" push -q 2> /dev/null; then
        L "  ✓ $n: ${change:0:8} → ${sha:0:8}${skip:+ (sin desplegar)}" "  ✓ $n: ${change:0:8} → ${sha:0:8}${skip:+ (not deployed)}"; echo
      else
        # La rama solo acepta PRs: el cambio va en uno (al mergearlo, rige y despliega).
        local prb="andamio/pipeline-${sha:0:8}" url
        if git -C "$tmp/r" push -q -f origin "HEAD:refs/heads/$prb" 2> /dev/null &&
           url=$(L "Pone el pipeline de andamio al día (${change:0:8} → ${sha:0:8})." "Updates the andamio pipeline (${change:0:8} → ${sha:0:8})." \
                 | forge pr-create "$repo" "$br" "$prb" "andamio: pipeline ${sha:0:8}"); then
          L "  ✓ $n: $br solo acepta PRs, abrí uno: $url" "  ✓ $n: $br only takes PRs, opened one: $url"; echo
        else
          L "  ! $n: $repo rechazó el push y no pude abrir el PR" "  ! $n: $repo rejected the push and I couldn't open the PR"; echo
        fi
      fi
    fi
    rm -rf "$tmp"
  done
}

# andamio app retry: el último deploy falló (típico: faltaba una variable que ya pusiste) y
# quieres volver a intentarlo sin hacer otro push. Lo sigue en vivo.
app_retry() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  local repo run
  local wf br; read -r repo br wf <<< "$(app_ci "$f" "$name")"
  run=$(forge ci-last-failed "$repo" --branch "$br" ${wf:+--workflow "$wf"} 2> /dev/null || true)
  [ -n "$run" ] || die "$(L "El último deploy de $name no falló: nada que reintentar (para desplegar, haz push)" \
                             "$name's last deploy didn't fail: nothing to retry (to deploy, push)")"
  step "$(L "Reintentando el último deploy de $name" "Retrying $name's last deploy")"
  forge ci-rerun "$repo" "$run" || die "$(L "Volvió a fallar (la causa, arriba)." "It failed again (cause above).")"
  echo "✓ $(L "$name desplegada" "$name deployed")"
}

app_list() {
  printf '%-22s %-40s %-7s %s\n' APP URL "$(L ACCESO ACCESS)" "$(L ESTADO STATUS)"
  local status; status=$(ssh -n "$SERVER" "docker ps --format '{{.Names}} {{.Status}}'")
  for f in "$INFRA"/apps/*/app.yml; do
    local name host access st
    name=$(basename "$(dirname "$f")")
    host=$(awk '$1 == "host:" {gsub(/"/, "", $2); print $2}' "$f"); access=$(awk '$1 == "access:" {print $2}' "$f")
    st=$(grep -E "^$name-app-[0-9]+ " <<< "$status" | cut -d' ' -f2- || true)
    grep -qx 'stopped: true' "$f" && st="⏸ $(L detenida stopped)"
    printf '%-22s %-40s %-7s %s\n' "$name" "$(app_url "$host")" "${access:-vpn}" "${st:-$(L "sin desplegar" "not deployed")}"
  done
}

# andamio app info: lo que dice su app.yml y cómo está ahora en el servidor, en una pantalla.
app_info() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  # Del servidor, solo estado y consumo: nunca el entorno del contenedor (tiene los secretos).
  local live; live=$(ssh "$SERVER" bash -s -- "$name" <<'REMOTE' 2> /dev/null || true
c=$(docker ps -aq --filter label=com.docker.compose.project=$1 --filter label=com.docker.compose.service=app --filter label=com.docker.compose.oneoff=False | head -n 1)
[ -n "$c" ] || exit 0
docker inspect --format 'state={{.State.Status}}
started={{.State.StartedAt}}
restarts={{.RestartCount}}
health={{if .State.Health}}{{.State.Health.Status}}{{end}}
image={{.Config.Image}}' "$c"
[ "$(docker inspect --format '{{.State.Running}}' "$c")" = true ] \
  && docker stats --no-stream --format 'mem={{.MemUsage}}
cpu={{.CPUPerc}}' "$c"
REMOTE
)
  local secrets=""
  secrets=$(cd "$INFRA" && sops decrypt --input-type dotenv --output-type dotenv "apps/$name/secrets.sops.env" 2> /dev/null \
    | grep -oE '^[A-Za-z_][A-Za-z0-9_]*' | grep -vxE "${RESERVED// /|}" | paste -sd' ' || true)
  LIVE=$live SECRETS=$secrets python3 - "$f" "$DOMAIN" "$LNG" <<'PY'
import os, re, sys, yaml
from datetime import datetime, timezone
f, domain, lng = sys.argv[1:]
L = lambda es, en: es if lng == "es" else en
a = yaml.safe_load(open(f))
live = dict(l.split("=", 1) for l in os.environ["LIVE"].splitlines() if "=" in l)
if live.get("mem"):   # "4.832MiB / 256MiB" → "5 MiB"
    n, unit = re.match(r"([\d.]+)\s*([A-Za-z]+)", live["mem"]).groups()
    live["mem"] = f"{float(n):.0f} {unit}"
dim = lambda t: f"\033[2m{t}\033[0m"
host = str(a.get("host", a["name"]))
url = f"https://{domain}" if host == "@" else f"https://{host}.{domain}"

def ago(ts):
    try:
        s = (datetime.now(timezone.utc) - datetime.fromisoformat(ts[:19] + "+00:00")).total_seconds()
    except ValueError:
        return ""
    for n, es, en in ((86400, "d", "d"), (3600, "h", "h"), (60, "min", "min")):
        if s >= n:
            return L(f"hace {int(s // n)} {es}", f"{int(s // n)} {en} ago")
    return L("hace segundos", "seconds ago")

if a.get("stopped"):
    status = "⏸ " + L("detenida", "stopped")
elif not live:
    status = dim(L("sin desplegar (o el servidor no respondió)", "not deployed (or the server didn't answer)"))
elif live.get("state") == "running":
    h = live.get("health")
    mark = "\033[33m●\033[0m" if h in ("starting", "unhealthy") else "\033[32m●\033[0m"
    status = f"{mark} {L('corriendo', 'running')}" + (f" ({h})" if h and h != "healthy" else "") + f", {L('arrancó', 'started')} {ago(live.get('started', ''))}"
else:
    status = f"\033[31m●\033[0m {live.get('state')}"
if live.get("restarts", "0") not in ("", "0"):
    status += f" · {live['restarts']} " + L("reinicios", "restarts")
version = live.get("image", "").rpartition(":")[2][:7]
print(f"\n  \033[1m{a['name']}\033[0m  {status}" + (f"  {dim('v ' + version)}" if version else ""))

r = a.get("resources", {})
rows = [
    ("URL", f"{url}  ({L('pública', 'public') if a.get('access') == 'public' else L('solo VPN', 'VPN only')})"),
    (L("Dominios", "Domains"), ", ".join(a.get("domains") or [])),
    ("Repo", a.get("repo") or ""),
    (L("Puerto", "Port"), f"{a.get('port')}" + (f"   {L('salud', 'health')} {a['health']}" if a.get("health") else "")),
    ("RAM", f"{r.get('mem')}" + (f"   {dim(L('usa', 'using') + ' ' + live['mem'])}" if live.get("mem") else "")),
    ("CPU", f"{r.get('cpus')}" + (f"   {dim(L('usa', 'using') + ' ' + live['cpu'])}" if live.get("cpu") else "")),
    (L("Datos", "Data"), ", ".join(n for n, on in (("PostgreSQL", a.get("db")), ("MariaDB", a.get("mysql")), ("Redis", a.get("redis"))) if on)),
    (L("Base", "Database"), " · ".join(x for x in (
        L(f"hasta {a['db_connections']} conexiones", f"up to {a['db_connections']} connections") if a.get("db_connections") else "",
        L(f"consultas de hasta {a['db_timeout']}", f"queries up to {a['db_timeout']}") if str(a.get("db_timeout") or "0") != "0" else "") if x)),
    (L("Carpetas", "Folders"), ", ".join(a.get("volumes") or [])),
    ("CORS", ", ".join(a.get("cors") or [])),
    ("Worker", (f"{a['worker'].get('command', '')}  ({a['worker'].get('mem', '256m')})" if a.get("worker") else "")),
    (L("Secretos", "Secrets"), os.environ["SECRETS"]),
    (L("Tareas", "Tasks"), ", ".join(f"{c['name']} ({c['schedule']})" for c in a.get("cron") or [])),
]
for k, v in rows:
    if v:
        print(f"  {k:<9} {v}")
print("\n  " + dim(L(f"Cambiar: andamio app set {a['name']} --mem 512m | --cpus 1 | --port 8080 | --health /ruta | --public | --vpn"
                    + (" | --db-connections 20 | --db-timeout 30s" if a.get("db") or a.get("mysql") else ""),
                    f"Change: andamio app set {a['name']} --mem 512m | --cpus 1 | --port 8080 | --health /path | --public | --vpn"
                    + (" | --db-connections 20 | --db-timeout 30s" if a.get("db") or a.get("mysql") else ""))))
PY
}

# andamio app set: cambiar RAM, CPU, puerto, ruta de salud o acceso sin editar app.yml.
# Es un reinicio con la misma imagen (como un secreto), no un deploy.
app_set() {
  local name=${1:-}; shift || true
  [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  local missing; missing=$(L "falta el valor de" "missing value for")
  local changes=()   # clave=valor (resources.mem=512m)
  while [ $# -gt 0 ]; do
    case $1 in
      --mem) [[ ${2:-} =~ ^[0-9]+[mg]$ ]] || die "$(L "Memoria inválida: ${2:-} (ej. 256m, 1g)" "Invalid memory: ${2:-} (e.g. 256m, 1g)")"
             changes+=("resources.mem=$2"); shift ;;
      --cpus) [[ ${2:-} =~ ^[0-9]+(\.[0-9]+)?$ ]] && [[ ! ${2:-} =~ ^0+(\.0+)?$ ]] \
                || die "$(L "CPU inválida: ${2:-} (ej. 0.5, 1, 2)" "Invalid CPU: ${2:-} (e.g. 0.5, 1, 2)")"
              changes+=("resources.cpus=$2"); shift ;;
      --port) [[ ${2:-} =~ ^[0-9]{2,5}$ ]] && [ "$2" -le 65535 ] || die "$(L "Puerto inválido" "Invalid port"): ${2:-}"
              changes+=("port=$2"); shift ;;
      --health) [[ ${2:-} =~ ^/[A-Za-z0-9._/-]*$ ]] \
                  || die "$(L "Ruta de salud inválida: ${2:-} (ej. /healthz)" "Invalid health path: ${2:-} (e.g. /healthz)")"
                changes+=("health=$2"); shift ;;
      --public) changes+=("access=public") ;;
      --vpn) changes+=("access=vpn") ;;
      # Límites de su base (PostgreSQL compartido): conexiones y duración de una consulta. 0 = sin límite.
      --db-connections)
        [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && [ "$2" -le 500 ] \
          || die "$(L "Conexiones inválidas: ${2:-} (un número, ej. 20; 0 = sin límite)" "Invalid connections: ${2:-} (a number, e.g. 20; 0 = no limit)")"
        grep -qxE '(db|mysql): true' "$f" || die "$(L "$name no tiene base (db: true o mysql: true)" "$name has no database (db: true or mysql: true)")"
        changes+=("db_connections=$((10#$2))"); shift ;;
      --db-timeout)
        [[ ${2:-} =~ ^(0|[1-9][0-9]{0,4}(ms|s|min))$ ]] \
          || die "$(L "Tiempo inválido: ${2:-} (ej. 30s, 2min, 500ms; 0 = sin límite)" "Invalid time: ${2:-} (e.g. 30s, 2min, 500ms; 0 = no limit)")"
        grep -qxE '(db|mysql): true' "$f" || die "$(L "$name no tiene base (db: true o mysql: true)" "$name has no database (db: true or mysql: true)")"
        changes+=("db_timeout=$2"); shift ;;
      *) die "$(L "Opción desconocida" "Unknown option"): $1" ;;
    esac
    shift
  done
  [ ${#changes[@]} -gt 0 ] || die "$(L "Nada que cambiar. Opciones: --mem 512m, --cpus 1, --port 8080, --health /ruta, --public, --vpn, --db-connections 20, --db-timeout 30s" \
                                       "Nothing to change. Options: --mem 512m, --cpus 1, --port 8080, --health /path, --public, --vpn, --db-connections 20, --db-timeout 30s")"
  no_uncommitted

  # Edita solo esas líneas: los comentarios y el orden de app.yml se quedan como estaban.
  local summary
  summary=$("$INFRA/bin/andamio" _yaml_set "$f" "${changes[@]}")
  if [ -z "$summary" ]; then
    echo "✓ $(L "$name ya tiene esos valores: nada que cambiar" "$name already has those values: nothing to change")"
    return 0
  fi
  echo; sed 's/^/  /' <<< "$summary"; echo
  grep -q '^port:' <<< "$summary" && L "  ! Tu app tiene que escuchar en el puerto nuevo (si cambiaste el código, haz push: eso despliega)" \
    "  ! Your app has to listen on the new port (if you changed the code, push: that deploys)" && echo
  grep -q '^access: vpn → public' <<< "$summary" && L "  ! Pública: cualquiera en internet podrá abrirla" \
    "  ! Public: anyone on the internet will be able to open it" && echo
  if ! ask "$(L "¿Aplicar? (reinicia $name con la misma imagen)" "Apply? (restarts $name with the same image)")" s; then
    git -C "$INFRA" checkout -q -- "apps/$name/app.yml"
    die "$(L Cancelado Cancelled)"
  fi
  step "$(L "Compose de $name (ansible/apps.yml)" "$name's compose (ansible/apps.yml)")"
  (cd "$INFRA/ansible" && ansible-playbook apps.yml -e "andamio_only_app=$name" | grep -E 'fatal|ok=')
  git -C "$INFRA" add "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $name: $(paste -sd',' <<< "$summary" | sed 's/: [^,]* → /=/g')"
  app_apply "$name"
  # El tiempo máximo vale para conexiones nuevas: reiniciar renueva las que la app ya tenía abiertas.
  if grep -q '^db_timeout:' <<< "$summary" && ! grep -qx 'stopped: true' "$f"; then
    app_restart "$name"
  fi
}

# andamio app source: de dónde sale una app que comparte su repo con otras (dir: en app.yml): su
# carpeta, desde dónde se construye y qué rutas disparan su deploy. Cambiarlo reescribe su
# pipeline (.github/workflows/andamio-<app>.yml) en el repo de la app y lo guarda en app.yml. No
# toca el servidor: la imagen y la llave siguen siendo las suyas.
app_source() {
  local name=${1:-}; shift || true
  [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  local cur; cur=$(python3 - "$f" "$OWNER" <<'PY'
import sys, yaml
a = yaml.safe_load(open(sys.argv[1])) or {}
print(a.get("repo") or f"{sys.argv[2]}/{a.get('name')}")
print(a.get("branch") or "main")
print(a.get("dir") or "")
print(a.get("context") or "")
print(" ".join(a.get("watch") or []))
PY
)
  local repo branch appdir context watch_s
  { read -r repo; read -r branch; read -r appdir; read -r context; read -r watch_s; } <<< "$cur"  || true   # los últimos pueden venir vacíos
  local watch=(); [ -z "$watch_s" ] || read -ra watch <<< "$watch_s"
  if [ $# -eq 0 ]; then
    echo "Repo:      $repo  ($(L rama branch) $branch)"
    echo "$(L Carpeta Folder):   ${appdir:-$(L "la raíz (una app por repo)" "the root (one app per repo)")}"
    [ -z "$appdir" ] && return
    echo "$(L "Se construye desde" "Built from"):  ${context:-$appdir}"
    echo "$(L "Despliega si cambia" "Deploys when it changes"): $appdir ${watch[*]:-}${context:+ $(L "(y los manifiestos de la raíz)" "(and the root manifests)")}"
    echo "Pipeline:  .github/workflows/andamio-$name.yml"
    return
  fi
  [ -n "$appdir" ] || die "$(L "$name es la única app de su repo (sin carpeta): esto es para varias apps en un repo (andamio app create --dir)" \
                               "$name is its repo's only app (no folder): this is for several apps in one repo (andamio app create --dir)")"
  local missing; missing=$(L "falta el valor de" "missing value for")
  local newdir=$appdir newctx=$context deploy=false w
  while [ $# -gt 0 ]; do
    case $1 in
      --dir) newdir=$(valid_dir "${2:?$missing --dir}"); shift ;;
      --context) case ${2:?$missing --context} in
                   .) newctx=. ;; -|none|ninguno) newctx="" ;;
                   *) die "$(L "--context: . (la raíz) o - (su carpeta)" "--context: . (the root) or - (its folder)")" ;;
                 esac; shift ;;
      --watch-add) w=$(valid_watch "${2:?$missing --watch-add}"); shift
                   printf '%s\n' "${watch[@]}" | grep -qx -- "$w" && die "$(L "Ya está: $w" "Already there: $w")"
                   watch+=("$w") ;;
      --watch-rm) w=$(valid_watch "${2:?$missing --watch-rm}"); shift
                  printf '%s\n' "${watch[@]}" | grep -qx -- "$w" || die "$(L "No está: $w" "Not there: $w")"
                  mapfile -t watch < <(printf '%s\n' "${watch[@]}" | grep -vx -- "$w" || true) ;;
      *) die "$(L "Opción desconocida" "Unknown option"): $1" ;;
    esac
    shift
  done
  # Otra carpeta u otro contexto cambian lo que se construye: se despliega. Las rutas, no.
  { [ "$newdir" != "$appdir" ] || [ "$newctx" != "$context" ]; } && deploy=true
  no_uncommitted

  local work; work=$(mktemp -d)
  CLEANUP="${CLEANUP:-} $work"
  # shellcheck disable=SC2064   # la lista se fija ahora, a propósito
  trap "rm -rf ${CLEANUP}" EXIT
  git clone -q --depth 1 --branch "$branch" "$(forge clone-url "$repo")" "$work/repo" || die "$(L "No pude clonar $repo ($branch) por SSH" "Couldn't clone $repo ($branch) over SSH")"
  [ -f "$work/repo/$newdir/Dockerfile" ] \
    || die "$(L "$repo no tiene $newdir/Dockerfile (agrégalo, o crea la app de nuevo con andamio app create para que te proponga uno)" \
               "$repo has no $newdir/Dockerfile (add it, or create the app again with andamio app create to get one proposed)")"
  local wf=$work/repo/.github/workflows/andamio-$name.yml sha
  # La misma versión del pipeline que ya usa (actualizarla es andamio app ci-update).
  sha=$(grep -m1 -oE 'app-build\.yml@[0-9a-f]{40}' "$wf" 2> /dev/null | cut -d@ -f2 || true)
  [ -n "$sha" ] || sha=$(git -C "$INFRA" rev-list -n1 "$(git -C "$INFRA" describe --tags --abbrev=0 --match 'app-build-v*')")
  local args=(--branch "$branch" --app "$name" --dir "$newdir" ${newctx:+--context "$newctx"})
  for w in "${watch[@]}"; do [ -n "$w" ] && args+=(--watch "$w"); done
  mkdir -p "$(dirname "$wf")"
  forge ci-snippet "$INSTANCE_REPO" "$sha" "${args[@]}" > "$wf"

  echo "$(L Carpeta Folder):   $appdir → $newdir"
  echo "$(L "Se construye desde" "Built from"):  ${context:-$appdir} → ${newctx:-$newdir}"
  echo "$(L "Rutas" "Paths"):     ${watch[*]:-$(L "(solo su carpeta)" "(only its folder)")}"
  if git -C "$work/repo" diff --quiet && [ -z "$(git -C "$work/repo" status --porcelain)" ]; then
    echo "✓ $(L "Nada que cambiar" "Nothing to change")"; return 0
  fi
  confirm "$(L "¿Cambiarlo? (sube su pipeline a $repo$($deploy && echo " y despliega"))" \
               "Change it? (pushes its pipeline to $repo$($deploy && echo " and deploys"))")" ANDAMIO_SOURCE_OK

  # El app.yml primero (local), después el repo de la app; si su push falla, nada queda a medias.
  python3 - "$f" "$newdir" "$newctx" "${watch[@]}" <<'PY'
import re, sys
f, d, ctx, watch = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
lines = [l for l in open(f).read().split("\n") if not re.match(r"^(context|watch):", l)]
lines = [f"dir: {d}" if re.match(r"^dir:", l) else l for l in lines]
at = next(i + 1 for i, l in enumerate(lines) if l.startswith("dir:"))
extra = ([f"context: {ctx}"] if ctx else []) + ([f"watch: [{', '.join(watch)}]"] if watch else [])
lines[at:at] = extra
open(f, "w").write("\n".join(lines))
PY
  local skip=" [skip ci]"; $deploy && skip=""
  git -C "$work/repo" add ".github/workflows/andamio-$name.yml"
  git -C "$work/repo" commit -qm "andamio: pipeline de $name ($newdir)$skip"
  local via_pr=""
  if ! git -C "$work/repo" push -q origin HEAD 2> /dev/null; then
    # La rama solo acepta PRs: el pipeline nuevo va en uno (al mergearlo, rige la carpeta nueva).
    local prb="andamio/source-$name"
    if ! git -C "$work/repo" push -q -f origin "HEAD:refs/heads/$prb"; then
      git -C "$INFRA" checkout -q -- "apps/$name/app.yml"
      die "$(L "$repo rechazó el push: no cambié nada" "$repo rejected the push: nothing changed")"
    fi
    via_pr=$(L "Actualiza el pipeline de $name (carpeta y rutas que disparan su deploy). Al mergearlo, rige." \
               "Updates $name's pipeline (folder and paths that trigger its deploy). It applies once merged." \
             | forge pr-create "$repo" "$branch" "$prb" "andamio: $(L "pipeline de" "pipeline of") $name") \
      || { git -C "$INFRA" checkout -q -- "apps/$name/app.yml"; die "$(L "Subí la rama $prb, pero no pude abrir el PR" "Pushed branch $prb, but couldn't open the PR")"; }
  fi
  git -C "$INFRA" add "apps/$name/app.yml"
  git -C "$INFRA" commit -qm "feat(apps): $name source ($newdir)"
  push_infra
  if [ -n "$via_pr" ]; then
    echo "✓ $(L "$branch solo acepta PRs: abrí uno con el pipeline nuevo" "$branch only takes PRs: opened one with the new pipeline")"
    echo "  $via_pr"
    L "  Mergéalo y rige$($deploy && echo " (y despliega)")." "  Merge it and it applies$($deploy && echo " (and deploys)")."; echo
    return 0
  fi
  echo "✓ $(L "$name: pipeline al día en $repo" "$name: pipeline up to date in $repo")$($deploy && L ", desplegando" ", deploying")"
  if $deploy; then
    forge ci-watch "$repo" "$(git -C "$work/repo" rev-parse HEAD)" --workflow "andamio-$name.yml" || true
  fi
}

# andamio app cron: tareas programadas (cron: en app.yml). Cada una, un timer de systemd en el
# servidor que corre el comando con la imagen, los secretos y los límites de la app.
app_cron() {
  local sub=${1:-} name=${2:-}; shift 2 || usage
  [ -n "$sub" ] && [ -n "$name" ] || usage
  valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  case $sub in
    list)
      "$INFRA/bin/andamio" _cron list "$f" "$name"; echo; return ;;
    run)
      local task=${1:-}; [[ $task =~ ^[a-z][a-z0-9-]*$ ]] || usage
      grep -qx "  - name: $task" "$f" || die "$(L "$name no tiene una tarea $task (andamio app cron list $name)" "$name has no task $task (andamio app cron list $name)")"
      step "$(L "Corriendo $task de $name en el servidor (su salida, abajo)" "Running $name's $task on the server (its output, below)")"
      local rc=0
      ssh -t -q "$SERVER" "ANDAMIO_LANG=$LNG /srv/andamio/infra/scripts/app-cron.sh $name $task --manual" || rc=$?
      echo
      if [ "$rc" = 0 ]; then echo "✓ $(L "$task terminó bien" "$task finished fine")"; else die "$(L "$task terminó con código $rc" "$task exited with code $rc")"; fi
      return ;;
    runs)
      local task=${1:-}; [[ $task =~ ^[a-z][a-z0-9-]*$ ]] || usage
      "$INFRA/bin/andamio" _cron runs "$f" "$name" "$task"; return ;;
    add | rm | edit) ;;
    *) usage ;;
  esac
  no_uncommitted
  local msg
  if [ "$sub" = add ]; then
    local schedule=${1:-} command=${2:-} task=""
    [ -n "$schedule" ] && [ -n "$command" ] || usage
    shift 2
    while [ $# -gt 0 ]; do
      case $1 in
        --name) task=${2:?$(L "falta el valor de --name" "missing value for --name")}; shift ;;
        *) die "$(L "Opción desconocida" "Unknown option"): $1" ;;
      esac
      shift
    done
    echo
    "$INFRA/bin/andamio" _cron add "$f" "$schedule" "$command" "$task"
    task=$(git -C "$INFRA" diff -U0 -- "apps/$name/app.yml" | sed -n 's/^+  - name: //p' | tail -n 1)
    msg="feat(apps): $name: cron add $task"
  elif [ "$sub" = edit ]; then
    local task=${1:-} schedule="" command=""; [ -n "$task" ] || usage
    shift
    while [ $# -gt 0 ]; do
      case $1 in
        --schedule) schedule=${2:?$(L "falta el valor de --schedule" "missing value for --schedule")}; shift ;;
        --command) command=${2:?$(L "falta el valor de --command" "missing value for --command")}; shift ;;
        *) die "$(L "Opción desconocida" "Unknown option"): $1" ;;
      esac
      shift
    done
    [ -n "$schedule" ] || [ -n "$command" ] || die "$(L "Nada que cambiar: --schedule o --command" "Nothing to change: --schedule or --command")"
    echo
    "$INFRA/bin/andamio" _cron edit "$f" "$task" "$schedule" "$command"
    msg="feat(apps): $name: cron edit $task"
  else
    local task=${1:-}; [ -n "$task" ] || usage
    "$INFRA/bin/andamio" _cron rm "$f" "$task"
    msg="feat(apps): $name: cron rm $task"
  fi
  git -C "$INFRA" add "apps/$name/app.yml" ansible/group_vars/all.yml
  git -C "$INFRA" commit -qm "$msg"
  app_apply "$name" cron
  if [ "$sub" = add ]; then
    L "  Probarla ya: andamio app cron run $name $task   ·   Ver todas: andamio app cron list $name" \
      "  Try it now: andamio app cron run $name $task   ·   See all: andamio app cron list $name"; echo
  fi
}

app_logs() {
  local name=${1:-} service=app; [ -n "$name" ] || usage; valid_name "$name"
  [ -f "$INFRA/apps/$name/app.yml" ] || no_app "$name"
  [ "${2:-}" = --worker ] && service=worker
  [ -z "${2:-}" ] || [ "$2" = --worker ] || die "$(L "Opción desconocida" "Unknown option"): $2"
  # El contenedor más reciente de la app (o de su worker), corriendo o no: con la app caída es
  # cuando más se necesitan sus logs. -f los sigue mientras corra; si está apagada, muestra y sale.
  ssh -t -q "$SERVER" "c=\$(docker ps -aq --filter label=com.docker.compose.project=$name --filter label=com.docker.compose.service=$service --filter label=com.docker.compose.oneoff=False | head -n 1)
if [ -z \"\$c\" ]; then echo '$(L "$name no tiene contenedores (¿nunca se desplegó?)" "$name has no containers (never deployed?)")'; exit 1; fi
docker ps -a --filter id=\$c --format '{{.Names}}: {{.Status}}'
docker logs -f --tail 100 \$c"
}

app_restart() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  grep -qx 'stopped: true' "$f" && die "$(L "$name está detenida: para volver, andamio app start $name" "$name is stopped: to bring it back, andamio app start $name")"
  step "$(L "Reiniciando $name (misma versión; unos segundos sin responder)" "Restarting $name (same version; a few seconds without answering)")"
  ssh -n "$SERVER" "cd /srv/andamio/infra/apps/$name && docker compose restart -t 15 && docker compose ps --format '{{.Name}}: {{.Status}}'" \
    || die "$(L "No se pudo reiniciar (el detalle, arriba)" "Couldn't restart it (details above)")"
  echo "✓ $(L "$name reiniciada" "$name restarted")"
}

app_deploy() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  local repo target sha title
  local wf br; read -r repo br wf <<< "$(app_ci "$f" "$name")"
  # Lo último de main que se construyó bien (su imagen existe): el mismo deploy sin caída de siempre.
  target=$(forge ci-runs "$repo" 30 --branch "$br" ${wf:+--workflow "$wf"} | python3 -c '
import json, sys
for r in json.load(sys.stdin):
    if r["conclusion"] == "success" and r.get("full"):
        print(r["full"], r["title"].replace("\n", " ")[:80])
        break')
  [ -n "$target" ] || die "$(L "$name no tiene un build exitoso en main: haz push (o andamio app retry $name)" "$name has no successful build on main: push (or andamio app retry $name)")"
  read -r sha title <<< "$target"
  echo "$(L "Despliega" "Deploys"): ${sha:0:7}  «$title»"
  confirm "$(L "¿Desplegar $name ahora?" "Deploy $name now?")" ANDAMIO_DEPLOY_OK
  ssh -n "$SERVER" "/srv/andamio/infra/scripts/deploy-app.sh $name $sha ${sha:0:7}"
}

app_rollback() {
  local name=${1:-} want=${2:-}; [ -n "$name" ] || usage; valid_name "$name"
  local f=$INFRA/apps/$name/app.yml
  [ -f "$f" ] || no_app "$name"
  [ -z "$want" ] || [[ $want =~ ^[0-9a-f]{7,40}$ ]] \
    || die "$(L "Commit inválido: $want (de 7 a 40 caracteres hexadecimales)" "Invalid commit: $want (7 to 40 hex characters)")"
  local repo current target sha title
  local wf br; read -r repo br wf <<< "$(app_ci "$f" "$name")"
  # Los deploys salen de su CI (también en apps sin base); la versión que corre, del servidor.
  current=$(ssh -n "$SERVER" "sed -n 's/^TAG=//p' /srv/andamio/infra/apps/$name/.env 2> /dev/null" || true)
  target=$(forge ci-runs "$repo" 30 --branch "$br" ${wf:+--workflow "$wf"} | python3 -c '
import json, sys
want, current = sys.argv[1], sys.argv[2]
for r in json.load(sys.stdin):
    if r["conclusion"] != "success" or not r.get("full"):
        continue
    if (want and r["full"].startswith(want)) or (not want and r["full"] != current):
        print(r["full"], r["title"].replace("\n", " ")[:80])
        break' "$want" "$current")
  if [ -z "$target" ]; then
    [ -n "$want" ] && die "$(L "$want no es un deploy exitoso de $name (entre sus últimos 30)" "$want isn't a successful deploy of $name (among its last 30)")"
    die "$(L "No hay un deploy exitoso anterior para volver" "There's no previous successful deploy to go back to")"
  fi
  read -r sha title <<< "$target"
  [ "$sha" != "$current" ] || die "$(L "$name ya corre ${sha:0:7}" "$name already runs ${sha:0:7}")"
  echo "$(L "Ahora" "Now"): ${current:0:7}   →   ${sha:0:7}  «$title»"
  L "Ojo: el próximo push vuelve a desplegar lo último de main." "Note: the next push deploys main's latest again."
  confirm "$(L "¿Volver $name a ${sha:0:7}?" "Roll $name back to ${sha:0:7}?")" ANDAMIO_ROLLBACK_OK
  # El mismo deploy sin caída de siempre: si la imagen ya no está o no queda sana, sigue la actual.
  ssh -n "$SERVER" "/srv/andamio/infra/scripts/deploy-app.sh $name $sha ${sha:0:7}"
}

# Deshacer un cambio de configuración de una app (un commit que solo tocó su app.yml, y su
# compose generado): el cambio inverso de app.yml, el compose regenerado, un commit nuevo y
# aplicar. Nunca secretos, ni crear o borrar una app. Si un cambio posterior tocó las mismas
# líneas, no se puede deshacer solo y no toca nada.
app_revert() {
  local name=${1:-} want=${2:-}; [ -n "$name" ] && [ -n "$want" ] || usage; valid_name "$name"
  [ -f "$INFRA/apps/$name/app.yml" ] || no_app "$name"
  [[ $want =~ ^[0-9a-f]{7,40}$ ]] || die "$(L "Commit inválido: $want" "Invalid commit: $want")"
  no_uncommitted
  local full files subject
  full=$(git -C "$INFRA" rev-parse --verify -q "$want^{commit}") || die "$(L "No existe el commit $want en tu repo" "There's no commit $want in your repo")"
  files=$(git -C "$INFRA" show --format= --name-status "$full")
  # Solo M (modificado) de su app.yml y, si acaso, de su compose.yaml.
  if ! grep -qx "M	apps/$name/app.yml" <<< "$files" || grep -vqxE "M	apps/$name/(app\.yml|compose\.yaml)" <<< "$files"; then
    die "$(L "Ese commit no es un cambio de configuración de $name (solo se deshacen los que tocan únicamente su app.yml: RAM, dominios, tareas, CORS, acceso)" \
             "That commit isn't a configuration change to $name (only the ones that touch just its app.yml can be undone: RAM, domains, tasks, CORS, access)")"
  fi
  subject=$(git -C "$INFRA" show -s --format=%s "$full")
  echo "$(L "Deshacer" "Undo") ${full:0:7} «$subject»:"
  git -C "$INFRA" show --format= -U0 "$full" -- "apps/$name/app.yml" | grep -E '^[-+][^-+]' | sed 's/^-/  + /; t; s/^+/  - /'
  confirm "$(L "¿Deshacer este cambio de $name?" "Undo this change to $name?")" ANDAMIO_REVERT_OK
  if ! git -C "$INFRA" show --format= "$full" -- "apps/$name/app.yml" | git -C "$INFRA" apply -R; then
    die "$(L "Un cambio posterior tocó las mismas líneas de su app.yml: no se puede deshacer solo. No toqué nada." \
             "A later change touched the same lines of its app.yml: it can't be undone by itself. Nothing was touched.")"
  fi
  step "$(L "Compose de $name" "$name's compose")"
  (cd "$INFRA/ansible" && ansible-playbook apps.yml -e "andamio_only_app=$name" | grep -E 'fatal|ok=')
  git -C "$INFRA" add "apps/$name"
  git -C "$INFRA" commit -qm "revert(apps): $name: $(L deshacer undo) ${full:0:7} ($subject)"
  app_apply "$name"
}

app_restore() {
  local name=${1:-} snap=${2:-}; [ -n "$name" ] || usage; valid_name "$name"
  [ -f "$INFRA/apps/$name/app.yml" ] || no_app "$name"
  if [ -z "$snap" ]; then
    "$INFRA/bin/andamio" backups list
    echo
    L "Elige uno y corre:  andamio app restore $name <respaldo>   (latest: el más nuevo)" \
      "Pick one and run:  andamio app restore $name <backup>   (latest: the newest)"
    exit 0
  fi
  [[ $snap == latest || $snap =~ ^[0-9a-f]{8,64}$ ]] \
    || die "$(L "Respaldo inválido: $snap (su id, como sale en andamio backups list, o latest)" "Invalid backup: $snap (its id, as andamio backups list shows it, or latest)")"
  L "Esto RESTAURA $name al respaldo $snap:
  - su base (PostgreSQL o MariaDB) y sus carpetas persistentes vuelven a como estaban ese día
  - lo que tiene ahora se guarda antes en /srv/andamio/archive/ (entra en el backup)
  - la app se detiene unos segundos mientras tanto
No toca: Redis, el código ni la versión desplegada, ni sus secretos.
" "This RESTORES $name to backup $snap:
  - its database (PostgreSQL or MariaDB) and persistent folders go back to how they were that day
  - what it has now is saved first in /srv/andamio/archive/ (included in backups)
  - the app stops for a few seconds meanwhile
Left alone: Redis, the code and deployed version, and its secrets.
"
  local ok=""; read -rp "$(L "Para confirmar, escribe el nombre de la app: " "To confirm, type the app's name: ")" ok || true
  [ "$ok" = "$name" ] || die "$(L Cancelado Cancelled)"
  step "$(L "Servidor: restaurar (pide tu contraseña de sudo)" "Server: restore (asks for your sudo password)")"
  "$INFRA/bin/andamio" _restore "$name" "$snap"
}

app_destroy() {
  local name=${1:-}; [ -n "$name" ] || usage; valid_name "$name"
  local dir=$INFRA/apps/$name
  [ -f "$dir/app.yml" ] || no_app "$name"
  [ "$name" = "$(python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1])).get("andamio_dashboard_app") or "")' \
      "$INFRA/ansible/group_vars/all.yml")" ] \
    && die "$(L "$name es tu dashboard (andamio_dashboard_app): no se destruye con este comando" \
               "$name is your dashboard (andamio_dashboard_app): this command doesn't destroy it")"
  no_uncommitted

  L "Esto DESTRUYE la app $name:
  - sus contenedores (web y worker) en el servidor
  - su base y su usuario de PostgreSQL (antes: respaldo en /srv/andamio/archive/, que entra en restic)
  - su base y su usuario de MariaDB, si tiene (con el mismo respaldo antes)
  - sus claves y su usuario de Redis
  - sus carpetas persistentes (antes: archivadas en /srv/andamio/archive/)
  - apps/$name en este repo (revoca su llave de deploy y la quita del registro)
No toca: el repo de la app, sus imágenes en el registro ni $PROJECTS/$name.
" "This DESTROYS the app $name:
  - its containers (web and worker) on the server
  - its PostgreSQL database and user (first backed up to /srv/andamio/archive/, which restic includes)
  - its MariaDB database and user, if it has one (with the same backup first)
  - its Redis keys and user
  - its persistent folders (first archived to /srv/andamio/archive/)
  - apps/$name in this repo (revokes its deploy key and removes it from the registry)
Left alone: the app's repo, its images in the registry and $PROJECTS/$name.
"
  local ok=""; read -rp "$(L "Para confirmar, escribe el nombre de la app: " "To confirm, type the app's name: ")" ok || true
  [ "$ok" = "$name" ] || die "$(L Cancelado Cancelled)"

  step "$(L "Servidor: respaldo, contenedores, base y Redis" "Server: backup, containers, database and Redis")"
  ssh "$SERVER" bash -s -- "$name" "$LNG" <<'REMOTE'
set -euo pipefail
name=$1; LNG=$2; cd "/srv/andamio/infra/apps/$name"
L() { if [ "$LNG" = es ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }
dbname=""; role=""
url=$(grep '^DATABASE_URL=' .env 2>/dev/null | cut -d= -f2- || true)
if [ -n "$url" ]; then
  dbname=${url##*/}; role=$(sed -E 's#^postgres(ql)?://([^:]+):.*#\2#' <<< "$url")
  [[ $dbname =~ ^[a-z0-9_]+$ && $role =~ ^[a-z0-9_]+$ ]] || { L "DATABASE_URL inesperada; no sigo" "Unexpected DATABASE_URL; stopping"; exit 1; }
  install -d -m 700 /srv/andamio/archive
  out=/srv/andamio/archive/$name-$(date +%Y%m%d-%H%M%S).sql.gz
  docker run --rm --network data postgres:18.6-alpine pg_dump "$url" | gzip > "$out"
  [ "$(gunzip -c "$out" | wc -c)" -gt 0 ] || { L "El respaldo quedó vacío; no sigo" "The backup came out empty; stopping"; exit 1; }
  L "Respaldo: $out ($(du -h "$out" | cut -f1))" "Backup: $out ($(du -h "$out" | cut -f1))"
fi
# MariaDB (mysql: true): su base, respaldada antes de apagar nada.
mdb=""; muser=""
murl=$(grep '^MYSQL_URL=' .env 2>/dev/null | cut -d= -f2- || true)
if [ -n "$murl" ]; then
  mdb=${murl##*/}; muser=$(sed -E 's#^mysql://([^:]+):.*#\1#' <<< "$murl")
  [[ $mdb =~ ^[a-z0-9_]+$ && $muser =~ ^[a-z0-9_]+$ ]] || { L "MYSQL_URL inesperada; no sigo" "Unexpected MYSQL_URL; stopping"; exit 1; }
  install -d -m 700 /srv/andamio/archive
  out=/srv/andamio/archive/$name-mariadb-$(date +%Y%m%d-%H%M%S).sql.gz
  docker exec mariadb sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb-dump -uroot --single-transaction --routines --events --databases "$1"' _ "$mdb" | gzip > "$out"
  [ "$(gunzip -c "$out" | wc -c)" -gt 0 ] || { L "El respaldo de MariaDB quedó vacío; no sigo" "The MariaDB backup came out empty; stopping"; exit 1; }
  L "Respaldo de MariaDB: $out ($(du -h "$out" | cut -f1))" "MariaDB backup: $out ($(du -h "$out" | cut -f1))"
fi
L "Apagando contenedores" "Stopping containers"
# TAG de relleno: una app nunca desplegada no tiene TAG y compose se negaría a leer el archivo.
TAG=destroy docker compose --profile migrate down --remove-orphans
if [ -n "$dbname" ]; then
  docker exec -i postgres sh -c 'psql -v ON_ERROR_STOP=1 -q -U "$POSTGRES_USER" -d postgres' <<SQL
DROP DATABASE IF EXISTS "$dbname" WITH (FORCE);
DROP ROLE IF EXISTS "$role";
SQL
  L "PostgreSQL: base $dbname y usuario $role borrados" "PostgreSQL: database $dbname and user $role dropped"
fi
if [ -n "$mdb" ]; then
  docker exec -i mariadb sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot' <<SQL
DROP DATABASE IF EXISTS \`$mdb\`;
DROP USER IF EXISTS '$muser'@'%';
SQL
  L "MariaDB: base $mdb y usuario $muser borrados" "MariaDB: database $mdb and user $muser dropped"
fi
if grep -q '^REDIS_URL=' .env 2>/dev/null; then
  n=$(docker exec redis sh -c "redis-cli --no-auth-warning --scan --pattern '$name:*' | xargs -r redis-cli --no-auth-warning DEL | awk '{s += \$1} END {print s + 0}'")
  L "Redis: $n claves borradas (el usuario se quita al aplicar andamio)" "Redis: $n keys deleted (the user is removed when andamio is applied)"
fi
data=/srv/andamio/data/apps/$name
if [ -d "$data" ]; then
  # Son del usuario de la imagen: archivar y borrar con root, en un contenedor de un instante.
  install -d -m 700 /srv/andamio/archive
  out=$name-$(L archivos files)-$(date +%Y%m%d-%H%M%S).tar.gz
  docker run --rm -u 0 -v "$data:/d:ro" -v /srv/andamio/archive:/out --entrypoint tar postgres:18.6-alpine czf "/out/$out" -C /d .
  docker run --rm -u 0 -v /srv/andamio/data/apps:/apps --entrypoint rm postgres:18.6-alpine -rf "/apps/$name"
  L "Carpetas persistentes archivadas: /srv/andamio/archive/$out" "Persistent folders archived: /srv/andamio/archive/$out"
fi
rm -f .env
REMOTE

  step "$(L "Quitar apps/$name de este repo" "Removing apps/$name from this repo")"
  git -C "$INFRA" rm -rq "apps/$name"
  git -C "$INFRA" commit -qm "feat(apps): $(L destruir destroy) $name (andamio app destroy)"
  push_infra

  step "$(L "Servidor: revocar llave, quitar del registro y de Redis (pide tu contraseña de sudo)" \
            "Server: revoke the key, remove it from the registry and from Redis (asks for your sudo password)")"
  "$INFRA/bin/andamio" _apply --registry   # solo el registro: sin la app, su llave y su usuario se van

  echo
  L "✓ $name destruida. Si ya no quieres su repo, archívalo (o bórralo, irreversible) en
  $(forge name): $OWNER/$name" "✓ $name destroyed. If you no longer want its repo, archive it (or delete it, irreversible) on
  $(forge name): $OWNER/$name"
  echo
}

[ "${1:-}" = app ] || usage
shift
case ${1:-} in
  create) shift; app_create "$@" ;;
  list) app_list ;;
  info) shift; app_info "$@" ;;
  set) shift; app_set "$@" ;;
  logs) shift; app_logs "$@" ;;
  rollback) shift; app_rollback "$@" ;;
  restore) shift; app_restore "$@" ;;
  restart) shift; app_restart "$@" ;;
  deploy) shift; app_deploy "$@" ;;
  revert) shift; app_revert "$@" ;;
  sql) shift; [ -n "${1:-}" ] || usage; valid_name "$1"; exec "$INFRA/bin/andamio" _sql "$@" ;;
  destroy) shift; app_destroy "$@" ;;
  secret) shift; app_secret "$@" ;;
  source|fuente) shift; app_source "$@" ;;
  apply | aplicar) shift; app_apply "$@" ;;
  stop|start) app_state "$@" ;;
  domain) shift; app_list_edit domains "$@" ;;
  cors) shift; app_list_edit cors "$@" ;;
  volume | volumen) shift; app_list_edit volumes "$@" ;;
  cron) shift; app_cron "$@" ;;
  ci-update) shift; app_ci_update "$@" ;;
  retry | reintentar) shift; app_retry "$@" ;;
  *) usage ;;
esac
