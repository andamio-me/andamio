#!/usr/bin/env python3
"""andamio: prepara tu configuración y tu VPS / sets up your configuration and your VPS.

  andamio setup     deja tu máquina lista: instala lo que falta, preguntando antes (una vez)
  andamio init      preguntas guiadas -> configuración, llave de cifrado y secretos
                    (parte 1: solo en tu máquina; no toca ningún servidor)
  andamio servidor  prepara el VPS: acceso SSH verificado, usuario propio, endurecimiento,
                    VPN, llave del repo, registro de imágenes y los stacks (parte 2; se puede repetir)
  andamio estado    chequeo de seguridad y salud: desde el servidor y desde Internet,
                    con el arreglo de cada problema (no cambia nada)
  andamio backups   backups diarios, cifrados y fuera del servidor (B2 o S3): los
                    configura, hace el primero y prueba que se puede restaurar
  andamio app ...   tus apps: create, secret (set/rm/list), apply, volume, list, logs,
                    stop/start, rollback, destroy, ci-update
  andamio alertas   aviso al celular (ntfy, sin cuenta) si un contenedor se cae o el disco se llena
  andamio update    trae las mejoras y parches de andamio (fusión de tres vías por
                    archivo) sin tocar tu configuración, tus apps ni tus secretos
  andamio certificado [cert llave]
                    tu propio certificado HTTPS (andamio_tls: custom): sin argumentos
                    muestra el actual; con ellos lo valida y lo reemplaza (renovación)
  andamio use [carpeta|dominio]
                    con varios servidores: qué copia usa `andamio` fuera de sus carpetas
                    (dentro de una, usa esa; `andamio` se instala en ~/.local/bin)

Todo lo que genera queda en este repo (cifrado donde corresponde). Nada se sobreescribe:
si un archivo ya existe, se respeta.

Idioma: español si ANDAMIO_LANG (o LANG) empieza con "es"; si no, inglés. Cada mensaje
tiene sus dos versiones juntas: L("español", "English").
"""
from __future__ import annotations

import argparse
import getpass
import ipaddress
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "ansible" / "group_vars" / "all.yml"
SOPS_CONFIG = ROOT / ".sops.yaml"
AGE_KEY = Path(os.environ.get("SOPS_AGE_KEY_FILE", Path.home() / ".config" / "sops" / "age" / "keys.txt"))
INVENTORY = ROOT / "ansible" / "inventory.yml"
AUTH_KEYS = ROOT / "host" / "ssh" / "authorized_keys"
SSH_DIR = Path.home() / ".ssh"
LOCAL_KEY = SSH_DIR / "id_ed25519"
DEFAULT_ALIAS = "andamio"
TLS_CERT = ROOT / "host" / "tls" / "cert.pem"          # público: va en claro
TLS_KEY = ROOT / "host" / "sops" / "tls-key.sops"      # privada: cifrada
CERT_WARN_DAYS = 30


# ---------- idioma ----------

def _lang() -> str:
    for var in ("ANDAMIO_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            return "es" if os.environ[var].lower().startswith("es") else "en"
    return "en"


LANG = _lang()
os.environ["ANDAMIO_LANG"] = LANG     # bin/forge y los scripts lo heredan
# Lo que instala `andamio setup` (sops, ansible por pipx) vive en ~/.local/bin, que la
# shell recién instalada a veces aún no tiene en el PATH.
os.environ["PATH"] = f"{Path.home() / '.local' / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}"


def L(es: str, en: str) -> str:
    return es if LANG == "es" else en


# Herramientas que necesitas en TU máquina, y cómo instalarlas.
TOOLS = {
    "git": "bin/andamio setup",
    "ssh": "bin/andamio setup",
    "ssh-keygen": "bin/andamio setup",
    "sops": "bin/andamio setup",
    "age-keygen": "bin/andamio setup",
    "ansible-playbook": "bin/andamio setup",
}


# ---------- salida ----------

# "ANDAMIO" en bloques con sombra (estilo ANSI Shadow), en el azul de la marca.
BANNER = r"""
 █████╗ ███╗   ██╗██████╗  █████╗ ███╗   ███╗██╗ ██████╗
██╔══██╗████╗  ██║██╔══██╗██╔══██╗████╗ ████║██║██╔═══██╗
███████║██╔██╗ ██║██║  ██║███████║██╔████╔██║██║██║   ██║
██╔══██║██║╚██╗██║██║  ██║██╔══██║██║╚██╔╝██║██║██║   ██║
██║  ██║██║ ╚████║██████╔╝██║  ██║██║ ╚═╝ ██║██║╚██████╔╝
╚═╝  ╚═╝╚═╝  ╚═══╝╚═════╝ ╚═╝  ╚═╝╚═╝     ╚═╝╚═╝ ╚═════╝
"""


def banner() -> None:
    """Solo en terminales (no en logs ni pipes) y con espacio; NO_COLOR: sin colores."""
    if not sys.stdout.isatty() or shutil.get_terminal_size((80, 24)).columns < 60:
        return
    color = not os.environ.get("NO_COLOR")
    truecolor = os.environ.get("COLORTERM", "") in ("truecolor", "24bit")
    blue = ("\033[38;2;36;95;212m" if truecolor else "\033[38;5;26m") if color else ""
    shadow = ("\033[38;2;120;150;210m" if truecolor else "\033[38;5;67m") if color else ""
    reset = "\033[0m" if color else ""
    for line in BANNER.strip("\n").splitlines():
        out = "".join(f"{blue}{c}{reset}" if c == "█" else f"{shadow}{c}{reset}" if c != " " else c for c in line)
        print("  " + out)
    print("  " + (f"\033[2m" if color else "") + L("el PaaS de un solo VPS, seguro por defecto",
                                                   "the single-VPS PaaS, secure by default") + reset + "\n")

def title(t: str) -> None:
    print(f"\n\033[1m{t}\033[0m")


def note(t: str) -> None:
    for line in t.strip("\n").splitlines():
        print(f"  \033[2m{line}\033[0m")


def ok(t: str) -> None:
    print(f"  \033[32m✓\033[0m {t}")


def warn(t: str) -> None:
    print(f"  \033[33m!\033[0m {t}")


def die(t: str) -> None:
    sys.stdout.flush()
    print(f"\n\033[31m✗ {t}\033[0m", file=sys.stderr)
    sys.exit(1)


def ask(question: str, default: str | None = None, check=None, hint: str = "") -> str:
    """Pregunta hasta tener una respuesta válida. check devuelve un error o None."""
    suffix = f" [{default}]" if default else ""
    while True:
        try:
            value = input(f"  {question}{suffix}: ").strip()
        except EOFError:
            die(L("Entrada terminada antes de responder todo.", "Input ended before all questions were answered."))
        value = value or (default or "")
        error = check(value) if check else (None if value else L("No puede quedar vacío.", "It can't be empty."))
        if not error:
            return value
        warn(error + (f" {hint}" if hint else ""))


def choose(question: str, options: list[tuple[str, str]], default: str) -> str:
    """Elegir entre opciones fijas con ↑/↓ y Enter. Sin terminal interactiva (pipes, pruebas),
    vuelve a la pregunta escrita, con las mismas opciones."""
    values = [v for v, _ in options]
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return ask(f"{question} ({'/'.join(values)})", default,
                   lambda v: None if v in values else L(f"Opciones: {', '.join(values)}.", f"Options: {', '.join(values)}."))
    import termios
    import tty
    i, width = values.index(default), max(len(v) for v in values)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)

    def draw(first: bool) -> None:
        if not first:
            sys.stdout.write(f"\033[{len(options) + 1}A")
        for n, (v, label) in enumerate(options):
            mark = "\033[36m❯\033[0m" if n == i else " "
            text = f"\033[1m{v:<{width}}\033[0m" if n == i else f"{v:<{width}}"
            sys.stdout.write(f"\r\033[K    {mark} {text}  \033[2m{label}\033[0m\n")
        sys.stdout.write("\r\033[K    \033[2m" + L("↑/↓ para moverte, Enter para elegir", "↑/↓ to move, Enter to choose") + "\033[0m\n")
        sys.stdout.flush()
    print(f"  {question}:")
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l")   # sin cursor mientras se elige
        draw(True)
        while True:
            key = os.read(fd, 3)
            if key in (b"\r", b"\n"):
                break
            if key in (b"\x1b[A", b"k"):
                i = (i - 1) % len(options)
            elif key in (b"\x1b[B", b"j"):
                i = (i + 1) % len(options)
            elif key == b"\x03":
                raise KeyboardInterrupt
            draw(False)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h")
    # Deja una sola línea con lo elegido, como las demás preguntas.
    sys.stdout.write(f"\033[{len(options) + 2}A\r\033[J  {question}: \033[36m{values[i]}\033[0m\n")
    sys.stdout.flush()
    return values[i]


def ask_yes(question: str, default: bool) -> bool:
    """Sí o no: con flechas en una terminal; escrito (s/n) en pipes y pruebas. Desde el panel
    (ANDAMIO_ASSUME=default), la respuesta por defecto: lo demás ya se decidió en la página."""
    if os.environ.get("ANDAMIO_ASSUME") == "default":
        print(f"  {question}: {L('sí', 'yes') if default else 'no'}  "
              f"({L('respuesta por defecto, desde el panel', 'default answer, from the panel')})", flush=True)
        return default
    if sys.stdin.isatty() and sys.stdout.isatty():
        yes = L("sí", "yes")
        return choose(question, [(yes, ""), ("no", "")], yes if default else "no") == yes
    yes, no = L("s", "y"), "n"
    answer = ask(question, yes if default else no,
                 lambda v: None if v.lower() in ("s", "si", "sí", "y", "yes", "n", "no")
                 else L("Responde s o n.", "Answer y or n."))
    return answer.lower()[0] in ("s", "y")


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True, **kw)


# La forja de tus repos (GitHub hoy): todo pasa por bin/forge, nunca directo a su CLI.
def forge(*args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    return run([str(ROOT / "bin" / "forge"), *args], input=stdin)


def forge_out(*args: str) -> str:
    r = forge(*args)
    if r.returncode != 0:
        die(r.stderr.strip() or L(f"forge {args[0]} falló", f"forge {args[0]} failed"))
    return r.stdout.strip()


# ---------- validaciones ----------

def check_ip(v: str):
    try:
        ip = ipaddress.ip_address(v)
    except ValueError:
        return L("No es una IP válida.", "That's not a valid IP.")
    if ip.version != 4 or ip.is_private or ip.is_loopback:
        return L("Tiene que ser la IPv4 pública del VPS.", "It must be the VPS's public IPv4.")
    return None


def check_domain(v: str):
    return None if re.fullmatch(r"(?=.{4,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}", v) \
        else L("Dominio inválido (ej. midominio.com).", "Invalid domain (e.g. mydomain.com).")


def check_email(v: str):
    return None if re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", v) else L("Email inválido.", "Invalid email.")


def check_user(v: str):
    if v == "root":
        return L("No uses root: el punto es entrar con un usuario propio.",
                 "Don't use root: the point is to log in with your own user.")
    return None if re.fullmatch(r"[a-z][a-z0-9-]{1,30}", v) \
        else L("Minúsculas, números y guiones (2-31).", "Lowercase letters, digits and hyphens (2-31).")


def check_port(v: str):
    if not v.isdigit() or not 1024 <= int(v) <= 65535:
        return L("Entre 1024 y 65535.", "Between 1024 and 65535.")
    if int(v) in (8080, 51820):
        return L("Ese puerto lo usa andamio (Traefik o la VPN).", "andamio uses that port (Traefik or the VPN).")
    return None


def http_get(url: str, token: str) -> tuple[int, dict, str]:
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}",
                                               "User-Agent": "andamio", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status, dict(r.headers), r.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), ""
    except OSError as e:
        return 0, {}, str(e)


def registry_token_problem(token: str) -> str | None:
    """None si el token sirve para bajar imágenes del registro (lo valida la forja)."""
    r = forge("registry-token-check", stdin=token)
    return None if r.returncode == 0 else (r.stderr.strip() or L("No pude validar el token.", "Couldn't validate the token."))


def cloudflare_token_problem(token: str) -> str | None:
    code, _, body = http_get("https://api.cloudflare.com/client/v4/user/tokens/verify", token)
    if code == 200 and '"active"' in body:
        return None
    return L("Cloudflare no reconoce ese token como activo (¿mal copiado o vencido?).",
             "Cloudflare doesn't see that token as active (mistyped or expired?).")


def ask_secret(prompt: str, problem, tries: int = 3) -> str:
    """Pide un dato secreto (no se ve al escribir), lo verifica y repregunta."""
    for intento in range(tries):
        value = getpass.getpass(f"  {prompt}: ").strip()
        error = problem(value)
        if not error:
            return value
        left = tries - 1 - intento
        warn(error + (L(f" ({left} intentos más)", f" ({left} more tries)") if left else ""))
    die(L("No pude verificar el dato. Revísalo y vuelve a correr el comando: retoma donde quedó.",
          "Couldn't verify it. Check it and run the command again: it resumes where it stopped."))


def resolves_to(name: str) -> set[str]:
    try:
        return {a[4][0] for a in socket.getaddrinfo(name, None, socket.AF_INET)}
    except socket.gaierror:
        return set()


# ---------- certificado propio (andamio_tls: custom) ----------

def local_path(v: str) -> Path:
    """Ruta escrita por la persona; acepta rutas de Windows si corre en WSL (C:\\Users\\...)."""
    v = v.strip().strip("'\"")
    if re.match(r"^[A-Za-z]:\\", v) and shutil.which("wslpath"):
        v = run(["wslpath", "-u", v]).stdout.strip() or v
    return Path(v).expanduser()


def cert_info(cert: Path) -> dict:
    """Datos del primer certificado del archivo (el del servidor); {} si no es un PEM válido."""
    from datetime import datetime, timezone
    r = run(["openssl", "x509", "-in", str(cert), "-noout", "-subject", "-issuer", "-enddate",
             "-ext", "subjectAltName", "-nameopt", "RFC2253"])
    if r.returncode != 0:
        return {}
    field = lambda k: (re.search(rf"^{k}=(.*)$", r.stdout, re.M) or [None, ""])[1].strip()  # noqa: E731
    subject, issuer = field("subject"), field("issuer")
    expires = datetime.strptime(field("notAfter"), "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    cn = (re.search(r"CN=([^,]+)", subject) or [None, ""])[1]
    return {
        "cn": cn, "issuer": issuer, "self_signed": subject == issuer,
        "sans": [s.lower() for s in re.findall(r"DNS:([^,\s]+)", r.stdout)] or [cn.lower()],
        "expires": expires.strftime("%Y-%m-%d"), "days": (expires - datetime.now(timezone.utc)).days,
        "chain": cert.read_text(errors="ignore").count("BEGIN CERTIFICATE"),
        "cloudflare_origin": "cloudflare origin" in issuer.lower(),
    }


def covers(sans: list[str], name: str) -> bool:
    return any(s == name or (s.startswith("*.") and name.endswith(s[1:]) and name.count(".") == s.count("."))
               for s in sans)


def cert_problem(v: str) -> str | None:
    p = local_path(v)
    if not p.is_file():
        return L(f"No existe el archivo {p}.", f"File {p} doesn't exist.")
    info = cert_info(p)
    if not info:
        return L("No es un certificado PEM (texto que empieza con -----BEGIN CERTIFICATE-----). Si es binario "
                 "(.der/.cer): openssl x509 -inform der -in ARCHIVO -out cert.pem",
                 "Not a PEM certificate (text starting with -----BEGIN CERTIFICATE-----). If it's binary "
                 "(.der/.cer): openssl x509 -inform der -in FILE -out cert.pem")
    if info["days"] < 0:
        return L(f"Ese certificado venció el {info['expires']}.", f"That certificate expired on {info['expires']}.")
    return None


def key_problem(cert: Path, v: str) -> str | None:
    key = local_path(v)
    if not key.is_file():
        return L(f"No existe el archivo {key}.", f"File {key} doesn't exist.")
    r = run(["openssl", "pkey", "-in", str(key), "-passin", "pass:", "-pubout"])
    if r.returncode != 0:
        if "ENCRYPTED" in key.read_text(errors="ignore"):
            return L(f"La llave tiene contraseña. Quítasela (andamio la cifra con sops igual): "
                     f"openssl pkey -in {key} -out llave-sin-clave.key",
                     f"The key has a passphrase. Remove it (andamio encrypts it with sops anyway): "
                     f"openssl pkey -in {key} -out key-no-passphrase.key")
        return L("No es una llave privada PEM (texto que empieza con -----BEGIN ... PRIVATE KEY-----).",
                 "Not a PEM private key (text starting with -----BEGIN ... PRIVATE KEY-----).")
    if run(["openssl", "x509", "-in", str(cert), "-noout", "-pubkey"]).stdout.strip() != r.stdout.strip():
        return L("Esa llave no corresponde al certificado (¿es la de otra solicitud o de otro dominio?).",
                 "That key doesn't match the certificate (from another request, or another domain?).")
    return None


def cert_warnings(info: dict, domain: str) -> list[str]:
    """Problemas que no impiden usarlo, pero que la persona tiene que conocer."""
    out = []
    # El comodín se prueba con un nombre que nadie pondría en un certificado.
    missing = [n for n in (domain, f"*.{domain}") if not covers(info["sans"], n.replace("*", "andamio-x7q"))]
    if missing:
        out.append(L(f"No cubre {' ni '.join(missing)} (cubre: {', '.join(info['sans'])}). Las apps con "
                     "otros nombres mostrarán un error de certificado en el navegador.",
                     f"It doesn't cover {' or '.join(missing)} (it covers: {', '.join(info['sans'])}). Apps "
                     "with other names will show a certificate error in the browser."))
    if info["cloudflare_origin"]:
        out.append(L("Es un Origin Certificate de Cloudflare: solo lo aceptan los navegadores a través del "
                     "proxy de Cloudflare (nube naranja, SSL/TLS en modo Full (strict)). Tus paneles privados "
                     "(por la VPN) no pasan por Cloudflare y mostrarán un error de certificado. Si tu dominio "
                     "ya está en Cloudflare, el modo 'cloudflare' de andamio evita esto (gratis, se renueva solo).",
                     "It's a Cloudflare Origin Certificate: browsers only accept it through Cloudflare's "
                     "proxy (orange cloud, SSL/TLS mode Full (strict)). Your private panels (over the VPN) "
                     "don't go through Cloudflare and will show a certificate error. If your domain is "
                     "already on Cloudflare, andamio's 'cloudflare' mode avoids this (free, renews itself)."))
    elif info["self_signed"]:
        out.append(L("Es autofirmado: ningún navegador lo acepta.", "It's self-signed: no browser accepts it."))
    elif info["chain"] < 2:
        out.append(L("Trae solo tu certificado, sin los intermedios de tu CA: algunos clientes lo rechazarán. "
                     "Usa el archivo 'fullchain' o 'bundle', o pega los intermedios debajo del tuyo.",
                     "It only has your certificate, without your CA's intermediates: some clients will "
                     "reject it. Use the 'fullchain' or 'bundle' file, or paste the intermediates below yours."))
    if info["days"] < CERT_WARN_DAYS:
        out.append(L(f"Vence en {info['days']} días ({info['expires']}).",
                     f"It expires in {info['days']} days ({info['expires']})."))
    return out


def show_cert(info: dict) -> None:
    ok(L(f"{info['cn']}: cubre {', '.join(info['sans'])}", f"{info['cn']}: covers {', '.join(info['sans'])}"))
    note(L(f"Emitido por: {info['issuer']}\nVence: {info['expires']} (en {info['days']} días)",
           f"Issued by: {info['issuer']}\nExpires: {info['expires']} (in {info['days']} days)"))


def ask_cert(domain: str) -> tuple[Path, Path]:
    """Pide certificado y llave, los valida y muestra lo que hay que saber antes de usarlos."""
    if not shutil.which("openssl"):
        die(L("Falta openssl para revisar tu certificado: sudo apt install openssl  |  brew install openssl",
              "openssl is needed to check your certificate: sudo apt install openssl  |  brew install openssl"))
    note(L("""
Necesitas dos archivos PEM (texto que empieza con -----BEGIN):
  certificado: el tuyo seguido de los intermedios de tu CA (fullchain o bundle)
  llave privada: la que generaste con la solicitud (CSR), o la que te dio Cloudflare
En WSL, tu carpeta Descargas de Windows está en /mnt/c/Users/<tu usuario>/Downloads
(también puedes pegar la ruta de Windows tal cual).""", """
You need two PEM files (text starting with -----BEGIN):
  certificate: yours followed by your CA's intermediates (fullchain or bundle)
  private key: the one you generated with the request (CSR), or the one Cloudflare gave you
In WSL, your Windows Downloads folder is /mnt/c/Users/<your user>/Downloads
(you can also paste the Windows path as is)."""))
    while True:
        cert = local_path(ask(L("Ruta del certificado", "Certificate path"), check=cert_problem))
        key = local_path(ask(L("Ruta de la llave privada", "Private key path"), check=lambda v: key_problem(cert, v)))
        info = cert_info(cert)
        show_cert(info)
        problems = cert_warnings(info, domain)
        for p in problems:
            warn(p)
        if not problems or ask_yes(L("¿Usarlo igual?", "Use it anyway?"), False):
            return cert, key


def install_cert(cert: Path, key: Path) -> None:
    """Copia el certificado al repo y cifra la llave con sops (sin copias en claro)."""
    TLS_CERT.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(cert, TLS_CERT)
    TLS_CERT.chmod(0o644)
    ok(f"{TLS_CERT.relative_to(ROOT)}")
    rel = TLS_KEY.relative_to(ROOT)
    r = run(["sops", "encrypt", "--input-type", "binary", "--output-type", "json",
             "--filename-override", str(rel), str(key)], cwd=ROOT)
    if r.returncode != 0:
        die(L(f"sops no pudo cifrar la llave: {r.stderr.strip()}", f"sops couldn't encrypt the key: {r.stderr.strip()}"))
    TLS_KEY.parent.mkdir(parents=True, exist_ok=True)
    TLS_KEY.write_text(r.stdout)
    ok(L(f"{rel} (cifrada)", f"{rel} (encrypted)"))
    warn(L(f"Ya está cifrada en el repo: borra la copia sin cifrar ({key}), también de tu carpeta Descargas.",
           f"It's now encrypted in the repo: delete the unencrypted copy ({key}), from your Downloads folder too."))


# ---------- pasos ----------

def check_tools() -> None:
    title(L("Herramientas en tu máquina", "Tools on your machine"))
    missing = [t for t in TOOLS if not shutil.which(t)]
    try:
        import yaml  # noqa: F401
    except ImportError:
        missing.append("python3-yaml")
        TOOLS["python3-yaml"] = "bin/andamio setup"
    if not missing:   # forge lee la configuración con yaml
        forge_tools = dict(line.split("\t", 1) for line in forge_out("tools").splitlines())
        TOOLS.update(forge_tools)
        missing = [t for t in forge_tools if not shutil.which(t)]
    for t in missing:
        warn(L(f"Falta {t}: {TOOLS[t]}", f"Missing {t}: {TOOLS[t]}"))
    if missing:
        die(L("Falta preparar tu máquina: corre `bin/andamio setup` (lo instala todo, preguntando antes).",
              "Your machine isn't ready yet: run `bin/andamio setup` (it installs everything, asking first)."))
    ok(L(f"git, ssh, sops, age, ansible y {', '.join(forge_tools)} disponibles",
         f"git, ssh, sops, age, ansible and {', '.join(forge_tools)} available"))
    name = forge_out("name")
    if forge("auth-ok").returncode != 0:
        die(L(f"Tu CLI de {name} no tiene sesión iniciada ({', '.join(forge_tools)}): ",
              f"Your {name} CLI isn't logged in ({', '.join(forge_tools)}): ") + next(iter(forge_tools.values())))
    ok(L(f"Sesión iniciada en {name}", f"Logged in to {name}"))


# ---------- setup: tu máquina ----------

# Paquetes del sistema por herramienta (apt / brew). gh, sops y ansible van aparte.
APT_PKGS = {"git": "git", "ssh": "openssh-client", "ssh-keygen": "openssh-client", "ssh-copy-id": "openssh-client",
            "age-keygen": "age",
            "curl": "curl", "openssl": "openssl", "pipx": "pipx"}
BREW_PKGS = {"git": "git", "age-keygen": "age", "gh": "gh", "sops": "sops", "ansible-playbook": "ansible",
             "ssh-copy-id": "ssh-copy-id"}
COLLECTIONS = ("community.sops", "ansible.posix", "community.general")


def has_yaml() -> bool:
    return run([sys.executable, "-c", "import yaml"]).returncode == 0


def missing_collections() -> list[str]:
    if not shutil.which("ansible-galaxy"):
        return list(COLLECTIONS)
    listed = run(["ansible-galaxy", "collection", "list"]).stdout
    return [c for c in COLLECTIONS if not re.search(rf"^{re.escape(c)}\s", listed, re.M)]


def install_sops() -> None:
    """La última versión oficial de sops, verificada contra el checksum de la misma release
    antes de instalarla en ~/.local/bin (sin sudo)."""
    import hashlib
    import json
    import platform
    import urllib.request
    arch = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine().lower())
    osname = "darwin" if sys.platform == "darwin" else "linux"
    if not arch:
        die(L(f"No hay sops para {platform.machine()}: instálalo a mano (https://github.com/getsops/sops/releases).",
              f"No sops build for {platform.machine()}: install it by hand (https://github.com/getsops/sops/releases)."))

    def get(url: str) -> bytes:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "andamio"}), timeout=60) as r:
            return r.read()
    tag = json.loads(get("https://api.github.com/repos/getsops/sops/releases/latest"))["tag_name"]
    name, base = f"sops-{tag}.{osname}.{arch}", f"https://github.com/getsops/sops/releases/download/{tag}/"
    sums = get(f"{base}sops-{tag}.checksums.txt").decode()
    expected = next((line.split()[0] for line in sums.splitlines() if line.endswith(f" {name}")), None)
    binary = get(base + name)
    if not expected or hashlib.sha256(binary).hexdigest() != expected:
        die(L(f"El binario de sops no coincide con su checksum oficial: no lo instalo ({name}).",
              f"The sops binary doesn't match its official checksum: not installing it ({name})."))
    dest = Path.home() / ".local" / "bin" / "sops"
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(binary)
    dest.chmod(0o755)
    ok(L(f"sops {tag} (checksum verificado) en {dest}", f"sops {tag} (checksum verified) in {dest}"))


def has_origin() -> bool:
    return run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).returncode == 0


def cmd_setup(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio setup\033[0m: deja tu máquina lista para usar andamio (una vez). Pregunta antes de instalar.",
            "\033[1mandamio setup\033[0m: gets your machine ready for andamio (once). Asks before installing."))
    # Desde el andamio público: qué quieres. Solo blindar no necesita cuentas ni repos: una copia
    # local y `andamio seguridad`. Una copia local (sin origin) que vuelve a setup: conectarla con GitHub.
    local_copy = not has_origin()
    security_only = False
    if in_public_template():
        security_only = choose(L("¿Qué quieres hacer?", "What do you want to do?"), [
            ("seguridad", L("solo blindar mi VPS: tu llave, sin contraseñas ni root, firewall (sin cuentas ni repos)",
                            "only lock down my VPS: your key, no passwords or root, firewall (no accounts or repos)")),
            ("completo", L("andamio completo: el VPS blindado más tus apps, HTTPS y backups (usa GitHub)",
                           "full andamio: the locked-down VPS plus your apps, HTTPS and backups (uses GitHub)")),
        ], "seguridad") == "seguridad"
    elif local_copy:
        note(L("Tu copia es local (de andamio seguridad): la conecto con GitHub para la plataforma.",
               "Your copy is local (from andamio security): connecting it to GitHub for the platform."))
    title(L("1. Qué falta", "1. What's missing"))
    tools = (["git", "ssh", "ssh-keygen", "ssh-copy-id", "openssl", "ansible-playbook"] if security_only else
             ["git", "ssh", "ssh-keygen", "ssh-copy-id", "age-keygen", "openssl", "gh", "sops", "ansible-playbook"])
    missing = [t for t in tools if not shutil.which(t)] + ([] if has_yaml() else ["python3-yaml"])
    if sys.platform == "darwin":
        manager = "brew" if shutil.which("brew") else None
    else:
        osr = Path("/etc/os-release").read_text() if Path("/etc/os-release").exists() else ""
        manager = "apt" if re.search(r"^ID(_LIKE)?=.*\b(debian|ubuntu)\b", osr, re.M) and shutil.which("apt-get") else None
    for t in tools:
        (warn if t in missing else ok)(L(f"{t}: falta", f"{t}: missing") if t in missing else t)
    if "python3-yaml" in missing:
        warn(L("python3-yaml: falta", "python3-yaml: missing"))

    if missing:
        if not manager:
            die(L("No sé instalar en este sistema (andamio sabe con apt —Ubuntu/Debian/WSL— y con Homebrew en macOS). "
                  f"Instala a mano: {', '.join(missing)}",
                  "I don't know how to install on this system (andamio knows apt —Ubuntu/Debian/WSL— and Homebrew on "
                  f"macOS). Install by hand: {', '.join(missing)}"))
        note(L(f"Lo instalo con {manager}" + (" (te pedirá la contraseña de sudo de ESTA máquina)" if manager == "apt" else "")
               + ". sops viene de su release oficial y se verifica contra su checksum; ansible, con pipx.",
               f"Installing with {manager}" + (" (it asks for the sudo password of THIS machine)" if manager == "apt" else "")
               + ". sops comes from its official release, verified against its checksum; ansible, via pipx."))
        if not ask_yes(L("¿Instalo lo que falta?", "Install what's missing?"), True):
            die(L("No instalé nada.", "Nothing installed."))
        title(L("2. Instalando", "2. Installing"))
        if manager == "apt":
            pkgs = sorted({APT_PKGS[t] for t in missing if t in APT_PKGS}
                          | ({"python3-yaml"} if "python3-yaml" in missing else set())
                          | ({"pipx"} if "ansible-playbook" in missing and not shutil.which("pipx") else set())
                          | ({"curl"} if "gh" in missing and not shutil.which("curl") else set()))
            if pkgs and interactive(["sudo", "apt-get", "update", "-qq"]) + \
                    interactive(["sudo", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "-qq", *pkgs]) != 0:
                die(L("apt no pudo instalar: " + " ".join(pkgs), "apt couldn't install: " + " ".join(pkgs)))
            if "gh" in missing:   # repositorio oficial de GitHub CLI (firmado con su llave)
                if interactive(["sudo", "bash", "-c", """set -e
install -d -m 755 /etc/apt/keyrings
curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg
chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gh"""]) != 0:
                    die(L("No pude instalar gh.", "Couldn't install gh."))
            if "sops" in missing:
                install_sops()
            if "ansible-playbook" in missing:
                if interactive(["pipx", "install", "--include-deps", "ansible"]) != 0:
                    die(L("pipx no pudo instalar ansible.", "pipx couldn't install ansible."))
                interactive(["pipx", "ensurepath"])
        else:
            pkgs = sorted({BREW_PKGS[t] for t in missing if t in BREW_PKGS})
            if pkgs and interactive(["brew", "install", *pkgs]) != 0:
                die(L("brew no pudo instalar: " + " ".join(pkgs), "brew couldn't install: " + " ".join(pkgs)))
            if "python3-yaml" in missing:
                interactive([sys.executable, "-m", "pip", "install", "--user", "--break-system-packages", "pyyaml"])
        still = [t for t in tools if not shutil.which(t)] + ([] if has_yaml() else ["python3-yaml"])
        if still:
            die(L(f"Sigue faltando: {', '.join(still)}", f"Still missing: {', '.join(still)}"))
        ok(L("Herramientas instaladas", "Tools installed"))

    title(L("3. Colecciones de Ansible", "3. Ansible collections"))
    need = missing_collections()
    if need:
        if interactive(["ansible-galaxy", "collection", "install", "-r", str(ROOT / "ansible" / "requirements.yml")]) != 0:
            die(L("ansible-galaxy no pudo instalar las colecciones.", "ansible-galaxy couldn't install the collections."))
    ok(", ".join(COLLECTIONS))
    if security_only:
        setup_local_copy(missing)
        return

    title(L("4. Tu identidad en git", "4. Your git identity"))
    name, email = (run(["git", "config", "--global", k]).stdout.strip() for k in ("user.name", "user.email"))
    if not (name and email):
        note(L("Para los commits que hace andamio (tu configuración, tus apps).",
               "For the commits andamio makes (your configuration, your apps)."))
        name = name or ask(L("Tu nombre", "Your name"))
        email = email or ask(L("Tu email", "Your email"), check=check_email)
        run(["git", "config", "--global", "user.name", name])
        run(["git", "config", "--global", "user.email", email])
    ok(f"{name} <{email}>")

    fname = forge_out("name")
    title(L(f"5. Tu cuenta de {fname}", f"5. Your {fname} account"))
    if forge("auth-ok").returncode != 0:
        note(L("""
Vas a iniciar sesión en GitHub. Elige SSH como protocolo y deja que suba tu llave SSH.
Si estás en WSL y no se abre el navegador: copia el código que te muestra, abre
https://github.com/login/device en tu navegador de Windows y pégalo (tienes unos minutos).""", """
You're about to log in to GitHub. Pick SSH as the protocol and let it upload your SSH key.
If you're on WSL and no browser opens: copy the code it shows, open
https://github.com/login/device in your Windows browser and paste it (you have a few minutes)."""))
        interactive(["gh", "auth", "login", "--git-protocol", "ssh"])
        if forge("auth-ok").returncode != 0:
            die(L("No quedó la sesión iniciada: vuelve a correr `bin/andamio setup`.",
                  "Not logged in yet: run `bin/andamio setup` again."))
    ok(L(f"Sesión iniciada en {fname} como {forge_out('whoami')}", f"Logged in to {fname} as {forge_out('whoami')}"))
    host = forge_out("ssh-host")
    # Las llaves de host oficiales (de la API de la forja), no "la primera que se presente".
    known = SSH_DIR / "known_hosts"
    if not run(["ssh-keygen", "-F", host]).stdout.strip():
        SSH_DIR.mkdir(mode=0o700, exist_ok=True)
        with known.open("a") as f:
            f.write(forge_out("known-hosts") + "\n")
        ok(L(f"Llaves de host oficiales de {host} en ~/.ssh/known_hosts", f"{host}'s official host keys in ~/.ssh/known_hosts"))
    probe = run(["ssh", "-T", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", f"git@{host}"])
    if "successfully authenticated" in probe.stdout + probe.stderr:
        ok(L(f"Tu llave SSH entra a {host} (andamio sube por ahí el CI de tus apps)",
             f"Your SSH key gets into {host} (andamio pushes your apps' CI through it)"))
    else:
        warn(L(f"Tu llave SSH todavía no entra a {host}. Agrégala:  gh ssh-key add ~/.ssh/id_ed25519.pub",
               f"Your SSH key can't get into {host} yet. Add it:  gh ssh-key add ~/.ssh/id_ed25519.pub"))
        note(L("(si no tienes llave: ssh-keygen -t ed25519; si gh pide permiso: gh auth refresh -s admin:public_key)",
               "(no key yet: ssh-keygen -t ed25519; if gh asks for permission: gh auth refresh -s admin:public_key)"))

    # Corriendo desde el andamio público (recién clonado): tu copia privada, desde el template.
    origin = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    upstream = re.sub(r"\.git$", "", UPSTREAM_DEFAULT.split("github.com/")[-1])
    next_dir = None
    if not UPSTREAM_DEFAULT.startswith("@") and re.search(rf"[:/]{re.escape(upstream)}(\.git)?$", origin):
        title(L("6. Tu copia privada de andamio", "6. Your private copy of andamio"))
        note(L("""
Este es el andamio público: tu configuración (cifrada) vive en una copia PRIVADA tuya,
creada desde este template. La creo y la clono.""", """
This is the public andamio: your (encrypted) configuration lives in a PRIVATE copy of
yours, created from this template. Creating and cloning it."""))
        owner = forge_out("whoami")
        repo_name = ask(L(f"Nombre de tu repo (en {owner}/)", f"Your repo's name (under {owner}/)"), "mi-andamio",
                        lambda v: None if re.fullmatch(r"[A-Za-z0-9._-]{1,100}", v) else L("Nombre inválido.", "Invalid name."))
        target = Path(ask(L("Dónde clonarlo", "Where to clone it"), str(Path.home() / repo_name))).expanduser()
        if target.exists():
            die(L(f"{target} ya existe.", f"{target} already exists."))
        full = f"{owner}/{repo_name}"
        if forge("repo-exists", full).returncode == 0:
            ok(L(f"{full} ya existe: lo clono", f"{full} already exists: cloning it"))
        else:
            r = forge("repo-create", full, upstream)
            if r.returncode != 0:
                die(L(f"No pude crear {full}: {r.stderr.strip()}", f"Couldn't create {full}: {r.stderr.strip()}"))
            ok(L(f"{full} creado (privado, desde {upstream})", f"{full} created (private, from {upstream})"))
        if interactive(["git", "clone", "-q", forge_out("clone-url", full), str(target)]) != 0:
            die(L(f"No pude clonar {full}.", f"Couldn't clone {full}."))
        ok(f"{target}")
        next_dir = target

    elif local_copy:
        connect_local_copy()
    title(L("Listo: tu máquina está preparada", "Done: your machine is ready"))
    note((f"cd {next_dir}\n" if next_dir else "") + L("Siguiente:  andamio init", "Next:  andamio init"))
    if "ansible-playbook" in missing:
        note(L("(abre una terminal nueva para que tu shell vea ~/.local/bin)",
               "(open a new terminal so your shell sees ~/.local/bin)"))


def setup_local_copy(missing: list[str]) -> None:
    """Solo blindar: tu copia de andamio en tu máquina, sin cuenta ni repo (eso, si un día quieres
    la plataforma: andamio setup desde la copia la conecta con GitHub). Y sigue con seguridad."""
    title(L("4. Tu copia de andamio", "4. Your copy of andamio"))
    note(L("""
Ahí queda la configuración de tu servidor (IP, tu usuario, el puerto). Solo en tu máquina: no
hace falta cuenta de GitHub para blindar el VPS.""", """
Your server's configuration lives there (IP, your user, the port). Only on your machine: no
GitHub account is needed to lock down the VPS."""))
    target = Path(ask(L("Dónde crearla", "Where to create it"), str(Path.home() / "mi-andamio"),
                      lambda v: L(f"{Path(v).expanduser()} ya existe.", f"{Path(v).expanduser()} already exists.")
                      if Path(v).expanduser().exists() else None)).expanduser()
    if run(["git", "clone", "-q", str(ROOT), str(target)]).returncode != 0:
        die(L(f"No pude crear {target}.", f"Couldn't create {target}."))
    # Sin origin: no es el template (ni sube nada a ningún lado). De dónde viene, para andamio update.
    run(["git", "-C", str(target), "remote", "remove", "origin"])
    head = run(["git", "-C", str(ROOT), "rev-parse", "HEAD"]).stdout.strip()
    (target / ".andamio").mkdir(exist_ok=True)
    (target / ".andamio" / "upstream").write_text(f"url {UPSTREAM_DEFAULT}\ncommit {head}\n")
    ok(f"{target}")
    title(L("Listo: tu máquina está preparada", "Done: your machine is ready"))
    if "ansible-playbook" in missing:   # pipx lo dejó en ~/.local/bin: que este proceso lo vea
        os.environ["PATH"] = f"{Path.home() / '.local' / 'bin'}:{os.environ.get('PATH', '')}"
    if ask_yes(L("¿Blindo tu VPS ahora? (andamio seguridad)", "Lock down your VPS now? (andamio security)"), True):
        os.chdir(target)
        os.execv(str(target / "bin" / "andamio"), [str(target / "bin" / "andamio"), L("seguridad", "security")])
    note(L(f"Cuando quieras:  cd {target} && andamio seguridad", f"Whenever you want:  cd {target} && andamio security"))


def connect_local_copy() -> None:
    """La copia local de andamio seguridad pasa a tener su repo privado en la forja (para init y
    servidor): se crea vacío y se sube la copia tal cual, con su configuración."""
    name = forge_out("name")
    title(L(f"6. Tu copia en {name}", f"6. Your copy on {name}"))
    note(L(f"""
Tu configuración (y después tus secretos, cifrados) vive en un repo PRIVADO tuyo: el servidor
se configura desde ahí. Lo creo vacío y subo tu copia, con lo que ya hiciste.""", f"""
Your configuration (and later your secrets, encrypted) lives in a PRIVATE repo of yours: the
server is configured from there. Creating it empty and pushing your copy, with what you've done."""))
    owner = forge_out("whoami")
    repo_name = ask(L(f"Nombre de tu repo (en {owner}/)", f"Your repo's name (under {owner}/)"), ROOT.name,
                    lambda v: L("Nombre inválido.", "Invalid name.") if not re.fullmatch(r"[A-Za-z0-9._-]{1,100}", v)
                    else L(f"{owner}/{v} ya existe: elige otro nombre.", f"{owner}/{v} already exists: pick another name.")
                    if forge("repo-exists", f"{owner}/{v}").returncode == 0 else None)
    full = f"{owner}/{repo_name}"
    r = forge("repo-create-empty", full)
    if r.returncode != 0:
        die(L(f"No pude crear {full}: {r.stderr.strip()}", f"Couldn't create {full}: {r.stderr.strip()}"))
    ok(L(f"{full} creado (privado)", f"{full} created (private)"))
    run(["git", "-C", str(ROOT), "remote", "add", "origin", forge_out("clone-url", full)])
    run(["git", "-C", str(ROOT), "add", "-A"])
    if run(["git", "-C", str(ROOT), "diff", "--cached", "--quiet"]).returncode != 0:
        run(["git", "-C", str(ROOT), "commit", "-qm", "andamio: mi servidor (blindado con andamio seguridad)"])
    if interactive(["git", "-C", str(ROOT), "push", "-q", "-u", "origin", "HEAD:main"]) != 0:
        die(L(f"No pude subir tu copia a {full}: vuelve a correr `andamio setup`.",
              f"Couldn't push your copy to {full}: run `andamio setup` again."))
    ok(L(f"Tu copia está en {full}", f"Your copy is on {full}"))


def questions(pre: dict | None = None) -> dict:
    """Las preguntas de init. `pre`: lo que ya dejó `andamio seguridad` (IP, usuario, puerto),
    que no se vuelve a preguntar."""
    pre = pre or {}
    title(L("2. Tu servidor", "2. Your server"))
    if pre.get("andamio_server_ip"):
        a = {"ip": str(pre["andamio_server_ip"])}
        ok(L(f"IP del VPS: {a['ip']} (de andamio seguridad)", f"VPS IP: {a['ip']} (from andamio security)"))
    else:
        note(L("""
La IP pública del VPS que compraste (la ves en el panel de tu proveedor).""", """
The public IP of the VPS you bought (shown in your provider's dashboard)."""))
        a = {"ip": ask(L("IP del VPS", "VPS IP"), check=check_ip)}

    title(L("3. Tu dominio", "3. Your domain"))
    note(L("""
andamio publica cada app como <app>.tudominio. En el DNS de tu dominio necesitas dos
registros A apuntando a la IP del VPS: uno para el dominio y otro para *.dominio.""", """
andamio publishes each app as <app>.yourdomain. Your domain's DNS needs two A records
pointing to the VPS's IP: one for the domain and one for *.domain."""))
    a["domain"] = ask(L("Dominio", "Domain"), check=check_domain).lower()
    apex, wild = resolves_to(a["domain"]), resolves_to(f"andamio-check.{a['domain']}")
    if a["ip"] in apex and a["ip"] in wild:
        ok(L(f"{a['domain']} y *.{a['domain']} ya apuntan a {a['ip']}",
             f"{a['domain']} and *.{a['domain']} already point to {a['ip']}"))
    else:
        nothing = L("nada", "nothing")
        warn(f"{a['domain']} -> {', '.join(apex) or nothing}; *.{a['domain']} -> {', '.join(wild) or nothing}")
        note(L(f"""
Crea en tu DNS:  A  {a['domain']}  ->  {a['ip']}   y   A  *.{a['domain']}  ->  {a['ip']}
Sin eso no habrá certificados HTTPS. Puedes seguir y corregirlo antes de preparar el servidor.""", f"""
Create in your DNS:  A  {a['domain']}  ->  {a['ip']}   and   A  *.{a['domain']}  ->  {a['ip']}
Without them there will be no HTTPS certificates. You can go on and fix it before setting up the server."""))

    title(L("4. Acceso seguro", "4. Secure access"))
    if pre.get("andamio_user") and pre.get("andamio_ssh_port"):
        a["user"], a["port"] = str(pre["andamio_user"]), str(pre["andamio_ssh_port"])
        ok(L(f"Tu usuario '{a['user']}' y SSH en el {a['port']} (de andamio seguridad)",
             f"Your user '{a['user']}' and SSH on {a['port']} (from andamio security)"))
    else:
        a["user"], a["port"] = ask_access()

    name, host = forge_out("name"), forge_out("ssh-host")
    title(f"5. {name}")
    note(L(f"""
Tus apps viven en repos de {name} y sus imágenes en {forge_out('registry-name')}. El CI construye y despliega.""", f"""
Your apps live in {name} repos and their images in {forge_out('registry-name')}. CI builds and deploys."""))
    login = forge("whoami").stdout.strip()
    a["owner"] = ask(L(f"Usuario u organización de {name}", f"{name} user or organization"), login or None)
    remote = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    m = re.search(rf"{re.escape(host)}[:/]([^/]+/[^/.]+)", remote)
    a["repo"] = ask(L("Repo de esta configuración (dueño/nombre)", "This configuration's repo (owner/name)"),
                    m.group(1) if m else None,
                    lambda v: None if re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+", v)
                    else L("Formato dueño/nombre.", "Format: owner/name."))

    title("6. HTTPS")
    note(L("""
http (recomendado para empezar): un certificado de Let's Encrypt por app; funciona con
  cualquier DNS. Los nombres de tus apps (también las privadas) quedan en los registros
  públicos de certificados.
cloudflare: un solo certificado comodín; no publica los nombres. Necesita el DNS del
  dominio en Cloudflare y un token con permiso Zone:DNS:Edit para esa zona.
custom: tu propio certificado (de una CA comercial, o un Origin Certificate de Cloudflare).
  Nadie lo renueva solo: Grafana avisa antes de que venza y lo reemplazas con
  andamio certificado.""", """
http (recommended to start): one Let's Encrypt certificate per app; works with any DNS.
  Your apps' names (private ones too) end up in the public certificate logs.
cloudflare: a single wildcard certificate; names stay unpublished. Needs the domain's DNS
  on Cloudflare and a token with Zone:DNS:Edit permission for that zone.
custom: your own certificate (from a commercial CA, or a Cloudflare Origin Certificate).
  Nobody renews it for you: Grafana warns before it expires and you replace it with
  andamio certificate."""))
    a["tls"] = choose(L("Modo de HTTPS", "HTTPS mode"), [
        ("http", L("Let's Encrypt, un certificado por app (recomendado para empezar)",
                   "Let's Encrypt, one certificate per app (recommended to start)")),
        ("cloudflare", L("Let's Encrypt comodín (necesita un token de Cloudflare)",
                         "Let's Encrypt wildcard (needs a Cloudflare token)")),
        ("custom", L("tu propio certificado (te pide los archivos)", "your own certificate (asks for the files)")),
    ], "http")
    a["cf_token"] = (ask_secret(L("Token de Cloudflare (no se ve al escribir)", "Cloudflare token (hidden while typing)"),
                                cloudflare_token_problem)
                     if a["tls"] == "cloudflare" else "")
    if a["cf_token"]:
        ok(L("Token de Cloudflare activo", "Cloudflare token active"))
    a["cert"], a["key"] = ask_cert(a["domain"]) if a["tls"] == "custom" else (None, None)
    a["email"] = ("" if a["tls"] == "custom" else
                  ask(L("Email para Let's Encrypt (avisos de certificados)", "Email for Let's Encrypt (certificate notices)"),
                      check=check_email))

    title(L("7. Módulos", "7. Modules"))
    note(L("""
Monitoreo: "auto" elige según la RAM del VPS (completo con 3 GB o más: métricas, logs,
  Grafana con alertas y Uptime Kuma; mínimo: solo métricas, ~115 MiB).
Backups: después de preparar el servidor, con andamio backups (B2 o S3, guiado).
  Sin backups, tus datos solo viven en el VPS. Alertas por Telegram: se activan después.""", """
Monitoring: "auto" picks by the VPS's RAM (completo with 3 GB or more: metrics, logs,
  Grafana with alerts and Uptime Kuma; minimo: metrics only, ~115 MiB).
Backups: after setting up the server, with andamio backups (B2 or S3, guided).
  Without backups, your data only lives on the VPS. Telegram alerts: turned on later."""))
    a["monitoring"] = choose(L("Monitoreo", "Monitoring"), [
        ("auto", L("según la RAM del VPS (recomendado)", "depending on the VPS's RAM (recommended)")),
        ("minimo", L("solo métricas, ~115 MiB", "metrics only, ~115 MiB")),
        ("completo", L("métricas, logs, Grafana con alertas, Uptime Kuma (3 GB+)",
                       "metrics, logs, Grafana with alerts, Uptime Kuma (3 GB+)")),
    ], "auto")
    return a


def age_recipient() -> str:
    title(L("8. Llave de cifrado (age)", "8. Encryption key (age)"))
    if AGE_KEY.exists():
        ok(L(f"Uso tu llave existente: {AGE_KEY}", f"Using your existing key: {AGE_KEY}"))
    else:
        AGE_KEY.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        r = run(["age-keygen", "-o", str(AGE_KEY)])
        if r.returncode != 0:
            die(L(f"age-keygen falló: {r.stderr.strip()}", f"age-keygen failed: {r.stderr.strip()}"))
        AGE_KEY.chmod(0o600)
        ok(L(f"Llave creada: {AGE_KEY} (solo tú la puedes leer)", f"Key created: {AGE_KEY} (only you can read it)"))
        warn(L("Guárdala también en tu gestor de contraseñas: sin ella no se pueden descifrar tus secretos.",
               "Also keep it in your password manager: without it your secrets can't be decrypted."))
    pub = run(["age-keygen", "-y", str(AGE_KEY)]).stdout.strip()
    if not pub.startswith("age1"):
        die(L("No pude leer la llave pública de age.", "Couldn't read the age public key."))
    return pub


def write_if_missing(path: Path, content: str, mode: int = 0o644) -> bool:
    rel = path.relative_to(ROOT)
    if path.exists():
        warn(L(f"{rel} ya existe: no lo toco", f"{rel} already exists: leaving it alone"))
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)
    ok(f"{rel}")
    return True


def ask_access(provider_user: str | None = None) -> tuple[str, str]:
    """El usuario de operación y el puerto SSH nuevo (init y seguridad). Con `provider_user`, el
    nuevo tiene que ser distinto (el del proveedor tiene la sesión abierta durante el bootstrap)."""
    note(L("""
andamio crea un usuario propio (root deja de poder entrar), SSH solo con llave y en un
puerto distinto del 22 (menos ruido de bots que prueban contraseñas).""", """
andamio creates your own user (root can no longer log in), SSH with keys only, on a port
other than 22 (less noise from bots guessing passwords)."""))
    if provider_user:
        note(L(f"""
'{provider_user}' sigue existiendo (y sirve desde la consola web de tu proveedor), pero deja de
entrar por SSH: desde ahora entras con el usuario nuevo.""", f"""
'{provider_user}' keeps existing (and works from your provider's web console), but can no longer
log in over SSH: from now on you log in with the new user."""))
    user = ask(L("Nombre del usuario de Linux que andamio crea para ti en el servidor (entras con él; "
                 "distinto del que te dio el proveedor)",
                 "Name of the Linux user andamio creates for you on the server (you log in with it; "
                 "not the one your provider gave you)"),
               "andamio" if provider_user != "andamio" else "operador",
               lambda v: check_user(v) or (L(f"Tiene que ser distinto de '{provider_user}', el de tu proveedor.",
                                             f"It must differ from '{provider_user}', your provider's.")
                                           if v == provider_user else None))
    note(L("""
El puerto SSH nuevo: Enter acepta el sugerido (al azar, no lo que prueban los bots). Si tu
proveedor tiene firewall (Azure, AWS, Oracle, Google Cloud), ahí vas a abrir este mismo número.""", """
The new SSH port: Enter takes the suggested one (random, not what bots try). If your provider
has a firewall (Azure, AWS, Oracle, Google Cloud), that's where you'll open this same number."""))
    port = ask(L("Puerto SSH", "SSH port"), str(secrets.choice(range(20000, 30000))), check_port)
    return user, port


def is_partial_config() -> bool:
    """¿La configuración es solo la de `andamio seguridad` (sin dominio ni repo)?"""
    return CONFIG.exists() and "andamio_server_ip:" in CONFIG.read_text() and "andamio_repo:" not in CONFIG.read_text()


def write_config(a: dict, recipient: str, pre: dict | None = None) -> None:
    title(L("9. Configuración", "9. Configuration"))
    write_if_missing(SOPS_CONFIG, L(f"""# Secretos cifrados con sops + age. La llave privada vive solo en tu máquina
# ({AGE_KEY}) y en tu gestor de contraseñas.
""", f"""# Secrets encrypted with sops + age. The private key lives only on your machine
# ({AGE_KEY}) and in your password manager.
""") + f"""creation_rules:
  - path_regex: \\.sops(\\.env)?$
    age: {recipient}
""")
    c = {k: L(es, en) for k, (es, en) in {
        "head": ("# Configuración de este servidor (generada por andamio init). Lo único propio:\n"
                 "# roles, plantillas y scripts la leen de aquí.",
                 "# This server's configuration (generated by andamio init). The only thing that's yours:\n"
                 "# roles, templates and scripts read it from here."),
        "user": ("usuario de operación (SSH, docker)", "operator user (SSH, docker)"),
        "hostkey": ("la completa andamio servidor al conectar por primera vez",
                    "filled in by andamio server on first connection"),
        "forge": ("dónde viven tus repos (bin/forge)", "where your repos live (bin/forge)"),
        "registry": ("registro de las imágenes de tus apps", "registry for your apps' images"),
        "backups": ("se activa con andamio backups", "turned on by andamio backups"),
        "telegram": ("se activa con su configuración (bot y chat)", "turned on with its configuration (bot and chat)"),
    }.items()}
    pre = pre or {}
    if pre:   # la de `andamio seguridad`: se reescribe completa, con lo que ya tenía
        CONFIG.unlink()
    host_key = pre.get("andamio_ssh_host_key") or ""
    write_if_missing(CONFIG, f"""{c['head']}
andamio_user: {a['user']}              # {c['user']}
andamio_uid: {pre.get('andamio_uid') or 1001}
andamio_ssh_port: {a['port']}
andamio_ssh_host_key: "{host_key}"{'' if host_key else '           # ' + c['hostkey']}
andamio_server_ip: {a['ip']}
andamio_hostname: {a['domain'].split('.')[0]}
andamio_domain: {a['domain']}
andamio_tls: {a['tls']}
andamio_acme_email: "{a['email']}"
andamio_forge: {forge_out('name').lower()}              # {c['forge']}
andamio_registry: {forge_out('registry')}          # {c['registry']}
andamio_github_owner: {a['owner']}
andamio_repo: git@github-andamio:{a['repo']}.git
andamio_monitoring: {a['monitoring']}
andamio_backups: false              # {c['backups']}
andamio_telegram: false             # {c['telegram']}
""")


def encrypt(path: Path, values: dict[str, str]) -> None:
    """Cifra un .env con sops. El texto en claro vive solo en una carpeta 0700 y se borra."""
    rel = path.relative_to(ROOT)
    if path.exists():
        warn(L(f"{rel} ya existe: no lo toco", f"{rel} already exists: leaving it alone"))
        return
    tmp = Path(tempfile.mkdtemp(prefix="andamio-"))
    plain = tmp / "secrets.env"
    try:
        plain.write_text("".join(f"{k}={v}\n" for k, v in values.items()))
        plain.chmod(0o600)
        r = run(["sops", "encrypt", "--input-type", "dotenv", "--output-type", "dotenv",
                 "--filename-override", str(rel), str(plain)], cwd=ROOT)
        if r.returncode != 0:
            die(L(f"sops no pudo cifrar {rel}: {r.stderr.strip()}", f"sops couldn't encrypt {rel}: {r.stderr.strip()}"))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(r.stdout)
        ok(L(f"{rel} (cifrado)", f"{rel} (encrypted)"))
    finally:
        plain.write_bytes(b"\0" * 256)
        shutil.rmtree(tmp, ignore_errors=True)


def write_secrets(a: dict) -> None:
    title(L("10. Secretos de la plataforma (contraseñas aleatorias, cifradas)",
            "10. Platform secrets (random passwords, encrypted)"))
    pw = lambda: secrets.token_urlsafe(32).replace("-", "").replace("_", "")[:40]  # noqa: E731
    encrypt(ROOT / "stacks/proxy/secrets.sops.env", {"CF_DNS_API_TOKEN": a["cf_token"]})
    encrypt(ROOT / "stacks/data/secrets.sops.env",
            {"POSTGRES_USER": "andamio", "POSTGRES_PASSWORD": pw(), "REDIS_PASSWORD": pw(), "MARIADB_ROOT_PASSWORD": pw()})
    encrypt(ROOT / "stacks/monitoring/secrets.sops.env",
            {"DOMAIN": a["domain"], "GF_ADMIN_PASSWORD": pw(), "TELEGRAM_TOKEN": "", "TELEGRAM_CHAT_ID": ""})
    for stack in ("uptime-kuma", "whoami"):
        encrypt(ROOT / f"stacks/{stack}/secrets.sops.env", {"DOMAIN": a["domain"]})
    note(L("""
La contraseña de Grafana (usuario admin):  sops decrypt stacks/monitoring/secrets.sops.env""", """
Grafana's password (user admin):  sops decrypt stacks/monitoring/secrets.sops.env"""))


def in_public_template() -> bool:
    """¿Este repo es un clon del andamio público (no tu copia privada)?"""
    if UPSTREAM_DEFAULT.startswith("@"):
        return False
    origin = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    upstream = re.sub(r"\.git$", "", UPSTREAM_DEFAULT.split("github.com/")[-1])
    return bool(re.search(rf"[:/]{re.escape(upstream)}(\.git)?$", origin))


def refuse_public_template() -> None:
    """Tu configuración nunca va en el template público (lo verían todos)."""
    if in_public_template():
        die(L("Este es el andamio público (el template): tu configuración no va aquí, iría a un repo "
              "que ve todo el mundo. Corre `bin/andamio setup`: crea tu copia privada y te dice a dónde ir.",
              "This is the public andamio (the template): your configuration doesn't go here, it would "
              "end up in a repo everyone sees. Run `bin/andamio setup`: it creates your private copy "
              "and tells you where to go."))


def cmd_init(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio init\033[0m: prepara la configuración de tu VPS (parte 1, solo en tu máquina).",
            "\033[1mandamio init\033[0m: prepares your VPS's configuration (part 1, only on your machine)."))
    refuse_public_template()
    if not has_origin():
        die(L("Tu copia es local (de andamio seguridad): para la plataforma, primero `andamio setup` la conecta "
              "con GitHub. Después, andamio init.",
              "Your copy is local (from andamio security): for the platform, `andamio setup` first connects it "
              "to GitHub. Then andamio init."))
    partial = is_partial_config()
    if CONFIG.exists() and "andamio_server_ip:" in CONFIG.read_text() and not args.force and not partial:
        die(L(f"Ya hay una configuración en {CONFIG.relative_to(ROOT)}. No la sobreescribo (usa --force para "
              "completar lo que falte; lo existente se respeta igual).",
              f"There's already a configuration in {CONFIG.relative_to(ROOT)}. I won't overwrite it (use "
              "--force to fill in what's missing; existing files are kept anyway)."))
    check_tools()
    import yaml
    pre = (yaml.safe_load(CONFIG.read_text()) or {}) if partial else {}
    if partial:
        ok(L("Tu servidor ya está blindado (andamio seguridad): completo lo que falta para la plataforma",
             "Your server is already locked down (andamio security): filling in what the platform needs"))
    a = questions(pre)
    recipient = age_recipient()
    write_config(a, recipient, pre)
    write_secrets(a)
    if a["tls"] == "custom":
        title(L("11. Tu certificado", "11. Your certificate"))
        install_cert(a["cert"], a["key"])
    title(L("Listo. Próximos pasos", "Done. Next steps"))
    note(L(f"""
1. Sube tu configuración (va cifrada):
     git add -A && git commit -m "andamio: mi servidor" && git push

2. Si tu proveedor tiene firewall propio (Azure, AWS, Oracle, Google Cloud, y a veces
   Hetzner o DigitalOcean), ábrele estos puertos de entrada ANTES del paso 3:
     TCP {a['port']} (tu SSH nuevo), 80 y 443 (web)   ·   UDP 51820 (VPN)
   Deja también el 22 abierto hasta terminar: andamio entra primero por ahí.
   Si no lo haces, al mover SSH a tu puerto quedarías fuera del servidor.

3. Prepara el servidor:
     andamio servidor""", f"""
1. Push your configuration (it's encrypted):
     git add -A && git commit -m "andamio: my server" && git push

2. If your provider has its own firewall (Azure, AWS, Oracle, Google Cloud, sometimes
   Hetzner or DigitalOcean), open these inbound ports in it BEFORE step 3:
     TCP {a['port']} (your new SSH), 80 and 443 (web)   ·   UDP 51820 (VPN)
   Also keep 22 open until the end: andamio first gets in through it.
   Otherwise, once SSH moves to your port, you'd be locked out of the server.

3. Set up the server:
     andamio server"""))


# ================= parte 2: el servidor =================

def load_config() -> dict:
    import yaml
    refuse_public_template()
    if not CONFIG.exists():
        die(L("Falta la configuración: corre primero `andamio init`.", "No configuration yet: run `andamio init` first."))
    if is_partial_config():
        die(L("Esta copia solo tiene el blindaje (andamio seguridad). Para montar la plataforma: "
              "`andamio init` (completa lo que falta) y después `andamio servidor`.",
              "This copy only has the lockdown (andamio security). To set up the platform: "
              "`andamio init` (fills in what's missing) and then `andamio server`."))
    cfg = yaml.safe_load(CONFIG.read_text()) or {}
    for k in ("andamio_user", "andamio_ssh_port", "andamio_server_ip", "andamio_repo", "andamio_github_owner"):
        if not cfg.get(k):
            die(L(f"Falta {k} en {CONFIG.relative_to(ROOT)}.", f"{k} is missing in {CONFIG.relative_to(ROOT)}."))
    announce_server(cfg)
    return cfg


_ANNOUNCED = False


def announce_server(cfg: dict) -> None:
    """Con varios servidores, a cuál va este comando (lo decide la carpeta donde estás)."""
    global _ANNOUNCED
    if _ANNOUNCED or len(known_copies()) < 2:
        return
    _ANNOUNCED = True
    print(f"\033[2m→ {L('Servidor', 'Server')}: {cfg.get('andamio_domain') or L('sin dominio', 'no domain')} ({cfg.get('andamio_server_ip')}) · "
          f"{L('copia', 'copy')} {ROOT}   ({L('otro', 'another')}: cd {L('a su carpeta', 'into its folder')}, "
          f"{L('o', 'or')} andamio use)\033[0m")


def set_config(key: str, value: str) -> None:
    """Cambia una línea de la configuración (o la agrega si no está)."""
    text = CONFIG.read_text()
    line = f'{key}: "{value}"'
    new, n = re.subn(rf"^{re.escape(key)}:.*$", line, text, flags=re.M)
    CONFIG.write_text(new if n else text.rstrip("\n") + "\n" + line + "\n")


def ssh_ok(target: list[str]) -> bool:
    """¿Entra por SSH sin pedir nada? (solo llave, sin preguntar huellas)."""
    r = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=yes", *target, "true"])
    return r.returncode == 0


def push_copy() -> int:
    """Sube tu copia. Si GitHub tiene commits que tu copia no (un PR mergeado allá, Dependabot), los
    trae y pone los tuyos encima, y vuelve a subir. Si chocan, deshace el intento (no adivina)."""
    git = ["git", "-C", str(ROOT)]
    if run([*git, "push", "-q"]).returncode == 0:
        return 0
    note(L("  GitHub tiene cambios que tu copia no: los traigo y pongo los tuyos encima",
           "  GitHub has changes your copy doesn't: fetching them and putting yours on top"))
    if run([*git, "pull", "-q", "--rebase"]).returncode != 0:
        run([*git, "rebase", "--abort"])
        warn(L(f"Tu copia y GitHub cambiaron lo mismo: resuélvelo en {ROOT} (git pull).",
               f"Your copy and GitHub changed the same thing: resolve it in {ROOT} (git pull)."))
        return 1
    return interactive([*git, "push", "-q"])


def interactive(cmd: list[str], **kw) -> int:
    """Corre un comando que habla con la persona (contraseñas, confirmaciones)."""
    sys.stdout.flush()   # lo que andamio ya imprimió va antes que lo del comando
    return subprocess.run(cmd, check=False, **kw).returncode


_SUDO_FILE: Path | None = None
# Recordar la contraseña entre comandos (como sudo): solo en memoria ($XDG_RUNTIME_DIR es
# tmpfs, privado y se borra al cerrar sesión), nunca en disco; vence tras N minutos sin uso.
# Cuánto: lo eliges en el panel (Ajustes) y queda en ~/.config/andamio/ajustes.json, una
# preferencia de esta máquina (no del repo). ANDAMIO_SUDO_MINUTES manda si está. Por defecto, 15.
SUDO_CHOICES = (15, 60, 240, 480)
LOCAL_SETTINGS = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "andamio" / "ajustes.json"


def local_settings() -> dict:
    import json
    try:
        return json.loads(LOCAL_SETTINGS.read_text()) or {}
    except (OSError, ValueError):
        return {}


def sudo_minutes() -> int:
    env = os.environ.get("ANDAMIO_SUDO_MINUTES")
    if env and env.lstrip("-").isdigit():
        return int(env)
    v = local_settings().get("sudo_minutes")
    return v if v in SUDO_CHOICES else 15


def set_sudo_minutes(minutes: int) -> None:
    import json
    data = {**local_settings(), "sudo_minutes": minutes}
    LOCAL_SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    LOCAL_SETTINGS.write_text(json.dumps(data, indent=2) + "\n")


def human_minutes(m: int) -> str:
    return f"{m // 60} h" if m >= 60 and m % 60 == 0 else f"{m} min"
SUDO_CACHE = Path(os.environ["XDG_RUNTIME_DIR"]) / "andamio" if os.environ.get("XDG_RUNTIME_DIR") else None


def sudo_cache_file(cfg: dict) -> Path | None:
    if not SUDO_CACHE or sudo_minutes() <= 0:
        return None
    import hashlib
    key = hashlib.sha256(f"{cfg['andamio_user']}@{cfg['andamio_server_ip']}".encode()).hexdigest()[:16]
    return SUDO_CACHE / f"sudo-{key}"


def sudo_remembered(cfg: dict, alias: str) -> str | None:
    """La contraseña recordada, si no venció y el servidor la sigue aceptando."""
    f = sudo_cache_file(cfg)
    try:
        if not f or not f.is_file() or time.time() - f.stat().st_mtime > sudo_minutes() * 60:
            forget_sudo(f)
            return None
        pw = f.read_text()
    except OSError:
        return None
    if remote(alias, "sudo -S -p '' -v", stdin=pw + "\n").returncode != 0:
        forget_sudo(f)   # la cambiaste en el servidor: se pide de nuevo
        return None
    f.touch()   # el plazo cuenta desde el último uso
    return pw


def remember_sudo(cfg: dict, pw: str) -> None:
    f = sudo_cache_file(cfg)
    if not f:
        return
    try:
        f.parent.mkdir(mode=0o700, exist_ok=True)
        f.parent.chmod(0o700)
        fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as out:
            out.write(pw)
    except OSError:
        pass


def forget_sudo(f: Path | None = None) -> None:
    """Borra la contraseña recordada (una, o todas si no se indica)."""
    for p in ([f] if f else list(SUDO_CACHE.glob("sudo-*")) if SUDO_CACHE and SUDO_CACHE.is_dir() else []):
        try:
            p.write_text("\0" * 64)
            p.unlink()
        except OSError:
            pass


def sudo_password_file(cfg: dict, alias: str) -> Path:
    """La contraseña de sudo de TU usuario: se pide una vez, se verifica contra el
    servidor y Ansible la lee de un archivo privado (0600) que se borra al salir.
    Nunca va en la línea de comandos. Se recuerda unos minutos (sudo_remembered)."""
    global _SUDO_FILE
    if _SUDO_FILE:
        return _SUDO_FILE
    pw = sudo_remembered(cfg, alias)
    if pw is not None:
        ok(L(f"Contraseña de sudo recordada (vence a los {human_minutes(sudo_minutes())} sin uso; andamio olvidar la borra)",
             f"Sudo password remembered (expires after {human_minutes(sudo_minutes())} idle; andamio forget wipes it)"))
        return sudo_temp_file(pw)
    user = cfg["andamio_user"]
    note(L(f"""
andamio necesita la contraseña de sudo de tu usuario '{user}' en el servidor
({cfg['andamio_server_ip']}): la que le pusiste al crearlo (si lo creó andamio, fue en su
paso 3, donde se pidió dos veces). Se pide una sola vez para todo lo que sigue.""", f"""
andamio needs the sudo password of your user '{user}' on the server
({cfg['andamio_server_ip']}): the one you set when it was created (if andamio created it,
that was in its step 3, where it was asked twice). It's asked only once for everything that follows."""))
    for intento in range(3):
        pw = getpass.getpass(L(f"  Contraseña de sudo de '{user}': ", f"  Sudo password for '{user}': "))
        if remote(alias, "sudo -S -p '' -v", stdin=pw + "\n").returncode == 0:
            ok(L("Contraseña correcta", "Password correct"))
            remember_sudo(cfg, pw)
            return sudo_temp_file(pw)
        warn(L(f"No es la contraseña de sudo de '{user}' ({2 - intento} intentos más).",
               f"That's not the sudo password for '{user}' ({2 - intento} more tries)."))
    die(L(f"No pude verificar la contraseña de '{user}'. Si la perdiste: entra con la consola web de tu "
          f"proveedor como root y cámbiala con `passwd {user}`.",
          f"Couldn't verify the password for '{user}'. If you lost it: log in as root through your "
          f"provider's web console and change it with `passwd {user}`."))


def sudo_temp_file(pw: str) -> Path:
    """El archivo que lee Ansible (ANSIBLE_BECOME_PASSWORD_FILE): privado y de este comando."""
    global _SUDO_FILE
    tmp = Path(tempfile.mkdtemp(prefix="andamio-sudo-"))
    _SUDO_FILE = tmp / "become"
    fd = os.open(_SUDO_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(pw)
    return _SUDO_FILE


def wipe_sudo() -> None:
    if _SUDO_FILE:
        _SUDO_FILE.write_text("\0" * 64)
        shutil.rmtree(_SUDO_FILE.parent, ignore_errors=True)


def remote_sudo(cfg: dict, alias: str, cmd: str) -> int:
    """Corre un comando con sudo en el servidor, mostrando su salida en vivo. La contraseña
    (ya verificada) entra por stdin, nunca en la línea de comandos. sudo limpia el entorno:
    el idioma se pasa explícito."""
    pw = sudo_password_file(cfg, alias).read_text()
    return subprocess.run(["ssh", "-o", "BatchMode=yes", alias, f"sudo -S -p '' env ANDAMIO_LANG={LANG} {cmd}"],
                          input=pw + "\n", text=True, check=False).returncode


ANSIBLE_LOG = Path(tempfile.gettempdir()) / "andamio-ansible.log"


def run_playbook(args: list[str], env: dict | None = None) -> int:
    """ansible-playbook sin su salida cruda (en español y de cientos de líneas): el log
    completo va a ANSIBLE_LOG y aquí se ve una línea de progreso, el resumen y, si falla,
    la tarea que falló con su error. ANDAMIO_VERBOSE=1: la salida tal cual."""
    cmd = ["ansible-playbook", *args]
    if os.environ.get("ANDAMIO_VERBOSE"):
        return interactive(cmd, cwd=ROOT / "ansible", env=env)
    sys.stdout.flush()
    tasks = changed = 0
    task, failure, recap = "", [], ""
    tty = sys.stdout.isatty()
    # Desde el panel (sin terminal): una línea cada 10 tareas, para que se vea avanzar.
    lines = not tty and os.environ.get("ANDAMIO_ASSUME") == "default"
    with ANSIBLE_LOG.open("a") as log:
        log.write(f"\n===== {' '.join(cmd)}\n")
        p = subprocess.Popen(cmd, cwd=ROOT / "ansible", env=env, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in p.stdout:
            log.write(line)
            if line.startswith(("TASK [", "RUNNING HANDLER [")):
                tasks += 1
                task = line.split("[", 1)[1].rsplit("]", 1)[0]
                if tty:
                    sys.stdout.write(f"\r  \033[2m… {tasks} {L('tareas', 'tasks')}\033[0m\033[K")
                    sys.stdout.flush()
                elif lines and tasks % 10 == 0:
                    print(f"  … {tasks} {L('tareas', 'tasks')} · {task}", flush=True)
            elif line.startswith("changed:"):
                changed += 1
            elif line.startswith(("fatal:", "failed:")) or ("UNREACHABLE!" in line):
                failure = [task, line.rstrip()]
            elif failure and len(failure) < 25 and line.strip() and not line.startswith(("TASK [", "PLAY ")):
                failure.append(line.rstrip())
            elif " : ok=" in line:
                recap = line
        rc = p.wait()
    if tty:
        sys.stdout.write("\r\033[K")
    if rc == 0:
        ok(L(f"{tasks} tareas, {changed} cambios", f"{tasks} tasks, {changed} changes"))
    else:
        import json
        warn(L(f"Falló la tarea: {failure[0] if failure else task}", f"Failed task: {failure[0] if failure else task}"))
        for x in failure[1:]:
            if " : ok=" in x:
                continue
            # "fatal: [host]: FAILED! => {...}": de ese JSON, solo lo que se lee (msg, stderr).
            detail = None
            if "=> {" in x:
                try:
                    d = json.loads(x.split("=> ", 1)[1])
                    detail = [str(d[k]).strip() for k in ("msg", "stderr", "module_stderr") if d.get(k)]
                except ValueError:
                    pass
            for y in (detail or [x])[:3]:
                print(f"    \033[2m{y[:400]}\033[0m")
        note(L(f"Log completo: {ANSIBLE_LOG}", f"Full log: {ANSIBLE_LOG}"))
    return rc


def ansible(args: list[str], cfg: dict, alias: str) -> int:
    """ansible-playbook con la contraseña de sudo ya verificada (sin prompt genérico)."""
    env = dict(os.environ, ANSIBLE_BECOME_PASSWORD_FILE=str(sudo_password_file(cfg, alias)))
    return run_playbook(args, env)


def new_sudo_password(user: str) -> str:
    """La contraseña nueva del usuario de operación: oculta, dos veces, mínimo 12 caracteres.
    Devuelve su hash (SHA-512, el formato de /etc/shadow): la contraseña no sale de aquí."""
    for _ in range(3):
        pw = getpass.getpass(L(f"  Contraseña nueva para '{user}' (mínimo 12 caracteres, no se ve): ",
                               f"  New password for '{user}' (at least 12 characters, hidden): "))
        if len(pw) < 12:
            warn(L("Muy corta: al menos 12 caracteres.", "Too short: at least 12 characters."))
            continue
        if getpass.getpass(L("  Otra vez, para confirmar: ", "  Once more, to confirm: ")) != pw:
            warn(L("No coinciden.", "They don't match."))
            continue
        r = run(["openssl", "passwd", "-6", "-stdin"], input=pw + "\n")
        if r.returncode != 0 or not r.stdout.startswith("$6$"):
            die(L("openssl no pudo cifrar la contraseña.", "openssl couldn't hash the password."))
        ok(L("Contraseña lista (guárdala en tu gestor)", "Password set (keep it in your password manager)"))
        return r.stdout.strip()
    die(L("No quedó definida la contraseña: vuelve a correr el comando.", "The password wasn't set: run the command again."))


def step_local_key() -> str:
    title(L("1. Tu llave SSH", "1. Your SSH key"))
    pub = LOCAL_KEY.with_suffix(".pub")
    if not pub.exists():
        note(L("""
No tienes una llave ed25519: la creo ahora. Te pedirá una frase de paso (recomendado:
protege la llave si alguien copia tu disco). Enter dos veces = sin frase.""", """
You don't have an ed25519 key: creating one now. It asks for a passphrase (recommended:
it protects the key if someone copies your disk). Enter twice = no passphrase."""))
        SSH_DIR.mkdir(mode=0o700, exist_ok=True)
        if interactive(["ssh-keygen", "-t", "ed25519", "-f", str(LOCAL_KEY), "-C", f"andamio-{getpass.getuser()}"]) != 0:
            die(L("ssh-keygen falló.", "ssh-keygen failed."))
        key_backup_note()
    key = pub.read_text().strip()
    ok(L(f"Uso {pub}", f"Using {pub}"))
    if not AUTH_KEYS.exists():
        AUTH_KEYS.parent.mkdir(parents=True, exist_ok=True)
        AUTH_KEYS.write_text(key + "\n")
        ok(L(f"{AUTH_KEYS.relative_to(ROOT)}: tu llave pública (la que podrá entrar al servidor)",
             f"{AUTH_KEYS.relative_to(ROOT)}: your public key (the one allowed into the server)"))
    elif key.split()[1] not in AUTH_KEYS.read_text():
        warn(L(f"Tu llave no está en {AUTH_KEYS.relative_to(ROOT)}: no podrías entrar con ella.",
               f"Your key isn't in {AUTH_KEYS.relative_to(ROOT)}: you couldn't log in with it."))
        if ask_yes(L("¿Agregarla?", "Add it?"), True):
            with AUTH_KEYS.open("a") as f:
                f.write(key + "\n")
            ok(L("Agregada", "Added"))
    return str(pub)


def key_backup_note() -> None:
    """La llave es la única puerta: sin contraseñas en SSH, perderla es quedarse afuera."""
    warn(L("Esta llave va a ser tu ÚNICA forma de entrar al servidor (SSH deja de aceptar contraseñas).",
           "This key will be your ONLY way into the server (SSH stops accepting passwords)."))
    note(L(f"""
  - Guarda una copia de {LOCAL_KEY} (el archivo privado) en tu gestor de contraseñas como
    adjunto (Bitwarden, 1Password) o en un USB. Si reinstalas WSL o cambias de PC, la necesitas.
  - Mejor aún, una segunda llave desde otro equipo (tu laptop, o Termius en el celular): agrega su
    línea .pub a host/ssh/authorized_keys y vuelve a correr andamio seguridad.
  - Si aun así te quedas afuera: la consola web de tu proveedor (Azure: Ejecutar comando) y tu
    usuario con su contraseña de sudo permiten poner una llave nueva.""", f"""
  - Keep a copy of {LOCAL_KEY} (the private file) in your password manager as an attachment
    (Bitwarden, 1Password) or on a USB drive. If you reinstall WSL or change PCs, you need it.
  - Better still, a second key from another device (your laptop, or Termius on your phone): add its
    .pub line to host/ssh/authorized_keys and run andamio security again.
  - If you're still locked out: your provider's web console (Azure: Run command) and your user
    with its sudo password let you add a new key."""))


def step_host_key(cfg: dict) -> None:
    title(L("2. ¿Es tu servidor?", "2. Is it your server?"))
    ip, port = cfg["andamio_server_ip"], cfg["andamio_ssh_port"]
    known = cfg.get("andamio_ssh_host_key") or ""
    if known:
        ok(L("Llave del servidor ya verificada (andamio_ssh_host_key)", "Server key already verified (andamio_ssh_host_key)"))
        return
    note(L("""
La primera conexión es la delicada: si alguien se interpusiera en la red, te mostraría
su propia llave. Para comprobarla, mírala DENTRO del servidor por un camino que no sea
la red, y corre ahí:

    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub

  - Hetzner, DigitalOcean, Vultr, Linode, Contabo: la "Console" (consola web) del VPS.
  - Azure: la VM -> Operaciones -> Ejecutar comando -> RunShellScript.
  - AWS: EC2 -> Connect -> Session Manager (o "Get system log" de la instancia).

Tiene que dar exactamente la misma huella que ves abajo. Si no encuentras cómo, puedes
seguir: el riesgo es bajo, pero existe.""", """
The first connection is the delicate one: if someone sat in the middle of the network,
they would show you their own key. To check it, look at it INSIDE the server through a
path other than the network, and run there:

    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub

  - Hetzner, DigitalOcean, Vultr, Linode, Contabo: the VPS's "Console" (web console).
  - Azure: the VM -> Operations -> Run command -> RunShellScript.
  - AWS: EC2 -> Connect -> Session Manager (or the instance's "Get system log").

It must give exactly the same fingerprint you see below. If you can't find how, you can
go on: the risk is low, but real."""))
    r = run(["ssh-keyscan", "-t", "ed25519", "-p", "22", ip])
    lines = [x for x in r.stdout.splitlines() if x and not x.startswith("#")]
    if not lines:
        r = run(["ssh-keyscan", "-t", "ed25519", "-p", str(port), ip])
        lines = [x for x in r.stdout.splitlines() if x and not x.startswith("#")]
    if not lines:
        die(L(f"No responde SSH en {ip} (ni en el 22 ni en el {port}). Lo más probable: el firewall de tu "
              f"proveedor (Azure, AWS, Oracle, Google Cloud...). Ábrele la entrada TCP 22 (la primera conexión) "
              f"y {port} (tu SSH nuevo). Si ya están abiertos, revisa que el VPS esté encendido.",
              f"No SSH answer at {ip} (neither on 22 nor on {port}). Most likely your provider's firewall "
              f"(Azure, AWS, Oracle, Google Cloud...): allow inbound TCP 22 (the first connection) and {port} "
              f"(your new SSH). If they're already open, check that the VPS is running."))
    host_key = " ".join(lines[0].split()[1:3])
    fp = run(["ssh-keygen", "-lf", "-"], input=f"{ip} {host_key}\n").stdout.split()[1]
    print(L(f"\n    Huella del servidor:  {fp}\n", f"\n    Server fingerprint:  {fp}\n"))
    if not ask_yes(L("¿Coincide con la de tu proveedor (o decides seguir sin comprobarla)?",
                     "Does it match your provider's (or do you choose to go on without checking)?"), True):
        die(L("No sigo. Revisa la IP o pregunta a tu proveedor por la huella SSH (ED25519).",
              "Stopping. Check the IP or ask your provider for the SSH fingerprint (ED25519)."))
    for host in (ip, f"[{ip}]:{port}"):
        run(["ssh-keygen", "-R", host])
    SSH_DIR.mkdir(mode=0o700, exist_ok=True)
    with (SSH_DIR / "known_hosts").open("a") as f:
        f.write(f"{ip} {host_key}\n[{ip}]:{port} {host_key}\n")
    set_config("andamio_ssh_host_key", host_key)
    ok(L("Guardada en known_hosts y en la configuración (el CI la usa para desplegar)",
         "Saved in known_hosts and in the configuration (CI uses it to deploy)"))


def ssh_host_name(config_text: str, alias: str) -> str | None:
    """El HostName del bloque `Host <alias>` de ~/.ssh/config ("" si no tiene); None si no existe."""
    m = re.search(rf"^Host\s+{re.escape(alias)}\s*$(.*?)(?=^Host\s|\Z)", config_text, re.M | re.S)
    if not m:
        return None
    hn = re.search(r"^\s*HostName\s+(\S+)", m.group(1), re.M | re.I)
    return hn.group(1) if hn else ""


def free_alias(config_text: str, ip: str) -> str:
    """andamio, andamio-2, ...: el primero libre en ~/.ssh/config (o que ya apunte a esta IP).
    Con varios servidores, una copia nueva no debe heredar el alias de otro."""
    n = 1
    while True:
        alias = DEFAULT_ALIAS if n == 1 else f"{DEFAULT_ALIAS}-{n}"
        if ssh_host_name(config_text, alias) in (None, ip):
            return alias
        n += 1


def suggest_alias(config_text: str, cfg: dict) -> str:
    """Un nombre que diga cuál servidor es: andamio si está libre; si no, por su dominio o su proveedor."""
    ip = str(cfg["andamio_server_ip"])
    domain = str(cfg.get("andamio_domain") or "").split(".")[0]
    for name in (DEFAULT_ALIAS, domain, f"{DEFAULT_ALIAS}-{cfg.get('andamio_provider') or ''}".rstrip("-")):
        if name and re.fullmatch(ALIAS_RE, name) and ssh_host_name(config_text, name) in (None, ip):
            return name
    return free_alias(config_text, ip)


ALIAS_RE = r"[a-z0-9][a-z0-9-]{0,30}"


def step_ssh_alias(cfg: dict) -> str:
    """Alias en ~/.ssh/config e inventario de Ansible. Respeta lo que exista."""
    import yaml
    cfg_file = SSH_DIR / "config"
    current = cfg_file.read_text() if cfg_file.exists() else ""
    ip = str(cfg["andamio_server_ip"])
    alias = suggest_alias(current, cfg)
    if not INVENTORY.exists():
        note(L(f"""
El nombre corto con el que entras a este servidor: ssh <nombre>. Con varios servidores, que
diga cuál es (p. ej. el proveedor o el proyecto).""", f"""
The short name you log in to this server with: ssh <name>. With several servers, make it
say which one it is (e.g. the provider or the project)."""))
        alias = ask(L("Nombre para entrar por SSH", "Name to log in over SSH"), alias,
                    lambda v: (L("Minúsculas, números y guiones.", "Lowercase letters, digits and dashes.")
                               if not re.fullmatch(ALIAS_RE, v) else
                               L(f"Ese nombre ya es otro servidor en ~/.ssh/config ({ssh_host_name(current, v)}).",
                                 f"That name is already another server in ~/.ssh/config ({ssh_host_name(current, v)}).")
                               if ssh_host_name(current, v) not in (None, ip) else None))
    if INVENTORY.exists():
        inv = yaml.safe_load(INVENTORY.read_text()) or {}
        hosts = (((inv.get("all") or {}).get("children") or {}).get("servers") or {}).get("hosts") or {}
        alias = next(iter(hosts), alias)
    else:
        INVENTORY.write_text(L(f'# Host, usuario, puerto y llave salen de ~/.ssh/config (alias "{alias}").\n',
                               f'# Host, user, port and key come from ~/.ssh/config (alias "{alias}").\n') + f"""all:
  children:
    servers:
      hosts:
        {alias}:
""")
        ok(f"{INVENTORY.relative_to(ROOT)} (alias {alias})")
    other = ssh_host_name(current, alias)
    if other and other != str(cfg["andamio_server_ip"]) and str(cfg["andamio_server_ip"]) not in resolves_to(other):
        die(L(f"En ~/.ssh/config, el alias '{alias}' apunta a {other}, no a tu servidor ({cfg['andamio_server_ip']}). "
              "Corrige su HostName (o borra ese bloque) y vuelve a correr el comando.",
              f"In ~/.ssh/config, the alias '{alias}' points to {other}, not to your server ({cfg['andamio_server_ip']}). "
              "Fix its HostName (or remove that block) and run the command again."))
    if other is None:
        with cfg_file.open("a") as f:
            f.write(f"""
Host {alias}
    HostName {cfg['andamio_server_ip']}
    User {cfg['andamio_user']}
    Port {cfg['andamio_ssh_port']}
    IdentityFile {LOCAL_KEY}
    IdentitiesOnly yes
    ServerAliveInterval 60
""")
        cfg_file.chmod(0o600)
        ok(f"~/.ssh/config: alias '{alias}' (ssh {alias})")
    return alias


def step_bootstrap(cfg: dict, alias: str, pub: str) -> str | None:
    """Crea tu usuario y mueve SSH. Devuelve el usuario inicial del proveedor (None si ya estaba hecho)."""
    title(L("3. Usuario propio y SSH en tu puerto", "3. Your own user and SSH on your port"))
    user, port = cfg["andamio_user"], cfg["andamio_ssh_port"]
    if ssh_ok([alias]):
        ok(L(f"Ya entras como {user} por el puerto {port}: bootstrap hecho",
             f"You already log in as {user} on port {port}: bootstrap done"))
        return None
    ip = cfg["andamio_server_ip"]
    provider, initial = cfg.get("andamio_provider"), cfg.get("andamio_provider_user")
    if initial:
        ok(L(f"Entro primero como {initial}, el usuario que te dio tu proveedor",
             f"First I log in as {initial}, the user your provider gave you"))
    else:
        provider, initial = ask_provider()
    if initial == user:
        # Es el usuario con sesión abierta durante el bootstrap: no se le puede cambiar el UID
        # (usermod falla), y además queda fuera de SSH al final (AllowUsers).
        warn(L(f"Tu usuario de andamio no puede ser '{initial}': es el que te dio el proveedor. andamio crea uno "
               "propio, aparte (el del proveedor deja de poder entrar por SSH).",
               f"Your andamio user can't be '{initial}': it's the one your provider gave you. andamio creates its "
               "own, separate one (the provider's can no longer log in over SSH)."))
        new = ask(L("Nombre de tu usuario de andamio", "Name of your andamio user"), "andamio" if initial != "andamio" else "operador",
                  lambda v: check_user(v) or (L(f"Tiene que ser distinto de '{initial}'.", f"It must differ from '{initial}'.")
                                              if v == initial else None))
        rename_operator(alias, user, new)
        cfg["andamio_user"] = user = new
    target = ["-p", "22", f"{initial}@{ip}"]
    if not ssh_ok(target):
        how = choose(L(f"Tu llave todavía no entra como {initial}. ¿Cómo te dio acceso el proveedor?",
                       f"Your key can't log in as {initial} yet. How did your provider give you access?"), [
            ("pem", L("un archivo de llave (.pem): lo normal en Azure, AWS y Oracle",
                      "a key file (.pem): the usual on Azure, AWS and Oracle")),
            ("password", L("una contraseña", "a password")),
        ], "pem" if provider in ("azure", "aws", "oracle") else "password")
        if how == "pem":
            note(L("En WSL, tu carpeta Descargas está en /mnt/c/Users/<tu usuario>/Downloads (o pega la ruta de Windows).",
                   "In WSL, your Downloads folder is /mnt/c/Users/<your user>/Downloads (or paste the Windows path)."))
            pem_src = local_path(ask(L("Ruta del archivo .pem", "Path to the .pem file"),
                                     check=lambda v: None if local_path(v).is_file()
                                     else L(f"No existe {local_path(v)}.", f"{local_path(v)} doesn't exist.")))
            # ssh rechaza llaves con permisos abiertos (las de /mnt/c lo son): una copia 0600, temporal.
            tmp = Path(tempfile.mkdtemp(prefix="andamio-pem-"))
            pem = tmp / "key.pem"
            try:
                pem.write_bytes(pem_src.read_bytes())
                pem.chmod(0o600)
                if run(["ssh", "-i", str(pem), "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
                        "-o", "ConnectTimeout=10", *target, "true"]).returncode != 0:
                    die(L(f"Ese archivo no entra como {initial}@{ip}: ¿es la llave de este VPS y el usuario correcto?",
                          f"That file can't log in as {initial}@{ip}: is it this VPS's key and the right user?"))
                ok(L("El archivo .pem entra: con él instalo tu llave (y no se vuelve a usar)",
                     "The .pem file gets in: installing your key with it (it isn't used again)"))
                # Sin ssh-copy-id: su chequeo "¿la llave ya entra?" entraría con el .pem y no instalaría nada.
                key = Path(pub).read_text().strip()
                done = run(["ssh", "-i", str(pem), "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes", *target,
                            'umask 077; mkdir -p ~/.ssh; k=$(cat); grep -qxF "$k" ~/.ssh/authorized_keys 2>/dev/null '
                            '|| printf "%s\\n" "$k" >> ~/.ssh/authorized_keys'], input=key + "\n").returncode == 0
            finally:
                shutil.rmtree(tmp, ignore_errors=True)
        else:
            note(L(f"Escribes la contraseña de {initial} UNA vez; desde ahí, solo llave.",
                   f"You type {initial}'s password ONCE; keys only from then on."))
            done = interactive(["ssh-copy-id", "-i", pub, *target]) == 0
        if not done or not ssh_ok(target):
            die(L(f"No pude instalar tu llave en {initial}@{ip}. Revisa el usuario y la llave o contraseña.",
                  f"Couldn't install your key for {initial}@{ip}. Check the user and the key or password."))
    ok(L(f"Entras como {initial} con tu llave", f"You log in as {initial} with your key"))
    extra = ["-e", f"ansible_user={initial}", "-e", "ansible_port=22"]
    become_file: Path | None = None
    if initial != "root":
        extra += ["--become"]
        if run(["ssh", "-o", "BatchMode=yes", *target, "sudo -n true"]).returncode == 0:
            ok(L(f"{initial} usa sudo sin contraseña (normal en Azure y AWS): no hace falta pedirla",
                 f"{initial} uses sudo without a password (normal on Azure and AWS): no need to ask for it"))
        else:
            note(L(f"""
{initial} necesita contraseña para sudo: la de {initial} que te dio tu proveedor (no la de
tu usuario nuevo, que todavía no existe).""", f"""
{initial} needs a password for sudo: {initial}'s, from your provider (not your new user's,
which doesn't exist yet)."""))
            pw = ask_secret(L(f"Contraseña de sudo de '{initial}'", f"Sudo password for '{initial}'"),
                            lambda v: None if run(["ssh", "-o", "BatchMode=yes", *target, "sudo -S -p '' -v"],
                                                  input=v + "\n").returncode == 0
                            else L(f"No es la contraseña de sudo de '{initial}'.",
                                   f"That's not the sudo password for '{initial}'."))
            tmp = Path(tempfile.mkdtemp(prefix="andamio-sudo-"))
            become_file = tmp / "become"
            become_file.write_text(pw)
            become_file.chmod(0o600)
            extra += ["--become-password-file", str(become_file)]
    step_port_reachable(ip, int(port))
    note(L(f"""
Ahora creo tu usuario '{user}' y muevo SSH al puerto {port}. Inventa una contraseña NUEVA
para '{user}' (larga) y guárdala en tu gestor: es solo para sudo (para entrar sigue
siendo tu llave), y andamio te la pedirá en los pasos siguientes.""", f"""
Now I create your user '{user}' and move SSH to port {port}. Make up a NEW password for
'{user}' (long) and keep it in your password manager: it's only for sudo (you still log
in with your key), and andamio will ask for it in the next steps."""))
    # Va como hash, en un archivo privado que se borra: el playbook no la pregunta
    # (vars_prompt se salta cuando la variable ya viene definida).
    import json
    vars_dir = Path(tempfile.mkdtemp(prefix="andamio-boot-"))
    vars_file = vars_dir / "vars.json"
    vars_file.write_text(json.dumps({"bootstrap_password": new_sudo_password(user)}))
    vars_file.chmod(0o600)
    title(L("   Creando tu usuario y moviendo SSH (la conexión se corta al final: es lo esperado)",
            "   Creating your user and moving SSH (the connection drops at the end: that's expected)"))
    try:
        rc = run_playbook(["bootstrap.yml", *extra, "-e", f"@{vars_file}"])
    finally:
        shutil.rmtree(vars_dir, ignore_errors=True)
        if become_file:   # la contraseña del usuario del proveedor: fuera apenas termina
            become_file.write_text("\0" * 64)
            shutil.rmtree(become_file.parent, ignore_errors=True)
    # Falló antes de mover SSH (la última tarea): el servidor sigue entrando por el 22 como antes.
    if rc != 0 and not ssh_ok([alias]):
        die(L("El bootstrap falló (arriba: la tarea y el motivo). SSH sigue en el 22 como antes: corrígelo y "
              "vuelve a correr el comando.",
              "The bootstrap failed (above: the task and the reason). SSH is still on 22 as before: fix it and "
              "run the command again."))
    for _ in range(10):
        if ssh_ok([alias]):
            ok(L(f"Entras como {user} por el puerto {port}", f"You log in as {user} on port {port}"))
            return initial
        import time
        time.sleep(3)
    die(L(f"No logro entrar con `ssh {alias}`. Revisa el firewall de tu proveedor (el puerto {port}).",
          f"Can't log in with `ssh {alias}`. Check your provider's firewall (port {port})."))


def probe_port(ip: str, port: int, timeout: float = 6) -> str:
    """Cómo responde un puerto desde aquí: open (alguien escucha), closed (el servidor lo rechaza:
    llega), filtered (nadie responde: un firewall lo descarta) o rejected (otro rechazo de red)."""
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return "open"
    except ConnectionRefusedError:
        return "closed"
    except TimeoutError:
        return "filtered"
    except OSError:
        return "rejected"


def step_port_reachable(ip: str, port: int) -> None:
    """Antes de mover SSH: si el firewall del proveedor bloquea el puerto nuevo, quedarías afuera."""
    state = probe_port(ip, port)
    if state in ("open", "closed"):
        ok(L(f"El puerto {port} llega al servidor: al mover SSH no quedas afuera",
             f"Port {port} reaches the server: moving SSH won't lock you out"))
        return
    if state == "filtered":
        die(L(f"""El puerto {port} no llega al servidor: lo bloquea el firewall de tu proveedor.
Si muevo SSH ahí, quedarías afuera. Ábrele la entrada TCP {port}:
  - Azure: la VM -> Redes -> Agregar regla de puerto de entrada.
  - AWS: el Security group de la instancia.   Oracle: la Security list de su subred.
  - Google Cloud: VPC network -> Firewall.   Hetzner / DigitalOcean: su Firewall, si le pusiste uno.
Después vuelve a correr el comando: retoma donde quedó.""", f"""Port {port} doesn't reach the server: your provider's firewall blocks it.
If I move SSH there, you'd be locked out. Allow inbound TCP {port}:
  - Azure: the VM -> Networking -> Add inbound port rule.
  - AWS: the instance's Security group.   Oracle: its subnet's Security list.
  - Google Cloud: VPC network -> Firewall.   Hetzner / DigitalOcean: their Firewall, if you added one.
Then run the command again: it resumes where it stopped."""))
    warn(L(f"El puerto {port} devuelve un rechazo de red: puede haber otro firewall en el camino (p. ej. "
           "las reglas que trae la imagen de Oracle).",
           f"Port {port} returns a network rejection: there may be another firewall on the way (e.g. the "
           "rules Oracle's image ships with)."))
    if not ask_yes(L("¿Sigo igual? (si el puerto no llega, quedarías afuera)",
                     "Go on anyway? (if the port doesn't get through, you'd be locked out)"), False):
        die(L("No sigo. Revisa el firewall y vuelve a correr el comando.", "Stopping. Check the firewall and run the command again."))


def ask_provider() -> tuple[str, str]:
    """Dónde está el VPS y el usuario con el que su proveedor deja entrar (el que ya existe)."""
    # El usuario con el que cada proveedor deja entrar a un VPS nuevo.
    provider = choose(L("¿Dónde está tu VPS?", "Where is your VPS?"), [
        ("azure", "Azure (azureuser)"), ("aws", "AWS (ubuntu)"), ("oracle", "Oracle Cloud (ubuntu)"),
        ("gcp", L("Google Cloud (tu usuario de Google)", "Google Cloud (your Google user)")),
        ("hetzner", "Hetzner (root)"), ("digitalocean", "DigitalOcean (root)"),
        ("other", L("otro (Vultr, Linode, Contabo...: root)", "other (Vultr, Linode, Contabo...: root)")),
    ], "azure")
    default_user = {"azure": "azureuser", "aws": "ubuntu", "oracle": "ubuntu"}.get(provider, "root")
    note(L("(el que ya existe en el VPS; si al crearlo elegiste otro nombre, escríbelo)",
           "(the one that already exists on the VPS; if you picked another name when creating it, type it)"))
    initial = ask(L("Usuario con el que te deja entrar el proveedor", "User your provider lets you in with"),
                  default_user, check_user_initial)
    return provider, initial


def rename_operator(alias: str, old: str, new: str) -> None:
    """Otro nombre para tu usuario de andamio: en la configuración y en el alias de ~/.ssh/config."""
    set_config("andamio_user", new)
    cfg_file = SSH_DIR / "config"
    if cfg_file.exists():
        text = cfg_file.read_text()
        m = re.search(rf"^Host\s+{re.escape(alias)}\s*$(.*?)(?=^Host\s|\Z)", text, re.M | re.S)
        if m:
            block = re.sub(rf"^(\s*User\s+){re.escape(old)}\s*$", rf"\g<1>{new}", m.group(1), flags=re.M)
            cfg_file.write_text(text[:m.start(1)] + block + text[m.end(1):])
    ok(L(f"Tu usuario de andamio ahora es '{new}' (configuración y ssh {alias})",
         f"Your andamio user is now '{new}' (configuration and ssh {alias})"))


def check_user_initial(v: str):
    return None if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", v) else L("Usuario inválido.", "Invalid user.")


def step_repo_pushed(cmd: str = "servidor") -> None:
    name = forge_out("name")
    rerun = f"andamio {L(cmd, {'servidor': 'server'}.get(cmd, cmd))}"
    title(L(f"4. Tu configuración en {name}", f"4. Your configuration on {name}"))
    note(L(f"""
El servidor se configura desde tu repo en {name}: lo que no esté subido, no existe para él.""", f"""
The server is configured from your repo on {name}: whatever isn't pushed doesn't exist for it."""))
    if run(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout.strip():
        die(L("Hay cambios sin commit (la configuración, la llave del servidor...). Corre:\n"
              "    git add -A && git commit -m 'andamio: configuración' && git push\n"
              f"y vuelve a correr `{rerun}`: retoma donde quedó.",
              "There are uncommitted changes (the configuration, the server key...). Run:\n"
              "    git add -A && git commit -m 'andamio: configuration' && git push\n"
              f"and run `{rerun}` again: it resumes where it stopped."))
    run(["git", "-C", str(ROOT), "fetch", "-q"])
    if run(["git", "-C", str(ROOT), "rev-parse", "HEAD"]).stdout != run(["git", "-C", str(ROOT), "rev-parse", "@{u}"]).stdout:
        die(L(f"Tus commits no están en {name}: corre `git push` y vuelve a correr `{rerun}`.",
              f"Your commits aren't on {name}: run `git push` and run `{rerun}` again."))
    ok(L("Todo subido", "Everything pushed"))


def step_harden(cfg: dict, alias: str) -> None:
    title(L("5. Endurecimiento: SSH, firewall, fail2ban, parches, Docker y VPN",
            "5. Hardening: SSH, firewall, fail2ban, patches, Docker and VPN"))
    if ansible(["site.yml", "--tags", "base,ssh,firewall,fail2ban,docker,wireguard"], cfg, alias) != 0:
        die(L("El endurecimiento falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio servidor`.",
              "Hardening failed (details above). Fix it and run `andamio server` again."))
    ok(L("Servidor endurecido", "Server hardened"))


def remote(alias: str, script: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    """Corre en el servidor. Sin stdin: el script entra por la entrada estándar (bash -s).
    Con stdin (p. ej. un token): el script va como comando y stdin es solo ese dato."""
    if stdin is None:
        return run(["ssh", "-o", "BatchMode=yes", alias, "bash", "-s"], input=script)
    return run(["ssh", "-o", "BatchMode=yes", alias, script], input=stdin)


def step_repo_key(cfg: dict, alias: str) -> None:
    name = forge_out("name")
    title(L("6. Llave del servidor para leer tu repo", "6. The server's key to read your repo"))
    note(L(f"""
El servidor baja tu configuración de {name} con una llave propia, de SOLO LECTURA y solo
para ese repo. Se genera en el servidor: la privada nunca sale de ahí.""", f"""
The server pulls your configuration from {name} with its own key, READ-ONLY and for that
repo only. It's generated on the server: the private key never leaves it."""))
    m = re.search(r":([^/]+/[^/]+?)(\.git)?$", cfg["andamio_repo"])
    repo = m.group(1) if m else die(L("andamio_repo no tiene el formato git@github-andamio:dueño/repo.git",
                                      "andamio_repo isn't in the git@github-andamio:owner/repo.git format"))
    host, known_hosts = forge_out("ssh-host"), forge_out("known-hosts")
    r = remote(alias, f"""set -e
umask 077
k=~/.ssh/id_ed25519_andamio
[ -f $k ] || ssh-keygen -q -t ed25519 -N '' -C "andamio-server" -f $k
grep -q '^Host github-andamio$' ~/.ssh/config 2>/dev/null || cat >> ~/.ssh/config <<'EOF'
Host github-andamio
    HostName {host}
    User git
    IdentityFile ~/.ssh/id_ed25519_andamio
    IdentitiesOnly yes
EOF
grep -q '^{host} ' ~/.ssh/known_hosts 2>/dev/null || cat >> ~/.ssh/known_hosts <<'EOF'
{known_hosts}
EOF
cat $k.pub
""")
    if r.returncode != 0 or "ssh-ed25519" not in r.stdout:
        die(L(f"No pude preparar la llave en el servidor: {r.stderr.strip()}",
              f"Couldn't prepare the key on the server: {r.stderr.strip()}"))
    tmp = Path(tempfile.mkstemp(suffix=".pub")[1])
    try:
        tmp.write_text(r.stdout.strip().splitlines()[-1] + "\n")
        if forge("deploy-key-has", repo, "andamio-server", str(tmp)).returncode == 0:
            ok(L(f"Ya registrada en {name}", f"Already registered on {name}"))
        else:
            add = forge("deploy-key-add", repo, "andamio-server", str(tmp))
            if add.returncode != 0:
                die(L(f"{name} rechazó la llave: {add.stderr.strip()}", f"{name} rejected the key: {add.stderr.strip()}"))
            ok(L(f"Registrada en {repo} como deploy key de solo lectura", f"Registered on {repo} as a read-only deploy key"))
    finally:
        tmp.unlink()


def registry(cfg: dict) -> tuple[str, str]:
    """(host del registro de imágenes, su nombre para mostrar)."""
    return cfg.get("andamio_registry") or forge_out("registry"), forge_out("registry-name")


def ask_registry_token(cfg: dict, alias: str) -> str | None:
    """Pide el token del registro al principio (antes de minutos de salida de Ansible, donde
    es fácil pegarlo a destiempo y que quede impreso). None si el servidor ya tiene login."""
    host, name = registry(cfg)
    title(L(f"4b. Acceso a tus imágenes ({name})", f"4b. Access to your images ({name})"))
    if remote(alias, f"grep -q '\"{host}\"' ~/.docker/config.json 2>/dev/null").returncode == 0:
        ok(L(f"El servidor ya puede bajar imágenes de {name}", f"The server can already pull images from {name}"))
        return None
    note(forge_out("registry-token-help"))
    token = ask_secret(L("Token de solo lectura de imágenes (no se ve al escribir)", "Read-only image token (hidden while typing)"),
                       registry_token_problem)
    ok(L("Token válido: lo uso cuando Docker esté instalado (paso 7).", "Token valid: used once Docker is installed (step 7)."))
    return token


def step_registry(cfg: dict, alias: str, token: str | None) -> None:
    host, name = registry(cfg)
    title(L(f"7. Login en {name}", f"7. Login to {name}"))
    if token is None:
        ok(L("Ya hecho", "Already done"))
        return
    r = remote(alias, f"docker login {host} -u {cfg['andamio_github_owner']} --password-stdin", stdin=token + "\n")
    if r.returncode != 0:
        die(L(f"docker login falló: {r.stderr.strip()}", f"docker login failed: {r.stderr.strip()}"))
    ok(L(f"Login en {name} hecho (el token queda solo en el servidor)", f"Logged in to {name} (the token stays only on the server)"))


def step_platform(cfg: dict, alias: str) -> None:
    title(L("8. Plataforma: Traefik, datos, monitoreo", "8. Platform: Traefik, data, monitoring"))
    if ansible(["site.yml", "--tags", "andamio"], cfg, alias) != 0:
        die(L("La plataforma falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio servidor`.",
              "The platform failed (details above). Fix it and run `andamio server` again."))
    ok(L("Plataforma arriba", "Platform up"))


SECURITY_TOOLS = {"ssh": "bin/andamio setup", "ssh-keygen": "bin/andamio setup", "ssh-copy-id": "bin/andamio setup",
                  "openssl": "bin/andamio setup", "ansible-playbook": "bin/andamio setup"}


def check_tools_security() -> None:
    """Lo que necesita `andamio seguridad`: SSH y Ansible (sin GitHub, sops ni age)."""
    title(L("Herramientas en tu máquina", "Tools on your machine"))
    missing = [t for t in SECURITY_TOOLS if not shutil.which(t)]
    if not has_yaml():
        missing.append("python3-yaml")
    missing += missing_collections() if shutil.which("ansible-playbook") else []
    for t in missing:
        warn(L(f"Falta {t}", f"Missing {t}"))
    if missing:
        die(L("Falta preparar tu máquina: corre `bin/andamio setup` (lo instala todo, preguntando antes).",
              "Your machine isn't ready yet: run `bin/andamio setup` (it installs everything, asking first)."))
    ok(L("ssh y ansible disponibles", "ssh and ansible available"))


def load_security_config() -> dict:
    """La configuración mínima para blindar: IP, tu usuario y el puerto SSH. Si no existe, la pregunta
    (y `andamio init` la completa después, sin volver a preguntarla)."""
    import yaml
    refuse_public_template()
    if not CONFIG.exists():
        title(L("Tu servidor", "Your server"))
        note(L("""
La IP pública del VPS que compraste (la ves en el panel de tu proveedor).""", """
The public IP of the VPS you bought (shown in your provider's dashboard)."""))
        ip = ask(L("IP del VPS", "VPS IP"), check=check_ip)
        provider, initial = ask_provider()
        user, port = ask_access(initial)
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(L("# Configuración de este servidor (andamio seguridad: solo el blindaje).\n"
                            "# andamio init la completa (dominio, repo, HTTPS) sin volver a preguntar esto.\n",
                            "# This server's configuration (andamio security: the lockdown only).\n"
                            "# andamio init completes it (domain, repo, HTTPS) without asking this again.\n") + f"""\
andamio_user: {user}
andamio_uid: 1001
andamio_ssh_port: {port}
andamio_ssh_host_key: ""
andamio_server_ip: {ip}
andamio_provider: {provider}
andamio_provider_user: {initial}
""")
        ok(f"{CONFIG.relative_to(ROOT)}")
    cfg = yaml.safe_load(CONFIG.read_text()) or {}
    for k in ("andamio_user", "andamio_ssh_port", "andamio_server_ip"):
        if not cfg.get(k):
            die(L(f"Falta {k} en {CONFIG.relative_to(ROOT)}.", f"{k} is missing in {CONFIG.relative_to(ROOT)}."))
    announce_server(cfg)
    return cfg


def offers_password(stderr: str) -> bool | None:
    """Del rechazo de ssh ("Permission denied (publickey,password)."): ¿el servidor ofrece
    contraseña? None si ssh no llegó a ese punto."""
    m = re.search(r"Permission denied \(([^)]*)\)", stderr)
    if not m:
        return None
    return bool({"password", "keyboard-interactive"} & set(m.group(1).split(",")))


def locked_rows(cfg: dict, initial: str) -> list:
    """Recién movido SSH (todavía sin fail2ban, que bloquearía tu IP por estas pruebas): desde
    afuera, nadie entra con contraseña y el 22 ya no responde."""
    ip, port = cfg["andamio_server_ip"], int(cfg["andamio_ssh_port"])
    rows = []
    for who in dict.fromkeys(["root", initial, cfg["andamio_user"]]):
        r = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=yes",
                 "-o", "PubkeyAuthentication=no", "-o", "PreferredAuthentications=password,keyboard-interactive",
                 "-p", str(port), f"{who}@{ip}", "true"])
        offered = offers_password(r.stderr)
        if offered is False:
            rows.append(["OK", "SSH", L(f"{who} con contraseña: rechazado (solo llave)",
                                        f"{who} with a password: refused (keys only)"), ""])
        elif offered:
            rows.append(["FAIL", "SSH", L(f"{who} todavía puede intentar con contraseña",
                                          f"{who} can still try a password"), L("vuelve a correr andamio seguridad",
                                                                                "run andamio security again")])
        else:
            rows.append(["WARN", "SSH", L(f"No pude probar {who} con contraseña: {r.stderr.strip()[-120:]}",
                                          f"Couldn't test {who} with a password: {r.stderr.strip()[-120:]}"), ""])
    rows.append(["FAIL", "SSH", L("El 22 todavía responde", "Port 22 still answers"),
                 L("vuelve a correr andamio seguridad", "run andamio security again")]
                if port_open(ip, 22) else
                ["OK", "SSH", L("SSH ya no escucha en el 22", "SSH no longer listens on 22"), ""])
    return rows


def cmd_seguridad(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio seguridad\033[0m: blinda tu VPS recién comprado (solo llave, sin root, firewall y "
            "fail2ban). No instala nada más. Se puede volver a correr.",
            "\033[1mandamio security\033[0m: locks down your freshly bought VPS (keys only, no root, firewall "
            "and fail2ban). Installs nothing else. Safe to run again."))
    check_tools_security()
    pub = step_local_key()
    cfg = load_security_config()
    step_host_key(cfg)
    cfg = load_security_config()
    alias = step_ssh_alias(cfg)
    initial = step_bootstrap(cfg, alias, pub)
    locked = locked_rows(cfg, initial) if initial else []
    title(L("4. Contraseña de sudo", "4. Sudo password"))
    sudo_password_file(cfg, alias)
    try:
        title(L("5. Blindaje: parches automáticos, SSH, firewall y fail2ban",
                "5. Lockdown: automatic patches, SSH, firewall and fail2ban"))
        if ansible(["site.yml", "--tags", "base,ssh,firewall,fail2ban"], cfg, alias) != 0:
            die(L("El blindaje falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio seguridad`.",
                  "The lockdown failed (details above). Fix it and run `andamio security` again."))
        ok(L("Servidor blindado", "Server locked down"))
        title(L("6. Parches de seguridad pendientes", "6. Pending security patches"))
        note(L("""
La imagen de un VPS nuevo trae semanas de parches atrasados: los aplico ya (unos minutos), en
vez de esperar a las actualizaciones de la noche.""", """
A new VPS's image ships weeks of patches behind: applying them now (a few minutes) instead of
waiting for the nightly updates."""))
        pw = sudo_password_file(cfg, alias).read_text()
        r = run(["ssh", "-o", "BatchMode=yes", alias, "sudo -S -p '' sh -c 'apt-get update -qq && unattended-upgrade'"],
                input=pw + "\n")
        if r.returncode == 0:
            ok(L("Parches de seguridad aplicados", "Security patches applied"))
        else:
            warn(L(f"No pude aplicarlos ahora ({(r.stderr or r.stdout).strip()[-160:]}): llegan solos esta noche.",
                   f"Couldn't apply them now ({(r.stderr or r.stdout).strip()[-160:]}): they arrive by themselves tonight."))
        if remote(alias, "test -f /var/run/reboot-required").returncode == 0:
            note(L("""
Algunos parches (p. ej. el kernel) solo valen después de reiniciar. Se hará solo en la ventana
configurada; como todavía no hay nada corriendo en el servidor, puede ser ya (~1 minuto).""", """
Some patches (e.g. the kernel) only take effect after a reboot. It'll happen by itself in the
configured window; since nothing runs on the server yet, it can be now (~1 minute)."""))
            if ask_yes(L("¿Reinicio ahora?", "Reboot now?"), True):
                run(["ssh", "-o", "BatchMode=yes", alias, "sudo -S -p '' systemctl reboot"], input=pw + "\n")
                import time
                time.sleep(15)
                for _ in range(40):
                    if ssh_ok([alias]):
                        break
                    time.sleep(5)
                else:
                    die(L(f"El servidor no volvió en 3 minutos: míralo en la consola de tu proveedor y "
                          f"vuelve a correr el comando (ssh {alias} para probar).",
                          f"The server didn't come back in 3 minutes: look at it in your provider's console "
                          f"and run the command again (ssh {alias} to try)."))
                # Recién arrancado, el reloj tarda unos segundos en sincronizarse: la verificación
                # lo marcaría como problema.
                remote(alias, "timeout 60 sh -c 'until [ \"$(timedatectl show -p NTPSynchronized --value)\" = yes ]; "
                              "do sleep 2; done'")
                ok(L("Reiniciado, con los parches activos", "Rebooted, with the patches active"))
        title(L("7. Verificación", "7. Check"))
        results, listening = server_check(cfg, alias, "SOLO=seguridad")
    finally:
        wipe_sudo()
    net, _ = internet_port_rows(cfg, alias, listening, set())
    rows = locked + results + net
    print_rows(rows)
    every = print_totals(rows)
    note(L(f"""
Entras con:  ssh {alias}   (solo con tu llave; consérvala: es tu única entrada)
fail2ban: no lo pruebes desde tu PC (bloquearía tu IP una hora). Desde otra red (p. ej. Azure Cloud
  Shell): ssh -p {cfg['andamio_ssh_port']} falso@{cfg['andamio_server_ip']} cinco veces; luego aquí:
  ssh -t {alias} sudo fail2ban-client status sshd
Para montar la plataforma (apps, HTTPS, backups): {'andamio setup (conecta tu copia con GitHub), ' if not has_origin() else ''}andamio init (completa lo que falta) y andamio servidor.""", f"""
Log in with:  ssh {alias}   (only with your key; keep it safe: it's your only way in)
fail2ban: don't test it from your PC (it would block your IP for an hour). From another network (e.g.
  Azure Cloud Shell): ssh -p {cfg['andamio_ssh_port']} fake@{cfg['andamio_server_ip']} five times; then here:
  ssh -t {alias} sudo fail2ban-client status sshd
To set up the platform (apps, HTTPS, backups): {'andamio setup (connects your copy to GitHub), ' if not has_origin() else ''}andamio init (fills in what's missing) and andamio server."""))
    if "FAIL" in every:
        sys.exit(1)


def cmd_servidor(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio servidor\033[0m: prepara tu VPS (parte 2). Se puede volver a correr: retoma donde quedó.",
            "\033[1mandamio server\033[0m: sets up your VPS (part 2). Safe to run again: it resumes where it stopped."))
    check_tools()
    cfg = load_config()
    pub = step_local_key()
    step_host_key(cfg)
    cfg = load_config()
    alias = step_ssh_alias(cfg)
    step_bootstrap(cfg, alias, pub)
    step_repo_pushed()
    token = ask_registry_token(cfg, alias)
    title(L("4c. Contraseña de sudo", "4c. Sudo password"))
    sudo_password_file(cfg, alias)
    try:
        step_harden(cfg, alias)
        step_repo_key(cfg, alias)
        step_registry(cfg, alias, token)
        step_platform(cfg, alias)
    finally:
        wipe_sudo()
    title(L("Listo: tu VPS está seguro y preparado", "Done: your VPS is secure and ready"))
    note(L(f"""
VPN: importa ~/andamio-vpn/mi-pc.conf en la app de WireGuard (paneles privados solo por VPN);
  celular: qrencode -t ansiutf8 < ~/andamio-vpn/mi-pc.conf y escanéalo con la app.
Grafana (si tu monitoreo es completo): https://grafana.{cfg.get('andamio_domain')} con la VPN.
Primera app:  andamio app create <nombre> --repo <dueño/repo>   (queda en https://<nombre>.{cfg.get('andamio_domain')})
Chequeo de seguridad:  andamio estado     Backups:  andamio backups""", f"""
VPN: import ~/andamio-vpn/mi-pc.conf into the WireGuard app (private panels only over the VPN);
  phone: qrencode -t ansiutf8 < ~/andamio-vpn/mi-pc.conf and scan it with the app.
Grafana (if your monitoring is completo): https://grafana.{cfg.get('andamio_domain')} over the VPN.
First app:  andamio app create <name> --repo <owner/repo>   (it lives at https://<name>.{cfg.get('andamio_domain')})
Security check:  andamio status     Backups:  andamio backups"""))


# ================= backups =================

RESTIC_ENV = ROOT / "host" / "sops" / "restic-env.sops"
RESTIC_PW = ROOT / "host" / "sops" / "restic-password.sops"
# La llave de B2 que crea andamio: un solo bucket y SIN deleteFiles. restic "oculta" en
# vez de borrar, así que quien tome el servidor no puede borrar tus backups (ADR 0014).
B2_CAPS = ["listBuckets", "listFiles", "readFiles", "writeFiles"]


def server_alias() -> str:
    """El alias SSH del servidor: el primer host del inventario (lo crea andamio servidor)."""
    import yaml
    if not INVENTORY.exists():
        die(L("Falta ansible/inventory.yml: corre primero `andamio servidor`.",
              "ansible/inventory.yml is missing: run `andamio server` first."))
    hosts = yaml.safe_load(INVENTORY.read_text())["all"]["children"]["servers"]["hosts"]
    return next(iter(hosts))


def sops_read(path: Path) -> str:
    r = run(["sops", "decrypt", "--input-type", "json", "--output-type", "binary", str(path)], cwd=ROOT)
    if r.returncode != 0:
        die(L(f"sops no pudo descifrar {path.relative_to(ROOT)}: {r.stderr.strip()}",
              f"sops couldn't decrypt {path.relative_to(ROOT)}: {r.stderr.strip()}"))
    return r.stdout


def encrypt_binary(path: Path, content: str) -> None:
    """Cifra un archivo entero con sops (como los demás secretos del host). El texto en claro
    vive solo en una carpeta 0700 y se sobreescribe antes de borrarse."""
    rel = path.relative_to(ROOT)
    tmp = Path(tempfile.mkdtemp(prefix="andamio-"))
    plain = tmp / "secreto"
    try:
        plain.write_text(content)
        plain.chmod(0o600)
        r = run(["sops", "encrypt", "--input-type", "binary", "--output-type", "json",
                 "--filename-override", str(rel), str(plain)], cwd=ROOT)
        if r.returncode != 0:
            die(L(f"sops no pudo cifrar {rel}: {r.stderr.strip()}", f"sops couldn't encrypt {rel}: {r.stderr.strip()}"))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(r.stdout)
        ok(L(f"{rel} (cifrado)", f"{rel} (encrypted)"))
    finally:
        plain.write_bytes(b"\0" * 256)
        shutil.rmtree(tmp, ignore_errors=True)


def b2_api(url: str, body: dict | None = None, token: str | None = None,
           basic: tuple[str, str] | None = None) -> tuple[int, dict]:
    import base64
    import json
    import urllib.error
    import urllib.request
    headers = {"User-Agent": "andamio"}
    if token:
        headers["Authorization"] = token
    if basic:
        headers["Authorization"] = "Basic " + base64.b64encode(f"{basic[0]}:{basic[1]}".encode()).decode()
    data = json.dumps(body).encode() if body is not None else None
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers), timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}
    except OSError as e:
        return 0, {"message": str(e)}


def b2_authorize(key_id: str, key: str) -> tuple[dict | None, str | None]:
    code, d = b2_api("https://api.backblazeb2.com/b2api/v3/b2_authorize_account", basic=(key_id, key))
    if code == 200:
        return d, None
    if code == 401:
        return None, L("Backblaze no reconoce ese keyID con esa llave (¿mal copiados, o es de otra cuenta?).",
                       "Backblaze doesn't recognize that keyID with that key (mistyped, or from another account?).")
    return None, L(f"No pude comprobarla con Backblaze ({code or d.get('message')}).",
                   f"Couldn't check it with Backblaze ({code or d.get('message')}).")


def ask_b2(cfg: dict) -> tuple[str, dict]:
    note(L("""
Backblaze B2: 10 GB gratis, luego unos 6 USD por TB al mes.
1. En https://secure.backblaze.com/b2_buckets.htm  → Create a Bucket:
     nombre único (ej. andamio-backups-<algo tuyo>), Files: Private,
     Object Lock: Enable (recomendado: protege los backups aunque alguien tome el servidor).
2. La llave que usará el servidor la puede crear andamio, SIN permiso de borrar y solo
   para ese bucket. Para eso necesita tu Master Application Key una vez (App Keys →
   Generate New Master Application Key): no se guarda y solo viaja a Backblaze.""", """
Backblaze B2: 10 GB free, then about 6 USD per TB per month.
1. At https://secure.backblaze.com/b2_buckets.htm  → Create a Bucket:
     unique name (e.g. andamio-backups-<something of yours>), Files: Private,
     Object Lock: Enable (recommended: protects backups even if someone takes the server).
2. andamio can create the key the server will use, WITHOUT delete permission and for
   that bucket only. For that it needs your Master Application Key once (App Keys →
   Generate New Master Application Key): it isn't stored and only travels to Backblaze."""))
    bucket = ask(L("Nombre del bucket", "Bucket name"),
                 check=lambda v: None if re.fullmatch(r"[A-Za-z0-9-]{6,50}", v)
                 else L("Entre 6 y 50 letras, números o guiones.", "6 to 50 letters, digits or hyphens."))
    if ask_yes(L("¿Creo la llave sin permiso de borrar con tu master key? (recomendado)",
                 "Create the key without delete permission using your master key? (recommended)"), True):
        master_id = ask(L("Master keyID (keyID de la master key)", "Master keyID (the master key's keyID)"))
        auth = {}

        def master_problem(k: str) -> str | None:
            d, error = b2_authorize(master_id, k)
            auth.update(d or {})
            return error
        ask_secret(L("Master applicationKey (no se ve al escribir)", "Master applicationKey (hidden while typing)"), master_problem)
        api, token = auth["apiInfo"]["storageApi"]["apiUrl"], auth["authorizationToken"]
        code, d = b2_api(f"{api}/b2api/v3/b2_list_buckets", {"accountId": auth["accountId"], "bucketName": bucket}, token)
        if code != 200 or not d.get("buckets"):
            die(L(f"No existe el bucket '{bucket}' en tu cuenta de Backblaze. Créalo y vuelve a correr `andamio backups`.",
                  f"Bucket '{bucket}' doesn't exist in your Backblaze account. Create it and run `andamio backups` again."))
        name = f"andamio-{cfg.get('andamio_hostname', 'server')}"
        code, key = b2_api(f"{api}/b2api/v3/b2_create_key", {
            "accountId": auth["accountId"], "keyName": name, "bucketId": d["buckets"][0]["bucketId"],
            "capabilities": B2_CAPS}, token)
        if code != 200:
            die(L(f"Backblaze no creó la llave: {key.get('message', code)}", f"Backblaze didn't create the key: {key.get('message', code)}"))
        auth.clear()
        ok(L(f"Llave '{name}' creada: solo el bucket {bucket}, sin permiso de borrar",
             f"Key '{name}' created: bucket {bucket} only, no delete permission"))
        key_id, app_key = key["applicationKeyId"], key["applicationKey"]
    else:
        note(L("""
Crea en App Keys → Add a New Application Key una llave con acceso SOLO a ese bucket.""", """
Create a key in App Keys → Add a New Application Key with access to that bucket ONLY."""))
        key_id = ask(L("keyID de esa llave", "That key's keyID"))
        caps: dict = {}

        def key_problem_b2(k: str) -> str | None:
            d, error = b2_authorize(key_id, k)
            caps.update((d or {}).get("apiInfo", {}).get("storageApi", {}))
            return error
        app_key = ask_secret(L("applicationKey (no se ve al escribir)", "applicationKey (hidden while typing)"), key_problem_b2)
        allowed = [b.get("name") for b in caps.get("allowed", {}).get("buckets") or []]
        if bucket not in allowed:
            seen = ", ".join(filter(None, allowed)) or L("todos", "all")
            warn(L(f"Esa llave no está limitada al bucket {bucket} (puede ver: {seen}).",
                   f"That key isn't limited to bucket {bucket} (it can see: {seen})."))
        if "deleteFiles" in caps.get("allowed", {}).get("capabilities", caps.get("capabilities", [])):
            warn(L("Esa llave PUEDE BORRAR: si alguien toma el servidor, puede borrar tus backups. "
                   "Mejor deja que andamio cree una sin ese permiso (vuelve a correr y responde s).",
                   "That key CAN DELETE: if someone takes the server, they can delete your backups. "
                   "Better let andamio create one without that permission (run again and answer y)."))
        if not ask_yes(L("¿Usarla igual?", "Use it anyway?"), False):
            die(L("Cancelado: no cambié nada.", "Cancelled: nothing changed."))
    return (f"b2:{bucket}:{cfg.get('andamio_hostname', 'andamio')}",
            {"B2_ACCOUNT_ID": key_id, "B2_ACCOUNT_KEY": app_key})


def ask_s3(cfg: dict) -> tuple[str, dict]:
    note(L("""
Cualquier almacenamiento compatible con S3. Crea un bucket PRIVADO y una llave de acceso
limitada a ese bucket (si el proveedor lo permite, sin permiso de borrar y con
versionado u Object Lock). Endpoints:
  AWS S3:         s3.<región>.amazonaws.com        (ej. s3.us-east-1.amazonaws.com)
  Cloudflare R2:  <id de tu cuenta>.r2.cloudflarestorage.com   (10 GB gratis)
  Wasabi:         s3.<región>.wasabisys.com
La llave se prueba desde tu servidor en el paso siguiente.""", """
Any S3-compatible storage. Create a PRIVATE bucket and an access key limited to that
bucket (if the provider allows it, without delete permission and with versioning or
Object Lock). Endpoints:
  AWS S3:         s3.<region>.amazonaws.com        (e.g. s3.us-east-1.amazonaws.com)
  Cloudflare R2:  <your account id>.r2.cloudflarestorage.com   (10 GB free)
  Wasabi:         s3.<region>.wasabisys.com
The key is tested from your server in the next step."""))
    endpoint = ask("Endpoint", check=lambda v: None if re.fullmatch(r"(https?://)?[A-Za-z0-9.-]+(:\d+)?/?", v)
                   else L("Solo el host (ej. s3.us-east-1.amazonaws.com).", "Just the host (e.g. s3.us-east-1.amazonaws.com)."))
    endpoint = re.sub(r"^https?://", "", endpoint).rstrip("/")
    bucket = ask(L("Nombre del bucket", "Bucket name"),
                 check=lambda v: None if re.fullmatch(r"[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]", v)
                 else L("Minúsculas, números, puntos y guiones (3-63).", "Lowercase letters, digits, dots and hyphens (3-63)."))
    m = re.match(r"s3[.-]([a-z0-9-]+)\.amazonaws\.com$", endpoint)
    region = ask(L("Región", "Region"), m.group(1) if m else "auto")
    key_id = ask("Access Key ID")
    secret = ask_secret(L("Secret Access Key (no se ve al escribir)", "Secret Access Key (hidden while typing)"),
                        lambda v: None if len(v) >= 16
                        else L("Muy corta para ser una Secret Access Key.", "Too short to be a Secret Access Key."))
    return (f"s3:https://{endpoint}/{bucket}/{cfg.get('andamio_hostname', 'andamio')}",
            {"AWS_ACCESS_KEY_ID": key_id, "AWS_SECRET_ACCESS_KEY": secret, "AWS_DEFAULT_REGION": region})


def restic_probe(alias: str, repo: str, env: dict, password: str) -> tuple[str, str]:
    """Prueba el destino DESDE el servidor (allí corre restic) y crea el repositorio si no
    existe. Los secretos van en el script por stdin: ni en disco ni en la línea de comandos."""
    import shlex
    exports = " ".join(f"{k}={shlex.quote(v)}" for k, v in {**env, "RESTIC_REPOSITORY": repo,
                                                           "RESTIC_PASSWORD": password}.items())
    r = remote(alias, f"""export {exports}
if out=$(timeout 60 restic cat config 2>&1 > /dev/null); then echo ANDAMIO:EXISTE; exit 0; fi
case "$out" in *"wrong password"*|*"no key found"*) echo ANDAMIO:CLAVE; exit 0 ;; esac
if out=$(timeout 120 restic init 2>&1); then echo ANDAMIO:CREADO; exit 0; fi
echo ANDAMIO:ERROR; printf '%s\\n' "$out" | tail -n 4
""")
    lines = (r.stdout + r.stderr).strip().splitlines()
    status = next((x.split(":", 1)[1] for x in lines if x.startswith("ANDAMIO:")), "ERROR")
    return status, "\n".join(x for x in lines if not x.startswith("ANDAMIO:"))


def server_pull(cfg: dict, alias: str) -> None:
    """Trae al servidor lo último de tu repo (los scripts que van a correr), como hace un deploy."""
    infra = f"{cfg.get('andamio_root', '/srv/andamio')}/infra"
    r = run(["ssh", "-o", "BatchMode=yes", alias,
             f"flock {infra}/.git/andamio-pull.lock git -C {infra} pull --ff-only --quiet origin main"])
    if r.returncode != 0:
        warn(L("El servidor no pudo traer lo último de tu repo (¿hiciste push?); sigo con lo que tiene.",
               "The server couldn't fetch your repo's latest (did you push?); going on with what it has."))


def backups_now() -> None:
    """Un respaldo ya: el mismo servicio que corre cada noche, con su salida en vivo."""
    import shlex
    cfg, alias = load_config(), server_alias()
    if str(cfg.get("andamio_backups")).lower() != "true":
        die(L("Los backups no están activados: corre `andamio backups`.", "Backups aren't turned on: run `andamio backups`."))
    title(L("Respaldo ahora", "Backup now"))
    note(L("El mismo de cada noche: bases, datos de tus apps y la plataforma, cifrado y fuera del servidor. Tarda unos minutos.",
           "The same as every night: databases, your apps' data and the platform, encrypted and off-server. It takes a few minutes."))
    sudo_password_file(cfg, alias)
    script = ('start=$(date +%s); journalctl -u andamio-backup.service -f -o cat --since "@$start" & j=$!; '
              'systemctl start andamio-backup.service; rc=$?; sleep 1; kill $j; exit $rc')
    try:
        server_pull(cfg, alias)
        rc = remote_sudo(cfg, alias, f"bash -c {shlex.quote(script)}")
    finally:
        wipe_sudo()
    if rc != 0:
        die(L("El respaldo falló (el detalle está arriba).", "The backup failed (details above)."))
    ok(L("Respaldo hecho", "Backup done"))


def backups_list() -> None:
    """Los respaldos que hay (fecha, cuánto tardó, tamaño): los que puedes restaurar."""
    import json
    cfg, alias = load_config(), server_alias()
    if str(cfg.get("andamio_backups")).lower() != "true":
        die(L("Los backups no están activados: corre `andamio backups`.", "Backups aren't turned on: run `andamio backups`."))
    sudo_password_file(cfg, alias)
    try:
        server_pull(cfg, alias)
        rc = remote_sudo(cfg, alias, f"{cfg.get('andamio_root', '/srv/andamio')}/infra/scripts/backup-list.sh")
    finally:
        wipe_sudo()
    if rc != 0:
        die(L("No pude leer la lista de respaldos (el detalle está arriba).", "Couldn't read the list of backups (details above)."))
    r = run(["ssh", "-o", "BatchMode=yes", alias, "cat /var/lib/andamio-backup/snapshots.json"])
    snaps = json.loads(r.stdout).get("snapshots", []) if r.returncode == 0 else []
    print()
    for s in snaps:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(s["time"])) if s.get("time") else "?"
        size = f"{s['size'] / 1e9:.1f} GB" if s.get("size") else ""
        secs = f"{s['secs'] // 60} min {s['secs'] % 60} s" if s.get("secs") is not None else ""
        print(f"  {s['short']}  {when}  {size:>9}  {secs}")
    if not snaps:
        print("  " + L("Todavía no hay respaldos.", "No backups yet."))


def cmd_backups(args: argparse.Namespace) -> None:
    if getattr(args, "accion", None) in ("now", "ahora"):
        backups_now()
        return
    if getattr(args, "accion", None) in ("list", "lista"):
        backups_list()
        return
    print(L("\033[1mandamio backups\033[0m: backups diarios, cifrados y fuera del servidor. "
            "Se puede volver a correr: retoma donde quedó.",
            "\033[1mandamio backups\033[0m: daily, encrypted, off-server backups. "
            "Safe to run again: it resumes where it stopped."))
    check_tools()
    cfg = load_config()
    alias = server_alias()
    if not ssh_ok([alias]):
        die(L(f"No entro al servidor ({alias}) por SSH: corre primero `andamio servidor`.",
              f"Can't reach the server ({alias}) over SSH: run `andamio server` first."))
    note(L("""
Qué se guarda, cada noche (03:30 UTC): las bases de datos (PostgreSQL y Redis), los datos
de tus apps y la plataforma (/srv/andamio), y lo necesario para reconstruir el servidor
igual (llaves SSH, VPN, secretos del host). restic lo cifra EN el servidor antes de
enviarlo: el destino nunca ve tus datos. Se guardan 7 diarios, 4 semanales y 6 mensuales.""", """
What's saved, every night (03:30 UTC): the databases (PostgreSQL and Redis), your apps'
data and the platform (/srv/andamio), and what's needed to rebuild the same server
(SSH keys, VPN, host secrets). restic encrypts it ON the server before sending it: the
destination never sees your data. 7 daily, 4 weekly and 6 monthly are kept."""))

    if RESTIC_ENV.exists() and RESTIC_PW.exists():
        title(L("1-3. Destino", "1-3. Destination"))
        ok(L(f"Ya configurado ({RESTIC_ENV.relative_to(ROOT)})", f"Already configured ({RESTIC_ENV.relative_to(ROOT)})"))
    else:
        title(L("1. ¿Dónde se guardan?", "1. Where are they stored?"))
        kind = choose(L("Destino", "Destination"), [
            ("b2", L("Backblaze B2: 10 GB gratis; andamio crea una llave que no puede borrar",
                     "Backblaze B2: 10 GB free; andamio creates a key that can't delete")),
            ("s3", L("cualquier S3: AWS, Cloudflare R2, Wasabi, MinIO", "any S3: AWS, Cloudflare R2, Wasabi, MinIO")),
        ], "b2")
        repo, env = ask_b2(cfg) if kind == "b2" else ask_s3(cfg)

        title(L("2. Contraseña del repositorio", "2. Repository password"))
        if RESTIC_PW.exists():
            password = sops_read(RESTIC_PW).strip()
            ok(L(f"Uso la de {RESTIC_PW.relative_to(ROOT)}", f"Using the one in {RESTIC_PW.relative_to(ROOT)}"))
        else:
            password = secrets.token_urlsafe(32)
            note(L("""
Aleatoria y cifrada con sops en tu repo: no la ves ni la necesitas escribir. Para leerla
hace falta tu llave age, así que guarda esa llave fuera de esta máquina (gestor de
contraseñas): sin ella, nadie (tú tampoco) puede abrir los backups.""", """
Random and encrypted with sops in your repo: you don't see it or need to type it. Reading
it takes your age key, so keep that key off this machine too (password manager):
without it, nobody (you included) can open the backups."""))

        title(L("3. Probar el destino desde el servidor", "3. Testing the destination from the server"))
        status, detail = restic_probe(alias, repo, env, password)
        if status == "CLAVE":
            warn(L(f"Ya hay un repositorio de backups en {repo}, con otra contraseña.",
                   f"There's already a backup repository at {repo}, with another password."))
            if not ask_yes(L("¿Es tuyo (de una instalación anterior) y tienes su contraseña?",
                             "Is it yours (from a previous install) and do you have its password?"), False):
                die(L("Usa otro bucket (o borra ese repositorio) y vuelve a correr `andamio backups`.",
                      "Use another bucket (or delete that repository) and run `andamio backups` again."))
            password = ask_secret(L("Contraseña de ese repositorio (no se ve al escribir)",
                                    "That repository's password (hidden while typing)"),
                                  lambda p: None if restic_probe(alias, repo, env, p)[0] == "EXISTE"
                                  else L("No abre ese repositorio.", "It doesn't open that repository."))
            status = "EXISTE"
        if status == "ERROR":
            die(L(f"El servidor no pudo usar ese destino:\n{detail}\nRevisa el bucket y la llave, y vuelve a correr.",
                  f"The server couldn't use that destination:\n{detail}\nCheck the bucket and the key, and run again."))
        ok(L("Repositorio creado", "Repository created") if status == "CREADO"
           else L("Repositorio existente: se sigue usando", "Existing repository: it keeps being used"))
        encrypt_binary(RESTIC_PW, password + "\n")
        encrypt_binary(RESTIC_ENV, "".join(f"{k}={v}\n" for k, v in {
            "RESTIC_REPOSITORY": repo, "RESTIC_PASSWORD_FILE": "/etc/restic/password", **env}.items()))
        del password, env

    if str(cfg.get("andamio_backups")).lower() != "true":
        set_config("andamio_backups", "true")
        ok("andamio_backups: true")
    step_repo_pushed("backups")

    title(L("5. Activar en el servidor", "5. Turning it on in the server"))
    try:
        if ansible(["site.yml", "--tags", "andamio"], cfg, alias) != 0:
            die(L("No se pudo activar (el detalle está arriba). Corrígelo y vuelve a correr `andamio backups`.",
                  "Couldn't turn it on (details above). Fix it and run `andamio backups` again."))
        ok(L("Backup diario programado", "Daily backup scheduled"))

        title(L("6. Primer backup (ahora)", "6. First backup (now)"))
        note(L("Puede tardar unos minutos la primera vez.", "It can take a few minutes the first time."))
        if remote_sudo(cfg, alias, "systemctl start andamio-backup.service") != 0:
            remote_sudo(cfg, alias, "journalctl -u andamio-backup.service -n 25 --no-pager")
            die(L("El backup falló (el detalle está arriba).", "The backup failed (details above)."))
        ok(L("Primer backup hecho", "First backup done"))

        title(L("7. Prueba de restauración", "7. Restore test"))
        note(L("Restaura el backup en una base temporal y la compara con producción (no toca nada).",
               "Restores the backup into a temporary database and compares it with production (touches nothing)."))
        if remote_sudo(cfg, alias, f"{cfg.get('andamio_root', '/srv/andamio')}/infra/scripts/restore-check.sh") != 0:
            die(L("La prueba de restauración encontró diferencias (arriba). Tus backups existen, pero revísalo.",
                  "The restore test found differences (above). Your backups exist, but look into it."))
    finally:
        wipe_sudo()

    title(L("Listo: tus datos tienen copia fuera del servidor", "Done: your data has a copy off the server"))
    note(L(f"""
Cada noche a las 03:30 UTC. Con Telegram activado (andamio_telegram) te avisa del
resultado; si no, revísalo de vez en cuando:  ssh {alias} systemctl status andamio-backup
Para reconstruir todo en otro servidor: docs/runbooks/reconstruir-servidor.md""", f"""
Every night at 03:30 UTC. With Telegram on (andamio_telegram) you get the result; if not,
check it now and then:  ssh {alias} systemctl status andamio-backup
To rebuild everything on another server: docs/runbooks/reconstruir-servidor.md"""))


# ================= alertas =================

def alerts_test() -> None:
    """Un aviso de prueba por todos los canales activos (ntfy y Telegram), desde el servidor."""
    cfg, alias = load_config(), server_alias()
    msg = L("Así se verán: un contenedor caído, el disco casi lleno o una tarea que falla. Todo bien por ahora.",
            "This is how they'll look: a container down, the disk almost full or a failing task. All good for now.")
    infra = f"{cfg.get('andamio_root', '/srv/andamio')}/infra"
    r = run(["ssh", "-o", "BatchMode=yes", alias,
             f"test -r /etc/andamio/telegram.env && echo telegram; grep -q '^ANDAMIO_NTFY_URL=.' /etc/andamio/andamio.env && echo ntfy; "
             f"{infra}/scripts/notify.sh {shlex_quote(L('✓ Prueba de alertas', '✓ Alerts test'))} {shlex_quote(msg)}"])
    if r.returncode != 0:
        die(L(f"El servidor no pudo mandarla: {r.stderr.strip()}", f"The server couldn't send it: {r.stderr.strip()}"))
    channels = [c for c in ("ntfy", "telegram") if c in r.stdout.split()]
    if not channels:
        die(L("No hay alertas activadas: actívalas con `andamio alertas` (ntfy) o Telegram.",
              "No alerts are turned on: turn them on with `andamio alerts` (ntfy) or Telegram."))
    ok(L(f"Enviada desde el servidor por {' y '.join(channels)}. ¿Te llegó al celular?",
         f"Sent from the server through {' and '.join(channels)}. Did it reach your phone?"))


def shlex_quote(s: str) -> str:
    import shlex
    return shlex.quote(s)


# ---- Telegram guiado ----
TELEGRAM_ENV = ROOT / "host" / "sops" / "telegram-env.sops"
TG_TOKEN = re.compile(r"\d{5,12}:[A-Za-z0-9_-]{30,50}")
TG_CHAT = re.compile(r"-?\d{1,20}")


def tg_api(token: str, method: str, params: dict | None = None, timeout: int = 15) -> dict:
    """Una llamada a la API de bots de Telegram, desde tu máquina. El token va en la URL (así lo
    pide Telegram) pero nunca en la línea de comandos ni en un log."""
    import json
    import urllib.error
    import urllib.request
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/{method}",
                                 data=json.dumps(params or {}).encode(), headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return json.load(e)
        except ValueError:
            return {"ok": False, "error_code": e.code, "description": str(e.code)}
    except OSError as e:
        return {"ok": False, "description": str(e)}


def tg_check(token: str) -> dict:
    """¿Es un token válido? Devuelve el bot ({bot, name}) o el error."""
    if not TG_TOKEN.fullmatch(token):
        return {"error": L("Eso no parece un token de bot (se ve así: 123456789:AA…).", "That doesn't look like a bot token (it looks like 123456789:AA…).")}
    r = tg_api(token, "getMe")
    if not r.get("ok"):
        return {"error": L("Telegram dice que ese token no sirve (¿revocado o mal copiado?).", "Telegram says that token doesn't work (revoked or mistyped?).")
                if r.get("error_code") in (401, 404) else L(f"No pude hablar con Telegram: {r.get('description', '')}", f"Couldn't reach Telegram: {r.get('description', '')}")}
    return {"bot": r["result"].get("username", ""), "name": r["result"].get("first_name", "")}


def tg_chats(token: str, wait: int = 0) -> dict:
    """Los chats que le escribieron al bot (para no tener que buscar tu ID). wait: segundos de
    espera (long polling) si todavía no hay ninguno."""
    r = tg_api(token, "getUpdates", {"timeout": wait, "allowed_updates": ["message"]}, timeout=wait + 15)
    if not r.get("ok"):
        if r.get("error_code") == 409:
            return {"chats": [], "error": L("Ese bot ya lo está usando tu servidor (su bot responde los mensajes): escribe tu ID de chat a mano, o usa un bot nuevo.",
                                             "Your server is already using that bot (it answers its messages): type your chat ID by hand, or use a new bot.")}
        return {"chats": [], "error": r.get("description", "")}
    chats = {}
    for u in r.get("result", []):
        c = (u.get("message") or {}).get("chat") or {}
        if c.get("id") is not None:
            name = " ".join(x for x in (c.get("first_name"), c.get("last_name")) if x) or c.get("title") or ""
            chats[c["id"]] = {"id": str(c["id"]), "name": name, "username": c.get("username", ""), "type": c.get("type", "")}
    return {"chats": list(chats.values()), "error": ""}


def cmd_telegram(args: argparse.Namespace) -> None:
    """Telegram guiado: el bot, tu chat (sin buscar IDs), cifrado en tu repo y aplicado."""
    import getpass
    cfg = load_config()
    on = str(cfg.get("andamio_telegram", "")).lower() == "true"
    if args.accion in ("prueba", "test"):
        alerts_test()
        return
    git = ["git", "-C", str(ROOT)]
    if args.accion in ("desactivar", "off"):
        if not on:
            ok(L("Telegram ya está desactivado.", "Telegram is already off."))
            return
        set_config("andamio_telegram", "false")
        if (run([*git, "add", str(CONFIG)]).returncode != 0 or run([*git, "commit", "-qm", "andamio: Telegram desactivado"]).returncode != 0
                or push_copy() != 0):
            die(L("No pude subir el cambio: súbelo a mano y vuelve a correr `andamio telegram desactivar`.",
                  "Couldn't push the change: push it by hand and run `andamio telegram off` again."))
    else:
        print(L("\033[1mandamio telegram\033[0m: avisos al celular por Telegram (deploys, backups, tareas, alertas) y un bot que responde /system.",
                "\033[1mandamio telegram\033[0m: phone notices through Telegram (deploys, backups, tasks, alerts) and a bot that answers /system."))
        check_tools()
        note(L("""
1. En Telegram, abre @BotFather y mándale /newbot. Elige un nombre y un usuario (termina en "bot").
2. Te da un token (123456789:AA…): pégalo aquí. No se muestra, y se guarda cifrado en tu repo.""", """
1. In Telegram, open @BotFather and send /newbot. Pick a name and a username (ending in "bot").
2. It gives you a token (123456789:AA…): paste it here. It isn't shown, and it's saved encrypted in your repo."""))
        token = sys.stdin.readline().strip() if args.token_stdin else getpass.getpass(L("  Token del bot: ", "  Bot token: ")).strip()
        bot = tg_check(token)
        if "error" in bot:
            die(bot["error"])
        ok(L(f"Bot: @{bot['bot']} ({bot['name']})", f"Bot: @{bot['bot']} ({bot['name']})"))
        chat = args.chat or ""
        if chat and not TG_CHAT.fullmatch(chat):
            die(L(f"ID de chat inválido: {chat}", f"Invalid chat ID: {chat}"))
        if not chat:
            note(L(f"\n3. Abre https://t.me/{bot['bot']} y toca Iniciar (o mándale /start). Te espero…",
                   f"\n3. Open https://t.me/{bot['bot']} and tap Start (or send it /start). Waiting for you…"))
            found: list[dict] = []
            deadline = time.time() + 180
            while time.time() < deadline and not found:
                r = tg_chats(token, wait=20)
                if r["error"]:
                    die(r["error"])
                found = [c for c in r["chats"] if c["type"] == "private"] or r["chats"]
            if not found:
                die(L("No me llegó ningún mensaje en 3 minutos. Vuelve a correr `andamio telegram`. Si es el bot que ya usa "
                      "tu servidor, su bot se queda con los mensajes: usa `--chat <tu ID>` o un bot nuevo.",
                      "No message arrived in 3 minutes. Run `andamio telegram` again. If it's the bot your server already uses, "
                      "its bot takes the messages: use `--chat <your ID>` or a new bot."))
            if len(found) == 1:
                c = found[0]
                if not ask_yes(L(f"¿Eres tú: {c['name']}{' (@' + c['username'] + ')' if c['username'] else ''}?",
                                 f"Is this you: {c['name']}{' (@' + c['username'] + ')' if c['username'] else ''}?"), True):
                    die(L("Cancelado.", "Cancelled."))
                chat = c["id"]
            else:
                chat = choose(L("¿Cuál eres tú?", "Which one is you?"),
                              [(c["id"], f"{c['name']} {'@' + c['username'] if c['username'] else ''}") for c in found], found[0]["id"])
        encrypt_binary(TELEGRAM_ENV, f"TELEGRAM_TOKEN={token}\nTELEGRAM_CHAT_ID={chat}\n")
        token = ""
        set_config("andamio_telegram", "true")
        if (run([*git, "add", str(CONFIG), str(TELEGRAM_ENV)]).returncode != 0
                or run([*git, "commit", "-qm", f"andamio: Telegram {'cambiado' if on else 'activado'} (@{bot['bot']})"]).returncode != 0
                or push_copy() != 0):
            die(L("No pude subir el cambio: súbelo a mano y vuelve a correr `andamio telegram`.",
                  "Couldn't push the change: push it by hand and run `andamio telegram` again."))
    title(L("Servidor: aplicar (pide tu contraseña de sudo)", "Server: applying (asks for your sudo password)"))
    alias = server_alias()
    try:
        if ansible(["site.yml", "--tags", "andamio"], cfg, alias) != 0:
            die(L("No se pudo aplicar (el detalle está arriba).", "Couldn't apply it (details above)."))
    finally:
        wipe_sudo()
    if args.accion in ("desactivar", "off"):
        ok(L("Telegram desactivado: sin avisos, sin resumen diario y sin bot.", "Telegram off: no notices, no daily summary, no bot."))
        return
    alerts_test()
    note(L("Desde ahora: deploys que fallan, backups, tareas que fallan, alertas y un resumen diario. El bot responde /system.",
           "From now on: failed deploys, backups, failing tasks, alerts and a daily summary. The bot answers /system."))


def cmd_zona(args: argparse.Namespace) -> None:
    """La zona horaria de tus tareas programadas (andamio_timezone): verla o cambiarla."""
    import yaml
    cfg = load_config()
    now = cfg.get("andamio_timezone") or ""
    if not args.zona:
        print(now or L("(sin elegir: se pregunta con la primera tarea)", "(not chosen: asked with the first task)"))
        return
    if err := check_timezone(args.zona):
        die(err)
    if args.zona == now:
        ok(L(f"Ya es {now}", f"It's already {now}"))
        return
    tasks = sum(len((yaml.safe_load(f.read_text()) or {}).get("cron") or []) for f in (ROOT / "apps").glob("*/app.yml"))
    set_config("andamio_timezone", args.zona)
    ok(f"andamio_timezone: {args.zona}")
    git = ["git", "-C", str(ROOT)]
    if (run([*git, "add", str(CONFIG)]).returncode != 0
            or run([*git, "commit", "-qm", f"andamio: zona horaria {args.zona}"]).returncode != 0
            or push_copy() != 0):
        die(L("No pude subir el cambio: súbelo a mano y vuelve a correr `andamio zona`.",
              "Couldn't push the change: push it by hand and run `andamio timezone` again."))
    if not tasks:
        ok(L("Sin tareas programadas: nada más que aplicar.", "No scheduled tasks: nothing else to apply."))
        return
    title(L(f"Servidor: tus {tasks} tareas a la hora nueva (pide tu contraseña de sudo)",
            f"Server: your {tasks} tasks to the new time (asks for your sudo password)"))
    alias = server_alias()
    try:
        if ansible(["site.yml", "--tags", "andamio"], cfg, alias) != 0:
            die(L("No se pudo aplicar (el detalle está arriba).", "Couldn't apply it (details above)."))
    finally:
        wipe_sudo()
    ok(L(f"Tus tareas corren ahora en {args.zona}.", f"Your tasks now run in {args.zona}."))


# ================= PostgreSQL, Redis y MariaDB compartidos (andamio servicios) =================

# Los de ansible/roles/andamio/defaults/main.yml (un test comprueba que coinciden).
SERVICE_DEFAULTS = {
    "postgres": {"mem": "1g", "cpus": "1.5", "max_connections": "100", "work_mem": "4MB"},
    "redis": {"engine": "redis", "mem": "256m", "cpus": "0.5", "policy": "noeviction"},
    "mariadb": {"mem": "512m", "cpus": "1", "max_connections": "100"},
}
SERVICE_NAMES = {"postgres": "PostgreSQL", "redis": "Redis", "mariadb": "MariaDB"}
REDIS_POLICIES = ["noeviction", "allkeys-lru", "allkeys-lfu", "volatile-lru", "volatile-lfu", "volatile-ttl"]
# Los motores de Redis (stacks/data/compose.yaml): hablan el mismo protocolo; cambiar copia los datos.
REDIS_ENGINES = {"redis": "Redis", "valkey": "Valkey", "dragonfly": "Dragonfly"}
DRAGONFLY_POLICIES = ["noeviction", "allkeys-lru", "allkeys-lfu"]   # Dragonfly: rechaza, o borra (cache_mode)
SV_MEM = re.compile(r"[1-9][0-9]{0,5}[mg]")
SV_WORK_MEM = re.compile(r"[1-9][0-9]{0,3}(kB|MB)")


def mem_mb(v: str) -> int:
    return int(v[:-1]) * (1024 if v[-1].lower() == "g" else 1)


def services_config(cfg: dict | None = None) -> dict:
    """Lo configurado (group_vars) o, si no está, lo de siempre."""
    cfg = cfg if cfg is not None else ui_config()
    return {svc: {k: str(cfg.get(f"andamio_{svc}_{k}", v)) for k, v in vals.items()}
            for svc, vals in SERVICE_DEFAULTS.items()}


def service_db_limits() -> dict[str, dict]:
    """Las apps con PostgreSQL, MariaDB o Redis, y los límites de su base (app.yml: db_connections,
    db_timeout; valen para la base que tenga)."""
    out = {}
    for f in sorted((ROOT / "apps").glob("*/app.yml")):
        a = yaml_load(f) or {}
        if a.get("db") or a.get("redis") or a.get("mysql"):
            out[f.parent.name] = {"db": bool(a.get("db")), "redis": bool(a.get("redis")), "mysql": bool(a.get("mysql")),
                                  "db_connections": int(a.get("db_connections") or 0),
                                  "db_timeout": str(a.get("db_timeout") or "0")}
    return out


def services_check(svc: str, new: dict, server: dict | None) -> str:
    """El error de una configuración nueva (o ""). `server`: CPUs y memoria del servidor, si se sabe."""
    p, r, m = new["postgres"], new["redis"], new["mariadb"]
    apps = service_db_limits()
    mariadb_on = any(a["mysql"] for a in apps.values())
    if not SV_MEM.fullmatch(p["mem"]) or mem_mb(p["mem"]) < 256:
        return L(f"Memoria de PostgreSQL inválida: {p['mem']} (desde 256m; ej. 512m, 2g)",
                 f"Invalid PostgreSQL memory: {p['mem']} (from 256m; e.g. 512m, 2g)")
    if not SV_MEM.fullmatch(r["mem"]) or mem_mb(r["mem"]) < 32:
        return L(f"Memoria de Redis inválida: {r['mem']} (desde 32m; ej. 256m, 1g)",
                 f"Invalid Redis memory: {r['mem']} (from 32m; e.g. 256m, 1g)")
    if not SV_MEM.fullmatch(m["mem"]) or mem_mb(m["mem"]) < 256:
        return L(f"Memoria de MariaDB inválida: {m['mem']} (desde 256m; ej. 512m, 1g)",
                 f"Invalid MariaDB memory: {m['mem']} (from 256m; e.g. 512m, 1g)")
    if not m["max_connections"].isdigit() or not 20 <= int(m["max_connections"]) <= 1000:
        return L("Conexiones máximas de MariaDB: entre 20 y 1000", "MariaDB max connections: between 20 and 1000")
    for name, v in (("PostgreSQL", p["cpus"]), ("Redis", r["cpus"]), ("MariaDB", m["cpus"])):
        if not CPUS.fullmatch(v) or float(v) < 0.1:
            return L(f"CPU de {name} inválida: {v} (ej. 0.5, 1, 2)", f"Invalid {name} CPU: {v} (e.g. 0.5, 1, 2)")
        if server and float(v) > server["cpus"]:
            return L(f"{name}: el servidor tiene {server['cpus']} CPU", f"{name}: the server has {server['cpus']} CPUs")
    if not p["max_connections"].isdigit() or not 20 <= int(p["max_connections"]) <= 1000:
        return L("Conexiones máximas: entre 20 y 1000", "Max connections: between 20 and 1000")
    if not SV_WORK_MEM.fullmatch(p["work_mem"]) or (p["work_mem"].endswith("MB") and int(p["work_mem"][:-2]) > 1024):
        return L(f"Memoria por consulta inválida: {p['work_mem']} (ej. 4MB, 16MB, 512kB)",
                 f"Invalid memory per query: {p['work_mem']} (e.g. 4MB, 16MB, 512kB)")
    if r["policy"] not in REDIS_POLICIES:
        return L(f"Política inválida: {r['policy']} ({', '.join(REDIS_POLICIES)})", f"Invalid policy: {r['policy']} ({', '.join(REDIS_POLICIES)})")
    if r["engine"] not in REDIS_ENGINES:
        return L(f"Motor inválido: {r['engine']} ({', '.join(REDIS_ENGINES)})", f"Invalid engine: {r['engine']} ({', '.join(REDIS_ENGINES)})")
    if r["engine"] == "dragonfly":
        if mem_mb(r["mem"]) < 256:
            return L("Dragonfly necesita al menos 256m (256 MB por hilo)", "Dragonfly needs at least 256m (256 MB per thread)")
        if r["policy"] not in DRAGONFLY_POLICIES:
            return L(f"Dragonfly no tiene {r['policy']}: usa {', '.join(DRAGONFLY_POLICIES)}",
                     f"Dragonfly has no {r['policy']}: use {', '.join(DRAGONFLY_POLICIES)}")
    for name, conf, key in (("PostgreSQL", p, "db"), ("MariaDB", m, "mysql")):
        top = max((a["db_connections"] for a in apps.values() if a[key]), default=0)
        if top and top > int(conf["max_connections"]) - 5:
            return L(f"Una app tiene un límite de {top} conexiones: {name} necesita al menos {top + 5}",
                     f"An app has a limit of {top} connections: {name} needs at least {top + 5}")
    if server:
        need = mem_mb(p["mem"]) + mem_mb(r["mem"]) * 3 // 2 + (mem_mb(m["mem"]) if mariadb_on else 0)
        room = int(server["mem_total"] / 1048576 * 0.7)
        if need > room:
            who = L("PostgreSQL, Redis y MariaDB" if mariadb_on else "PostgreSQL y Redis",
                    "PostgreSQL, Redis and MariaDB" if mariadb_on else "PostgreSQL and Redis")
            return L(f"{who} pedirían {need} MB, y el servidor deja hasta {room} MB (70 % de su memoria) "
                     "para no dejar a las apps sin espacio.",
                     f"{who} would ask for {need} MB, and the server allows up to {room} MB (70% of its memory) "
                     "so the apps don't run out.")
    return ""


# Corre en el servidor (python3 por stdin): cuánto usan PostgreSQL y Redis ahora. Nada secreto:
# tamaños, conexiones por usuario (el nombre de cada app) y memoria.
SERVICES_LIVE = r"""
import json, os, re, subprocess
def sh(*a):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=20).stdout
    except Exception:
        return ""
UNITS = {"B": 1, "KiB": 1024, "MiB": 1024 ** 2, "GiB": 1024 ** 3, "kB": 1000, "MB": 1000 ** 2, "GB": 1000 ** 3}
def size(v):
    m = re.match(r"([0-9.]+)\s*([A-Za-z]+)", v.strip())
    return int(float(m.group(1)) * UNITS.get(m.group(2), 1)) if m else None
out = {"postgres": {}, "redis": {}, "mariadb": {}}
running = sh("docker", "ps", "--format", "{{.Names}}").split()
names = [n for n in ("postgres", "redis", "mariadb") if n in running]
for line in (sh("docker", "stats", "--no-stream", "--format", "{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}", *names).splitlines() if names else []):
    name, mem, cpu = (line.split("\t") + ["", "", ""])[:3]
    if name in out:
        out[name].update(mem_used=size(mem.split("/")[0]), cpu=float(cpu.rstrip("%") or 0), up=True)
q = ("SELECT json_build_object('version', current_setting('server_version'), "
     "'conns', (SELECT coalesce(json_object_agg(u, n), '{}') FROM (SELECT usename u, count(*) n FROM pg_stat_activity "
     "WHERE backend_type = 'client backend' AND usename IS NOT NULL AND pid <> pg_backend_pid() GROUP BY 1) x), "
     "'sizes', (SELECT json_object_agg(datname, pg_database_size(datname)) FROM pg_database WHERE NOT datistemplate))")
try:
    out["postgres"].update(json.loads(sh("docker", "exec", "postgres", "sh", "-c", 'psql -U "$POSTGRES_USER" -d postgres -tAc "$0"', q)))
except ValueError:
    pass
info = dict(l.split(":", 1) for l in sh("docker", "exec", "redis", "redis-cli", "info").splitlines() if ":" in l and not l.startswith("#"))
users = {}
for l in sh("docker", "exec", "redis", "redis-cli", "client", "list").splitlines():
    m = re.search(r"\buser=(\S+)", l)
    if m:
        users[m.group(1)] = users.get(m.group(1), 0) + 1
if info:
    engine = ("valkey" if info.get("server_name", "").strip() == "valkey" else
              "dragonfly" if "dragonfly_version" in info else "redis")
    version = (info.get("valkey_version") or info.get("dragonfly_version") or info.get("redis_version") or "").strip()
    out["redis"].update(engine=engine, version=version.removeprefix("df-v"), data_used=int(info.get("used_memory", "0")),
                        peak=int(info.get("used_memory_peak", "0")), evicted=int(info.get("evicted_keys", "0")),
                        keys=sum(int(re.search(r"keys=(\d+)", v).group(1)) for k, v in info.items() if re.fullmatch(r"db\d+", k)),
                        clients=users)
# De cada app, su usuario y su base (de DATABASE_URL en su .env; la clave no se lee ni sale).
roles = {}
root = "/srv/andamio/infra/apps"
for app in sorted(os.listdir(root)) if os.path.isdir(root) else []:
    try:
        env = open(os.path.join(root, app, ".env")).read()
    except OSError:
        continue
    m = re.search(r"(?m)^DATABASE_URL=postgres(?:ql)?://([a-z0-9_]+):[^@]*@[^/]+/([a-z0-9_]+)", env)
    if m:
        roles[app] = {"role": m.group(1), "db": m.group(2)}
out["postgres"]["apps"] = roles
# MariaDB (solo si corre): versión, conexiones por usuario y tamaño de cada base.
if "mariadb" in running:
    mq = ("SELECT JSON_OBJECT('version', VERSION(), "
          "'conns', (SELECT COALESCE(JSON_OBJECTAGG(u, n), '{}') FROM (SELECT USER u, COUNT(*) n FROM information_schema.PROCESSLIST "
          "WHERE USER NOT IN ('root', 'system user', 'event_scheduler') AND ID <> CONNECTION_ID() GROUP BY USER) x), "
          "'sizes', (SELECT COALESCE(JSON_OBJECTAGG(s, b), '{}') FROM (SELECT TABLE_SCHEMA s, SUM(DATA_LENGTH + INDEX_LENGTH) b "
          "FROM information_schema.TABLES WHERE TABLE_SCHEMA NOT IN ('mysql', 'sys', 'performance_schema', 'information_schema') "
          "GROUP BY TABLE_SCHEMA) y))")
    try:
        got = json.loads(sh("docker", "exec", "mariadb", "sh", "-c", 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot -N -B -r -e "$0"', mq) or "{}")
        # MariaDB devuelve los objetos de adentro como texto JSON.
        got.update({k: json.loads(got[k]) for k in ("conns", "sizes") if isinstance(got.get(k), str)})
        got["version"] = got.get("version", "").split("-")[0]
        out["mariadb"].update(got)
    except ValueError:
        pass
    users = {}
    for app in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        try:
            env = open(os.path.join(root, app, ".env")).read()
        except OSError:
            continue
        m = re.search(r"(?m)^MYSQL_URL=mysql://([a-z0-9_]+):[^@]*@[^/]+/([a-z0-9_]+)", env)
        if m:
            users[app] = {"role": m.group(1), "db": m.group(2)}
    out["mariadb"]["apps"] = users
mem = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in open("/proc/meminfo"))}
out["server"] = {"cpus": os.cpu_count(), "mem_total": mem["MemTotal"]}
print(json.dumps(out))
"""


def ui_data_services() -> dict:
    """La página Servicios: lo configurado, lo que usan ahora y los límites de cada app."""
    apps = service_db_limits()
    out: dict = {"config": services_config(), "defaults": SERVICE_DEFAULTS, "policies": REDIS_POLICIES,
                 "engines": list(REDIS_ENGINES), "dragonfly_policies": DRAGONFLY_POLICIES,
                 "apps": apps, "mariadb_needed": any(a["mysql"] for a in apps.values()), "live": None, "error": ""}
    try:
        out["live"] = ui_remote(SERVICES_LIVE)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        out["error"] = str(e) or L("No pude leer el estado del servidor", "Couldn't read the server's status")
    return out


def cmd_servicios(args: argparse.Namespace) -> None:
    """PostgreSQL, Redis y MariaDB compartidos: ver cómo están o cambiar su memoria, CPU y ajustes."""
    cfg = load_config()
    cur = services_config(cfg)
    flags = {"postgres": {"mem": args.mem, "cpus": args.cpus, "max_connections": args.max_connections, "work_mem": args.work_mem},
             "redis": {"engine": args.engine, "mem": args.mem, "cpus": args.cpus, "policy": args.policy},
             "mariadb": {"mem": args.mem, "cpus": args.cpus, "max_connections": args.max_connections}}
    if not args.servicio:
        try:
            live = ui_remote(SERVICES_LIVE)
        except (RuntimeError, ValueError, subprocess.TimeoutExpired):
            live = {}
        mb = lambda b: f"{(b or 0) / 1048576:.0f} MB"   # noqa: E731
        pg, rd = live.get("postgres") or {}, live.get("redis") or {}
        p, r = cur["postgres"], cur["redis"]
        title(f"PostgreSQL {pg.get('version', '')}".strip())
        print(f"  {L('Memoria', 'Memory'):<20} {p['mem']}" + (f"   ({L('usa', 'using')} {mb(pg.get('mem_used'))})" if pg.get("up") else ""))
        print(f"  {'CPU':<20} {p['cpus']}" + (f"   ({pg.get('cpu', 0):.1f} %)" if pg.get("up") else ""))
        print(f"  {L('Conexiones máx.', 'Max connections'):<20} {p['max_connections']}" +
              (f"   ({L('abiertas', 'open')} {sum((pg.get('conns') or {}).values())})" if pg.get("conns") is not None else ""))
        print(f"  {L('Memoria por consulta', 'Memory per query'):<20} {p['work_mem']}")
        title(f"{REDIS_ENGINES.get(rd.get('engine') or r['engine'], 'Redis')} {rd.get('version', '')}".strip())
        print(f"  {L('Motor', 'Engine'):<20} {r['engine']}")
        print(f"  {L('Memoria (datos)', 'Memory (data)'):<20} {r['mem']}" + (f"   ({L('usa', 'using')} {mb(rd.get('data_used'))})" if rd else ""))
        print(f"  {'CPU':<20} {r['cpus']}")
        print(f"  {L('Si se llena', 'When full'):<20} {r['policy']}")
        md, mc = live.get("mariadb") or {}, cur["mariadb"]
        if md.get("up") or any(a["mysql"] for a in service_db_limits().values()):
            title(f"MariaDB {md.get('version', '')}".strip())
            print(f"  {L('Memoria', 'Memory'):<20} {mc['mem']}" + (f"   ({L('usa', 'using')} {mb(md.get('mem_used'))})" if md.get("up") else ""))
            print(f"  {'CPU':<20} {mc['cpus']}")
            print(f"  {L('Conexiones máx.', 'Max connections'):<20} {mc['max_connections']}" +
                  (f"   ({L('abiertas', 'open')} {sum((md.get('conns') or {}).values())})" if md.get("conns") is not None else ""))
        note(L("\nCambiar: andamio servicios postgres --mem 2g --cpus 1 --max-connections 150 --work-mem 8MB\n"
               "         andamio servicios redis --engine valkey --mem 512m --cpus 0.5 --policy noeviction\n"
               "         andamio servicios mariadb --mem 1g --cpus 1 --max-connections 150\n"
               "Por app: andamio app set <app> --db-connections 20 --db-timeout 30s",
               "\nChange: andamio services postgres --mem 2g --cpus 1 --max-connections 150 --work-mem 8MB\n"
               "        andamio services redis --engine valkey --mem 512m --cpus 0.5 --policy noeviction\n"
               "        andamio services mariadb --mem 1g --cpus 1 --max-connections 150\n"
               "Per app: andamio app set <app> --db-connections 20 --db-timeout 30s"))
        return
    svc = args.servicio
    wrong = sorted({k for other, fl in flags.items() if other != svc for k, v in fl.items()
                    if v is not None and k not in flags[svc]})
    if wrong:
        die(L(f"{svc} no tiene --{wrong[0].replace('_', '-')}", f"{svc} has no --{wrong[0].replace('_', '-')}"))
    new = {k: dict(v) for k, v in cur.items()}
    for k, v in flags[svc].items():
        if v is not None:
            new[svc][k] = str(v)
    changes = {k: (cur[svc][k], v) for k, v in new[svc].items() if v != cur[svc][k]}
    if not changes:
        ok(L(f"{svc} ya tiene esos valores: nada que cambiar", f"{svc} already has those values: nothing to change"))
        return
    try:
        server = ui_remote(SERVICES_LIVE).get("server")
    except (RuntimeError, ValueError, subprocess.TimeoutExpired):
        server = None
    if err := services_check(svc, new, server):
        die(err)
    print()
    for k, (a, b) in changes.items():
        print(f"  {svc}.{k}: {a} → {b}")
    print()
    if svc == "redis" and changes.get("policy", ("", "noeviction"))[1] != "noeviction":
        warn(L("Con esa política, cuando Redis se llena borra claves para hacer espacio. Si una app guarda colas ahí "
               "(BullMQ, Sidekiq, Celery), perdería trabajos sin avisar.",
               "With that policy, when Redis fills up it deletes keys to make room. If an app keeps queues there "
               "(BullMQ, Sidekiq, Celery), it would lose jobs silently."))
    if "engine" in changes:
        a, b = (REDIS_ENGINES[x] for x in changes["engine"])
        note(L(f"Cambiar de {a} a {b} copia todas las claves al motor nuevo (sus archivos no son compatibles): "
               "mientras se copia, las escrituras esperan (las lecturas siguen). El volumen del anterior queda.",
               f"Switching from {a} to {b} copies every key to the new engine (their files aren't compatible): "
               "while it copies, writes wait (reads go on). The old engine's volume is kept."))
        if changes["engine"][1] == "dragonfly":
            warn(L("Dragonfly no guarda cada segundo (AOF): guarda una foto cada minuto y al apagarse. En un corte "
                   "de luz o un reinicio forzado podrías perder hasta un minuto de datos.",
                   "Dragonfly doesn't save every second (AOF): it saves a snapshot every minute and on shutdown. On a "
                   "power cut or a forced restart you could lose up to a minute of data."))
    name = REDIS_ENGINES[new["redis"]["engine"]] if svc == "redis" else SERVICE_NAMES[svc]
    if not ask_yes(L(f"¿Aplicar? {name} se reinicia: las apps pierden la conexión unos segundos y se reconectan solas",
                     f"Apply? {name} restarts: apps lose the connection for a few seconds and reconnect by themselves"), True):
        die(L("Cancelado", "Cancelled"))
    for k, (_, v) in changes.items():
        set_config(f"andamio_{svc}_{k}", v)
    git = ["git", "-C", str(ROOT)]
    msg = f"andamio: {svc} " + ", ".join(f"{k}={v}" for k, (_, v) in changes.items())
    if (run([*git, "add", str(CONFIG)]).returncode != 0 or run([*git, "commit", "-qm", msg]).returncode != 0
            or push_copy() != 0):
        die(L("No pude subir el cambio: súbelo a mano y vuelve a correr el comando.",
              "Couldn't push the change: push it by hand and run the command again."))
    title(L(f"Servidor: {name} con su configuración nueva (pide tu contraseña de sudo)",
            f"Server: {name} with its new configuration (asks for your sudo password)"))
    alias = server_alias()
    try:
        if ansible(["servicios.yml"], cfg, alias) != 0:
            die(L("No se pudo aplicar (el detalle está arriba).", "Couldn't apply it (details above)."))
    finally:
        wipe_sudo()
    ok(L(f"{name} corre con su configuración nueva.", f"{name} runs with its new configuration."))


def cmd_alertas(args: argparse.Namespace) -> None:
    if getattr(args, "accion", None) in ("prueba", "test"):
        alerts_test()
        return
    print(L("\033[1mandamio alertas\033[0m: que te avise al celular si un contenedor se cae o el disco se llena.",
            "\033[1mandamio alerts\033[0m: get a phone notification if a container goes down or the disk fills up."))
    cfg = load_config()
    alias = server_alias()
    current = str(cfg.get("andamio_alerts_ntfy") or "")
    note(L("""
Las manda ntfy: una app gratuita (Android, iOS o el navegador) que recibe notificaciones
de un "tema" sin crear cuenta. andamio inventa un tema largo y aleatorio: quien no lo
conozca no puede leerlo. Los avisos pasan por ntfy.sh; si prefieres, usa tu propio
servidor ntfy. (Con Telegram activado, también llegan ahí.)""", """
ntfy sends them: a free app (Android, iOS or the browser) that receives notifications from
a "topic" without an account. andamio makes up a long random topic: whoever doesn't know it
can't read it. Notices go through ntfy.sh; if you prefer, use your own ntfy server.
(With Telegram on, they go there too.)"""))
    options = [("ntfy.sh", L("tema nuevo en ntfy.sh, gratis y sin cuenta (recomendado)",
                             "new topic on ntfy.sh, free and no account (recommended)")),
               ("propio", L("mi propio servidor ntfy (te pido la URL del tema)", "my own ntfy server (asks for the topic URL)"))]
    if current:
        ok(L(f"Hoy: {current}", f"Now: {current}"))
        options = [("probar", L("mandar una de prueba al tema actual", "send a test one to the current topic"))] + options + \
                  [("quitar", L("dejar de usar ntfy", "stop using ntfy"))]
    # --ntfy (el panel, o sin preguntas): nuevo | <URL de tu servidor ntfy> | quitar.
    given = getattr(args, "ntfy", None)
    NTFY_URL = r"https://[A-Za-z0-9.-]+(:\d+)?/[A-Za-z0-9_-]{1,64}"
    if given:
        if given in ("nuevo", "new"):
            how = "ntfy.sh"
        elif given in ("quitar", "off"):
            how = "quitar"
        elif re.fullmatch(NTFY_URL, given):
            how = "propio"
        else:
            die(L("--ntfy: nuevo, quitar o la URL https de tu tema (ej. https://ntfy.tudominio.com/alertas)",
                  "--ntfy: new, off or your topic's https URL (e.g. https://ntfy.yourdomain.com/alerts)"))
    else:
        how = choose(L("¿Qué hago?", "What should I do?"), options, options[0][0])
    url = current
    if how == "ntfy.sh":
        url = f"https://ntfy.sh/andamio-{secrets.token_hex(12)}"
    elif how == "propio" and given:
        url = given
    elif how == "propio":
        url = ask(L("URL del tema (ej. https://ntfy.tudominio.com/alertas)", "Topic URL (e.g. https://ntfy.yourdomain.com/alerts)"),
                  check=lambda v: None if re.fullmatch(r"https://[A-Za-z0-9.-]+(:\d+)?/[A-Za-z0-9_-]{1,64}", v)
                  else L("Una URL https con el tema al final.", "An https URL with the topic at the end."))
    elif how == "quitar":
        url = ""
    if url != current:
        set_config("andamio_alerts_ntfy", url)
        ok(f"andamio_alerts_ntfy: {url or L('(sin ntfy)', '(no ntfy)')}")
        git = ["git", "-C", str(ROOT)]
        if (run([*git, "add", str(CONFIG)]).returncode != 0
                or run([*git, "commit", "-qm", f"andamio: alertas {'por ntfy' if url else 'sin ntfy'}"]).returncode != 0
                or push_copy() != 0):
            die(L("No pude subir el cambio de configuración: súbelo a mano y vuelve a correr `andamio alertas`.",
                  "Couldn't push the configuration change: push it by hand and run `andamio alerts` again."))
        title(L("Servidor: aplicar (pide tu contraseña de sudo)", "Server: applying (asks for your sudo password)"))
        try:
            if ansible(["site.yml", "--tags", "secretos"], cfg, alias) != 0:
                die(L("No se pudo aplicar (el detalle está arriba).", "Couldn't apply it (details above)."))
        finally:
            wipe_sudo()
    if not url:
        ok(L("Sin ntfy. Telegram, si está activado, sigue avisando.", "No ntfy. Telegram, if it's on, keeps notifying."))
        return
    if how != "probar":
        topic = url.rsplit("/", 1)[-1]
        title(L("Suscríbete en tu celular", "Subscribe on your phone"))
        note(L(f"""
1. Instala ntfy (Play Store, App Store o F-Droid), o abre {url} en el navegador.
2. En la app: + (suscribirse a un tema) y escribe:  {topic}""" + ("" if url.startswith("https://ntfy.sh/") else
               f"\n   (servidor: {url.rsplit('/', 1)[0]})"), f"""
1. Install ntfy (Play Store, App Store or F-Droid), or open {url} in the browser.
2. In the app: + (subscribe to a topic) and type:  {topic}""" + ("" if url.startswith("https://ntfy.sh/") else
               f"\n   (server: {url.rsplit('/', 1)[0]})")))
        if shutil.which("qrencode"):
            run_qr = subprocess.run(["qrencode", "-t", "ansiutf8", url], check=False)
            if run_qr.returncode == 0:
                note(L("(o escanea el código con la cámara)", "(or scan the code with the camera)"))
        sys.stdout.flush()
        if given:   # sin preguntas: la prueba, cuando te suscribas (andamio alertas prueba, o el panel)
            ok(L("Listo. Cuando estés suscrito, manda una de prueba: andamio alertas prueba",
                 "Done. Once you're subscribed, send a test one: andamio alerts test"))
            return
        input(L("  Cuando estés suscrito, presiona Enter para mandar una de prueba… ",
                "  Once subscribed, press Enter to send a test one… "))
    # La prueba sale DESDE el servidor: así se comprueba también que llega a ntfy.
    msg = L("Así se verán: un contenedor caído o el disco casi lleno. Todo bien por ahora.",
            "This is how they'll look: a container down or the disk almost full. All good for now.")
    title_q = urllib.parse.quote(L(f"✓ Prueba de alertas · {cfg['andamio_domain']}", f"✓ Alerts test · {cfg['andamio_domain']}"))
    r = remote(alias, f"curl -fsS -m 15 --data-binary @- '{url}?title={title_q}' > /dev/null", stdin=msg)
    if r.returncode != 0:
        die(L(f"El servidor no pudo mandarla: {r.stderr.strip()}", f"The server couldn't send it: {r.stderr.strip()}"))
    ok(L("Enviada desde el servidor. ¿Te llegó al celular?", "Sent from the server. Did it reach your phone?"))
    note(L("Desde ahora: aviso si un contenedor se cae, se reinicia en bucle o queda enfermo más de un minuto, "
           "si el disco pasa del 85 %, y otro cuando se resuelve.",
           "From now on: a notice if a container goes down, crash-loops or stays unhealthy for over a minute, "
           "if the disk goes over 85%, and another one when it's resolved."))


# ================= app: Dockerfile para el repo de una app =================
# Lo llama bin/andamio-app (andamio app create) con el repo de la app ya clonado.

DOCKERFILES = ROOT / "templates" / "dockerfiles"
KINDS = {"node": ("Node", "3000"), "python": ("Python", "8000"), "go": ("Go", "8080"),
         "static": (L("sitio estático", "static site"), "8080")}
DOCKERIGNORE = {
    "node": ".git\nnode_modules\n.next/cache\n.env*\nnpm-debug.log*\n",
    "python": ".git\n.venv\nvenv\n__pycache__\n*.pyc\n.pytest_cache\n.env*\n",
    "go": ".git\n.env*\n",
    "static": ".git\n.github\n.env*\nDockerfile\n.dockerignore\n",
}


def detect_kind(d: Path) -> str | None:
    if (d / "package.json").exists():
        return "node"
    if (d / "requirements.txt").exists() or (d / "pyproject.toml").exists():
        return "python"
    if (d / "go.mod").exists():
        return "go"
    if (d / "index.html").exists():
        return "static"
    return None


def render_dockerfile(kind: str, values: dict[str, str]) -> str:
    """La plantilla con sus valores; de los comentarios #es:/#en: queda el del idioma actual."""
    out = []
    for line in (DOCKERFILES / f"{kind}.Dockerfile").read_text().splitlines(keepends=True):
        if line[:5] in ("#es: ", "#en: "):
            if line[1:3] == LANG:
                out.append("# " + line[5:])
            continue
        out.append(line)
    text = "".join(out)
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", v)
    if "{{" in text:
        die(f"templates/dockerfiles/{kind}.Dockerfile: {re.findall(r'{{[A-Z_]+}}', text)}")
    return text


def node_values(d: Path) -> tuple[dict[str, str], str]:
    import json
    pkg = json.loads((d / "package.json").read_text())
    scripts, deps = pkg.get("scripts", {}), {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
    if (d / "pnpm-lock.yaml").exists():
        m = re.match(r"pnpm@(\d+)", pkg.get("packageManager", ""))
        pm, setup, manifests = "pnpm", f"RUN npm install -g pnpm@{m.group(1) if m else 10}\n", "package.json pnpm-lock.yaml"
        install, run, prune = "pnpm install --frozen-lockfile", "pnpm run", "RUN pnpm prune --prod"
    elif (d / "yarn.lock").exists():
        pm, setup, manifests = "yarn", "RUN corepack enable\n", "package.json yarn.lock"
        install, run = "yarn install --frozen-lockfile", "yarn run"
        prune = "RUN yarn install --production --frozen-lockfile --ignore-scripts"
    else:
        lock = (d / "package-lock.json").exists()
        pm, setup = "npm", ""
        manifests = "package.json package-lock.json" if lock else "package.json"
        install, run, prune = ("npm ci" if lock else "npm install"), "npm run", "RUN npm prune --omit=dev"
    test = scripts.get("test", "")
    start = scripts.get("start") or ("next start" if "next" in deps else f"node {pkg.get('main', 'index.js')}")
    return {
        "PM": pm, "NODE": "24", "PM_SETUP": setup, "MANIFESTS": manifests, "INSTALL": install,
        "BUILD": f"RUN {run} build" if "build" in scripts else "",
        "TEST": f"\nFROM build AS test\nRUN {run} test\n" if test and "no test specified" not in test else "",
        "PRUNE": prune,
    }, start


def python_values(d: Path) -> tuple[dict[str, str], str]:
    req = d / "requirements.txt"
    deps = (req.read_text() if req.exists() else (d / "pyproject.toml").read_text()).lower()
    install = ("COPY requirements.txt ./\nRUN pip install -r requirements.txt\nCOPY . ." if req.exists()
               else "COPY . .\nRUN pip install .")
    has_tests = (d / "tests").is_dir() or any(d.glob("test_*.py"))
    mod = "main" if (d / "main.py").exists() else "app" if (d / "app.py").exists() else "main"
    wsgi = next(iter(d.glob("*/wsgi.py")), None)
    if (d / "manage.py").exists() and wsgi:
        start, need = f"gunicorn {wsgi.parent.name}.wsgi --bind 0.0.0.0:$PORT", "gunicorn"
    elif "fastapi" in deps:
        start, need = f"uvicorn {mod}:app --host 0.0.0.0 --port $PORT", "uvicorn"
    elif "flask" in deps:
        start, need = f"gunicorn {mod}:app --bind 0.0.0.0:$PORT", "gunicorn"
    else:
        start, need = f"python {mod}.py", ""
    if need and need not in deps:
        warn(L(f"Para arrancar así hace falta {need} en tus dependencias (agrégalo a requirements.txt).",
               f"Starting it this way needs {need} in your dependencies (add it to requirements.txt)."))
    return {"PY": "3.13", "INSTALL": install,
            "TEST": "\nFROM build AS test\nRUN pip install pytest && python -m pytest -q\n" if has_tests else ""}, start


def go_values(d: Path) -> dict[str, str]:
    m = re.search(r"^go (\d+\.\d+)", (d / "go.mod").read_text(), re.M)
    mains = [p.parent for p in d.glob("cmd/*/main.go")]
    pkg = "." if (d / "main.go").exists() or not mains else f"./{mains[0].relative_to(d)}"
    return {"GO": m.group(1) if m else "1.27", "GOSUM": "go.sum " if (d / "go.sum").exists() else "", "PKG": pkg}


def cmd_scaffold(args: argparse.Namespace) -> None:
    """Interno: Dockerfile para el repo clonado de una app. Escribe el resultado en args.out
    (status=existing|generated|declined|unknown, port=...) para que bin/andamio-app siga."""
    d, out = Path(args.dir), Path(args.out)
    if (d / "Dockerfile").exists():
        ok(L("Tu repo ya tiene Dockerfile: lo uso tal cual.", "Your repo already has a Dockerfile: using it as is."))
        out.write_text(f"status=existing\nport={args.port}\n")
        return
    kind = detect_kind(d)
    if not kind:
        warn(L("Tu repo no tiene Dockerfile y no reconozco el lenguaje (busqué package.json, requirements.txt, "
               "pyproject.toml, go.mod, index.html). Escribe un Dockerfile y vuelve a correr.",
               "Your repo has no Dockerfile and I don't recognize the language (looked for package.json, "
               "requirements.txt, pyproject.toml, go.mod, index.html). Write a Dockerfile and run again."))
        out.write_text(f"status=unknown\nport={args.port}\n")
        return
    label, default_port = KINDS[kind]
    port = "8080" if kind == "static" else (args.port or default_port)
    note(L(f"Tu repo no tiene Dockerfile. Detecté: {label}. Te propongo uno listo para el pipeline "
           "(tests antes de desplegar, imagen final mínima y sin root).",
           f"Your repo has no Dockerfile. Detected: {label}. Here's one ready for the pipeline "
           "(tests before deploying, minimal final image, no root)."))
    values: dict[str, str] = {"PORT": port}
    if kind in ("node", "python"):
        extra, start = node_values(d) if kind == "node" else python_values(d)
        values.update(extra)
        print(L(f"  Tu app arrancará con:  \033[1m{start}\033[0m\n"
                f"  \033[2m(escucha en el puerto {port}: andamio le pasa $PORT={port})\033[0m",
                f"  Your app will start with:  \033[1m{start}\033[0m\n"
                f"  \033[2m(it listens on port {port}: andamio passes it $PORT={port})\033[0m"))
        chosen = os.environ.get("ANDAMIO_START_CMD", "").strip()
        if chosen and "\n" not in chosen:   # desde el panel: el comando que elegiste en la página
            start = chosen
            ok(L(f"Arranca con: {start} (lo elegiste en el panel)", f"Starts with: {start} (you chose it in the panel)"))
        elif not ask_yes(L("¿Arranca así?", "Start it like this?"), True):
            while True:
                ans = ask(L("Comando que arranca tu app (como lo correrías en tu máquina; usa $PORT para el puerto)",
                            "Command that starts your app (as you'd run it locally; use $PORT for the port)"), "").strip()
                if ans.isdigit():   # respondieron un puerto: el comando sugerido ya usa $PORT
                    port = values["PORT"] = ans
                    ok(L(f"Puerto {port}, con el comando sugerido.", f"Port {port}, with the suggested command."))
                    break
                if ans:
                    start = ans
                    break
        values["START"] = start.replace("\\", "\\\\").replace('"', '\\"')
    elif kind == "go":
        values.update(go_values(d))
        note(L(f"Tu app tiene que escuchar en el puerto {port} (o leerlo de la variable PORT).",
               f"Your app must listen on port {port} (or read it from the PORT variable)."))
    text = render_dockerfile(kind, values)
    print("\n" + "\n".join(f"    \033[2m{x}\033[0m" for x in text.splitlines()) + "\n")
    if not ask_yes(L("¿Uso este Dockerfile? (se sube a tu repo al final, junto con el CI)",
                     "Use this Dockerfile? (it's pushed to your repo at the end, along with CI)"), True):
        out.write_text(f"status=declined\nport={args.port}\n")
        return
    (d / "Dockerfile").write_text(text)
    if not (d / ".dockerignore").exists():
        (d / ".dockerignore").write_text(DOCKERIGNORE[kind])
    out.write_text(f"status=generated\nport={port}\n")


# ================= revisión previa =================

SOURCE_EXT = {".py", ".js", ".mjs", ".cjs", ".ts", ".mts", ".jsx", ".tsx", ".go", ".rb", ".php"}
SKIP_DIRS = {".git", "node_modules", "vendor", "dist", "build", ".next", "venv", ".venv", "__pycache__", "test", "tests"}
LOCALHOST = re.compile(
    r"""(listen\s*\([^)]*['"](127\.0\.0\.1|localhost)['"]"""          # Node: listen(3000, "localhost")
    r"""|host\s*=\s*['"](127\.0\.0\.1|localhost)['"]"""                # Python: host="127.0.0.1"
    r"""|--host[= ](127\.0\.0\.1|localhost)\b"""                       # uvicorn/gunicorn en la línea de comandos
    r"""|\bapp\.run\(\s*\)"""                                          # Flask: app.run() escucha en 127.0.0.1
    r"""|ListenAndServe\(\s*"(127\.0\.0\.1|localhost):)""")            # Go
FIXED_PORT = re.compile(r"""(?:listen\s*\(\s*|port\s*[=:]\s*|ListenAndServe\(\s*":)(\d{2,5})\b""", re.I)
DISK = re.compile(
    r"""(sqlite3?|better-sqlite3|\.sqlite\b|\.db['"]|provider\s*=\s*"sqlite"|multer\(|UPLOAD_FOLDER|MEDIA_ROOT"""
    r"""|writeFile(Sync)?\(|appendFile(Sync)?\(|createWriteStream\(|open\([^)]*['"][wa]b?\+?['"]"""
    r"""|\.write_(text|bytes)\(|\.open\(\s*['"][wa]|\.save\(\s*['"/]|os\.WriteFile\(|os\.Create\()""")

# Lo que se parece a un archivo .db pero es una clave de configuración: config.get('redis.db'),
# settings["mongo.db"]. Se quita de la línea antes de buscar escrituras a disco.
DISK_NOT = re.compile(r"""get\s*(?:<[^>]*>)?\(\s*['"][\w.-]+\.db['"]|\[\s*['"][\w.-]+\.db['"]\s*\]""")


# Imágenes base sin parches de seguridad (a 2026-10): Node < 22 y las impares (19, 21, 23, 25),
# Python ≤ 3.9 y Debian stretch/buster/bullseye.
def eol_image(img: str) -> str:
    """La imagen que conviene si `img` ya no tiene soporte; "" si está bien."""
    name, _, tag = img.lower().rpartition("/")[2].partition(":")
    if name == "node" and (m := re.match(r"(\d+)", tag)):
        major = int(m.group(1))
        if major < 22 or (major % 2 and major <= 25):
            return "node:24"
    if name == "python" and (m := re.match(r"3\.(\d+)", tag)) and int(m.group(1)) <= 9:
        return "python:3.13"
    if re.search(r"\b(stretch|buster|bullseye)\b", tag):
        return name + ":" + re.sub(r"\b(stretch|buster|bullseye)\b", "bookworm", tag)
    return ""


def dockerfile_findings(d: Path) -> list[tuple[bool, str]]:
    """Lo que un Dockerfile propio deja mal en el servidor: imagen sin soporte, npm en la imagen
    final (Trivy le encuentra CVEs y frena el deploy), imagen base pesada y COPY sin .dockerignore."""
    f = d / "Dockerfile"
    if not f.is_file():
        return []
    text = f.read_text(errors="ignore")
    stages = re.findall(r"(?im)^\s*FROM\s+(?:--\S+\s+)*(\S+)(?:\s+AS\s+(\S+))?", text)
    if not stages:
        return []
    alias = {a.lower(): img for img, a in stages if a}

    def base(img: str) -> str:   # una etapa que parte de otra: hasta la imagen real
        for _ in range(10):
            if img.lower() not in alias:
                break
            img = alias[img.lower()]
        return img
    out: list[tuple[bool, str]] = []
    eol = {img: new for img, _ in stages if img.lower() not in alias and (new := eol_image(img))}
    if eol:
        old, new = ", ".join(eol), ", ".join(sorted(set(eol.values())))
        out.append((False, L(f"Imagen base sin soporte ({old}): ya no recibe parches de seguridad y el escaneo del pipeline "
                             f"(Trivy) puede frenar el deploy. Sube a {new}.",
                             f"Unsupported base image ({old}): it no longer gets security patches and the pipeline's scan "
                             f"(Trivy) may stop the deploy. Move to {new}.")))
    final = base(stages[-1][0]).lower()
    last = re.split(r"(?im)^\s*FROM\s", text)[-1]
    fname, _, ftag = final.rpartition("/")[2].partition(":")
    if fname == "node" and not re.search(r"rm\s+-\w+[^\n]*/usr/local/(lib/node_modules|bin/npm)", last):
        via_npm = re.search(r"(?im)^\s*(CMD|ENTRYPOINT)\b.*\b(npm|yarn|pnpm)\b", last)
        out.append((False, L("La imagen final trae npm, y Trivy suele encontrarle CVEs que frenan el deploy. Bórralo en la última "
                             "etapa: RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx"
                             + (" (y arranca con node, no con npm start)." if via_npm else "."),
                             "The final image carries npm, and Trivy often finds CVEs in it that stop the deploy. Remove it in the "
                             "last stage: RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx"
                             + (" (and start with node, not npm start)." if via_npm else "."))))
    if fname in ("node", "python") and not re.search(r"slim|alpine", ftag):
        out.append((False, L(f"La imagen final parte de {final} (~1 GB): con {fname}:<versión>-slim o -alpine pesa varias veces "
                             "menos, y cada deploy sube y baja más rápido.",
                             f"The final image starts from {final} (~1 GB): with {fname}:<version>-slim or -alpine it's several "
                             "times smaller, and every deploy pushes and pulls faster.")))
    if len(stages) == 1 and re.search(r"(?m)\bnpm (ci|install)\b(?![^\n]*(--omit=dev|--production|--only=prod))", text):
        out.append((False, L("Una sola etapa con npm install: la imagen lleva las devDependencies y lo usado para compilar. "
                             "Con varias etapas (como el Dockerfile que propone andamio) queda solo lo que corre.",
                             "A single stage with npm install: the image carries devDependencies and the build tooling. "
                             "With several stages (like the Dockerfile andamio proposes) only what runs stays.")))
    if re.search(r"(?im)^\s*(COPY|ADD)\s+(--\S+\s+)*\.\s", text) and not (d / ".dockerignore").is_file():
        out.append((False, L("COPY . sin .dockerignore: a la imagen va todo, también .git (tu historial). "
                             "Crea un .dockerignore con al menos: .git, node_modules, .env*",
                             "COPY . without .dockerignore: everything goes into the image, .git (your history) included. "
                             "Create a .dockerignore with at least: .git, node_modules, .env*")))
    return out


REDIS_LIB = re.compile(r"""(?:from|require\(|import)\s*['"]?(ioredis|redis|bullmq|bull|@nestjs/bull\w*|connect-redis|"""
                       r"""cache-manager-redis\S*|@keyv/redis|rq|celery)\b|^\s*import\s+redis\b""", re.M)


def redis_findings(texts: list[str]) -> list[tuple[bool, str]]:
    """Redis en andamio: cada app tiene su usuario (en REDIS_URL) y solo puede usar claves que
    empiezan con «<app>:». Un código armado con REDIS_HOST/REDIS_PASSWORD, o sin prefijo, falla."""
    code = "\n".join(texts)
    if not REDIS_LIB.search(code) and not re.search(r"\bREDIS_(HOST|PASSWORD|PORT)\b", code):
        return []
    out: list[tuple[bool, str]] = []
    if "REDIS_URL" not in code:
        out.append((False, L("Tu código arma la conexión a Redis sin REDIS_URL. andamio entrega Redis solo como REDIS_URL "
                             "(con el usuario y la clave de la app): sin usuario, Redis rechaza la conexión. Lee REDIS_URL.",
                             "Your code builds the Redis connection without REDIS_URL. andamio gives Redis only as REDIS_URL "
                             "(with the app's own user and password): without a user, Redis rejects the connection. Read REDIS_URL.")))
    if not re.search(r"(?i)key_?prefix|\bprefix\s*[:=]|REDIS_PREFIX", code):
        out.append((False, L("En andamio cada app solo puede usar claves de Redis que empiezan con «<app>:» (las demás dan NOPERM). "
                             "Pon ese prefijo: keyPrefix en ioredis, prefix en BullMQ.",
                             "On andamio each app can only use Redis keys starting with “<app>:” (others get NOPERM). "
                             "Set that prefix: keyPrefix in ioredis, prefix in BullMQ.")))
    return out


def precheck_findings(d: Path, port: str, has_volume: bool) -> list[tuple[bool, str]]:
    """(grave, mensaje) de lo que haría fallar o perder datos en un servidor."""
    out: list[tuple[bool, str]] = []
    tracked = run(["git", "-C", str(d), "ls-files"]).stdout.split()
    envs = [f for f in tracked if re.fullmatch(r"(.*/)?\.env(\.(local|production|prod))?", f)]
    if envs:
        out.append((True, L(f"{', '.join(envs)} está subido al repo: tus secretos quedan en el historial de git. "
                            f"Sácalo (git rm --cached {envs[0]}, y agrégalo a .gitignore), cambia esas claves y "
                            "ponlas con andamio app secret set.",
                            f"{', '.join(envs)} is committed to the repo: your secrets stay in git history. "
                            f"Remove it (git rm --cached {envs[0]}, and add it to .gitignore), rotate those keys and "
                            "set them with andamio app secret set.")))
    local, ports, disk = [], set(), []
    # El bloque `if __name__ == "__main__":` de Python solo corre si el contenedor arranca el
    # archivo (python main.py), no con uvicorn/gunicorn/flask: entonces no cuenta.
    dockerfile = d / "Dockerfile"
    cmd = " ".join(re.findall(r"(?m)^\s*(?:CMD|ENTRYPOINT)\s+(.+)$", dockerfile.read_text(errors="ignore"))) \
        if dockerfile.is_file() else ""
    runs_py_file = bool(re.search(r"python[0-9.]*\W+[\w./-]+\.py", cmd))
    files = [d / f for f in tracked if Path(f).suffix in SOURCE_EXT or Path(f).name in ("Dockerfile", "Procfile", "package.json")]
    texts: list[str] = []
    for f in files:
        rel = str(f.relative_to(d))
        if set(Path(rel).parts) & SKIP_DIRS or not f.is_file() or f.stat().st_size > 200_000:
            continue
        main_indent = None
        content = f.read_text(errors="ignore")
        if f.suffix in SOURCE_EXT:
            texts.append(content)
        for n, line in enumerate(content.splitlines(), 1):
            if line.lstrip().startswith(("#", "//")):
                continue
            if f.suffix == ".py":
                indent = len(line) - len(line.lstrip())
                if re.match(r"\s*if\s+__name__\s*==\s*['\"]__main__['\"]", line):
                    main_indent = indent
                    continue
                if main_indent is not None and line.strip() and indent <= main_indent:
                    main_indent = None
                if main_indent is not None and not runs_py_file:
                    continue   # solo corre en tu máquina
            if LOCALHOST.search(line) and "0.0.0.0" not in line:
                local.append(f"{rel}:{n}")
            if (m := FIXED_PORT.search(line)) and "PORT" not in line:
                ports.add((m.group(1), f"{rel}:{n}"))
            if DISK.search(DISK_NOT.sub("", line)):
                disk.append(f"{rel}:{n}")
    if local:
        out.append((True, L(f"Escucha en localhost ({', '.join(local[:3])}): dentro del contenedor nadie más llega. "
                            "Haz que escuche en 0.0.0.0.",
                            f"Listens on localhost ({', '.join(local[:3])}): inside the container nobody else reaches it. "
                            "Make it listen on 0.0.0.0.")))
    other = sorted({p for p, _ in ports if p != port})
    if other and port:
        where = next(w for p, w in sorted(ports) if p == other[0])
        out.append((False, L(f"Puerto fijo {other[0]} en el código ({where}), y andamio va a usar el {port}. "
                             f"Lee el puerto de la variable PORT, o crea la app con --port {other[0]}.",
                             f"Fixed port {other[0]} in the code ({where}), and andamio will use {port}. "
                             f"Read the port from the PORT variable, or create the app with --port {other[0]}.")))
    if disk and not has_volume:
        out.append((False, L(f"Parece guardar archivos o una base SQLite ({', '.join(disk[:3])}). En un contenedor se "
                             "pierden en cada deploy: usa --volume /data (y guarda ahí) o --db para PostgreSQL.",
                             f"It seems to store files or a SQLite database ({', '.join(disk[:3])}). In a container they're "
                             "lost on every deploy: use --volume /data (and store there) or --db for PostgreSQL.")))
    return out + redis_findings(texts) + dockerfile_findings(d)


def cmd_precheck(args: argparse.Namespace) -> None:
    """Interno (andamio app create): revisa el repo clonado antes de registrar la app.
    Sale con 2 si hay algo grave (andamio-app pregunta si seguir), 0 si no."""
    findings = precheck_findings(Path(args.dir), args.port, args.volume == "1")
    if not findings:
        ok(L("Revisión previa: nada que corregir", "Pre-check: nothing to fix"))
        return
    title(L("Revisión previa: antes del primer deploy", "Pre-check: before the first deploy"))
    for serious, msg in findings:
        if serious:
            warn(msg)
        else:
            note(L("Aviso: ", "Note: ") + msg)
    sys.exit(2 if any(s for s, _ in findings) else 0)


# ================= app.yml =================

def yaml_set(text: str, changes: list[str]) -> tuple[str, list[str]]:
    """Cambia valores de un app.yml línea por línea (`port=8080`, `resources.mem=512m`): los
    comentarios y el orden quedan como estaban. Devuelve (texto, ["clave: antes → después"])."""
    lines = text.split("\n")
    out = []
    for change in changes:
        key, value = change.split("=", 1)
        parent, child = key.split(".", 1) if "." in key else (None, key)
        block, found = None, None
        for i, line in enumerate(lines):
            top = re.match(r"^([A-Za-z_][\w-]*):", line)
            if top:
                block = top.group(1)
            if (parent is None and top and block == child) or \
               (parent and block == parent and re.match(rf"^\s+{re.escape(child)}:", line)):
                found = i
                break
        if found is None:
            if parent:
                die(L(f"{key}: no está en el app.yml", f"{key}: not in the app.yml"))
            # Una clave que falta (health) va justo después de port.
            at = next((i + 1 for i, l in enumerate(lines) if l.startswith("port:")), len(lines))
            lines.insert(at, f"{child}: {value}")
            out.append(f"{key}: ({L('ninguna', 'none')}) → {value}")
            continue
        m = re.match(r"^(\s*[\w-]+:\s*)(.*?)(\s+#.*)?$", lines[found])
        old = m.group(2).strip('"')
        if old == value:
            continue
        lines[found] = m.group(1) + value + (m.group(3) or "")
        out.append(f"{key}: {old} → {value}")
    return "\n".join(lines), out


# ================= tareas programadas (cron: en app.yml) =================

CRON_NAME = re.compile(r"[a-z][a-z0-9-]{0,29}")


def cron_lib():
    """El conversor cron → systemd que usa Ansible (ansible/filter_plugins): uno solo para los dos."""
    import importlib.util
    sys.dont_write_bytecode = True   # sin __pycache__ en tu repo
    spec = importlib.util.spec_from_file_location("andamio_cron", ROOT / "ansible" / "filter_plugins" / "andamio_cron.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def local_timezone() -> str:
    """La zona horaria de esta máquina (America/Bogota), o UTC si no se puede saber."""
    r = run(["timedatectl", "show", "-p", "Timezone", "--value"]) if shutil.which("timedatectl") else None
    if r and r.returncode == 0 and "/" in r.stdout:
        return r.stdout.strip()
    target = str(Path("/etc/localtime").resolve())
    if "zoneinfo/" in target:
        return target.split("zoneinfo/", 1)[1]
    try:
        return Path("/etc/timezone").read_text().strip() or "UTC"
    except OSError:
        return "UTC"


def check_timezone(v: str) -> str | None:
    from zoneinfo import ZoneInfo
    try:
        ZoneInfo(v)
        return None
    except (ValueError, KeyError, OSError):
        return L(f"No conozco la zona «{v}» (ej. America/Bogota, Europe/Madrid, UTC).",
                 f"Unknown time zone '{v}' (e.g. America/New_York, Europe/Madrid, UTC).")


def cron_timezone() -> str:
    """La zona de las tareas (andamio_timezone): la primera vez, la de tu máquina, confirmada."""
    import yaml
    tz = (yaml.safe_load(CONFIG.read_text()) or {}).get("andamio_timezone")
    if tz:
        return tz
    # Desde el panel: la zona ya se eligió en la página (la de tu navegador, confirmada).
    given = os.environ.get("ANDAMIO_TIMEZONE", "")
    if given and not check_timezone(given):
        set_config("andamio_timezone", given)
        ok(L(f"Zona horaria de tus tareas: {given} (guardada en tu configuración)",
             f"Your tasks' time zone: {given} (saved in your configuration)"))
        return given
    note(L("Las tareas corren a la hora que escribas, en tu zona horaria (el servidor usa UTC).",
           "Tasks run at the time you write, in your time zone (the server uses UTC)."))
    tz = ask(L("Tu zona horaria (se guarda en tu configuración)", "Your time zone (saved in your configuration)"),
             local_timezone(), check_timezone)
    set_config("andamio_timezone", tz)
    return tz


def next_run(calendar: str) -> str:
    """Próxima vez, según systemd-analyze de esta máquina (si lo hay)."""
    if not shutil.which("systemd-analyze"):
        return ""
    r = run(["systemd-analyze", "calendar", calendar])
    m = re.search(r"Next elapse: (.+)", r.stdout)
    return m.group(1).strip() if r.returncode == 0 and m else ""


def cron_entries(text: str) -> list[dict]:
    import yaml
    return (yaml.safe_load(text) or {}).get("cron") or []


def cron_write(text: str, entries: list[dict]) -> str:
    """Reescribe el bloque cron: de un app.yml (al final); el resto queda igual."""
    import json
    out, skipping = [], False
    for line in text.rstrip("\n").split("\n"):
        if re.match(r"^cron:", line):
            skipping = True
            continue
        if skipping and (not line.strip() or line[0] in " \t-"):
            continue
        skipping = False
        out.append(line)
    if entries:
        out.append("cron:")
        for e in entries:
            out += [f"  - name: {e['name']}", f"    schedule: {json.dumps(e['schedule'])}",
                    f"    command: {json.dumps(e['command'], ensure_ascii=False)}"]
    return "\n".join(out) + "\n"


def cron_default_name(command: str, taken: list[str]) -> str:
    """Un nombre a partir del comando: «python limpiar.py» → limpiar, «npm run report» → report."""
    words = [w for w in command.split() if not w.startswith("-")]
    base = re.sub(r"[^a-z0-9]+", "-", Path(words[-1]).stem.lower()).strip("-") if words else ""
    base = (base if CRON_NAME.fullmatch(base[:30] or "-") else L("tarea", "task"))[:26]
    name, n = base, 2
    while name in taken:
        name, n = f"{base}-{n}", n + 1
    return name


def cmd_cron(args: list[str]) -> None:
    """Interno (andamio app cron): _cron add <app.yml> <horario> <comando> [nombre] | rm <app.yml> <nombre>
    | list <app.yml> <app>. add y rm editan el app.yml; bin/andamio-app hace el commit y lo aplica."""
    op, f = args[0], Path(args[1])
    text = f.read_text()
    entries = cron_entries(text)
    names = [e["name"] for e in entries]
    if op == "add":
        schedule, command = " ".join(args[2].split()), args[3].strip()
        lib = cron_lib()
        try:
            calendar = lib.cron_calendar(schedule)
        except lib.CronError as e:
            die(str(e))
        if not command or "\n" in command or len(command) > 500:
            die(L("El comando va en una sola línea (hasta 500 caracteres).", "The command goes on one line (up to 500 characters)."))
        name = args[4] if len(args) > 4 and args[4] else cron_default_name(command, names)
        if not CRON_NAME.fullmatch(name):
            die(L(f"Nombre inválido: {name} (minúsculas, números y guiones; empieza con letra)",
                  f"Invalid name: {name} (lowercase letters, digits and hyphens; starts with a letter)"))
        if name in names:
            die(L(f"Ya hay una tarea {name}: usa otro --name, o quítala antes (app cron rm)",
                  f"There's already a task {name}: use another --name, or remove it first (app cron rm)"))
        tz = cron_timezone()
        f.write_text(cron_write(text, [*entries, {"name": name, "schedule": schedule, "command": command}]))
        nxt = next_run(f"{calendar} {tz}")
        print(f"  {L('Tarea', 'Task'):<9} {name}\n  {L('Comando', 'Command'):<9} {command}\n"
              f"  {L('Horario', 'Schedule'):<9} {schedule}   ({tz})"
              + (f"\n  {L('Próxima', 'Next'):<9} {nxt}" if nxt else ""))
    elif op == "rm":
        name = args[2]
        if name not in names:
            die(L(f"No hay una tarea {name}. Tareas: {', '.join(names) or 'ninguna'}",
                  f"No task {name}. Tasks: {', '.join(names) or 'none'}"))
        f.write_text(cron_write(text, [e for e in entries if e["name"] != name]))
    elif op == "edit":
        name, schedule, command = args[2], " ".join(args[3].split()), args[4].strip()
        current = next((e for e in entries if e["name"] == name), None)
        if not current:
            die(L(f"No hay una tarea {name}. Tareas: {', '.join(names) or 'ninguna'}",
                  f"No task {name}. Tasks: {', '.join(names) or 'none'}"))
        if schedule:
            lib = cron_lib()
            try:
                lib.cron_calendar(schedule)
            except lib.CronError as e:
                die(str(e))
        if command and ("\n" in command or len(command) > 500):
            die(L("El comando va en una sola línea (hasta 500 caracteres).", "The command goes on one line (up to 500 characters)."))
        new = {**current, **({"schedule": schedule} if schedule else {}), **({"command": command} if command else {})}
        if new == current:
            die(L("Nada que cambiar: es igual a la de ahora.", "Nothing to change: it's the same as now."))
        f.write_text(cron_write(text, [new if e["name"] == name else e for e in entries]))
        for k in ("schedule", "command"):
            if new[k] != current[k]:
                print(f"  {k}: {current[k]}  →  {new[k]}")
    elif op == "runs":
        cron_runs_print(args[2], args[3])
    elif op == "list":
        cron_list(args[2], entries)


def cron_runs(app: str, task: str) -> list[dict]:
    """Las últimas corridas programadas de una tarea (las guarda app-cron.sh), de la más nueva a la
    más vieja: código, inicio, segundos y su salida."""
    script = (f"for f in $(ls -1 /var/lib/andamio-cron/{app}.{task}.runs/*.log 2> /dev/null | sort -r | head -n 5); "
              "do printf '\\036'; cat \"$f\"; done")
    r = run([*ssh_cmd("-n"), script])
    out = []
    for chunk in r.stdout.split("\x1e")[1:]:
        head, _, body = chunk.partition("\n")
        parts = head.split()
        if len(parts) == 3 and all(p.lstrip("-").isdigit() for p in parts):
            out.append({"rc": int(parts[0]), "start": int(parts[1]), "secs": int(parts[2]), "output": body.rstrip("\n")})
    return out


def cron_runs_print(app: str, task: str) -> None:
    runs = cron_runs(app, task)
    if not runs:
        print(L(f"  {task} todavía no tiene corridas programadas guardadas (las a mano no se guardan).",
                f"  {task} has no saved scheduled runs yet (manual ones aren't saved)."))
        return
    for r in runs:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(r["start"]))
        mark = "\033[32m✓\033[0m" if r["rc"] == 0 else f"\033[31m✗ {L('código', 'code')} {r['rc']}\033[0m"
        print(f"\n  {mark}  {when}  ({r['secs']} s)")
        print("\n".join("    " + line for line in r["output"].splitlines()[-40:]) or "    " + L("(sin salida)", "(no output)"))


def cron_live(app: str, entries: list[dict], tz: str) -> dict[str, tuple[str, list[str]]]:
    """Del servidor, por tarea: (próxima vez en tu zona, [código, inicio, segundos] de la última).
    Próxima: "-" = sin aplicar; "*" = corriendo ahora (systemd no la da mientras corre)."""
    if not entries:
        return {}
    script = "".join(
        f"u=andamio-cron-{app}.{e['name']}; printf '%s|' {e['name']}; "
        f"if [ \"$(systemctl show $u.timer -p LoadState --value)\" != loaded ]; then printf -- '-'; "
        f"elif [ \"$(systemctl is-active $u.service)\" = activating ]; then printf '*'; "
        f"else TZ={tz} systemctl show $u.timer -p NextElapseUSecRealtime --value | tr -d '\\n'; fi; printf '|'; "
        f"cat /var/lib/andamio-cron/{app}.{e['name']} 2> /dev/null || echo; " for e in entries)
    r = run([*ssh_cmd("-n"), script])
    live = {}
    for line in r.stdout.splitlines():
        name, nxt, last = (line.split("|") + ["", ""])[:3]
        live[name] = (nxt.strip(), last.split())
    return live


def cron_list(app: str, entries: list[dict]) -> None:
    import yaml
    if not entries:
        print(L(f"  {app} no tiene tareas. Agrega una:  andamio app cron add {app} \"0 3 * * *\" \"python limpiar.py\"",
                f"  {app} has no tasks. Add one:  andamio app cron add {app} \"0 3 * * *\" \"python cleanup.py\""))
        return
    tz = (yaml.safe_load(CONFIG.read_text()) or {}).get("andamio_timezone") or "UTC"
    live = cron_live(app, entries, tz)
    failed = []
    for e in entries:
        nxt, last = live.get(e["name"], ("-", []))
        nxt = {"-": L(f"(sin aplicar: andamio app apply {app})", f"(not applied: andamio app apply {app})"),
               "*": L("corriendo ahora", "running now"), "": "?"}.get(nxt, nxt)
        if len(last) == 3:
            rc, start, secs = last
            ago = int(time.time()) - int(start)
            when = L("hace segundos", "seconds ago") if ago < 60 else L("hace", "") + " " + (
                f"{ago // 86400} d" if ago >= 86400 else f"{ago // 3600} h" if ago >= 3600 else f"{ago // 60} min") + L("", " ago")
            res = (f"\033[32m✓\033[0m" if rc == "0" else f"\033[31m✗ {L('código', 'exit code')} {rc}\033[0m") + \
                f" {when.strip()} ({secs} s)"
            if rc != "0":
                failed.append(e["name"])
        else:
            res = f"\033[2m{L('todavía no ha corrido', 'not run yet')}\033[0m"
        print(f"\n  \033[1m{e['name']}\033[0m  {e['schedule']}  \033[2m({tz})\033[0m\n    {e['command']}")
        print(f"    {L('Próxima', 'Next')}: {nxt}   ·   {L('Última', 'Last')}: {res}")
    if failed:
        print("\n  " + L(f"Por qué falló (ver su salida): andamio app cron run {app} {failed[0]}",
                         f"Why it failed (see its output): andamio app cron run {app} {failed[0]}"))


# ================= panel local (andamio ui) =================
# Un servidor web en TU máquina (127.0.0.1), no en el servidor: habla con él por SSH, como la
# CLI. Fase 1: solo mira (apps, estado, tareas, deploys y logs). Ver docs/decisions/0028.

UI_DIR = ROOT / "ui"
APP_NAME = re.compile(r"[a-z][a-z0-9-]{1,28}[a-z0-9]")
RESERVED_SECRETS = {"DOMAIN", "DATABASE_URL", "MYSQL_URL", "REDIS_URL", "TAG"}

# Corre en el servidor (python3 por stdin), en una sola conexión: el contenedor más nuevo de cada
# app (sin los de las tareas) y el estado del servidor. Nunca el entorno: tiene los secretos.
UI_LIVE = r'''
import json, os, re, subprocess, time
def sh(*a):
    r = subprocess.run(a, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""
ids = sh("docker", "ps", "-aq", "--filter", "label=com.docker.compose.service=app",
         "--filter", "label=com.docker.compose.oneoff=False").split()
apps = {}
for c in (json.loads(sh("docker", "inspect", *ids) or "[]") if ids else []):
    p = (c["Config"].get("Labels") or {}).get("com.docker.compose.project", "")
    if p in apps and apps[p]["created"] > c["Created"]:
        continue
    st = c["State"]
    apps[p] = {"created": c["Created"], "id": c["Id"][:12], "full": c["Id"], "state": st["Status"],
               "health": (st.get("Health") or {}).get("Status", ""), "started": st.get("StartedAt", ""),
               "restarts": c.get("RestartCount", 0), "version": c["Config"]["Image"].rpartition(":")[2][:7]}
# Memoria y CPU, de los cgroups del contenedor (docker stats tarda segundos): CPU en % de un
# núcleo, como docker stats, medida en medio segundo.
def cg(full, f):
    try:
        return open(f"/sys/fs/cgroup/system.slice/docker-{full}.scope/{f}").read()
    except OSError:
        return ""
def usec(full):
    m = re.search(r"usage_usec (\d+)", cg(full, "cpu.stat"))
    return int(m.group(1)) if m else None
running = {p: a for p, a in apps.items() if a["state"] == "running"}
before = {p: usec(a["full"]) for p, a in running.items()}
time.sleep(0.5)
for p, a in running.items():
    m, u = cg(a["full"], "memory.current").strip(), usec(a["full"])
    if m.isdigit():
        a["mem"] = f"{int(m) / 1048576:.0f}MiB"
    if u is not None and before[p] is not None:
        a["cpu"] = f"{(u - before[p]) / 5000:.1f}%"
for a in apps.values():
    del a["full"]
# La plataforma: backups (su timer y el resultado del último) y alertas (solo si están
# configuradas: la dirección de ntfy no sale de aquí, quien la conozca lee tus avisos).
def unit(name, *props):
    out = sh("systemctl", "show", name, "--timestamp=unix", *[f"--property={p}" for p in props])
    return dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
stamp = lambda v: int(v.lstrip("@")) if v and v.lstrip("@").isdigit() else None
bs = unit("andamio-backup.service", "Result", "ExecMainExitTimestamp", "ActiveState")
bt = unit("andamio-backup.timer", "LoadState", "TimersCalendar")
nxt = re.search(r"next_elapse=@(\d+)", bt.get("TimersCalendar", ""))
try:
    env = open("/etc/andamio/andamio.env").read()
except OSError:
    env = ""
platform = {
    "backups": {"configured": bt.get("LoadState") == "loaded", "result": bs.get("Result", ""),
                "last": stamp(bs.get("ExecMainExitTimestamp", "")), "next": int(nxt.group(1)) if nxt else None,
                "running": bs.get("ActiveState") == "activating"},
    "alerts": {"ntfy": bool(re.search(r"(?m)^ANDAMIO_NTFY_URL=\S", env)), "telegram": os.path.exists("/etc/andamio/telegram.env")},
}
mem = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in open("/proc/meminfo"))}
fs = os.statvfs("/")
server = {"uptime": float(open("/proc/uptime").read().split()[0]), "load": float(open("/proc/loadavg").read().split()[0]),
          "cpus": os.cpu_count(), "mem_total": mem["MemTotal"], "mem_used": mem["MemTotal"] - mem["MemAvailable"],
          "disk_total": fs.f_blocks * fs.f_frsize, "disk_used": (fs.f_blocks - fs.f_bfree) * fs.f_frsize}
print(json.dumps({"apps": apps, "server": server, "platform": platform}))
'''


SSH_PERSIST = 120   # segundos que la conexión compartida sigue abierta sin uso (el panel la sube)


# Los deploys de cada repo (GitHub tarda 1-4 s): 30 s en memoria, para que ir y volver sea al instante.
_CI_RUNS: dict[str, tuple[float, list]] = {}


def ci_runs_cached(repo: str, ttl: int = 30, workflow: str = "", branch: str = "main") -> list[dict]:
    """Con workflow (varias apps en un repo), solo las corridas de esa app; de su rama."""
    import json
    key = f"{repo} {workflow} {branch}"
    hit = _CI_RUNS.get(key)
    if hit and time.time() - hit[0] < ttl:
        return hit[1]
    r = forge("ci-runs", repo, "--branch", branch, *(["--workflow", workflow] if workflow else []))
    try:
        data = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []
    except ValueError:
        data = []
    if r.returncode == 0:
        _CI_RUNS[key] = (time.time(), data)
    return data


def ssh_cmd(*extra: str) -> list[str]:
    """ssh al servidor, sin preguntas, y reusando una sola conexión (cada una nueva tarda ~2 s).
    El socket vive en $XDG_RUNTIME_DIR (memoria, privado) y se cierra a los 2 min sin uso."""
    cmd = ["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]
    if SUDO_CACHE:
        SUDO_CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
        cmd += ["-o", "ControlMaster=auto", "-o", f"ControlPath={SUDO_CACHE}/ssh-%C", "-o", f"ControlPersist={SSH_PERSIST}"]
    return [*cmd, *extra, server_alias()]


def ui_remote(script: str) -> dict:
    """Corre un script de Python en el servidor (por stdin) y devuelve su JSON."""
    import json
    r = run([*ssh_cmd("-T"), "python3", "-"], input=script, timeout=40)
    if r.returncode != 0:
        raise RuntimeError(L("El servidor no respondió por SSH", "The server didn't answer over SSH")
                           + (f": {r.stderr.strip().splitlines()[-1]}" if r.stderr.strip() else ""))
    return json.loads(r.stdout)


def ui_app_record(f: Path, cfg: dict) -> dict:
    """Lo que dice el app.yml de una app, como lo muestra el panel."""
    import yaml
    a = yaml.safe_load(f.read_text()) or {}
    name, domain = f.parent.name, cfg.get("andamio_domain", "")
    host = str(a.get("host", name))
    r = a.get("resources") or {}
    path = str(a.get("path") or "")
    return {"name": name, "url": (f"https://{domain}" if host == "@" else f"https://{host}.{domain}") + path,
            "host": host, "path": path, "dir": str(a.get("dir") or ""), "context": str(a.get("context") or ""),
            "branch": str(a.get("branch") or "main"),
            "watch": [str(w) for w in a.get("watch") or []],
            "workflow": f"andamio-{name}.yml" if a.get("dir") else "",
            "access": a.get("access", "vpn"), "repo": a.get("repo") or f"{cfg.get('andamio_github_owner', '')}/{name}",
            "port": a.get("port"), "health": a.get("health", ""), "mem": r.get("mem"), "cpus": r.get("cpus"),
            "db": bool(a.get("db")), "mysql": bool(a.get("mysql")), "redis": bool(a.get("redis")), "volumes": a.get("volumes") or [],
            "domains": a.get("domains") or [], "cors": a.get("cors") or [],
            "worker": (a.get("worker") or {}).get("command", ""), "cron": a.get("cron") or [],
            "stopped": bool(a.get("stopped")),
            "db_connections": int(a.get("db_connections") or 0), "db_timeout": str(a.get("db_timeout") or "0")}


def ui_config() -> dict:
    import yaml
    return yaml.safe_load(CONFIG.read_text()) or {}


def ui_apps() -> dict:
    cfg = ui_config()
    out: dict = {"domain": cfg.get("andamio_domain", ""), "server": None, "error": "", "apps": [],
                 "platform": None, "security": ui_security(), "backups_enabled": str(cfg.get("andamio_backups", "")).lower() == "true"}
    live = {}
    try:
        data = ui_remote(UI_LIVE)
        live, out["server"], out["platform"] = data["apps"], data["server"], data.get("platform")
    except (RuntimeError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
        out["error"] = str(e) or L("No pude leer el estado del servidor", "Couldn't read the server's status")
    for f in sorted((ROOT / "apps").glob("*/app.yml")):
        rec = ui_app_record(f, cfg)
        rec["live"] = live.get(rec["name"])
        out["apps"].append(rec)
    return out


def ui_security() -> dict | None:
    """El último `andamio estado` de esta copia (lo guarda el comando, desde la CLI o el panel)."""
    import json
    try:
        return json.loads(estado_cache().read_text())
    except (OSError, ValueError):
        return None


def ui_deploys(limit: int = 12) -> list[dict]:
    """Los últimos deploys de todas tus apps juntas, del más nuevo al más viejo."""
    import json
    from concurrent.futures import ThreadPoolExecutor
    cfg = ui_config()
    recs = [ui_app_record(f, cfg) for f in sorted((ROOT / "apps").glob("*/app.yml"))]

    def runs(rec: dict) -> list[dict]:
        return [{**x, "app": rec["name"]} for x in ci_runs_cached(rec["repo"], ttl=10, workflow=rec["workflow"], branch=rec["branch"])]
    with ThreadPoolExecutor(6) as pool:
        every = [d for chunk in pool.map(runs, recs) for d in chunk]
    return sorted(every, key=lambda d: d["created"], reverse=True)[:limit]


def ui_app(name: str) -> dict | None:
    """Todo de una app: configuración, estado, secretos (solo nombres), tareas y deploys."""
    import json
    from concurrent.futures import ThreadPoolExecutor
    f = ROOT / "apps" / name / "app.yml"
    if not APP_NAME.fullmatch(name) or not f.is_file():
        return None
    cfg = ui_config()
    tz = cfg.get("andamio_timezone") or "UTC"
    rec = ui_app_record(f, cfg)

    def secrets() -> list[str]:
        r = run(["sops", "decrypt", "--input-type", "dotenv", "--output-type", "dotenv",
                 f"apps/{name}/secrets.sops.env"], cwd=ROOT) if shutil.which("sops") else None
        if not r or r.returncode != 0:
            return []
        return [k for k in re.findall(r"(?m)^([A-Za-z_][A-Za-z0-9_]*)=", r.stdout) if k not in RESERVED_SECRETS]

    # Los deploys (GitHub) van aparte (/api/deploys?app=): la página no los espera.
    with ThreadPoolExecutor(3) as pool:
        apps_f, sec_f = pool.submit(ui_apps), pool.submit(secrets)
        cron_f = pool.submit(cron_live, name, rec["cron"], tz)
        everything = apps_f.result()
        rec["live"] = next((a["live"] for a in everything["apps"] if a["name"] == name), None)
        rec["secrets"] = sec_f.result()
        cron = cron_f.result()
    rec["timezone"] = tz
    for e in rec["cron"]:
        nxt, last = cron.get(e["name"], ("-", []))
        e["next"] = nxt
        e["last"] = dict(zip(("rc", "start", "secs"), map(int, last))) if len(last) == 3 else None
    return {"app": rec, "error": everything["error"], "server": everything["server"], "domain": everything["domain"]}


# Historial de uso, de Prometheus del servidor (cAdvisor por contenedor, node-exporter del
# servidor; 30 días). Se consulta por SSH en 127.0.0.1 del servidor: nada nuevo queda abierto.
UI_RANGES = {"1h": (3600, 30), "6h": (21600, 120), "24h": (86400, 600), "7d": (604800, 3600)}
UI_METRICS = r'''
import json, time, urllib.parse, urllib.request
P = json.loads(PARAMS)
end = int(time.time()) // P["step"] * P["step"]
out = {"series": {}, "error": ""}
for key, q in P["queries"].items():
    url = "http://127.0.0.1:9091/api/v1/query_range?" + urllib.parse.urlencode(
        {"query": q, "start": end - P["span"], "end": end, "step": P["step"]})
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            res = json.load(r)["data"]["result"]
    except Exception as e:
        out["error"] = type(e).__name__
        break
    vals = res[0]["values"] if res else []
    out["series"][key] = [[int(t), round(float(v), 4)] for t, v in vals if v not in ("NaN", "+Inf", "-Inf")]
out["start"], out["end"], out["step"] = end - P["span"], end, P["step"]
print(json.dumps(out))
'''


def ui_metrics(app: str, rng: str) -> dict:
    """CPU (% de un núcleo), RAM (bytes) y red (bytes/s) de una app, o del servidor sin app."""
    import json
    if rng not in UI_RANGES:
        return {"error": L("Rango inválido", "Invalid range")}
    if app and (not APP_NAME.fullmatch(app) or not (ROOT / "apps" / app / "app.yml").is_file()):
        return {"error": L("No existe esa app", "No such app")}
    span, step = UI_RANGES[rng]
    w = f"{max(2 * step, 120)}s"
    if app:
        sel = f'name=~"{app}-(app|worker)-[0-9]+"'
        queries = {"cpu": f"sum(rate(container_cpu_usage_seconds_total{{{sel}}}[{w}])) * 100",
                   "mem": f"sum(max_over_time(container_memory_working_set_bytes{{{sel}}}[{step}s]))",
                   "rx": f"sum(rate(container_network_receive_bytes_total{{{sel}}}[{w}]))",
                   "tx": f"sum(rate(container_network_transmit_bytes_total{{{sel}}}[{w}]))"}
    else:
        nic = 'device!~"lo|veth.*|br-.*|docker.*|wg.*"'
        queries = {"cpu": f'100 * (1 - avg(rate(node_cpu_seconds_total{{mode="idle"}}[{w}])))',
                   "mem": f"max(max_over_time(node_memory_MemTotal_bytes[{step}s]) - min_over_time(node_memory_MemAvailable_bytes[{step}s]))",
                   "rx": f"sum(rate(node_network_receive_bytes_total{{{nic}}}[{w}]))",
                   "tx": f"sum(rate(node_network_transmit_bytes_total{{{nic}}}[{w}]))"}
    params = json.dumps({"queries": queries, "span": span, "step": step})
    try:
        data = ui_remote(f"PARAMS = {params!r}\n" + UI_METRICS)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        return {"error": str(e) or L("No pude leer las métricas", "Couldn't read the metrics")}
    if data.get("error"):
        data["error"] = L("Prometheus no respondió en el servidor (¿está corriendo el monitoreo?)",
                          "Prometheus didn't answer on the server (is monitoring running?)")
    return {**data, "range": rng}


# Los respaldos: la lista sin secretos que deja backup-list.sh (se lee sin sudo) y el estado del
# servicio. Para restaurar una app, andamio app restore (con sudo).
UI_BACKUPS = r'''
import json, re, subprocess
def unit(name, *props):
    r = subprocess.run(["systemctl", "show", name, "--timestamp=unix", *[f"--property={p}" for p in props]],
                       capture_output=True, text=True)
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
stamp = lambda v: int(v.lstrip("@")) if v and v.lstrip("@").isdigit() else None
bs = unit("andamio-backup.service", "Result", "ExecMainExitTimestamp", "ActiveState")
bt = unit("andamio-backup.timer", "LoadState", "TimersCalendar")
nxt = re.search(r"next_elapse=@(\d+)", bt.get("TimersCalendar", ""))
try:
    listing = json.load(open("/var/lib/andamio-backup/snapshots.json"))
except (OSError, ValueError):
    listing = None
print(json.dumps({"configured": bt.get("LoadState") == "loaded", "result": bs.get("Result", ""),
                  "last": stamp(bs.get("ExecMainExitTimestamp", "")), "next": int(nxt.group(1)) if nxt else None,
                  "running": bs.get("ActiveState") == "activating",
                  "listed": listing is not None, "listed_at": (listing or {}).get("at"),
                  "snapshots": (listing or {}).get("snapshots", []),
                  "archive": (listing or {}).get("archive", []), "archive_total": (listing or {}).get("archive_total", 0),
                  "archive_days": (listing or {}).get("archive_days", 90)}))
'''


def ui_history(app: str = "", limit: int = 80) -> list[dict]:
    """Los cambios de tu copia (sus commits), del más nuevo al más viejo. Cada uno: qué apps
    toca, de qué tipo es y, si es un cambio de configuración de una app, sus líneas y si se
    puede deshacer (andamio app revert)."""
    args = ["git", "-C", str(ROOT), "log", f"-n{limit}", "--format=%x1e%H%x1f%h%x1f%at%x1f%an%x1f%s", "--name-status"]
    if app:
        args += ["--", f"apps/{app}"]
    out = []
    for chunk in run(args).stdout.split("\x1e")[1:]:
        head, _, rest = chunk.partition("\n")
        full, short, at, author, subject = head.split("\x1f")
        files = [tuple(l.split("\t")[:2]) for l in rest.splitlines() if "\t" in l]
        apps = sorted({p.split("/")[1] for _, p in files if p.startswith("apps/") and p.count("/") >= 2})
        kind = "platform"
        if apps:
            yml = [(st, p) for st, p in files if p.endswith("/app.yml")]
            if any(st == "A" for st, _ in yml):
                kind = "create"
            elif any(st == "D" for st, _ in yml):
                kind = "destroy"
            elif any(p.endswith("secrets.sops.env") for _, p in files):
                kind = "secrets"
            else:
                kind = "config"
        one = apps[0] if len(apps) == 1 else ""
        revertible = bool(one) and kind == "config" and ("M", f"apps/{one}/app.yml") in files and \
            all(st == "M" and p in (f"apps/{one}/app.yml", f"apps/{one}/compose.yaml") for st, p in files)
        lines: list[str] = []
        if revertible:
            diff = run(["git", "-C", str(ROOT), "show", "--format=", "-U0", full, "--", f"apps/{one}/app.yml"]).stdout
            lines = [l for l in diff.splitlines() if l[:1] in "+-" and l[:3] not in ("+++", "---")][:12]
        out.append({"sha": full, "short": short, "at": int(at), "author": author, "subject": subject,
                    "apps": apps, "kind": kind, "revertible": revertible, "lines": lines,
                    "files": len(files)})
    return out


UI_ALERTS = r'''
import json, os, re
try:
    env = open("/etc/andamio/andamio.env").read()
except OSError:
    env = ""
print(json.dumps({"ntfy": bool(re.search(r"(?m)^ANDAMIO_NTFY_URL=\S", env)), "telegram": os.path.exists("/etc/andamio/telegram.env")}))
'''


def ui_upstream(cfg: dict) -> str:
    """De dónde se actualiza esta copia (como andamio update); "@…" = es la fuente de andamio."""
    saved = dict(x.split(" ", 1) for x in UPSTREAM_FILE.read_text().splitlines() if " " in x) \
        if UPSTREAM_FILE.exists() else {}
    return str(cfg.get("andamio_upstream") or saved.get("url") or UPSTREAM_DEFAULT)


def ui_settings() -> dict:
    """Lo de la página Ajustes: alertas (sí o no, nunca sus direcciones), zona de las tareas,
    tus copias y un resumen de la configuración."""
    import yaml
    from zoneinfo import available_timezones
    cfg = ui_config()
    tasks = sum(len((yaml.safe_load(f.read_text()) or {}).get("cron") or []) for f in (ROOT / "apps").glob("*/app.yml"))
    out = {"domain": cfg.get("andamio_domain", ""), "server": server_alias(), "copy": str(ROOT),
           "timezone": cfg.get("andamio_timezone") or "", "local_timezone": local_timezone(), "tasks": tasks,
           "timezones": sorted(z for z in available_timezones() if "/" in z and not z.startswith(("Etc/", "SystemV/", "posix/", "right/"))) + ["UTC"],
           "monitoring": str(cfg.get("andamio_monitoring", "auto")), "backups": str(cfg.get("andamio_backups", "")).lower() == "true",
           "forge": cfg.get("andamio_forge") or "github", "alerts": None, "error": "",
           "telegram_on": str(cfg.get("andamio_telegram", "")).lower() == "true",
           # La dirección del tema: quien la tenga lee tus avisos. Solo se muestra aquí (panel local).
           "ntfy_url": str(cfg.get("andamio_alerts_ntfy") or ""),
           # Cuánto se recuerda la contraseña de sudo (en esta máquina) y si ahora hay una recordada.
           "sudo_minutes": sudo_minutes(), "sudo_choices": list(SUDO_CHOICES),
           "sudo_env": bool(os.environ.get("ANDAMIO_SUDO_MINUTES")),
           "sudo_remembered": bool(SUDO_CACHE and SUDO_CACHE.is_dir() and any(
               time.time() - p.stat().st_mtime <= sudo_minutes() * 60 for p in SUDO_CACHE.glob("sudo-*"))),
           "updatable": not ui_upstream(cfg).startswith("@")}
    try:
        out["alerts"] = ui_remote(UI_ALERTS)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        out["error"] = str(e)
    return out


# ---- Consola SQL de solo lectura (scripts/app-sql.sh) ----
SQL_MAX_ROWS = 500


def sql_remote(app: str, mode: str, query: str | None = None, tty: bool = False,
               engine: str = "postgres") -> subprocess.CompletedProcess:
    """Corre scripts/app-sql.sh (PostgreSQL) o app-sql-mysql.sh (MariaDB), los de TU copia (así no
    depende de lo que tenga el servidor), en el servidor, por SSH. La consulta va por stdin,
    nunca en la línea de comandos."""
    import shlex
    script = "app-sql-mysql.sh" if engine == "mysql" else "app-sql.sh"
    remote_cmd = f"bash -c {shlex.quote((ROOT / 'scripts' / script).read_text())} app-sql {app}" + (f" {mode}" if mode else "")
    if tty:
        return subprocess.run(["ssh", "-t", "-q", server_alias(), remote_cmd], check=False)
    return subprocess.run([*ssh_cmd("-T"), remote_cmd], input=query or "", capture_output=True, text=True,
                          timeout=40, check=False)


def sql_result(r: subprocess.CompletedProcess) -> dict:
    """El CSV de psql → columnas y filas (hasta SQL_MAX_ROWS), o el error de PostgreSQL."""
    import csv
    import io
    if r.returncode != 0:
        err = [l.strip() for l in r.stderr.splitlines() if l.strip()]
        msg = next((l.split(":", 1)[1].strip() for l in err if l.startswith(("ERROR:", "FATAL:"))), err[-1] if err else "")
        return {"error": msg or L("La consulta falló", "The query failed"), "columns": [], "rows": []}
    rows = list(csv.reader(io.StringIO(r.stdout)))
    if not rows:
        return {"columns": [], "rows": [], "truncated": False, "count": 0, "error": ""}
    body = rows[1:]
    return {"columns": rows[0], "rows": body[:SQL_MAX_ROWS], "count": len(body),
            "truncated": len(body) > SQL_MAX_ROWS or len(r.stdout) >= 4_000_000, "error": ""}


def sql_result_mysql(r: subprocess.CompletedProcess) -> dict:
    """El TSV de mariadb --batch → columnas y filas, como sql_result. En --batch, los saltos de
    línea, tabulaciones y barras de los datos vienen escapados (\\n, \\t, \\\\)."""
    if r.returncode != 0:
        err = [l.strip() for l in r.stderr.splitlines() if l.strip()]
        msg = next((l.split(": ", 1)[1] for l in err if l.startswith("ERROR") and ": " in l), err[-1] if err else "")
        return {"error": msg or L("La consulta falló", "The query failed"), "columns": [], "rows": []}
    unesc = {"n": "\n", "t": "\t", "\\": "\\", "0": "\0"}
    def field(v: str) -> str:
        return re.sub(r"\\(.)", lambda m: unesc.get(m.group(1), m.group(1)), v)
    lines = [l for l in r.stdout.split("\n") if l != ""]
    if not lines:
        return {"columns": [], "rows": [], "truncated": False, "count": 0, "error": ""}
    cols = [field(c) for c in lines[0].split("\t")]
    body = [[field(v) for v in l.split("\t")] for l in lines[1:]]
    return {"columns": cols, "rows": body[:SQL_MAX_ROWS], "count": len(body),
            "truncated": len(body) > SQL_MAX_ROWS or len(r.stdout) >= 4_000_000, "error": ""}


def app_engines(app: str) -> list[str]:
    """Las bases de una app: postgres (db: true), mysql (mysql: true, MariaDB)."""
    a = yaml_load(ROOT / "apps" / app / "app.yml") or {}
    return [e for e, k in (("postgres", "db"), ("mysql", "mysql")) if a.get(k)]


def ui_sql_app(app: str, engine: str = "") -> str | None:
    """Error si la app no existe o no tiene esa base (sin engine: alguna)."""
    f = ROOT / "apps" / app / "app.yml"
    if not APP_NAME.fullmatch(app) or not f.is_file():
        return L("No existe esa app", "No such app")
    engines = app_engines(app)
    if not engines or (engine and engine not in engines):
        return L(f"{app} no tiene base de datos", f"{app} has no database")
    return None


def ui_sql(app: str, query: str, engine: str = "postgres") -> dict:
    if err := ui_sql_app(app, engine):
        return {"error": err, "columns": [], "rows": []}
    if not query.strip() or len(query) > 8000:
        return {"error": L("Escribe una consulta (hasta 8000 caracteres)", "Write a query (up to 8000 characters)"), "columns": [], "rows": []}
    start = time.time()
    try:
        r = sql_remote(app, "--query", query, engine=engine)
        out = sql_result_mysql(r) if engine == "mysql" else sql_result(r)
    except subprocess.TimeoutExpired:
        out = {"error": L("El servidor no respondió a tiempo", "The server didn't answer in time"), "columns": [], "rows": []}
    return {**out, "ms": round((time.time() - start) * 1000)}


# Las tablas de la base, con sus columnas (nombre y tipo) y sus filas: exactas en las chicas (o
# nunca analizadas: una base nueva no tiene estadísticas), aproximadas en las grandes. El conteo
# exacto va con query_to_xml, que corre como el resto: de solo lectura y con 5 s como máximo.
SQL_TABLES = """
SELECT n.nspname AS schema, c.relname AS name,
       CASE WHEN c.reltuples < 50000 THEN (xpath('/row/c/text()', query_to_xml(
              format('SELECT count(*) AS c FROM %I.%I', n.nspname, c.relname), false, true, '')))[1]::text::bigint
            ELSE c.reltuples::bigint END AS rows,
       (c.reltuples < 50000) AS exact,
       (SELECT json_agg(json_build_array(a.attname, format_type(a.atttypid, a.atttypmod)) ORDER BY a.attnum)
          FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped)::text AS columns
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('r', 'p', 'v', 'm') AND n.nspname NOT IN ('pg_catalog', 'information_schema')
  AND n.nspname NOT LIKE 'pg_toast%' AND has_table_privilege(c.oid, 'SELECT')
ORDER BY 1, 2;
"""


# MariaDB: las tablas de su base y sus columnas. Las filas de information_schema son aproximadas
# (InnoDB las estima): en las chicas se cuentan de verdad después (ui_sql_tables).
SQL_TABLES_MYSQL = """
SELECT t.TABLE_SCHEMA AS s, t.TABLE_NAME AS n, COALESCE(t.TABLE_ROWS, -1) AS r,
  (SELECT JSON_ARRAYAGG(JSON_ARRAY(c.COLUMN_NAME, c.COLUMN_TYPE) ORDER BY c.ORDINAL_POSITION)
     FROM information_schema.COLUMNS c WHERE c.TABLE_SCHEMA = t.TABLE_SCHEMA AND c.TABLE_NAME = t.TABLE_NAME) AS c
FROM information_schema.TABLES t WHERE t.TABLE_SCHEMA = DATABASE() ORDER BY 2;
"""


def ui_sql_tables_mysql(app: str) -> dict:
    import json
    r = sql_result_mysql(sql_remote(app, "--query", SQL_TABLES_MYSQL, engine="mysql"))
    if r["error"]:
        return {"error": r["error"], "tables": []}
    out = []
    for sch, n, rows, cols in r["rows"]:
        try:
            columns = [{"name": c[0], "type": c[1]} for c in json.loads(cols if cols != "NULL" else "[]")]
        except ValueError:
            columns = []
        out.append({"schema": sch, "name": n, "rows": int(rows) if rows.lstrip("-").isdigit() else -1,
                    "exact": False, "columns": columns})
    # Las chicas, contadas de verdad (una consulta, de solo lectura y con 5 s como máximo).
    small = [t for t in out if 0 <= t["rows"] < 50000][:200]
    if small:
        tick = lambda x: "`" + x.replace("`", "``") + "`"   # noqa: E731
        q = " UNION ALL ".join(f"SELECT '{t['name'].replace(chr(39), chr(39) * 2)}', COUNT(*) FROM {tick(t['name'])}"
                               for t in small)
        c = sql_result_mysql(sql_remote(app, "--query", q + ";", engine="mysql"))
        if not c["error"]:
            exact = {n: int(v) for n, v in c["rows"] if v.isdigit()}
            for t in small:
                if t["name"] in exact:
                    t.update(rows=exact[t["name"]], exact=True)
    return {"error": "", "tables": out}


def ui_sql_tables(app: str, engine: str = "postgres") -> dict:
    import json
    if err := ui_sql_app(app, engine):
        return {"error": err, "tables": []}
    if engine == "mysql":
        try:
            return ui_sql_tables_mysql(app)
        except subprocess.TimeoutExpired:
            return {"error": L("El servidor no respondió a tiempo", "The server didn't answer in time"), "tables": []}
    try:
        r = sql_result(sql_remote(app, "--query", SQL_TABLES))
        if r["error"]:   # una tabla enorme sin analizar puede pasar de los 5 s: la lista de siempre
            r = sql_result(sql_remote(app, "--tables"))
            r["rows"] = [[s, n, rows, "f", json.dumps([c.rsplit(" ", 1) if " " in c else [c, ""] for c in cols.split(", ")])]
                         for s, n, rows, cols in r["rows"]]
    except subprocess.TimeoutExpired:
        return {"error": L("El servidor no respondió a tiempo", "The server didn't answer in time"), "tables": []}
    if r["error"]:
        return {"error": r["error"], "tables": []}
    out = []
    for s, n, rows, exact, cols in r["rows"]:
        try:
            columns = [{"name": c[0], "type": c[1]} for c in json.loads(cols or "[]")]
        except ValueError:
            columns = []
        out.append({"schema": s, "name": n, "rows": int(rows) if rows.lstrip("-").isdigit() else -1,
                    "exact": exact == "t", "columns": columns})
    return {"error": "", "tables": out}


# ---- Certificados HTTPS (desde tu máquina) y disponibilidad (Prometheus del servidor) ----
_CERTS: dict = {"at": 0.0, "data": None}


def cert_check(host: str, tries: int = 2) -> dict:
    """El certificado que sirve el servidor para ese dominio: hasta cuándo vale (o por qué no).
    Un corte de red pasajero se reintenta una vez."""
    import ssl
    ctx = ssl.create_default_context()
    try:
        with socket.create_connection((host, 443), timeout=6) as raw, ctx.wrap_socket(raw, server_hostname=host) as tls:
            cert = tls.getpeercert()
        end = ssl.cert_time_to_seconds(cert["notAfter"])
        issuer = dict(x[0] for x in cert.get("issuer", ())).get("organizationName", "")
        return {"host": host, "ok": True, "expires": int(end), "days": int((end - time.time()) // 86400), "issuer": issuer}
    except ssl.SSLCertVerificationError as e:
        return {"host": host, "ok": False, "error": e.verify_message or str(e)}
    except (OSError, ValueError) as e:
        if tries > 1:
            return cert_check(host, tries - 1)
        return {"host": host, "ok": False, "error": str(e) or type(e).__name__}


def ui_certs() -> dict:
    """Todos los dominios de tus apps (el suyo y los propios), con su certificado. Se guarda 30 min."""
    from concurrent.futures import ThreadPoolExecutor
    # Bien: se guarda 30 min. Con algún error, solo 2 (que no quede pegado un corte pasajero).
    if _CERTS["data"] is not None and time.time() - _CERTS["at"] < _CERTS.get("ttl", 1800):
        return _CERTS["data"]
    cfg = ui_config()
    hosts: dict[str, list[str]] = {}
    for f in sorted((ROOT / "apps").glob("*/app.yml")):
        rec = ui_app_record(f, cfg)
        hosts[rec["name"]] = [rec["url"].removeprefix("https://").split("/", 1)[0], *rec["domains"]]
    every = sorted({h for hs in hosts.values() for h in hs})
    with ThreadPoolExecutor(8) as pool:
        found = {c["host"]: c for c in pool.map(cert_check, every)}
    data = {"apps": {app: [found[h] for h in hs] for app, hs in hosts.items()}, "at": int(time.time())}
    _CERTS.update(at=time.time(), data=data, ttl=1800 if all(c["ok"] for c in found.values()) else 120)
    return data


UI_AVAIL = r'''
import json, time, urllib.parse, urllib.request
P = json.loads(PARAMS)
out = {"apps": {}, "error": ""}
def query(q):
    with urllib.request.urlopen("http://127.0.0.1:9091/api/v1/query?" + urllib.parse.urlencode({"query": q}), timeout=10) as r:
        return json.load(r)["data"]["result"]
now = time.time()
for app in P["apps"]:
    row = {}
    web = f'andamio_container_health{{name=~"{app}-app-[0-9]+"}}'
    try:
        # Desde cuándo medir: su primer contenedor (antes del primer deploy no estaba "caída").
        first = query(f'min_over_time(timestamp(max({web}))[7d:10m])')
        since = float(first[0]["value"][1]) if first else None
    except Exception as e:
        out["error"], since = type(e).__name__, None
    for rng, span, step in (("24h", 86400, "2m"), ("7d", 604800, "10m")):
        if since is None:
            row[rng] = None
            continue
        # Fracción del tiempo con un contenedor web sano (o sin healthcheck pero corriendo), desde
        # que existe; una app registrada sin contenedor sano cuenta como caída (* 0).
        eff = max(600, min(span, int(now - since)))
        q = (f'avg_over_time((max(andamio_container_health{{name=~"{app}-app-[0-9]+",status=~"healthy|none"}}) '
             f'or (max(andamio_app_info{{name="{app}"}}) * 0))[{eff}s:{step}])')
        try:
            res = query(q)
            row[rng] = round(float(res[0]["value"][1]) * 100, 2) if res else None
        except Exception as e:
            out["error"] = type(e).__name__
            row[rng] = None
    out["apps"][app] = row
print(json.dumps(out))
'''


UI_TIMELINE = r'''
import json, time, urllib.parse, urllib.request
P = json.loads(PARAMS)
app = P["app"]
# En línea: un contenedor web sano; caída: la app existe (andamio_app_info) y no hay uno. Antes de
# crearla, sin medición (no cuenta como caída).
up = f'(max(andamio_container_health{{name=~"{app}-app-[0-9]+",status=~"healthy|none"}}) or (max(andamio_app_info{{name="{app}"}}) * 0))'
end = int(time.time()) // 3600 * 3600 + 3600
start = end - 7 * 86400
def series(q, step):
    url = "http://127.0.0.1:9091/api/v1/query_range?" + urllib.parse.urlencode({"query": q, "start": start, "end": end, "step": step})
    with urllib.request.urlopen(url, timeout=15) as r:
        res = json.load(r)["data"]["result"]
    return {int(t): float(v) for t, v in res[0]["values"]} if res else {}
out = {"start": start, "end": end, "error": ""}
try:
    # Por hora: la fracción en línea de esa hora (sin medición: null).
    hourly = series(f"avg_over_time({up}[1h:1m])", 3600)
    # Antes de su primer contenedor la app no estaba caída: aún no existía (sin medición).
    seen = series(f'max(andamio_container_health{{name=~"{app}-app-[0-9]+"}})', 600)
    first = min(seen) if seen else end
    out["hours"] = [[t, round(hourly[t], 4) if t in hourly and t > first else None] for t in range(start + 3600, end + 1, 3600)]
    # Caídas: tramos seguidos sin un contenedor sano (cada 2 min), de la más nueva a la más vieja.
    fine = {t: v for t, v in series(up, 120).items() if t >= first}
    outages, cur = [], None
    for t in sorted(fine):
        if fine[t] < 0.5:
            cur = cur or [t, t]
            cur[1] = t + 120
        elif cur:
            outages.append(cur)
            cur = None
    if cur:
        outages.append(cur + ["ongoing"])
    out["outages"] = [{"start": o[0], "end": o[1], "mins": (o[1] - o[0]) // 60, "ongoing": len(o) > 2} for o in reversed(outages)][:20]
except Exception as e:
    out["error"] = type(e).__name__
print(json.dumps(out))
'''


def ui_timeline(app: str) -> dict:
    """Los últimos 7 días de una app, por hora, y sus caídas (de la salud de su contenedor)."""
    import json
    if not APP_NAME.fullmatch(app) or not (ROOT / "apps" / app / "app.yml").is_file():
        return {"error": L("No existe esa app", "No such app")}
    try:
        data = ui_remote(f"PARAMS = {json.dumps({'app': app})!r}\n" + UI_TIMELINE)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        return {"error": str(e)}
    if data.get("error"):
        data["error"] = L("Prometheus no respondió en el servidor", "Prometheus didn't answer on the server")
    return data


# Las piezas de una app ahora mismo: su contenedor web, su worker y los servicios compartidos que
# usa (PostgreSQL, Redis), con su salud, RAM y CPU. De Prometheus (cAdvisor y la salud que publica
# container-health.sh): ni el socket de Docker ni sudo.
UI_SERVICES = r'''
import json, re, urllib.parse, urllib.request
P = json.loads(PARAMS)
sel = f'name=~"{P["app"]}-(app|worker)-[0-9]+|postgres|redis"'
def query(q):
    with urllib.request.urlopen("http://127.0.0.1:9091/api/v1/query?" + urllib.parse.urlencode({"query": q}), timeout=10) as r:
        return json.load(r)["data"]["result"]
out = {"services": [], "error": ""}
try:
    health = {x["metric"]["name"]: x["metric"].get("status", "none") for x in query(f"andamio_container_health{{{sel}}}")}
    mem = {x["metric"]["name"]: float(x["value"][1]) for x in query(f"container_memory_working_set_bytes{{{sel}}}")}
    cpu = {x["metric"]["name"]: float(x["value"][1]) * 100 for x in query(f"sum by (name) (rate(container_cpu_usage_seconds_total{{{sel}}}[2m]))")}
    for name in sorted(set(health) | set(mem)):
        kind = name if name in ("postgres", "redis") else re.sub(r"^.*-(app|worker)-[0-9]+$", r"\1", name)
        out["services"].append({"name": name, "kind": kind, "status": health.get(name, "down"),
                                "mem": round(mem[name]) if name in mem else None,
                                "cpu": round(cpu[name], 2) if name in cpu else None})
except Exception as e:
    out["error"] = type(e).__name__
print(json.dumps({"services_of": P["app"], **out}))
'''


def ui_services(app: str) -> dict:
    """El contenedor web, el worker y los servicios compartidos de una app, ahora mismo."""
    import json
    if not APP_NAME.fullmatch(app) or not (ROOT / "apps" / app / "app.yml").is_file():
        return {"error": L("No existe esa app", "No such app")}
    try:
        data = ui_remote(f"PARAMS = {json.dumps({'app': app})!r}\n" + UI_SERVICES)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        return {"error": str(e)}
    data.pop("services_of", None)
    if data.get("error"):
        data["error"] = L("Prometheus no respondió en el servidor", "Prometheus didn't answer on the server")
    return data


UI_USAGE7D = r'''
import json, urllib.parse, urllib.request
P = json.loads(PARAMS)
sel = f'name=~"{P["app"]}-app-[0-9]+"'
qs = {
    # Pico de RAM del contenedor web en 7 días, y el percentil 95 de su CPU (en % de un núcleo).
    "mem_peak": f"max_over_time(sum(container_memory_working_set_bytes{{{sel}}})[7d:5m])",
    "cpu_p95": f"quantile_over_time(0.95, (sum(rate(container_cpu_usage_seconds_total{{{sel}}}[5m])) * 100)[7d:5m])",
    "cpu_max": f"max_over_time((sum(rate(container_cpu_usage_seconds_total{{{sel}}}[5m])) * 100)[7d:5m])",
    # Cuántas muestras de 5 min hay (para saber cuántos días cubre).
    "samples": f"count_over_time(sum(container_memory_working_set_bytes{{{sel}}})[7d:5m])",
}
out = {"error": ""}
for k, q in qs.items():
    try:
        with urllib.request.urlopen("http://127.0.0.1:9091/api/v1/query?" + urllib.parse.urlencode({"query": q}), timeout=15) as r:
            res = json.load(r)["data"]["result"]
        out[k] = float(res[0]["value"][1]) if res else None
    except Exception as e:
        out["error"] = type(e).__name__
print(json.dumps(out))
'''

MIB = 1024 * 1024


def mem_bytes(v: str) -> int | None:
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([mg])", str(v or "").lower())
    return int(float(m.group(1)) * (1024 if m.group(2) == "g" else 1) * MIB) if m else None


def mem_text(b: int) -> str:
    mib = -(-b // (64 * MIB)) * 64   # hacia arriba, de a 64 MiB
    return f"{mib // 1024}g" if mib % 1024 == 0 else f"{mib}m"


def ui_suggest(app: str) -> dict:
    """Con los últimos 7 días (al menos 2): ¿le sobra o le falta RAM o CPU a la app? Solo sugiere;
    aplicar es el mismo `app set` de siempre."""
    import json
    f = ROOT / "apps" / app / "app.yml"
    if not APP_NAME.fullmatch(app) or not f.is_file():
        return {"error": L("No existe esa app", "No such app")}
    rec = ui_app_record(f, ui_config())
    try:
        d = ui_remote(f"PARAMS = {json.dumps({'app': app})!r}\n" + UI_USAGE7D)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        return {"error": str(e)}
    if d.get("error"):
        return {"error": L("Prometheus no respondió en el servidor", "Prometheus didn't answer on the server")}
    days = round((d.get("samples") or 0) * 5 / 60 / 24, 1)
    out: dict = {"days": days, "mem": None, "cpu": None, "error": ""}
    limit, peak = mem_bytes(rec["mem"]), d.get("mem_peak")
    if limit and peak is not None:
        m: dict = {"peak": int(peak), "limit": limit, "suggest": None, "why": ""}
        if days >= 2 and peak > 0.85 * limit:
            m.update(suggest=mem_text(int(peak * 1.4)), why="up")
        elif days >= 2 and peak < 0.25 * limit and limit > 128 * MIB:
            new = max(128 * MIB, int(peak * 2))
            if mem_bytes(mem_text(new)) < limit:
                m.update(suggest=mem_text(new), why="down")
        out["mem"] = m
    cpus, p95 = float(rec["cpus"] or 0), d.get("cpu_p95")
    if cpus and p95 is not None:
        cmax = d.get("cpu_max") or p95
        c: dict = {"p95": round(p95, 2), "max": round(cmax, 2), "limit": cpus * 100, "suggest": None, "why": ""}
        quarter = lambda x: max(0.25, round(-(-x // 0.25) * 0.25, 2))
        if days >= 2 and p95 > 0.8 * cpus * 100:
            c.update(suggest=str(quarter(cpus * 1.5)), why="up")
        elif days >= 2 and p95 < 0.1 * cpus * 100 and cmax < 0.5 * cpus * 100 and cpus > 0.25:
            new = quarter(max(p95 / 100 * 3, cmax / 100 * 1.5))
            if new < cpus:
                c.update(suggest=str(new), why="down")
        out["cpu"] = c
    return out


def ui_availability() -> dict:
    """% del tiempo en línea de cada app, en 24 h y 7 días (de la salud de su contenedor)."""
    import json
    names = [f.parent.name for f in sorted((ROOT / "apps").glob("*/app.yml"))]
    try:
        data = ui_remote(f"PARAMS = {json.dumps({'apps': names})!r}\n" + UI_AVAIL)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        return {"apps": {}, "error": str(e)}
    if data.get("error"):
        data["error"] = L("Prometheus no respondió en el servidor", "Prometheus didn't answer on the server")
    return data


# La CPU de las últimas 24 h de todas las apps (web + worker), en una sola consulta a Prometheus:
# para las gráficas mini de la tabla del Inicio (48 puntos por app, cada 30 min).
UI_SPARKS = r'''
import json, re, time, urllib.parse, urllib.request
end = int(time.time()) // 1800 * 1800
q = 'sum by (name) (rate(container_cpu_usage_seconds_total{name=~".+-(app|worker)-[0-9]+"}[30m])) * 100'
out = {"sparks": {}, "start": end - 86400, "end": end, "step": 1800, "error": ""}
try:
    url = "http://127.0.0.1:9091/api/v1/query_range?" + urllib.parse.urlencode({"query": q, "start": end - 86400, "end": end, "step": 1800})
    with urllib.request.urlopen(url, timeout=10) as r:
        res = json.load(r)["data"]["result"]
    acc = {}
    for s in res:
        app = re.sub(r"-(app|worker)-[0-9]+$", "", s["metric"].get("name", ""))
        for t, v in s["values"]:
            acc.setdefault(app, {}).setdefault(int(t), 0.0)
            acc[app][int(t)] += float(v)
    out["sparks"] = {a: [[t, round(v, 3)] for t, v in sorted(pts.items())] for a, pts in acc.items()}
except Exception as e:
    out["error"] = type(e).__name__
print(json.dumps(out))
'''


def ui_sparks() -> dict:
    try:
        data = ui_remote(UI_SPARKS)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        return {"sparks": {}, "error": str(e)}
    if data.get("error"):
        data["error"] = L("Prometheus no respondió en el servidor", "Prometheus didn't answer on the server")
    return data


def ui_deploy_progress(app: str) -> dict:
    """El último deploy de la app y, si está en curso (o acaba de terminar), sus jobs y pasos."""
    import json
    f = ROOT / "apps" / app / "app.yml"
    if not APP_NAME.fullmatch(app) or not f.is_file():
        return {"error": L("No existe esa app", "No such app")}
    rec = ui_app_record(f, ui_config())
    runs = ci_runs_cached(rec["repo"], ttl=4, workflow=rec["workflow"], branch=rec["branch"])
    if not runs:
        return {"run": None, "jobs": [], "error": ""}
    run = runs[0]
    r = forge("ci-jobs", rec["repo"], str(run["id"]))
    try:
        jobs = json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        jobs = []
    return {"run": run, "jobs": jobs, "error": ""}


def ui_copies() -> list[dict]:
    """Tus copias de andamio (una por servidor): la de este panel y las otras (andamio use)."""
    import yaml
    out = []
    for c in dict.fromkeys([ROOT, *known_copies()]):
        try:
            cfg = yaml.safe_load((c / "ansible" / "group_vars" / "all.yml").read_text()) or {}
        except (OSError, yaml.YAMLError):
            continue
        out.append({"path": str(c), "domain": cfg.get("andamio_domain") or c.name, "current": c == ROOT})
    return out


def ui_spawn_panel(path: str, children: dict) -> dict:
    """Abre el panel de otra copia (otro servidor): su propio proceso, puerto y clave. Así cada
    servidor queda separado (sus llaves, su configuración). Si ya está abierto, el mismo link."""
    copies = {c["path"]: c for c in ui_copies()}
    if path not in copies or copies[path]["current"]:
        return {"error": L("Esa copia no está entre las tuyas (andamio use)", "That copy isn't one of yours (andamio use)")}
    old = children.get(path)
    if old and old[0].poll() is None:
        return {"url": old[1]}
    exe = Path(path) / "bin" / "andamio"
    if not exe.is_file():
        return {"error": L(f"No encuentro {exe}", f"Can't find {exe}")}
    proc = subprocess.Popen([str(exe), "ui", "--no-browser"], cwd=path, env={**os.environ, "ANDAMIO_LANG": LANG},
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            start_new_session=True)
    deadline, said = time.time() + 30, []
    while time.time() < deadline:
        line = proc.stdout.readline()
        if not line:
            break
        if line.strip():
            said.append(ANSI.sub("", line).strip())
        m = re.search(r"http://127\.0\.0\.1:\d+/\?t=[\w-]+", ANSI.sub("", line))
        if m:
            children[path] = (proc, m.group(0))
            # Lo que siga escribiendo no debe llenar la tubería y frenarlo.
            import threading
            threading.Thread(target=lambda: [None for _ in proc.stdout], daemon=True).start()
            return {"url": m.group(0)}
    proc.kill()
    why = said[-1] if said else ""
    if "ui" in why and ("desconocido" in why or "Unknown" in why):
        return {"error": L("Esa copia tiene un andamio de antes del panel: ponla al día con `andamio update` en su carpeta.",
                           "That copy has an andamio from before the panel: bring it up to date with `andamio update` in its folder.")}
    return {"error": L("El panel de esa copia no arrancó", "That copy's panel didn't start") + (f": {why}" if why else "")}


def ui_backups() -> dict:
    cfg = ui_config()
    out = {"enabled": str(cfg.get("andamio_backups", "")).lower() == "true", "error": ""}
    try:
        out.update(ui_remote(UI_BACKUPS))
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        out["error"] = str(e) or L("No pude leer los respaldos", "Couldn't read the backups")
    return out


def open_browser(url: str) -> bool:
    """El navegador de esta máquina; en WSL, el de Windows (que llega a 127.0.0.1 de WSL)."""
    try:
        wsl = "microsoft" in Path("/proc/version").read_text().lower()
    except OSError:
        wsl = False
    if wsl:
        for cmd in (["wslview", url], ["cmd.exe", "/c", "start", "", url]):
            if shutil.which(cmd[0]) and run(cmd, cwd="/mnt/c" if Path("/mnt/c").is_dir() else None).returncode == 0:
                return True
    import webbrowser
    return webbrowser.open(url)


ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
CONTENT_TYPES = {".js": "text/javascript", ".css": "text/css", ".woff2": "font/woff2", ".svg": "image/svg+xml",
                 ".html": "text/html", ".json": "application/json"}
MEM = re.compile(r"[0-9]+[mg]")
CPUS = re.compile(r"[0-9]+(\.[0-9]+)?")
HEALTH = re.compile(r"/[A-Za-z0-9._/-]*")


class UiJob:
    """Una acción del panel: corre un comando de la CLI y guarda su salida para la página."""

    def __init__(self, jid: str, argv: list[str], needs_sudo: bool, stdin: str | None = None,
                 env: dict | None = None):
        import shlex
        import threading
        self.id, self.argv, self.needs_sudo = jid, argv, needs_sudo
        self.stdin, self.env = stdin, env or {}   # el stdin (un secreto) no se muestra ni se guarda
        self.exe = "andamio-app"
        self.action = ""   # el nombre de la acción del panel (para volver a mostrarla al recargar)
        self.command = "andamio " + shlex.join(argv)
        self.events: list[tuple[str, str]] = []   # (line|prompt|done, texto)
        self.cond = threading.Condition()
        self.state = "starting"   # password | running | done
        self.rc: int | None = None
        self.tries = 0
        self.password_ok = threading.Event()
        self.cancelled = False

    def emit(self, kind: str, text: str = "") -> None:
        with self.cond:
            self.events.append((kind, text))
            self.cond.notify_all()

    def finish(self, rc: int) -> None:
        self.rc, self.state = rc, "done"
        self.emit("done", str(rc))


SECRET_KEY = re.compile(r"[A-Z][A-Z0-9_]{0,63}")
DOMAIN_RX = re.compile(r"(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}")
ORIGIN_RX = re.compile(r"https?://[a-z0-9.-]+(?::[0-9]{1,5})?")
VOLUME_RX = re.compile(r"(?:/[A-Za-z0-9._-]+)+")


def ui_action_argv(body: dict) -> dict | str:
    """Del pedido de la página al comando de la CLI, o el error. Devuelve argv (lista: nunca
    pasa por un shell), si necesita sudo, lo que entra por stdin (el valor de un secreto: nunca
    en la línea de comandos) y entorno extra. Se valida aquí además de en la CLI."""
    import yaml
    action, name = body.get("action"), str(body.get("app", ""))
    f = ROOT / "apps" / name / "app.yml"
    if not APP_NAME.fullmatch(name) or not f.is_file():
        return L("No existe esa app", "No such app")
    plan = lambda argv, sudo=True, stdin=None, env=None: {"argv": argv, "sudo": sudo, "stdin": stdin, "env": env or {}}
    cron = [c.get("name") for c in (yaml.safe_load(f.read_text()) or {}).get("cron") or []]
    if action in ("stop", "start"):
        return plan(["app", action, name])
    if action == "set":
        values, argv = body.get("set") or {}, ["app", "set", name]
        checks = {"mem": MEM, "cpus": CPUS, "port": re.compile(r"[0-9]{2,5}"), "health": HEALTH}
        for key, rx in checks.items():
            if key in values:
                v = str(values[key])
                if not rx.fullmatch(v):
                    return L(f"Valor inválido para {key}: {v}", f"Invalid value for {key}: {v}")
                argv += [f"--{key}", v]
        if values.get("access") in ("public", "vpn"):
            argv.append(f"--{values['access']}")
        for key, rx in (("db_connections", re.compile(r"[0-9]{1,3}")), ("db_timeout", re.compile(r"0|[1-9][0-9]{0,4}(ms|s|min)"))):
            if key in values:
                v = str(values[key])
                if not rx.fullmatch(v):
                    return L(f"Valor inválido para {key}: {v}", f"Invalid value for {key}: {v}")
                argv += [f"--{key.replace('_', '-')}", v]
        return plan(argv) if len(argv) > 3 else L("Nada que cambiar", "Nothing to change")
    if action == "cron-run":
        task = str(body.get("task", ""))
        if task not in cron:
            return L(f"{name} no tiene una tarea {task}", f"{name} has no task {task}")
        return plan(["app", "cron", "run", name, task], sudo=False)
    if action == "cron-rm":
        task = str(body.get("task", ""))
        if task not in cron:
            return L(f"{name} no tiene una tarea {task}", f"{name} has no task {task}")
        return plan(["app", "cron", "rm", name, task])
    if action == "restart":
        return plan(["app", "restart", name], sudo=False)
    if action == "deploy":
        # Ya lo confirmaste en la página: la CLI no vuelve a preguntar (ANDAMIO_DEPLOY_OK).
        return plan(["app", "deploy", name], sudo=False, env={"ANDAMIO_DEPLOY_OK": "1"})
    if action == "cron-edit":
        task = str(body.get("task", ""))
        if task not in cron:
            return L(f"{name} no tiene una tarea {task}", f"{name} has no task {task}")
        schedule = " ".join(str(body.get("schedule", "")).split())
        command = str(body.get("command", "")).strip()
        if schedule:
            lib = cron_lib()
            try:
                lib.cron_calendar(schedule)
            except lib.CronError as e:
                return str(e)
        if command and ("\n" in command or len(command) > 500):
            return L("El comando va en una sola línea (hasta 500 caracteres).", "The command goes on one line (up to 500 characters).")
        if not schedule and not command:
            return L("Nada que cambiar", "Nothing to change")
        return plan(["app", "cron", "edit", name, task, *(["--schedule", schedule] if schedule else []),
                     *(["--command", command] if command else [])])
    if action == "cron-add":
        schedule, command, task = (" ".join(str(body.get(k, "")).split()) if k == "schedule" else str(body.get(k, "")).strip()
                                   for k in ("schedule", "command", "task"))
        lib = cron_lib()
        try:
            lib.cron_calendar(schedule)
        except lib.CronError as e:
            return str(e)
        if not command or "\n" in command or len(command) > 500:
            return L("El comando va en una sola línea (hasta 500 caracteres).", "The command goes on one line (up to 500 characters).")
        if task and (not CRON_NAME.fullmatch(task) or task in cron):
            return L(f"Nombre de tarea inválido o repetido: {task}", f"Invalid or repeated task name: {task}")
        tz = str(body.get("timezone", ""))
        env = {"ANDAMIO_TIMEZONE": tz} if tz and not check_timezone(tz) else {}
        return plan(["app", "cron", "add", name, schedule, command, *(["--name", task] if task else [])], env=env)
    if action == "secret-import":
        pairs = body.get("pairs")
        if not isinstance(pairs, list) or not 1 <= len(pairs) <= 100:
            return L("Entre 1 y 100 variables.", "Between 1 and 100 variables.")
        lines, seen = [], set()
        for p in pairs:
            key, value = (str(p.get("key", "")), p.get("value")) if isinstance(p, dict) else ("", None)
            if not SECRET_KEY.fullmatch(key) or key in RESERVED_SECRETS or key in seen:
                return L(f"Nombre de secreto inválido o repetido: {key}", f"Invalid or repeated secret name: {key}")
            if not isinstance(value, str) or not value or "\n" in value or "\r" in value or len(value) > 4096:
                return L(f"{key}: el valor va en una sola línea (hasta 4096 caracteres).",
                         f"{key}: the value goes on one line (up to 4096 characters).")
            seen.add(key)
            lines.append(f'{key}="{value}"')   # entre comillas: secrets_merge quita solo ese par
        return plan(["app", "secret", "import", name, "-"], stdin="\n".join(lines) + "\n")
    if action in ("secret-set", "secret-rm"):
        key = str(body.get("key", ""))
        if not SECRET_KEY.fullmatch(key) or key in RESERVED_SECRETS:
            return L(f"Nombre de secreto inválido: {key} (MAYÚSCULAS, números y _; no DOMAIN, DATABASE_URL, MYSQL_URL, REDIS_URL ni TAG)",
                     f"Invalid secret name: {key} (UPPERCASE, digits and _; not DOMAIN, DATABASE_URL, MYSQL_URL, REDIS_URL or TAG)")
        if action == "secret-rm":
            return plan(["app", "secret", "rm", name, key])
        value = body.get("value")
        if not isinstance(value, str) or not value or "\n" in value or "\r" in value or len(value) > 4096:
            return L("El valor va en una sola línea (hasta 4096 caracteres).", "The value goes on one line (up to 4096 characters).")
        return plan(["app", "secret", "set", name, key], stdin=value)
    if action == "source":
        # De dónde sale una de varias apps de un repo: su carpeta, desde dónde se construye, sus rutas.
        argv = ["app", "source", name]
        d, ctx = str(body.get("dir", "") or "").rstrip("/"), str(body.get("context", "") or "")
        add, rm = str(body.get("watch_add", "") or "").lstrip("/"), str(body.get("watch_rm", "") or "").lstrip("/")
        if d:
            if not DIR_RX.fullmatch(d) or ".." in d:
                return L(f"Carpeta inválida: {d}", f"Invalid folder: {d}")
            argv += ["--dir", d]
        if ctx:
            if ctx not in (".", "-"):
                return L("Construir desde: . (la raíz) o - (su carpeta)", "Built from: . (the root) or - (its folder)")
            argv += ["--context", ctx]
        for flag, w in (("--watch-add", add), ("--watch-rm", rm)):
            if w:
                if not re.fullmatch(r"[A-Za-z0-9._*/-]+", w) or ".." in w:
                    return L(f"Ruta inválida: {w}", f"Invalid path: {w}")
                argv += [flag, w]
        if len(argv) == 3:
            return L("Nada que cambiar", "Nothing to change")
        return plan(argv, sudo=False, env={"ANDAMIO_SOURCE_OK": "1"})
    if action in ("domain-add", "domain-rm", "cors-add", "cors-rm", "volume-add", "volume-rm"):
        kind, op = action.split("-")
        value = str(body.get("value", "")).strip()
        value = value.lower().rstrip("/") if kind in ("domain", "cors") else value.rstrip("/")
        rx = {"domain": DOMAIN_RX, "cors": ORIGIN_RX, "volume": VOLUME_RX}[kind]
        if not rx.fullmatch(value) or ".." in value:
            return L(f"Valor inválido: {value}", f"Invalid value: {value}")
        env = {"ANDAMIO_DNS_OK": "1"} if kind == "domain" and op == "add" and body.get("dns_ok") is True else {}
        return plan(["app", kind, op, name, value], env=env)
    if action == "retry":
        return plan(["app", "retry", name], sudo=False)
    if action == "revert":
        # Ya lo confirmaste en la ventana: la CLI no vuelve a preguntar (ANDAMIO_REVERT_OK).
        sha = str(body.get("commit", ""))
        if not re.fullmatch(r"[0-9a-f]{40}", sha):
            return L("Commit inválido", "Invalid commit")
        return plan(["app", "revert", name, sha], env={"ANDAMIO_REVERT_OK": "1"})
    if action == "rollback":
        # Ya lo confirmaste en la ventana: la CLI no vuelve a preguntar (ANDAMIO_ROLLBACK_OK).
        sha = str(body.get("sha", ""))
        if not re.fullmatch(r"[0-9a-f]{40}", sha):
            return L("Commit inválido", "Invalid commit")
        return plan(["app", "rollback", name, sha], sudo=False, env={"ANDAMIO_ROLLBACK_OK": "1"})
    if action == "restore":
        # Doble confirmación, como al borrar: entiendes qué se reemplaza y escribiste el nombre.
        snap = str(body.get("snapshot", ""))
        if not re.fullmatch(r"latest|[0-9a-f]{8,64}", snap):
            return L("Respaldo inválido", "Invalid backup")
        if body.get("understood") is not True or body.get("confirm") != name:
            return L("Para restaurar: marca que entiendes lo que se reemplaza y escribe el nombre exacto de la app",
                     "To restore: tick that you understand what gets replaced and type the app's exact name")
        return plan(["app", "restore", name, snap], stdin=name + "\n")
    if action == "destroy":
        # Doble confirmación, como GitHub: marcaste que entiendes lo que se borra y escribiste el
        # nombre. Se vuelve a comprobar aquí, y la CLI pide el nombre otra vez (va por stdin).
        if body.get("understood") is not True or body.get("confirm") != name:
            return L("Para borrar: marca que entiendes lo que se borra y escribe el nombre exacto de la app",
                     "To delete: tick that you understand what's deleted and type the app's exact name")
        if name == str(ui_config().get("andamio_dashboard_app") or ""):
            return L(f"{name} es tu dashboard: no se borra desde aquí", f"{name} is your dashboard: it isn't deleted from here")
        return plan(["app", "destroy", name], stdin=name + "\n")
    return L("Acción desconocida", "Unknown action")


def ui_server_action(body: dict) -> dict | str | None:
    """Acciones del servidor (no de una app existente). None si no es una de estas."""
    if body.get("action") == "estado":
        return {"argv": ["estado"], "sudo": True, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") == "create":
        return ui_create_argv(body.get("create") or {})
    if body.get("action") == "telegram":
        token, chat = str(body.get("token", "")), str(body.get("chat", ""))
        if not TG_TOKEN.fullmatch(token) or not TG_CHAT.fullmatch(chat):
            return L("Falta el token del bot o tu ID de chat", "The bot token or your chat ID is missing")
        # El token entra por stdin (--token-stdin): nunca en la línea de comandos.
        return {"argv": ["telegram", "--chat", chat, "--token-stdin"], "sudo": True, "stdin": token + "\n", "env": {}, "exe": "andamio"}
    if body.get("action") == "ntfy":
        value = str(body.get("ntfy", ""))
        if value not in ("nuevo", "quitar") and not re.fullmatch(r"https://[A-Za-z0-9.-]+(:\d+)?/[A-Za-z0-9_-]{1,64}", value):
            return L("ntfy: nuevo, quitar o la URL https de tu tema", "ntfy: new, off or your topic's https URL")
        return {"argv": ["alertas", "--ntfy", value], "sudo": True, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") == "telegram-off":
        return {"argv": ["telegram", "desactivar"], "sudo": True, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") == "alert-test":
        return {"argv": ["alertas", "prueba"], "sudo": False, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") == "update-check":
        return {"argv": ["update", "--check"], "sudo": False, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") == "timezone":
        tz = str(body.get("timezone", ""))
        if not re.fullmatch(r"[A-Za-z0-9_+/-]{1,64}", tz) or check_timezone(tz):
            return L(f"Zona horaria inválida: {tz}", f"Invalid time zone: {tz}")
        return {"argv": ["zona", tz], "sudo": True, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") == "services":
        svc, values = str(body.get("service", "")), body.get("set") or {}
        if svc not in SERVICE_DEFAULTS or not isinstance(values, dict):
            return L("Servicio inválido", "Invalid service")
        argv = ["servicios", svc]
        for k, v in values.items():
            if k not in SERVICE_DEFAULTS[svc] or not re.fullmatch(r"[A-Za-z0-9.-]{1,20}", str(v)):
                return L(f"Valor inválido para {k}", f"Invalid value for {k}")
            argv += [f"--{k.replace('_', '-')}", str(v)]
        new = {k: dict(v) for k, v in services_config().items()}
        new[svc].update({k: str(v) for k, v in values.items()})
        if len(argv) == 2:
            return L("Nada que cambiar", "Nothing to change")
        if err := services_check(svc, new, None):
            return err
        return {"argv": argv, "sudo": True, "stdin": None, "env": {}, "exe": "andamio"}
    if body.get("action") in ("backup-now", "backup-list"):
        argv = ["backups", "now" if body["action"] == "backup-now" else "list"]
        return {"argv": argv, "sudo": True, "stdin": None, "env": {}, "exe": "andamio"}
    return None

# ---- Crear una app desde el panel (fase 3) ----

REPO_RX = re.compile(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+")
DIR_RX = re.compile(r"[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*")   # una carpeta del repo (varias apps en un repo)
HOST_RX = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?")


def ui_taken() -> tuple[list[str], list[str]]:
    """Nombres y hosts que ya usan tus apps (en tus archivos). Un host que una app comparte por
    rutas (path:) va como "host/ruta"."""
    recs = [(f.parent.name, yaml_load(f) or {}) for f in sorted((ROOT / "apps").glob("*/app.yml"))]
    return [n for n, _ in recs], [str(a.get("host", n)) + str(a.get("path") or "") for n, a in recs]


# Detección de las apps de un monorepo. Primero lo que el repo declara (workspaces de pnpm, npm o
# yarn, lerna, go.work); después, carpetas con Dockerfile o un proyecto, hasta 3 niveles. Cada
# una se clasifica: app (se despliega: Dockerfile, script start, un framework de servidor o de
# front) o librería (solo exporta código). Las carpetas dentro de una app (frontend/public,
# backend/src) no cuentan: son parte de ella.
FOLDER_SKIP = {"node_modules", "dist", "build", "out", "vendor", "coverage", "target", "__pycache__", "venv", "env",
               "public", "static", "assets", "src", "lib", "test", "tests", "__tests__", "fixtures", "migrations", "tmp"}
LIB_ROOTS = {"packages", "libs", "lib", "shared", "common", "tooling", "config", "configs", "examples", "example",
             "e2e", "scripts", "internal", "pkg", "docs-src"}
APP_NAMES = {"apps", "services", "frontend", "backend", "api", "web", "server", "client", "site", "app", "www", "admin",
             "dashboard", "worker", "docs"}
FRONT = {"next": "Next.js", "nuxt": "Nuxt", "@sveltejs/kit": "SvelteKit", "@remix-run/node": "Remix", "astro": "Astro",
         "@angular/core": "Angular", "gatsby": "Gatsby", "vite": "Vite", "react-scripts": "React", "@vue/cli-service": "Vue"}
BACK = {"@nestjs/core": "NestJS", "express": "Express", "fastify": "Fastify", "hono": "Hono", "koa": "Koa",
        "@hapi/hapi": "hapi", "@adonisjs/core": "AdonisJS"}
PY_BACK = {"django": "Django", "fastapi": "FastAPI", "flask": "Flask", "litestar": "Litestar", "starlette": "Starlette"}


def workspace_dirs(d: Path) -> list[Path]:
    """Las carpetas que el repo declara como paquetes de su monorepo."""
    import json
    globs: list[str] = []
    try:
        import yaml
        if (d / "pnpm-workspace.yaml").is_file():
            globs += (yaml.safe_load((d / "pnpm-workspace.yaml").read_text()) or {}).get("packages") or []
        if (d / "lerna.json").is_file():
            globs += json.loads((d / "lerna.json").read_text()).get("packages") or []
        if (d / "package.json").is_file():
            ws = json.loads((d / "package.json").read_text()).get("workspaces") or []
            globs += ws.get("packages", []) if isinstance(ws, dict) else ws
        if (d / "go.work").is_file():
            globs += re.findall(r"(?m)^\s*(?:use\s+)?\(?\s*(\./[\w./-]+)", (d / "go.work").read_text())
    except (ValueError, OSError, AttributeError):
        pass
    out: list[Path] = []
    for g in globs:
        g = str(g).strip().removeprefix("./").rstrip("/")
        if not g or g.startswith(("!", "/")) or ".." in g:
            continue
        for m in sorted(d.glob(g)) if any(c in g for c in "*?[") else [d / g]:
            if m.is_dir() and d in m.resolve().parents:
                out.append(m)
    return out


def classify_folder(sub: Path) -> dict | None:
    """¿Qué es esta carpeta? Lenguaje, si se despliega (app) o es una librería, y su papel."""
    import json
    kind = detect_kind(sub)
    docker = (sub / "Dockerfile").is_file()
    if not kind and not docker:
        return None
    framework, role, deployable, library = "", "", docker, False
    if kind == "node":
        try:
            pkg = json.loads((sub / "package.json").read_text())
        except (ValueError, OSError):
            pkg = {}
        deps = {**(pkg.get("dependencies") or {}), **(pkg.get("devDependencies") or {})}
        scripts = pkg.get("scripts") or {}
        back = next((v for k, v in BACK.items() if k in deps), "")
        front = next((v for k, v in FRONT.items() if k in deps), "")
        framework = back or front
        role = "api" if back else "web" if front else ""
        deployable = deployable or bool(framework or scripts.get("start"))
        library = not deployable and bool(pkg.get("main") or pkg.get("exports") or pkg.get("types") or not scripts.get("dev"))
    elif kind == "python":
        text = ""
        for f in ("requirements.txt", "pyproject.toml"):
            if (sub / f).is_file():
                text += (sub / f).read_text(errors="ignore").lower()
        framework = next((v for k, v in PY_BACK.items() if re.search(rf"(^|[\s\"'\[]){k}\b", text, re.M)), "")
        worker = re.search(r"(?m)^\s*[\"']?(celery|rq|dramatiq|arq|huey)\b", text)
        role = "api" if framework else "worker" if worker else ""
        deployable = deployable or bool(framework or worker) or any((sub / f).is_file() for f in ("manage.py", "main.py", "app.py"))
        library = not deployable
    elif kind == "go":
        mains = [f for f in [*sub.glob("*.go"), *sub.glob("cmd/*/*.go")] if re.search(r"(?m)^package main\b", f.read_text(errors="ignore"))]
        deployable = deployable or bool(mains)
        library = not deployable
    elif kind == "static":
        role, deployable = "site", True
    return {"kind": kind or "", "label": KINDS[kind][0] if kind else "", "dockerfile": docker, "framework": framework,
            "role": role, "lib": library and not docker}


def repo_folders(d: Path, limit: int = 40) -> list[dict]:
    """Las apps de un repo (front, back, workers...) y, aparte, sus librerías. Las más probables
    primero: las que declara el repo, con Dockerfile o framework, y con nombres de app."""
    declared = {m.resolve() for m in workspace_dirs(d)}
    seen: dict[Path, dict] = {}
    cands = [*declared, *[x for depth in ("*", "*/*", "*/*/*") for x in sorted(d.glob(depth)) if x.is_dir()]]
    for sub in sorted({c.resolve() for c in cands}, key=lambda x: (len(x.relative_to(d.resolve()).parts), str(x))):
        rel = sub.relative_to(d.resolve())
        if not rel.parts or any(part.startswith(".") or part in FOLDER_SKIP for part in rel.parts):
            continue
        # Dentro de una app ya detectada (frontend/public, backend/app): es parte de ella.
        if any(a in sub.parents and not info["lib"] for a, info in seen.items()):
            continue
        info = classify_folder(sub)
        if not info:
            continue
        top = rel.parts[0].lower()
        info["lib"] = info["lib"] or (top in LIB_ROOTS and not info["dockerfile"] and not info["framework"])
        score = 3 * info["dockerfile"] + 2 * bool(info["framework"]) + 2 * (sub in declared) \
            + (top in APP_NAMES or rel.parts[-1].lower() in APP_NAMES) - 5 * info["lib"]
        seen[sub] = {**info, "dir": rel.as_posix(), "declared": sub in declared, "score": score}
    found = sorted(seen.values(), key=lambda x: (x["lib"], -x["score"], x["dir"]))
    return found[:limit]


def yaml_load(f: Path):
    import yaml
    return yaml.safe_load(f.read_text())


ENV_USE = re.compile(
    r"""os\.environ(?:\.get)?\s*[\[(]\s*['"]([A-Z][A-Z0-9_]*)['"]"""     # Python: os.environ["X"], os.environ.get("X")
    r"""|os\.getenv\(\s*['"]([A-Z][A-Z0-9_]*)['"]"""                     # Python: os.getenv("X")
    r"""|process\.env\.([A-Z][A-Z0-9_]*)|process\.env\[['"]([A-Z][A-Z0-9_]*)['"]\]"""   # Node
    r"""|os\.(?:Getenv|LookupEnv)\("([A-Z][A-Z0-9_]*)"\)"""              # Go
    r"""|config\w*\.get(?:OrThrow)?(?:<[^>()]*>)?\(\s*['"]([A-Z][A-Z0-9_]*)['"]""")   # NestJS: config.get("X")
# El código falla sin ella: getOrThrow("X") (NestJS), os.environ["X"] (Python); process.env.X! se ve aparte.
ENV_REQUIRED = re.compile(r"""config\w*\.getOrThrow|os\.environ\s*\[""", re.I)
# Un valor de ejemplo que no es un valor: <...>, tu-clave, changeme, xxx...
ENV_PLACEHOLDER = re.compile(r"(?i)^(<.*>|\[.*\]|your[-_ ].*|tu[-_ ].*|change[-_ ]?me|x{3,}|\*+|\.\.\.|todo|replace.*|secret|password)$")
ENV_SECRETISH = re.compile(r"SECRET|PASSWORD|PASSWD|_PASS$|TOKEN|PRIVATE|_KEY$|^KEY$|API_?KEY|CREDENTIAL|DSN|SALT|WEBHOOK")
ENV_IGNORED = RESERVED_SECRETS | {"PORT", "NODE_ENV", "HOME", "PATH", "HOSTNAME", "APP_VERSION", "PYTHONUNBUFFERED", "CI"}


MYSQL_HINTS = [
    (".env.example", r"(?mi)^\s*DB_CONNECTION\s*=\s*['\"]?(mysql|mariadb)\b"),          # Laravel
    (".env.example", r"(?mi)^\s*\w*(DATABASE|DB)_URL\s*=\s*['\"]?(mysql|mariadb)\w*://"),
    ("package.json", r'"(mysql2|mysql|mariadb)"\s*:'),                                      # Node
    ("prisma/schema.prisma", r'provider\s*=\s*"mysql"'),
    ("schema.prisma", r'provider\s*=\s*"mysql"'),
    ("requirements.txt", r"(?mi)^\s*(mysqlclient|pymysql|mysql-connector-python|aiomysql|asyncmy)\b"),
    ("pyproject.toml", r"(?i)[\"'](mysqlclient|pymysql|mysql-connector-python|aiomysql|asyncmy)"),
    ("go.mod", r"github\.com/go-sql-driver/mysql"),
    ("Gemfile", r"gem ['\"]mysql2['\"]"),
    ("composer.json", r'"ext-pdo_mysql"'),
]


def detect_mysql(d: Path) -> bool:
    """¿El código declara MySQL/MariaDB? Solo lo que el repo dice (un driver, DB_CONNECTION=mysql,
    Prisma con provider "mysql"), nunca por el lenguaje: Laravel también puede usar PostgreSQL."""
    for name, rx in MYSQL_HINTS:
        files = [d / name] + ([d / ".env.sample", d / ".env.dist", d / ".env.template"] if name == ".env.example" else [])
        for f in files:
            try:
                if f.is_file() and f.stat().st_size < 500_000 and re.search(rx, f.read_text(errors="ignore")):
                    return True
            except OSError:
                continue
    return False


def detect_env_names(d: Path) -> list[dict]:
    """Las variables de entorno que el código usa (y las de un .env.example), con dónde están:
    las que el panel deja listas para llenar antes del primer deploy. `required`: el código falla
    sin ella (getOrThrow, os.environ[...], process.env.X!); `example`: el valor del .env.example, si no es secreto ni de tu máquina."""
    found: dict[str, str] = {}
    required: set[str] = set()
    example: dict[str, str] = {}
    tracked = run(["git", "-C", str(d), "ls-files"]).stdout.split()
    for rel in tracked:
        f = d / rel
        name = Path(rel).name
        if set(Path(rel).parts) & SKIP_DIRS or not f.is_file() or f.stat().st_size > 200_000:
            continue
        if re.fullmatch(r"\.env\.(example|sample|template|dist)", name):
            for n, line in enumerate(f.read_text(errors="ignore").splitlines(), 1):
                m = re.match(r"\s*(?:export\s+)?([A-Z][A-Z0-9_]*)\s*=\s*(.*)$", line)
                if m and m.group(1) not in ENV_IGNORED:
                    found.setdefault(m.group(1), f"{rel}:{n}")
                    v = re.sub(r"\s+#.*$", "", m.group(2)).strip()
                    v = v[1:-1] if len(v) > 1 and v[0] == v[-1] and v[0] in "'\"" else v
                    if v and len(v) <= 200 and not ENV_PLACEHOLDER.match(v) and not ENV_SECRETISH.search(m.group(1)) \
                            and not re.search(r"localhost|127\.0\.0\.1|0\.0\.0\.0", v):
                        example.setdefault(m.group(1), v)
        elif Path(rel).suffix in SOURCE_EXT:
            for n, line in enumerate(f.read_text(errors="ignore").splitlines(), 1):
                for m in ENV_USE.finditer(line):
                    key = next(g for g in m.groups() if g)
                    if key not in ENV_IGNORED:
                        found.setdefault(key, f"{rel}:{n}")
                        if ENV_REQUIRED.match(m.group(0)) or (line[m.end():m.end() + 1] == "!" and line[m.end():m.end() + 2] != "!="):
                            required.add(key)
    # Las que el código exige, primero.
    keys = sorted(found, key=lambda k: k not in required)[:40]
    return [{"key": k, "where": found[k], "required": k in required, "example": example.get(k, "")} for k in keys]


# Clones de la revisión, por repo y rama, unos minutos: elegir otra carpeta no vuelve a clonar
# todo el repo (en uno grande eran >20 s cada vez).
_PREVIEW_CLONES: dict[tuple[str, str], tuple[float, Path]] = {}
_PREVIEW_LOCK = threading.Lock()
PREVIEW_TTL = 600


def _preview_clone(repo: str, branch: str, url: str, fresh: bool = False) -> Path | None:
    """La carpeta con el repo clonado (reusada si es reciente, salvo `fresh`); None si no se pudo clonar."""
    import atexit
    key = (repo.lower(), branch)
    with _PREVIEW_LOCK:
        now = time.time()
        for k, (at, d) in list(_PREVIEW_CLONES.items()):
            if now - at > PREVIEW_TTL or not d.is_dir() or (fresh and k == key):
                shutil.rmtree(d.parent, ignore_errors=True)
                del _PREVIEW_CLONES[k]
        if key in _PREVIEW_CLONES:
            return _PREVIEW_CLONES[key][1]
        if not _PREVIEW_CLONES:
            atexit.register(lambda: [shutil.rmtree(d.parent, ignore_errors=True) for _, d in _PREVIEW_CLONES.values()])
        tmp = Path(tempfile.mkdtemp(prefix="andamio-preview-"))
        r = run(["git", "clone", "-q", "--depth", "1", "--branch", branch, url, str(tmp / "r")], timeout=180)
        if r.returncode != 0:
            shutil.rmtree(tmp, ignore_errors=True)
            return None
        _PREVIEW_CLONES[key] = (now, tmp / "r")
        return tmp / "r"


def ui_create_preview(repo: str, sub: str = "") -> dict:
    """La revisión del paso 2: clona el repo en una carpeta temporal (que se reusa unos minutos y se borra) y dice lo
    mismo que diría `app create`: lenguaje, Dockerfile (el suyo o el que propone andamio),
    comando de arranque, puerto y la revisión previa. No escribe nada en ningún lado."""
    import contextlib
    import io
    if not REPO_RX.fullmatch(repo):
        return {"error": L("Repo inválido: escribe dueño/nombre", "Invalid repo: write owner/name")}
    if sub and (not DIR_RX.fullmatch(sub) or ".." in sub):
        return {"error": L(f"Carpeta inválida: {sub}", f"Invalid folder: {sub}")}
    cfg = ui_config()
    instance = re.sub(r"^[^:]+:", "", str(cfg.get("andamio_repo", ""))).removesuffix(".git")
    # Las consultas a GitHub, a la vez (una tras otra eran ~20 s).
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(4) as pool:
        exists, priv, inst_priv, clone, defbr = pool.map(lambda a: forge(*a), [
            ("repo-exists", repo), ("repo-private", repo), ("repo-private", instance), ("clone-url", repo), ("default-branch", repo)])
    if exists.returncode != 0:
        return {"error": L(f"No existe {repo}, o tu sesión de GitHub no tiene acceso", f"{repo} doesn't exist, or your GitHub session has no access")}
    private = priv.returncode == 0
    names, hosts = ui_taken()
    # Las apps que ya salen de este repo (otra carpeta): el panel propone compartir su dirección.
    cfg_recs = [ui_app_record(f, cfg) for f in sorted((ROOT / "apps").glob("*/app.yml"))]
    siblings = [{"name": r["name"], "host": r["host"], "path": r["path"], "dir": r["dir"]}
                for r in cfg_recs if r["repo"].lower() == repo.lower()]
    out: dict = {"repo": repo, "private": private, "instance": instance, "taken": names, "hosts": hosts,
                 "blocked": not private and inst_priv.returncode == 0, "dir": sub, "folders": [], "siblings": siblings,
                 "branch": defbr.stdout.strip() or "main"}
    base = re.sub(r"[^a-z0-9-]+", "-", repo.split("/", 1)[1].lower()).strip("-")[:30]
    if sub:
        base = (base + "-" + re.sub(r"[^a-z0-9-]+", "-", sub.split("/")[-1].lower()).strip("-"))[:30].strip("-")
    out["name"] = base if APP_NAME.fullmatch(base) else ""
    if out["blocked"]:
        return out
    # Revisar el repo de nuevo trae lo último; elegir una carpeta reusa ese clon.
    root = _preview_clone(repo, out["branch"], clone.stdout.strip(), fresh=not sub)
    if root is None:
        return {**out, "error": L(f"No pude clonar {repo} por SSH", f"Couldn't clone {repo} over SSH")}
    out["folders"] = repo_folders(root)
    d = root / sub if sub else root
    if not d.is_dir():
        return {**out, "error": L(f"{repo} no tiene la carpeta {sub}", f"{repo} has no folder {sub}")}
    kind = detect_kind(d)
    out.update(kind=kind or "", label=KINDS[kind][0] if kind else "", start="", dockerfile="", has_dockerfile=False)
    df = d / "Dockerfile"
    port = "3000"
    if df.is_file():
        text = df.read_text(errors="ignore")
        m = re.search(r"(?mi)^EXPOSE +(\d+)", text)
        port = m.group(1) if m else port
        out.update(has_dockerfile=True, dockerfile=text[:20000])
    elif kind:
        port = "8080" if kind == "static" else KINDS[kind][1]
        values: dict = {"PORT": port}
        start = ""
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                if kind in ("node", "python"):
                    extra, start = node_values(d) if kind == "node" else python_values(d)
                    values.update(extra, START=start.replace("\\", "\\\\").replace('"', '\\"'))
                elif kind == "go":
                    values.update(go_values(d))
                out["dockerfile"] = render_dockerfile(kind, values)
        except SystemExit:
            out["dockerfile"] = ""
        out["start"] = start
    out["port"] = port
    out["findings"] = [{"serious": serious, "msg": msg, "volume": "--volume" in msg}
                       for serious, msg in precheck_findings(d, port, False)]
    out["env"] = detect_env_names(d)
    out["mysql"] = detect_mysql(d)
    return out


_ENV_CHECK: dict[str, tuple[float, dict]] = {}


def ui_env_check(app: str) -> dict:
    """Las variables que usa el código de la app (lo último de main) y cuáles no tiene como secreto.
    Clona el repo en una carpeta temporal que se borra; 60 s en caché."""
    f = ROOT / "apps" / app / "app.yml"
    if not APP_NAME.fullmatch(app) or not f.is_file():
        return {"error": L("No existe esa app", "No such app")}
    hit = _ENV_CHECK.get(app)
    if hit and time.time() - hit[0] < 60:
        return hit[1]
    rec = ui_app_record(f, ui_config())
    r = run(["sops", "decrypt", "--input-type", "dotenv", "--output-type", "dotenv", f"apps/{app}/secrets.sops.env"], cwd=ROOT) \
        if shutil.which("sops") else None
    have = set(re.findall(r"(?m)^([A-Za-z_][A-Za-z0-9_]*)=", r.stdout)) if r and r.returncode == 0 else set()
    clone = forge("clone-url", rec["repo"])
    tmp = Path(tempfile.mkdtemp(prefix="andamio-env-"))
    try:
        c = run(["git", "clone", "-q", "--depth", "1", clone.stdout.strip(), str(tmp / "r")], timeout=180)
        if clone.returncode != 0 or c.returncode != 0:
            return {"error": L(f"No pude clonar {rec['repo']} por SSH", f"Couldn't clone {rec['repo']} over SSH")}
        used = detect_env_names(tmp / "r" / rec["dir"] if rec["dir"] else tmp / "r")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    # Las que pone andamio (DATABASE_URL, REDIS_URL...) no faltan nunca.
    missing = [u for u in used if u["key"] not in have and u["key"] not in RESERVED_SECRETS]
    out = {"used": used, "missing": missing, "have": sorted(have - RESERVED_SECRETS), "error": ""}
    _ENV_CHECK[app] = (time.time(), out)
    return out


def ui_create_argv(c: dict) -> dict | str:
    """Del formulario de "Nueva app" al mismo `andamio app create` (con lo que ya decidiste)."""
    cfg = ui_config()
    names, hosts = ui_taken()
    name, repo = str(c.get("name", "")), str(c.get("repo", "") or "")
    if not APP_NAME.fullmatch(name):
        return L("Nombre inválido: minúsculas, números y guiones (3-30)", "Invalid name: lowercase letters, digits and hyphens (3-30)")
    if name in names or (ROOT / "apps" / name).exists():
        return L(f"Ya hay una app {name}", f"There's already an app {name}")
    if repo and not REPO_RX.fullmatch(repo):
        return L("Repo inválido: dueño/nombre", "Invalid repo: owner/name")
    if not repo and not cfg.get("andamio_app_template"):
        return L("Elige el repo de tu app (no hay plantilla configurada)", "Pick your app's repo (no template configured)")
    host = str(c.get("host") or name)
    if host != "@" and not HOST_RX.fullmatch(host):
        return L(f"Dirección inválida: {host}", f"Invalid address: {host}")
    sub, ctx, path = str(c.get("dir", "") or "").rstrip("/"), str(c.get("context", "") or ""), str(c.get("path", "") or "")
    if sub and (not DIR_RX.fullmatch(sub) or ".." in sub or not repo):
        return L(f"Carpeta inválida: {sub}", f"Invalid folder: {sub}")
    if ctx and (ctx != "." or not sub):
        return L("Construir desde la raíz va con una carpeta", "Building from the root goes with a folder")
    if path and not re.fullmatch(r"/[a-z0-9._-]+(/[a-z0-9._-]+)*", path):
        return L(f"Ruta inválida: {path} (ej. /api)", f"Invalid path: {path} (e.g. /api)")
    if host + path in hosts:
        return L(f"La dirección {host}{path} ya la usa otra app", f"Address {host}{path} is already used by another app")
    port, mem, health = str(c.get("port", "3000")), str(c.get("mem", "256m")), str(c.get("health", "") or "")
    if not re.fullmatch(r"[0-9]{2,5}", port) or int(port) > 65535:
        return L(f"Puerto inválido: {port}", f"Invalid port: {port}")
    if not MEM.fullmatch(mem):
        return L(f"Memoria inválida: {mem}", f"Invalid memory: {mem}")
    if health and not HEALTH.fullmatch(health):
        return L(f"Ruta de salud inválida: {health}", f"Invalid health path: {health}")
    argv = ["app", "create", name, *(["--repo", repo] if repo else []), "--host", host, "--port", port, "--mem", mem]
    if health:
        argv += ["--health", health]
    own = str(c.get("domain", "") or "").strip().lower().rstrip(".")
    if own:
        if not DOMAIN_RX.fullmatch(own):
            return L(f"Dominio inválido: {own}", f"Invalid domain: {own}")
        argv += ["--domain", own]
    branch = str(c.get("branch", "") or "")
    if branch:
        if not re.fullmatch(r"[A-Za-z0-9._/-]{1,100}", branch) or ".." in branch:
            return L(f"Rama inválida: {branch}", f"Invalid branch: {branch}")
        argv += ["--branch", branch]
    if sub:
        argv += ["--dir", sub, *(["--context", "."] if ctx else [])]
    if path:
        argv += ["--path", path]
    if c.get("access") == "public":
        argv.append("--public")
    if c.get("db") is True:
        argv.append("--db")
    if c.get("mysql") is True:
        argv.append("--mysql")
    if c.get("redis") is True:
        argv.append("--redis")
    volume = str(c.get("volume", "") or "").rstrip("/")
    if volume:
        if not VOLUME_RX.fullmatch(volume) or ".." in volume or \
           re.match(r"^/(bin|boot|dev|etc|lib|lib64|proc|root|run|sbin|sys|usr|var/run)(/|$)", volume):
            return L(f"Carpeta inválida: {volume}", f"Invalid folder: {volume}")
        argv += ["--volume", volume]
    env = {"ANDAMIO_CREATE_OK": "1", **({"ANDAMIO_DNS_OK": "1"} if own and c.get("dns_ok") is True else {})}
    if c.get("precheck_ok") is True:
        env["ANDAMIO_PRECHECK_OK"] = "1"
    start = str(c.get("start", "") or "").strip()
    if start:
        if "\n" in start or len(start) > 300:
            return L("El comando de arranque va en una sola línea", "The start command goes on one line")
        env["ANDAMIO_START_CMD"] = start
    # Variables para el primer deploy: por stdin (--env-file -), nunca en la línea de comandos.
    lines, seen = [], set()
    for item in c.get("secrets") or []:
        key, value = str(item.get("key", "")), item.get("value")
        if not SECRET_KEY.fullmatch(key) or key in RESERVED_SECRETS or key in seen:
            return L(f"Variable inválida o repetida: {key}", f"Invalid or repeated variable: {key}")
        if not isinstance(value, str) or not value or "\n" in value or "\r" in value or len(value) > 4096:
            return L(f"El valor de {key} va en una sola línea", f"{key}'s value goes on one line")
        seen.add(key)
        lines.append(f"{key}={value}")
    stdin = None
    if lines:
        argv += ["--env-file", "-"]
        stdin = "\n".join(lines) + "\n"
    return {"argv": argv, "sudo": True, "stdin": stdin, "env": env}



def ui_dns(domain: str) -> dict:
    """¿El DNS de este dominio ya apunta a tu servidor? (lo mismo que revisa la CLI)."""
    cfg = ui_config()
    ip = str(cfg.get("andamio_server_ip", ""))
    d = domain.lower().rstrip(".")
    if not DOMAIN_RX.fullmatch(d):
        return {"ok": False, "error": L(f"Dominio inválido: {domain}", f"Invalid domain: {domain}")}
    try:
        found = sorted({a[4][0] for a in socket.getaddrinfo(d, None, socket.AF_INET)})
    except OSError:
        found = []
    return {"ok": ip in found, "ip": ip, "found": found}


def ui_cron_preview(schedule: str, tz: str) -> dict:
    """El horario traducido y la próxima vez, para mostrarlo mientras lo escribes."""
    lib = cron_lib()
    try:
        cal = lib.cron_calendar(" ".join(schedule.split()))
    except lib.CronError as e:
        return {"error": str(e)}
    zone = tz if tz and not check_timezone(tz) else (ui_config().get("andamio_timezone") or "UTC")
    return {"calendar": cal, "timezone": zone, "next": next_run(f"{cal} {zone}")}


def ui_run_job(job: UiJob) -> None:
    """Corre la acción: primero la contraseña de sudo si hace falta (la página la pide dentro
    de su terminal), después el mismo comando de la CLI, con su salida línea por línea."""
    job.emit("line", f"$ {job.command}")
    if job.needs_sudo:
        cfg = ui_config()
        if not sudo_cache_file(cfg):
            job.emit("line", L("✗ Sin $XDG_RUNTIME_DIR no puedo recordar tu contraseña de sudo: corre el comando en tu terminal.",
                               "✗ Without $XDG_RUNTIME_DIR I can't remember your sudo password: run the command in your terminal."))
            job.finish(1)
            return
        if sudo_remembered(cfg, server_alias()) is None:
            job.state = "password"
            job.emit("prompt", L(f"Contraseña de sudo de '{cfg['andamio_user']}'", f"Sudo password for '{cfg['andamio_user']}'"))
            job.password_ok.wait()
            if job.cancelled:
                job.emit("line", L("Cancelado: no se corrió nada.", "Cancelled: nothing ran."))
                job.finish(130)
                return
    job.state = "running"
    env = {**os.environ, "ANDAMIO_ASSUME": "default", "ANDAMIO_LANG": LANG, "PYTHONUNBUFFERED": "1", **job.env}
    # Sin terminal de control (start_new_session): ninguna pregunta puede quedarse esperando.
    proc = subprocess.Popen([str(ROOT / "bin" / job.exe), *job.argv], cwd=ROOT, env=env,
                            stdin=subprocess.PIPE if job.stdin is not None else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    if job.stdin is not None:   # el valor de un secreto: por stdin, como `... | andamio app secret set`
        proc.stdin.write(job.stdin.encode())
        proc.stdin.close()
        job.stdin = None
    for raw in proc.stdout:
        job.emit("line", ANSI.sub("", raw.decode(errors="replace")).rstrip("\r\n"))
    job.finish(proc.wait())


def ui_check_password(job: UiJob, pw: str) -> None:
    cfg = ui_config()
    user = cfg["andamio_user"]
    if remote(server_alias(), "sudo -S -p '' -v", stdin=pw + "\n").returncode == 0:
        remember_sudo(cfg, pw)
        m = human_minutes(sudo_minutes())
        job.emit("line", L(f"✓ Contraseña correcta (se recuerda {m} sin uso; Ajustes la olvida)", f"✓ Password correct (remembered for {m} idle; Settings forgets it)"))
        job.password_ok.set()
        return
    job.tries += 1
    if job.tries >= 3:
        job.emit("line", L(f"✗ No es la contraseña de sudo de '{user}'. No se corrió nada.",
                           f"✗ That's not the sudo password for '{user}'. Nothing ran."))
        job.cancelled = True
        job.password_ok.set()
        return
    job.emit("line", L(f"! No es la contraseña de sudo de '{user}' ({3 - job.tries} intentos más).",
                       f"! That's not the sudo password for '{user}' ({3 - job.tries} more tries)."))
    job.emit("prompt", L(f"Contraseña de sudo de '{user}'", f"Sudo password for '{user}'"))


def cmd_ui(args: argparse.Namespace) -> None:
    import hmac
    import json
    import select
    import threading
    from http.cookies import SimpleCookie
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlsplit

    if not CONFIG.exists():
        die(L("Esta copia todavía no tiene configuración: corre primero `andamio init`.",
              "This copy has no configuration yet: run `andamio init` first."))
    if not (UI_DIR / "index.html").is_file():
        die(L("Falta ui/index.html (la interfaz compilada): tools/ui-build.sh la genera.",
              "ui/index.html is missing (the built interface): tools/ui-build.sh generates it."))
    token, csrf = secrets.token_urlsafe(32), secrets.token_urlsafe(24)
    httpd = ThreadingHTTPServer(("127.0.0.1", args.port), BaseHTTPRequestHandler)
    httpd.daemon_threads = True
    port = httpd.server_address[1]
    hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    origins = {f"http://{h}" for h in hosts}
    cookie_name = f"andamio_ui_{port}"   # una por puerto: las cookies de 127.0.0.1 no separan puertos
    jobs: dict[str, UiJob] = {}
    children: dict[str, tuple] = {}   # paneles de tus otras copias (otros servidores), abiertos desde aquí
    busy = threading.Lock()   # una acción a la vez: dos commits a la vez chocarían

    class Handler(BaseHTTPRequestHandler):
        server_version = "andamio-ui"
        sys_version = ""

        def log_message(self, *_):   # sin ruido en tu terminal (y nada de lo enviado queda escrito)
            pass

        def send(self, code: int, body: bytes, ctype: str, extra: dict | None = None) -> None:
            self.send_response(code)
            for k, v in {"Content-Type": f"{ctype}; charset=utf-8", "Content-Length": str(len(body)),
                         "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff",
                         "Referrer-Policy": "no-referrer", "X-Frame-Options": "DENY",
                         "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; "
                                                    "frame-ancestors 'none'; base-uri 'none'; form-action 'none'",
                         **(extra or {})}.items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def json(self, data, code: int = 200) -> None:
            self.send(code, json.dumps(data).encode(), "application/json")

        def deny(self, why: str) -> None:
            self.send(403, why.encode(), "text/plain")

        def allowed(self) -> bool:
            # Otro sitio abierto en tu navegador no puede usar el panel: el nombre de host tiene que
            # ser este (frena el DNS rebinding) y el origen, si viene, también.
            if self.headers.get("Host") not in hosts:
                self.deny("host")
                return False
            origin = self.headers.get("Origin")
            if origin and origin not in origins:
                self.deny("origin")
                return False
            return True

        def authed(self) -> bool:
            c = SimpleCookie(self.headers.get("Cookie", ""))
            return cookie_name in c and hmac.compare_digest(c[cookie_name].value, token)

        def sse_headers(self) -> None:
            self.send_response(200)
            for k, v in {"Content-Type": "text/event-stream; charset=utf-8", "Cache-Control": "no-store",
                         "X-Content-Type-Options": "nosniff"}.items():
                self.send_header(k, v)
            self.end_headers()

        def do_GET(self) -> None:
            if not self.allowed():
                return
            url = urlsplit(self.path)
            # El link que imprime andamio ui trae la clave una vez; queda en una cookie y se va de la URL.
            given = parse_qs(url.query).get("t", [""])[0]
            if given and hmac.compare_digest(given, token):
                self.send(303, b"", "text/plain", {"Location": "/", "Set-Cookie":
                          f"{cookie_name}={token}; HttpOnly; SameSite=Strict; Path=/"})
                return
            if not self.authed():
                self.deny(L("Abre el link que mostró `andamio ui` (cambia cada vez que lo corres).",
                            "Open the link `andamio ui` printed (it changes every time you run it)."))
                return
            path = url.path
            if path == "/":
                self.send(200, (UI_DIR / "index.html").read_bytes(), "text/html")
            elif re.fullmatch(r"/assets/[A-Za-z0-9._-]+", path) and (UI_DIR / path[1:]).is_file():
                f = UI_DIR / path[1:]
                self.send(200, f.read_bytes(), CONTENT_TYPES.get(f.suffix, "application/octet-stream"))
            elif path == "/api/meta":
                cfg = ui_config()
                self.json({"lang": LANG, "domain": cfg.get("andamio_domain", ""), "server": server_alias(),
                           "user": cfg.get("andamio_user", ""), "copy": str(ROOT), "csrf": csrf,
                           "timezone": cfg.get("andamio_timezone") or "UTC",
                           "timezone_set": bool(cfg.get("andamio_timezone")),
                           "template": cfg.get("andamio_app_template") or "", "owner": cfg.get("andamio_github_owner", ""),
                           "dashboard_app": cfg.get("andamio_dashboard_app") or ""})
            elif path == "/api/apps":
                self.json(ui_apps())
            elif path == "/api/names":
                # Para Ctrl+K: solo tus archivos (al instante), sin preguntarle al servidor.
                cfg = ui_config()
                self.json({"apps": [{k: r[k] for k in ("name", "url", "stopped")}
                                    for r in (ui_app_record(f, cfg) for f in sorted((ROOT / "apps").glob("*/app.yml")))]})
            elif path.startswith("/api/app/"):
                data = ui_app(path.removeprefix("/api/app/"))
                self.json(data) if data else self.json({"error": "no existe"}, 404)
            elif path == "/api/repos":
                r = forge("repos")
                self.json({"repos": json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []})
            elif path == "/api/create/preview":
                q = parse_qs(url.query)
                self.json(ui_create_preview(q.get("repo", [""])[0], q.get("dir", [""])[0]))
            elif path == "/api/deploys":
                app = parse_qs(url.query).get("app", [""])[0]
                if not app:
                    self.json({"deploys": ui_deploys()})
                elif not APP_NAME.fullmatch(app) or not (ROOT / "apps" / app / "app.yml").is_file():
                    self.json({"error": "app"}, 400)
                else:
                    rec = ui_app_record(ROOT / "apps" / app / "app.yml", ui_config())
                    self.json({"deploys": ci_runs_cached(rec["repo"], workflow=rec["workflow"], branch=rec["branch"])})
            elif path == "/api/metrics":
                q = parse_qs(url.query)
                self.json(ui_metrics(q.get("app", [""])[0], q.get("range", ["24h"])[0]))
            elif path == "/api/history":
                app = parse_qs(url.query).get("app", [""])[0]
                if app and (not APP_NAME.fullmatch(app)):
                    self.json({"error": "app"}, 400)
                else:
                    self.json({"changes": ui_history(app)})
            elif path == "/api/copies":
                self.json({"copies": ui_copies()})
            elif path == "/api/ci-failure":
                q = parse_qs(url.query)
                app, rid = q.get("app", [""])[0], q.get("run", [""])[0]
                if not APP_NAME.fullmatch(app) or not (ROOT / "apps" / app / "app.yml").is_file() or not rid.isdigit():
                    self.json({"error": "app/run"}, 400)
                else:
                    rec = ui_app_record(ROOT / "apps" / app / "app.yml", ui_config())
                    r = forge("ci-failure", rec["repo"], rid)
                    try:
                        self.json(json.loads(r.stdout))
                    except ValueError:
                        self.json({"error": L("No pude leer esa corrida de GitHub", "Couldn't read that run from GitHub")})
            elif path == "/api/cron-runs":
                q = parse_qs(url.query)
                app, task = q.get("app", [""])[0], q.get("task", [""])[0]
                if not APP_NAME.fullmatch(app) or not CRON_NAME.fullmatch(task):
                    self.json({"error": "app/task"}, 400)
                else:
                    self.json({"runs": cron_runs(app, task)})
            elif path == "/api/certs":
                self.json(ui_certs())
            elif path == "/api/services":
                self.json(ui_services(parse_qs(url.query).get("app", [""])[0]))
            elif path == "/api/timeline":
                self.json(ui_timeline(parse_qs(url.query).get("app", [""])[0]))
            elif path == "/api/env-check":
                self.json(ui_env_check(parse_qs(url.query).get("app", [""])[0]))
            elif path == "/api/suggest":
                self.json(ui_suggest(parse_qs(url.query).get("app", [""])[0]))
            elif path == "/api/deploy-progress":
                self.json(ui_deploy_progress(parse_qs(url.query).get("app", [""])[0]))
            elif path == "/api/data-services":
                self.json(ui_data_services())
            elif path == "/api/sparks":
                self.json(ui_sparks())
            elif path == "/api/availability":
                self.json(ui_availability())
            elif path == "/api/sql/tables":
                q = parse_qs(url.query)
                self.json(ui_sql_tables(q.get("app", [""])[0], "mysql" if q.get("engine", [""])[0] == "mysql" else "postgres"))
            elif path == "/api/settings":
                self.json(ui_settings())
            elif path == "/api/backups":
                self.json(ui_backups())
            elif path == "/api/dns":
                self.json(ui_dns(parse_qs(url.query).get("domain", [""])[0]))
            elif path == "/api/cron-preview":
                q = parse_qs(url.query)
                self.json(ui_cron_preview(q.get("schedule", [""])[0], q.get("tz", [""])[0]))
            elif path.startswith("/api/logs/"):
                q = parse_qs(url.query)
                tail = q.get("tail", ["200"])[0]
                self.logs(path.removeprefix("/api/logs/"), int(tail) if tail in ("200", "1000", "5000") else 200,
                          "worker" if q.get("service", [""])[0] == "worker" else "app")
            elif path == "/api/jobs/current":
                # Al recargar la página, la acción que sigue corriendo (para volver a conectarse).
                cur = next((j for j in jobs.values() if j.state != "done"), None)
                self.json({"id": cur.id, "command": cur.command, "action": cur.action, "state": cur.state} if cur else {})
            elif m := re.fullmatch(r"/api/jobs/([a-f0-9]{16})/events", path):
                # Al reconectarse, el navegador manda el último evento que recibió: se sigue desde ahí.
                last = self.headers.get("Last-Event-ID") or parse_qs(url.query).get("from", ["0"])[0]
                self.job_events(m.group(1), int(last) if str(last).isdigit() else 0)
            else:
                self.send(404, b"", "text/plain")

        def do_HEAD(self) -> None:
            self.do_GET()

        def do_POST(self) -> None:
            # Una acción solo desde esta página: origen exacto (obligatorio), la clave de sesión en
            # una cabecera propia (otro sitio no puede leerla ni enviarla) y JSON.
            if not self.allowed():
                return
            if not self.authed():
                self.deny("auth")
                return
            if self.headers.get("Origin") not in origins or \
               not hmac.compare_digest(self.headers.get("X-Andamio-CSRF", ""), csrf) or \
               not self.headers.get("Content-Type", "").startswith("application/json"):
                self.deny("csrf")
                return
            size = int(self.headers.get("Content-Length") or 0)
            if size > 10_000:
                self.send(413, b"", "text/plain")
                return
            try:
                body = json.loads(self.rfile.read(size) or b"{}")
            except ValueError:
                self.json({"error": "json"}, 400)
                return
            path = urlsplit(self.path).path
            if path == "/api/jobs":
                self.new_job(body)
            elif path in ("/api/telegram/check", "/api/telegram/chats"):
                # El token solo viaja de esta página a este proceso, y de aquí a Telegram.
                token = str(body.get("token", ""))
                if path.endswith("check"):
                    self.json(tg_check(token))
                elif not TG_TOKEN.fullmatch(token):
                    self.json({"chats": [], "error": "token"}, 400)
                else:
                    wait = body.get("wait")
                    self.json(tg_chats(token, wait=min(wait, 20) if isinstance(wait, int) and wait > 0 else 0))
            elif path == "/api/sudo":
                # Cuánto se recuerda la contraseña de sudo (solo las opciones del panel), u olvidarla ya.
                if body.get("forget") is True:
                    forget_sudo()
                    self.json({"ok": True})
                elif body.get("minutes") in SUDO_CHOICES:
                    set_sudo_minutes(body["minutes"])
                    self.json({"ok": True, "minutes": body["minutes"]})
                else:
                    self.json({"error": L("Opción inválida", "Invalid option")}, 400)
            elif path == "/api/sql":
                self.json(ui_sql(str(body.get("app", "")), str(body.get("query", "")),
                                 "mysql" if body.get("engine") == "mysql" else "postgres"))
            elif path == "/api/switch":
                data = ui_spawn_panel(str(body.get("path", "")), children)
                self.json(data, 400 if "error" in data else 200)
            elif m := re.fullmatch(r"/api/jobs/([a-f0-9]{16})/(password|cancel)", path):
                job = jobs.get(m.group(1))
                if not job or job.state != "password":
                    self.json({"error": L("Esa acción no espera una contraseña", "That action isn't waiting for a password")}, 409)
                elif m.group(2) == "cancel":
                    job.cancelled = True
                    job.password_ok.set()
                    self.json({"ok": True})
                else:
                    threading.Thread(target=ui_check_password, args=(job, str(body.get("password", ""))),
                                     daemon=True).start()
                    self.json({"ok": True})
            else:
                self.send(404, b"", "text/plain")

        def do_PUT(self) -> None:
            self.send(405, b"", "text/plain")

        do_DELETE = do_PATCH = do_PUT

        def new_job(self, body: dict) -> None:
            plan = ui_server_action(body) or ui_action_argv(body)
            if isinstance(plan, str):
                self.json({"error": plan}, 400)
                return
            if not busy.acquire(blocking=False):
                running = next((j.command for j in jobs.values() if j.state != "done"), "")
                self.json({"error": L("Ya hay una acción corriendo", "An action is already running"), "running": running}, 409)
                return
            job = UiJob(secrets.token_hex(8), plan["argv"], plan["sudo"], plan["stdin"], plan["env"])
            job.exe = plan.get("exe", "andamio-app")
            job.action = str(body.get("action", ""))
            if job.exe == "andamio":
                job.command = "andamio " + " ".join(plan["argv"])
            jobs[job.id] = job

            def work() -> None:
                try:
                    ui_run_job(job)
                except Exception as e:   # que la página no quede esperando para siempre
                    job.emit("line", f"✗ {e}")
                    job.finish(1)
                finally:
                    busy.release()
            threading.Thread(target=work, daemon=True).start()
            self.json({"id": job.id, "command": job.command}, 201)

        def job_events(self, jid: str, start: int) -> None:
            """Lo que va saliendo de una acción (server-sent events); con ?from=N retoma donde quedó."""
            job = jobs.get(jid)
            if not job:
                self.send(404, b"", "text/plain")
                return
            self.sse_headers()
            i = max(0, start)
            try:
                while True:
                    with job.cond:
                        if i >= len(job.events):
                            job.cond.wait(15)
                        batch = job.events[i:]
                    i += len(batch)
                    if not batch:
                        self.wfile.write(b": ping\n\n")
                    for kind, text in batch:
                        self.wfile.write(f"event: {kind}\nid: {i}\ndata: {json.dumps(text)}\n\n".encode())
                    self.wfile.flush()
                    if any(k == "done" for k, _ in batch):
                        break
            except (BrokenPipeError, ConnectionResetError):
                pass

        def logs(self, name: str, tail: int = 200, service: str = "app") -> None:
            """Logs en vivo (server-sent events): las últimas `tail` líneas (200, 1000 o 5000) y lo que vaya saliendo."""
            if not APP_NAME.fullmatch(name) or not (ROOT / "apps" / name / "app.yml").is_file():
                self.send(404, b"", "text/plain")
                return
            remote_cmd = (f"c=$(docker ps -aq --filter label=com.docker.compose.project={name} "
                          f"--filter label=com.docker.compose.service={service} --filter label=com.docker.compose.oneoff=False "
                          f"| head -n 1); [ -n \"$c\" ] || {{ echo '{L('sin contenedores: nunca se desplegó', 'no containers: never deployed')}'; exit 0; }}; "
                          f"exec docker logs -f --timestamps --tail {tail} \"$c\" 2>&1")
            proc = subprocess.Popen([*ssh_cmd("-T"), remote_cmd], stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            self.sse_headers()
            fd, pending = proc.stdout.fileno(), b""
            try:
                while True:
                    ready, _, _ = select.select([fd], [], [], 15)
                    if not ready:   # sin logs nuevos: un latido, para notar si cerraste la página
                        self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
                        continue
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        self.wfile.write(b"event: end\ndata: {}\n\n")
                        self.wfile.flush()
                        break
                    *lines, pending = (pending + chunk).split(b"\n")
                    if lines:
                        self.wfile.write(b"".join(f"data: {json.dumps(l.decode(errors='replace').rstrip(chr(13)))}\n\n".encode()
                                                  for l in lines))
                        self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                proc.kill()
                proc.wait()

    httpd.RequestHandlerClass = Handler
    # Mientras el panel está abierto, la conexión SSH compartida queda lista (abrirla en frío
    # tarda hasta 8 s): dura 15 min sin uso y un latido cada 90 s la mantiene viva.
    global SSH_PERSIST
    SSH_PERSIST = 900

    def keepalive() -> None:
        while True:
            time.sleep(90)
            try:
                run([*ssh_cmd("-n"), "true"], timeout=20)
            except (OSError, subprocess.TimeoutExpired):
                pass
    threading.Thread(target=keepalive, daemon=True).start()
    url = f"http://127.0.0.1:{port}/?t={token}"
    title(L("Panel de andamio", "andamio panel"))
    note(L("Corre en tu máquina (solo 127.0.0.1) y habla con tu servidor por SSH. Cada acción corre el mismo comando de la CLI.",
           "It runs on your machine (127.0.0.1 only) and talks to your server over SSH. Each action runs the same CLI command."))
    print(f"\n  \033[1m{url}\033[0m\n")
    if not args.no_browser and not open_browser(url):
        warn(L("No pude abrir el navegador: copia el link de arriba.", "Couldn't open the browser: copy the link above."))
    print("  " + L("Ctrl+C lo cierra.", "Ctrl+C closes it."), flush=True)
    if getattr(args, "desktop", False):
        # La app de escritorio lo arrancó: cuando se cierra, su entrada se cierra, y el panel con ella.
        def until_stdin_closes() -> None:
            try:
                while sys.stdin.buffer.read(4096):
                    pass
            except OSError:
                pass
            httpd.shutdown()
        threading.Thread(target=until_stdin_closes, daemon=True).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print()
        ok(L("Panel cerrado.", "Panel closed."))
    finally:
        httpd.server_close()
        for proc, _ in children.values():   # los paneles de tus otras copias se cierran con este
            proc.terminate()


# ================= update =================

# El extractor (tools/extraer-plataforma.py) pone aquí la URL del repo público de andamio.
UPSTREAM_DEFAULT = "https://github.com/Geovani29/andamio.git"
UPSTREAM_FILE = ROOT / ".andamio" / "upstream"
UPSTREAM_CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "andamio" / "upstream.git"
# Lo tuyo: andamio update nunca lo toca (fnmatch: * también cruza carpetas).
OWN = ["ansible/group_vars/*", "ansible/inventory.yml", "apps/*", "host/sops/*", "host/ssh/authorized_keys",
       "host/tls/*", ".sops.yaml", "*.sops", "*.sops.*", ".andamio/*"]


# Lo que corre en el servidor: si una actualización lo cambia, hay que aplicarla (andamio
# servidor). El resto (bin/, docs, plantillas de Dockerfile) es de tu máquina o del CI.
SERVER_SIDE = ("ansible/", "scripts/", "stacks/", "host/")


def git_bytes(*args: str, cwd: Path | None = None) -> bytes:
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, check=False)
    if r.returncode != 0:
        die(f"git {args[0]}: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def git_up(*args: str) -> str:
    return git_bytes(*args, cwd=UPSTREAM_CACHE).decode()


def is_platform(path: str) -> bool:
    import fnmatch
    return not any(fnmatch.fnmatch(path, pat) for pat in OWN)


def upstream_tree(sha: str) -> dict[str, tuple[str, str]]:
    """{ruta: (modo, blob)} de los archivos de la plataforma en ese commit de upstream."""
    out = {}
    for line in git_up("ls-tree", "-r", "--full-tree", sha).splitlines():
        meta, path = line.split("\t", 1)
        mode, kind, blob = meta.split()
        if kind == "blob" and is_platform(path):
            out[path] = (mode, blob)
    return out


_LOCAL: dict[str, str | None] = {}


def local_blob(path: str) -> str | None:
    """Hash git de tu archivo (como lo calcularía git), o None si no existe."""
    if path not in _LOCAL:
        f = ROOT / path
        _LOCAL[path] = git_bytes("hash-object", str(f)).decode().strip() if f.is_file() else None
    return _LOCAL[path]


def infer_base(commits: list[str]) -> str:
    """Repos creados desde el template no comparten historial con upstream: la base es el
    commit de upstream cuyos archivos más coinciden con los tuyos (empate: el más nuevo)."""
    best, score = commits[-1], -1
    for sha in commits:   # del más nuevo al más viejo
        tree = upstream_tree(sha)
        hits = sum(1 for p, (_, blob) in tree.items() if local_blob(p) == blob)
        if hits > score:
            best, score = sha, hits
    return best


def merge3(path: str, base_blob: str | None, new_blob: str) -> tuple[bytes, bool]:
    """Fusión de tres vías (tuyo, base, andamio). Devuelve (contenido, hubo_conflicto)."""
    tmp = Path(tempfile.mkdtemp(prefix="andamio-merge-"))
    try:
        files = {"tuyo": (ROOT / path).read_bytes(),
                 "base": git_bytes("cat-file", "blob", base_blob, cwd=UPSTREAM_CACHE) if base_blob else b"",
                 "andamio": git_bytes("cat-file", "blob", new_blob, cwd=UPSTREAM_CACHE)}
        if any(b"\0" in c for c in files.values()):   # binario: no se puede combinar
            return files["tuyo"], True
        for name, content in files.items():
            (tmp / name).write_bytes(content)
        r = subprocess.run(["git", "merge-file", "-p", "-L", L("tuyo", "yours"), "-L", "base", "-L", "andamio",
                            str(tmp / "tuyo"), str(tmp / "base"), str(tmp / "andamio")], capture_output=True, check=False)
        if r.returncode < 0:
            die(f"git merge-file {path}: {r.stderr.decode(errors='replace')}")
        return r.stdout, r.returncode > 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_update(args: argparse.Namespace) -> None:
    print(L("\033[1mandamio update\033[0m: trae las mejoras y los parches de andamio sin tocar tu "
            "configuración ni tus apps.",
            "\033[1mandamio update\033[0m: brings in andamio's improvements and patches without touching "
            "your configuration or your apps."))
    import yaml
    cfg = (yaml.safe_load(CONFIG.read_text()) or {}) if CONFIG.exists() else {}
    saved = dict(x.split(" ", 1) for x in UPSTREAM_FILE.read_text().splitlines() if " " in x) \
        if UPSTREAM_FILE.exists() else {}
    url = args.desde or cfg.get("andamio_upstream") or saved.get("url") or UPSTREAM_DEFAULT
    if url.startswith("@"):
        die(L("Este repo es la fuente de andamio (no viene de un template): no hay de dónde actualizar.",
              "This repo is andamio's source (it doesn't come from the template): nothing to update from."))
    if run(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout.strip():
        die(L("Hay cambios sin commit (o archivos nuevos). Súbelos o descártalos antes: así `git diff` "
              "muestra solo lo que trae la actualización, y se puede deshacer entera.",
              "There are uncommitted changes (or new files). Commit or discard them first: that way "
              "`git diff` shows only what the update brings, and it can be undone entirely."))

    title(L("1. Traer la última versión de andamio", "1. Fetching the latest andamio"))
    if (UPSTREAM_CACHE / "HEAD").exists():
        git_up("remote", "set-url", "origin", url)
        git_up("fetch", "-q", "--prune", "origin", "+refs/heads/*:refs/heads/*")
    else:
        UPSTREAM_CACHE.parent.mkdir(parents=True, exist_ok=True)
        git_bytes("clone", "-q", "--bare", url, str(UPSTREAM_CACHE))
    new = git_up("rev-parse", "HEAD").strip()
    commits = git_up("rev-list", "HEAD").split()
    ok(f"{url} @ {new[:8]}")

    title(L("2. ¿De qué versión viene tu repo?", "2. Which version does your repo come from?"))
    base = saved.get("commit")
    if base not in commits:
        base = infer_base(commits)
        ok(L(f"{base[:8]} (deducida: es la versión que más se parece a tus archivos)",
             f"{base[:8]} (inferred: the version closest to your files)"))
    else:
        ok(f"{base[:8]} ({UPSTREAM_FILE.relative_to(ROOT)})")
    if base == new:
        ok(L("Ya estás al día.", "You're up to date."))
        return

    title(L("3. Qué trae", "3. What it brings"))
    for line in git_up("log", "--format=%h %s", f"{base}..{new}").splitlines()[:30]:
        mark = "\033[33m!\033[0m" if re.search(r"(?i)secur|segur|cve|vuln|fix|arregl", line) else " "
        print(f"  {mark} {line}")

    base_t, new_t = upstream_tree(base), upstream_tree(new)
    writes: dict[str, tuple[bytes | None, str]] = {}   # ruta -> (contenido o None = borrar, modo)
    report: dict[str, list[str]] = {k: [] for k in ("update", "add", "remove", "merged", "conflict", "kept")}
    for path in sorted(set(base_t) | set(new_t)):
        b, n, loc = base_t.get(path), new_t.get(path), local_blob(path)
        bb, nb = (b[1] if b else None), (n[1] if n else None)
        if loc == nb or bb == nb:          # ya está como upstream, o upstream no lo cambió (lo tuyo se respeta)
            continue
        if loc == bb:                      # no lo tocaste: va la versión nueva
            if nb is None:
                writes[path] = (None, "")
                report["remove"].append(path)
            else:
                writes[path] = (git_bytes("cat-file", "blob", nb, cwd=UPSTREAM_CACHE), n[0])
                report["add" if bb is None else "update"].append(path)
        elif nb is None or loc is None:    # lo cambiaste y andamio lo quitó, o lo borraste y andamio lo cambió
            report["kept"].append(path)
        else:                              # cambiaron los dos: combinar
            content, conflict = merge3(path, bb, nb)
            writes[path] = (content, n[0])
            report["conflict" if conflict else "merged"].append(path)

    labels = {
        "update": L("Actualizados", "Updated"), "add": L("Nuevos", "New"), "remove": L("Quitados", "Removed"),
        "merged": L("Combinados con tus cambios", "Merged with your changes"),
        "conflict": L("Con conflicto (tus cambios chocan con los de andamio)", "Conflicting (your changes clash with andamio's)"),
        "kept": L("Conservados como los tienes (andamio los quitó o tú los borraste)",
                  "Kept as you have them (andamio removed them or you deleted them)"),
    }
    title(L("4. Archivos", "4. Files"))
    for key, items in report.items():
        if items:
            print(f"  {labels[key]} ({len(items)}):")
            for p in items:
                print(f"      {p}")
    if not writes:
        ok(L("Nada que cambiar en tus archivos.", "Nothing to change in your files."))
    if args.check or (writes and not ask_yes(L("¿Aplicar?", "Apply?"), True)):
        note(L("No cambié nada.", "Nothing changed."))
        return

    for path, (content, mode) in writes.items():
        f = ROOT / path
        if content is None:
            f.unlink(missing_ok=True)
            continue
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_bytes(content)
        f.chmod(0o755 if mode == "100755" else 0o644)
    UPSTREAM_FILE.parent.mkdir(exist_ok=True)
    UPSTREAM_FILE.write_text(f"url {url}\ncommit {new}\n")

    title(L("Listo", "Done"))
    if report["conflict"]:
        warn(L("Resuelve los conflictos: busca las marcas <<<<<<< y >>>>>>> en los archivos de arriba y "
               "quédate con lo correcto de cada lado.",
               "Resolve the conflicts: look for the <<<<<<< and >>>>>>> markers in the files above and keep "
               "the right part of each side."))
    elif (how := choose(L("¿Lo subo ya? (commit y push; `git revert HEAD` lo deshace)",
                          "Push it now? (commit and push; `git revert HEAD` undoes it)"), [
            ("si", L(f"Sí, con el mensaje «andamio: actualización a {new[:8]}»",
                     f"Yes, with the message 'andamio: update to {new[:8]}'")),
            ("mensaje", L("Sí, escribo yo el mensaje", "Yes, I'll write the message")),
            ("no", L("No, primero lo reviso (git diff)", "No, I'll review it first (git diff)"))], "si")) != "no":
        msg = L(f"andamio: actualización a {new[:8]}", f"andamio: update to {new[:8]}")
        if how == "mensaje":
            msg = ask(L("Mensaje del commit", "Commit message"), msg)
        git = ["git", "-C", str(ROOT)]
        if (run([*git, "add", "-A"]).returncode == 0
                and run([*git, "commit", "-qm", msg]).returncode == 0
                and push_copy() == 0):
            ok(L("Subido.", "Pushed."))
            server_side = [p for p in writes if p.startswith(SERVER_SIDE)]
            if server_side:
                note(L(f"Cambió lo que corre en el servidor ({len(server_side)} archivos, p. ej. {server_side[0]}): "
                       "aplícalo cuando quieras:  andamio servidor",
                       f"What runs on the server changed ({len(server_side)} files, e.g. {server_side[0]}): "
                       "apply it whenever you want:  andamio server"))
            else:
                note(L("Solo cambió andamio en tu máquina: no hay nada que aplicar en el servidor.",
                       "Only andamio on your machine changed: nothing to apply on the server."))
            return
        warn(L("No pude subirlo: hazlo a mano (abajo).", "Couldn't push it: do it by hand (below)."))
    note(L("""
Revisa lo que cambió y súbelo; después aplícalo en el servidor:
  git diff --stat          (git diff: el detalle; git reset --hard && git clean -fd: lo deshace todo)
  git add -A && git commit -m "andamio: actualización" && git push
  andamio servidor         (aplica lo nuevo)""", """
Review what changed and push it; then apply it on the server:
  git diff --stat          (git diff: details; git reset --hard && git clean -fd: undoes it all)
  git add -A && git commit -m "andamio: update" && git push
  andamio server           (applies what's new)"""))


# ================= estado =================

def port_open(ip: str, port: int, timeout: float = 3) -> bool:
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except OSError:
        return False


def tls_seen_from_internet(host: str) -> tuple[bool, str]:
    """El certificado como lo ve un navegador: cadena válida, nombre correcto y vigencia."""
    import ssl
    from datetime import datetime, timezone
    try:
        with socket.create_connection((host, 443), timeout=8) as s:
            with ssl.create_default_context().wrap_socket(s, server_hostname=host) as t:
                cert = t.getpeercert()
    except ssl.SSLCertVerificationError as e:
        return False, L(f"un navegador lo rechaza: {e.verify_message}", f"a browser rejects it: {e.verify_message}")
    except OSError as e:
        return False, L(f"no responde ({e})", f"no answer ({e})")
    expires = datetime.strptime(cert["notAfter"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    issuer = dict(x[0] for x in cert["issuer"]).get("organizationName", "?")
    days = (expires - datetime.now(timezone.utc)).days
    return True, L(f"válido para un navegador ({issuer}, {days} días)", f"valid for a browser ({issuer}, {days} days)")


def redirects_to_https(host: str) -> bool:
    import http.client
    try:
        c = http.client.HTTPConnection(host, 80, timeout=8)
        c.request("HEAD", "/")
        r = c.getresponse()
        return r.status in (301, 302, 307, 308) and (r.getheader("Location") or "").startswith("https://")
    except OSError:
        return False


def cmd_estado(args: argparse.Namespace) -> None:
    print(L("\033[1mandamio estado\033[0m: chequeo de seguridad y salud de tu servidor (no cambia nada).",
            "\033[1mandamio status\033[0m: security and health check of your server (changes nothing)."))
    cfg = load_config()
    alias = server_alias()
    if not ssh_ok([alias]):
        die(L(f"No entro al servidor ({alias}) por SSH: corre primero `andamio servidor`.",
              f"Can't reach the server ({alias}) over SSH: run `andamio server` first."))
    domain = cfg["andamio_domain"]
    backups = str(cfg.get("andamio_backups", False)).lower() == "true"

    title(L("Desde el servidor", "From the server"))
    try:
        results, listening = server_check(cfg, alias, f"BACKUPS={'true' if backups else 'false'}")
    finally:
        wipe_sudo()
    net, on_vpn = internet_port_rows(cfg, alias, listening, {80, 443})
    ip = cfg["andamio_server_ip"]
    # Let's Encrypt (modo http) valida por el 80, y la redirección a HTTPS vive ahí.
    if not port_open(ip, 80):
        net.append(["FAIL", "Internet", L("El puerto 80 no responde desde Internet: Let's Encrypt y la redirección a HTTPS lo necesitan",
                                          "Port 80 doesn't answer from the internet: Let's Encrypt and the HTTPS redirect need it"),
                    L("ábrelo en el firewall de tu proveedor (TCP 80); después: ssh " + alias + " docker restart traefik",
                      "open it in your provider's firewall (TCP 80); then: ssh " + alias + " docker restart traefik")])
    host = f"whoami.{domain}"
    good, msg = tls_seen_from_internet(host)
    net.append(["OK", "Internet", L(f"HTTPS de {host}: {msg}", f"HTTPS of {host}: {msg}"), ""] if good else
               ["FAIL", "Internet", L(f"HTTPS de {host}: {msg}", f"HTTPS of {host}: {msg}"),
                L("revisa el DNS (A y *.dominio) y docker logs traefik", "check the DNS (A and *.domain) and docker logs traefik")])
    net.append(["OK", "Internet", L("HTTP redirige a HTTPS", "HTTP redirects to HTTPS"), ""] if redirects_to_https(host) else
               ["WARN", "Internet", L("HTTP no redirige a HTTPS", "HTTP doesn't redirect to HTTPS"),
                L("revisa stacks/proxy/traefik.yml (entryPoint web)", "check stacks/proxy/traefik.yml (entryPoint web)")])

    print_rows(results)
    title(L("Desde Internet", "From the internet"))
    if on_vpn:
        warn(L("Tu PC está conectada a la VPN del servidor: las pruebas de puertos desde Internet no "
               "serían reales. Desconéctala y vuelve a correr `andamio estado` para hacerlas.",
               "Your PC is connected to the server's VPN: port tests from the internet wouldn't be "
               "real. Disconnect it and run `andamio status` again to run them."))
    print_rows(net)
    every = print_totals(results + net)
    estado_save(results + net)
    if "FAIL" in every:
        sys.exit(1)


def server_check(cfg: dict, alias: str, extra_env: str = "") -> tuple[list, list[int]]:
    """scripts/security-check.sh en el servidor, con sudo: (filas OK/WARN/FAIL, puertos que escuchan).
    La contraseña de sudo queda en su archivo: quien llama la borra (wipe_sudo)."""
    script = f"ANDAMIO_LANG={LANG} SSH_PORT={int(cfg['andamio_ssh_port'])} {extra_env}\n" + \
        (ROOT / "scripts" / "security-check.sh").read_text()
    pw = sudo_password_file(cfg, alias).read_text()
    # sudo lee la primera línea (la contraseña); bash, el resto (el script). Nada en argv.
    r = run(["ssh", "-o", "BatchMode=yes", alias, "sudo -S -p '' bash -s"], input=pw + "\n" + script)
    results, listening = [], []
    for line in r.stdout.splitlines():
        parts = line.split("|", 3)
        if parts[0] == "LISTEN":
            listening.append(int(parts[2]))
        elif parts[0] in ("OK", "WARN", "FAIL"):
            results.append((parts + ["", ""])[:4])
    if not results:
        die(L(f"El chequeo no corrió en el servidor: {r.stderr.strip()[-300:]}",
              f"The check didn't run on the server: {r.stderr.strip()[-300:]}"))
    return results, listening


def internet_port_rows(cfg: dict, alias: str, listening: list[int], expected: set[int]) -> tuple[list, bool]:
    """Desde Internet: lo que de verdad ve cualquiera (Docker puede saltarse UFW): los puertos que
    escuchan fuera de `expected` y el 22. Con la VPN activa, tus conexiones entran por ella y el
    firewall las trata distinto: no valdrían. Devuelve (filas, ¿por la VPN?)."""
    ip, ssh_port = cfg["andamio_server_ip"], int(cfg["andamio_ssh_port"])
    on_vpn = remote(alias, 'echo "${SSH_CLIENT%% *}"').stdout.strip().startswith("10.8.0.")
    net = []
    if on_vpn:
        return net, True
    for port in sorted(set(listening) - {ssh_port} - expected):
        if port_open(ip, port):
            net.append(["FAIL", "Internet", L(f"El puerto {port} responde desde Internet y andamio no lo usa",
                                              f"Port {port} answers from the internet and andamio doesn't use it"),
                        L(f"ciérralo: quita el servicio o su ports: en compose; ssh al servidor: sudo ss -tlnp 'sport = :{port}'",
                          f"close it: remove the service or its ports: in compose; on the server: sudo ss -tlnp 'sport = :{port}'")])
        else:
            net.append(["OK", "Internet", L(f"El puerto {port} escucha, pero el firewall lo bloquea desde Internet",
                                            f"Port {port} listens, but the firewall blocks it from the internet"), ""])
    if ssh_port != 22:
        net.append(["FAIL", "Internet", L("El puerto 22 responde desde Internet", "Port 22 answers from the internet"),
                    L("ciérralo en el firewall de tu proveedor (y revisa sudo ufw status)",
                      "close it in your provider's firewall (and check sudo ufw status)")]
                   if port_open(ip, 22) else
                   ["OK", "Internet", L("El puerto 22 está cerrado (SSH solo en el tuyo)",
                                        "Port 22 is closed (SSH only on yours)"), ""])
    return net, False


def print_rows(rows: list) -> None:
    icon = {"OK": "\033[32m✓\033[0m", "WARN": "\033[33m!\033[0m", "FAIL": "\033[31m✗\033[0m"}
    for status, area, what, fix in rows:
        print(f"  {icon[status]} {area:<13} {what}")
        if fix and status != "OK":
            print(f"    \033[2m→ {fix}\033[0m")


def print_totals(rows: list) -> list[str]:
    every = [x[0] for x in rows]
    w, f = every.count("WARN"), every.count("FAIL")
    title(L(f"{every.count('OK')} bien · {w} {'aviso' if w == 1 else 'avisos'} · {f} {'problema' if f == 1 else 'problemas'}",
            f"{every.count('OK')} good · {w} {'warning' if w == 1 else 'warnings'} · {f} {'problem' if f == 1 else 'problems'}"))
    return every


def estado_cache() -> Path:
    """El último resultado de `andamio estado` de esta copia (en tu máquina): lo muestra el panel."""
    import hashlib
    base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "andamio"
    return base / f"estado-{hashlib.sha256(str(ROOT).encode()).hexdigest()[:12]}.json"


def estado_save(rows: list) -> None:
    import json
    every = [r[0] for r in rows]
    data = {"at": int(time.time()), "ok": every.count("OK"), "warn": every.count("WARN"), "fail": every.count("FAIL"),
            "items": [{"status": s, "area": a, "what": w, "fix": f} for s, a, w, f in rows if s != "OK"]}
    try:
        f = estado_cache()
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(data))
    except OSError:
        pass   # sin caché, el panel solo no lo muestra


def cmd_certificado(args: argparse.Namespace) -> None:
    cfg = load_config()
    cmd = L("certificado", "certificate")
    if not args.cert:
        title(L("Tu certificado (andamio_tls: custom)", "Your certificate (andamio_tls: custom)"))
        if not TLS_CERT.exists():
            die(L(f"No hay certificado propio en {TLS_CERT.relative_to(ROOT)}. Agrega uno con: "
                  f"andamio {cmd} <certificado> <llave>",
                  f"No custom certificate in {TLS_CERT.relative_to(ROOT)}. Add one with: "
                  f"andamio {cmd} <certificate> <key>"))
        info = cert_info(TLS_CERT)
        show_cert(info)
        for p in cert_warnings(info, cfg.get("andamio_domain", "")):
            warn(p)
        if cfg.get("andamio_tls") != "custom":
            warn(L(f"Tu configuración usa andamio_tls: {cfg.get('andamio_tls')}: este certificado no se está usando.",
                   f"Your configuration uses andamio_tls: {cfg.get('andamio_tls')}: this certificate isn't in use."))
        return
    if not args.key:
        die(L(f"Falta la llave: andamio {cmd} <certificado> <llave>", f"The key is missing: andamio {cmd} <certificate> <key>"))
    if not shutil.which("openssl"):
        die(L("Falta openssl: sudo apt install openssl  |  brew install openssl",
              "openssl is missing: sudo apt install openssl  |  brew install openssl"))

    title(L("1. Revisar el certificado nuevo", "1. Checking the new certificate"))
    error = cert_problem(args.cert) or key_problem(local_path(args.cert), args.key)
    if error:
        die(error)
    cert, key = local_path(args.cert), local_path(args.key)
    info = cert_info(cert)
    show_cert(info)
    problems = cert_warnings(info, cfg.get("andamio_domain", ""))
    for p in problems:
        warn(p)
    if problems and not ask_yes(L("¿Usarlo igual?", "Use it anyway?"), False):
        die(L("Cancelado: no cambié nada.", "Cancelled: nothing changed."))

    title(L("2. Guardarlo en tu configuración", "2. Saving it in your configuration"))
    if cfg.get("andamio_tls") != "custom":
        warn(L(f"Hoy usas andamio_tls: {cfg.get('andamio_tls')} (Let's Encrypt).",
               f"You currently use andamio_tls: {cfg.get('andamio_tls')} (Let's Encrypt)."))
        if not ask_yes(L("¿Cambiar a tu certificado (andamio_tls: custom)?", "Switch to your certificate (andamio_tls: custom)?"), False):
            die(L("Cancelado: no cambié nada.", "Cancelled: nothing changed."))
        set_config("andamio_tls", "custom")
        ok("andamio_tls: custom")
    install_cert(cert, key)

    title(L("Listo. Para usarlo en el servidor", "Done. To use it on the server"))
    note(L(f"""
git add {TLS_CERT.relative_to(ROOT)} {TLS_KEY.relative_to(ROOT)} {CONFIG.relative_to(ROOT)}
git commit -m "andamio: certificado nuevo (vence {info['expires']})" && git push
ansible/hl aplicar andamio
Traefik se reinicia solo para cargarlo (unos segundos sin servicio).""", f"""
git add {TLS_CERT.relative_to(ROOT)} {TLS_KEY.relative_to(ROOT)} {CONFIG.relative_to(ROOT)}
git commit -m "andamio: new certificate (expires {info['expires']})" && git push
ansible/hl apply andamio
Traefik restarts by itself to load it (a few seconds of downtime)."""))


# ================= comando global =================

# `andamio` en cualquier carpeta: un lanzador en ~/.local/bin elige la copia (la de la carpeta
# actual, o la elegida con `andamio use`). Cada copia se anota sola al usarse.
COPIES_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "andamio"
COPIES, CURRENT = COPIES_DIR / "copias", COPIES_DIR / "actual"
GLOBAL_CMD = Path.home() / ".local" / "bin" / "andamio"
SHIM_MARK = "# andamio: comando global"
SHIM = f"""#!/usr/bin/env bash
{SHIM_MARK} (lo instala bin/andamio; se reescribe solo). Usa la copia de andamio de la
# carpeta donde estás (o de una carpeta de arriba); afuera de una, la elegida con `andamio use`.
d=$PWD
while [ "$d" != / ]; do
  if [ -x "$d/bin/andamio" ] && [ -f "$d/ansible/site.yml" ]; then exec "$d/bin/andamio" "$@"; fi
  d=$(dirname "$d")
done
c=$(cat "${{XDG_CONFIG_HOME:-$HOME/.config}}/andamio/actual" 2> /dev/null)
if [ -n "$c" ] && [ -x "$c/bin/andamio" ]; then exec "$c/bin/andamio" "$@"; fi
if [[ ${{ANDAMIO_LANG:-${{LANG:-}}}} == es* ]]; then
  echo "✗ No sé qué copia de andamio usar: entra a su carpeta, o corre ahí: bin/andamio use" >&2
else
  echo "✗ Don't know which andamio copy to use: cd into its folder, or run there: bin/andamio use" >&2
fi
exit 1
"""


def known_copies() -> list[Path]:
    paths = COPIES.read_text().splitlines() if COPIES.exists() else []
    return [Path(p) for p in dict.fromkeys(paths) if p and (Path(p) / "ansible" / "group_vars" / "all.yml").exists()]


def remember_copy() -> None:
    """Anota esta copia (si ya tiene configuración) e instala o pone al día el lanzador global."""
    try:
        if CONFIG.exists():
            COPIES_DIR.mkdir(parents=True, exist_ok=True)
            copies = known_copies()
            if ROOT not in copies:
                COPIES.write_text("".join(f"{p}\n" for p in [*copies, ROOT]))
            if not CURRENT.exists() or not (Path(CURRENT.read_text().strip()) / "bin" / "andamio").exists():
                CURRENT.write_text(f"{ROOT}\n")
        current = GLOBAL_CMD.read_text() if GLOBAL_CMD.exists() else None
        if current == SHIM or (current is not None and SHIM_MARK not in current):
            return   # ya está al día, o ese archivo no es nuestro: no se toca
        GLOBAL_CMD.parent.mkdir(parents=True, exist_ok=True)
        GLOBAL_CMD.write_text(SHIM)
        GLOBAL_CMD.chmod(0o755)
        if current is None:
            ok(L("Instalé el comando `andamio`: desde ahora funciona en cualquier carpeta (en una terminal nueva).",
                 "Installed the `andamio` command: it now works from any folder (in a new terminal)."))
    except OSError:
        pass   # sin el lanzador, bin/andamio sigue funcionando igual


def copy_label(p: Path) -> str:
    import yaml
    try:
        cfg = yaml.safe_load((p / "ansible" / "group_vars" / "all.yml").read_text()) or {}
    except (OSError, yaml.YAMLError):
        cfg = {}
    return f"{cfg.get('andamio_domain') or '?'}  ({cfg.get('andamio_server_ip') or '?'})"


def cmd_use(args: argparse.Namespace) -> None:
    copies = known_copies()
    current = Path(CURRENT.read_text().strip()) if CURRENT.exists() else None
    if args.copia:
        want = args.copia.rstrip("/")
        p = Path(want).expanduser()
        target = p.resolve() if (p / "ansible" / "group_vars" / "all.yml").exists() else next(
            (c for c in copies if want in (c.name, str(c)) or copy_label(c).split()[0] == want), None)
        if not target:
            die(L(f"No encuentro una copia de andamio en «{want}» (ni con ese dominio). Mira la lista: andamio use",
                  f"No andamio copy at '{want}' (nor with that domain). See the list: andamio use"))
        COPIES_DIR.mkdir(parents=True, exist_ok=True)
        CURRENT.write_text(f"{target}\n")
        if target not in copies:
            COPIES.write_text("".join(f"{c}\n" for c in [*copies, target]))
        ok(L(f"Fuera de sus carpetas, `andamio` usa {target}: {copy_label(target)}",
             f"Outside their folders, `andamio` uses {target}: {copy_label(target)}"))
        return
    if not copies:
        note(L("Todavía no hay copias con configuración (se anotan al correr andamio init).",
               "No copies with a configuration yet (they're noted when you run andamio init)."))
        return
    print(L("Tus copias de andamio (● = la que usa `andamio` fuera de sus carpetas):",
            "Your andamio copies (● = the one `andamio` uses outside their folders):"))
    for c in copies:
        print(f"  {'●' if c == current else ' '} {c}   {copy_label(c)}")
    note(L("Cambiar: andamio use <carpeta o dominio>. Dentro de la carpeta de una copia, andamio usa esa.",
           "Switch: andamio use <folder or domain>. Inside a copy's folder, andamio uses that one."))


def overview() -> None:
    """`andamio`, `andamio help`: todos los comandos, en el orden en que se usan."""
    banner()
    b = lambda t: f"\033[1m{t}\033[0m"   # noqa: E731
    d = lambda t: f"\033[2m{t}\033[0m"   # noqa: E731
    print(L(f"""{b('andamio')}: tu VPS seguro y tus apps desplegadas, desde este repo.

{b('Empezar')} {d('(una vez, en este orden)')}
  setup                        deja tu máquina lista: instala git, gh, sops, age, ansible...
  init                         preguntas guiadas: configuración, llave de cifrado, secretos (solo local)
  seguridad                    solo blinda el VPS: tu llave, sin contraseñas ni root, firewall, fail2ban
  servidor                     prepara el VPS: usuario propio, SSH, firewall, VPN, Traefik, monitoreo
  backups                      backups diarios cifrados fuera del servidor (B2 o S3), con prueba
  alertas                      aviso al celular si algo se cae o el disco se llena (ntfy, sin cuenta)
  servicios                    PostgreSQL y Redis compartidos: cómo están, memoria, CPU y ajustes

{b('Tus apps')} {d('(cada una queda en https://<app>.tudominio)')}
  app create <app> --repo <dueño/repo> [--public] [--db] [--mysql] [--redis] [--host <sub>|@] [--health /ruta]
                               la registra (una vez); desde ahí cada git push a main la despliega
                               {d('URL: <app>.tudominio · --host api → api.tudominio · --host @ → tudominio')}
                               {d('     otro dominio o más niveles (v2.api.tudominio): app domain add')}
  app list                     todas, con su URL y estado
  app info <app>               su configuración y cómo está ahora (estado, RAM, versión)
  app set <app> --mem 512m     cambiar RAM, CPU, puerto, salud o acceso: un reinicio, sin deploy
                               {d('--cpus 1 · --port 8080 · --health /ruta · --public · --vpn · --db-connections 20 · --db-timeout 30s')}
  app logs <app>               logs en vivo
  app secret set|rm|list <app> [CLAVE]      variables y secretos (el valor se pide oculto)
                               {d('--later: guarda sin aplicar; después, una vez: app apply <app>')}
  app apply [<app>]            aplica lo pendiente en el servidor (y reintenta un deploy fallido)
  app domain add|rm|list <app> [dominio]    un dominio propio además de <app>.tudominio
  app cors add|rm|list <app> [origen]       frontend en otro lado (Vercel...)
  app volume add|rm|list <app> [/data]      carpeta que persiste entre deploys (entra al backup)
  app cron add <app> "0 3 * * *" "<comando>"   tarea programada, en tu hora (avisa si falla)
                               {d('app cron list|run|rm <app> [tarea]: verlas, correr una ya, quitarla')}
  app stop|start <app>         apagarla sin borrar nada / volver
  app rollback <app>           volver al deploy anterior
  app destroy <app>            borrarla (respalda su base y sus carpetas antes)
  app ci-update [<app>]        el pipeline de tus apps, a la versión actual de andamio
  app retry <app>              reintenta su último deploy, si falló

{b('Día a día')}
  estado                       chequeo de seguridad y salud, desde el servidor y desde Internet
  ui                           panel en tu navegador: el plano de tu servidor, apps, logs y acciones
                               {d('corre en tu máquina (no en el servidor) y habla con él por SSH')}
  update [--check]             trae mejoras y parches de andamio sin tocar lo tuyo
  certificado [cert llave]     tu propio certificado HTTPS: ver o reemplazar
  servidor                     también sirve para reaplicar todo (se puede repetir)
  use [carpeta|dominio]        con varios servidores: cuál usa `andamio` fuera de sus carpetas
  olvidar                      borra ya tu contraseña de sudo (se recuerda 15 min sin uso, o lo de Ajustes; solo en memoria)

{d('`andamio` funciona en cualquier carpeta: dentro de una copia usa esa; afuera, la de `andamio use`.')}
{d('Detalle de un comando: andamio help <comando>     Idioma: ANDAMIO_LANG=es|en')}
{d('Los nombres en inglés también funcionan: server, status, certificate.')}""",
            f"""{b('andamio')}: your secure VPS and your deployed apps, from this repo.

{b('Getting started')} {d('(once, in this order)')}
  setup                        gets your machine ready: installs git, gh, sops, age, ansible...
  init                         guided questions: configuration, encryption key, secrets (local only)
  security                     only locks down the VPS: your key, no passwords or root, firewall, fail2ban
  server                       sets up the VPS: own user, SSH, firewall, VPN, Traefik, monitoring
  backups                      daily encrypted off-server backups (B2 or S3), tested
  alerts                       phone notice if something goes down or the disk fills up (ntfy, no account)
  services                     shared PostgreSQL and Redis: how they're doing, memory, CPU and settings

{b('Your apps')} {d('(each one lives at https://<app>.yourdomain)')}
  app create <app> --repo <owner/repo> [--public] [--db] [--mysql] [--redis] [--host <sub>|@] [--health /path]
                               registers it (once); from then on every git push to main deploys it
                               {d('URL: <app>.yourdomain · --host api → api.yourdomain · --host @ → yourdomain')}
                               {d('     another domain or deeper (v2.api.yourdomain): app domain add')}
  app list                     all of them, with URL and status
  app info <app>               its configuration and how it's doing now (status, RAM, version)
  app set <app> --mem 512m     change RAM, CPU, port, health or access: a restart, no deploy
                               {d('--cpus 1 · --port 8080 · --health /path · --public · --vpn')}
  app logs <app>               live logs
  app secret set|rm|list <app> [KEY]        variables and secrets (the value is asked hidden)
                               {d('--later: save without applying; then, once: app apply <app>')}
  app apply [<app>]            applies what's pending on the server (and retries a failed deploy)
  app domain add|rm|list <app> [domain]     an own domain besides <app>.yourdomain
  app cors add|rm|list <app> [origin]       frontend hosted elsewhere (Vercel...)
  app volume add|rm|list <app> [/data]      folder that persists across deploys (backed up)
  app cron add <app> "0 3 * * *" "<command>"   scheduled task, in your time (notifies if it fails)
                               {d('app cron list|run|rm <app> [task]: see them, run one now, remove it')}
  app stop|start <app>         turn it off without deleting anything / back on
  app rollback <app>           back to the previous deploy
  app destroy <app>            delete it (backs up its database and folders first)
  app ci-update [<app>]        your apps' pipeline, to the current andamio version
  app retry <app>              retries its last deploy, if it failed

{b('Day to day')}
  status                       security and health check, from the server and from the internet
  ui                           panel in your browser: your server's plan, apps, logs and actions
                               {d('runs on your machine (not the server) and talks to it over SSH')}
  update [--check]             brings in andamio's improvements and patches, never touching yours
  certificate [cert key]       your own HTTPS certificate: show or replace
  server                       also re-applies everything (safe to repeat)
  use [folder|domain]          with several servers: which one `andamio` uses outside their folders
  forget                       wipes your sudo password now (remembered 15 idle min, or your Settings choice; memory only)

{d('`andamio` works from any folder: inside a copy it uses that one; elsewhere, the one from `andamio use`.')}
{d('Details of a command: andamio help <command>     Language: ANDAMIO_LANG=en|es')}
{d('Spanish names work too: servidor, estado, certificado.')}"""))


def main() -> None:
    args = sys.argv[1:]
    if not (args and args[0].startswith("_")):   # los internos los llama otro comando de andamio
        remember_copy()
    if not args or args[0] in ("help", "ayuda", "-h", "--help"):
        if len(args) < 2:
            overview()
            return
        args = [args[1], "--help"]   # andamio help <comando>
    # `andamio app ...`: el mini-PaaS de apps vive en bin/andamio-app (bash); se le pasa tal cual.
    if args[0] == "app":
        os.execv(str(ROOT / "bin" / "andamio-app"), [str(ROOT / "bin" / "andamio-app"), *args])
    if args[0] == "_folders":   # interno (andamio app create sin --dir): las apps del repo, si la raíz no es una
        root = Path(args[1])
        if not (root / "Dockerfile").is_file() and not detect_kind(root):
            for f in repo_folders(root):
                if not f["lib"]:
                    what = " · ".join(x for x in (f["framework"] or f["label"], f["role"]) if x)
                    print(f"    --dir {f['dir']:<28} {what}")
        return
    if args[0] == "_scaffold":   # interno (andamio app create): _scaffold <dir> <puerto|""> <salida>
        cmd_scaffold(argparse.Namespace(dir=args[1], port=args[2], out=args[3]))
        return
    if args[0] == "_precheck":   # interno (andamio app create): _precheck <dir> <puerto> <hay --volume: 0|1>
        cmd_precheck(argparse.Namespace(dir=args[1], port=args[2], volume=args[3]))
        return
    if args[0] == "_yaml_set":   # interno (andamio app set): _yaml_set <app.yml> clave=valor...; imprime lo que cambió
        f = Path(args[1])
        text, changed = yaml_set(f.read_text(), args[2:])
        if changed:
            f.write_text(text)
            print("\n".join(changed))
        return
    if args[0] == "_cron":       # interno (andamio app cron): ver cmd_cron
        cmd_cron(args[1:])
        return
    if args[0] == "_ask":        # interno (andamio app ...): _ask <pregunta> <s|n por defecto>; sale 0 = sí
        default = args[2] in ("s", "y")
        # Desde el panel (andamio ui): ya confirmaste en la página; cada pregunta toma su respuesta
        # por defecto, así que las de "¿seguro?" (por defecto no) frenan en vez de seguir.
        if os.environ.get("ANDAMIO_ASSUME") == "default":
            print(f"  {args[1]}: {L('sí', 'yes') if default else 'no'}  "
                  f"({L('respuesta por defecto, desde el panel', 'default answer, from the panel')})", flush=True)
            sys.exit(0 if default else 1)
        sys.exit(0 if ask_yes(args[1], default) else 1)
    if args[0] == "_sql":        # interno (andamio app sql): _sql <app> [consulta]
        app = (args + [""])[1]
        if err := ui_sql_app(app):
            die(err)
        # Con PostgreSQL y MariaDB a la vez: --mysql elige MariaDB (si no, PostgreSQL).
        rest = [a for a in args[2:] if a != "--mysql"]
        engines = app_engines(app)
        engine = "mysql" if ("--mysql" in args[2:] or engines == ["mysql"]) and "mysql" in engines else "postgres"
        if not rest:
            sys.exit(sql_remote(app, "", tty=True, engine=engine).returncode)
        raw = sql_remote(app, "--query", " ".join(rest), engine=engine)
        r = sql_result_mysql(raw) if engine == "mysql" else sql_result(raw)
        if r["error"]:
            die(r["error"])
        cols = r["columns"]
        widths = [min(40, max([len(c)] + [len(row[i]) for row in r["rows"]])) for i, c in enumerate(cols)]
        print("  ".join(c.ljust(w) for c, w in zip(cols, widths)))
        print("  ".join("-" * w for w in widths))
        for row in r["rows"]:
            print("  ".join(v[:w].ljust(w) for v, w in zip(row, widths)))
        print(L(f"({r['count']} filas" + (f"; se muestran {SQL_MAX_ROWS})" if r["truncated"] else ")"),
                f"({r['count']} rows" + (f"; showing {SQL_MAX_ROWS})" if r["truncated"] else ")")))
        return
    if args[0] == "_restore":    # interno (andamio app restore): _restore <app> <respaldo>
        app, snap = (args + ["", ""])[1:3]
        if not APP_NAME.fullmatch(app) or not re.fullmatch(r"latest|[0-9a-f]{8,64}", snap):
            die(L("Uso: _restore <app> <respaldo>", "Usage: _restore <app> <backup>"))
        cfg, alias = load_config(), server_alias()
        sudo_password_file(cfg, alias)
        try:
            server_pull(cfg, alias)
            rc = remote_sudo(cfg, alias, f"{cfg.get('andamio_root', '/srv/andamio')}/infra/scripts/app-restore.sh {app} {snap}")
        finally:
            wipe_sudo()
        sys.exit(rc)
    if args[0] == "_sudo":       # interno (andamio app create): la contraseña de sudo ya, si se va a recordar
        cfg = load_config()
        if sudo_cache_file(cfg):   # si no se recuerda, se pediría dos veces: mejor en su paso
            try:
                sudo_password_file(cfg, server_alias())
            finally:
                wipe_sudo()
        return
    if args[0] == "_apply":      # interno (andamio app ...): aplica la plataforma en el servidor
        # Con una app: solo esa (segundos); sin ella, la plataforma entera. --registry: también el
        # registro de apps (llaves de deploy, usuarios de Redis, Prometheus), que cambia al crear,
        # borrar, apagar o encender una; sin app y con --registry, solo el registro (tras borrarla).
        rest = args[1:]
        registry = "--registry" in rest
        names = [a for a in rest if a != "--registry"]
        app = names[0] if names else ""
        if app and not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", app):
            die(L(f"Nombre de app inválido: {app}", f"Invalid app name: {app}"))
        if app or registry:
            playbook = ["una-app.yml", "-e", f"andamio_app_name={app}", "-e", f"andamio_apps_registry={str(registry).lower()}"]
        else:
            playbook = ["site.yml", "--tags", "andamio"]
        cfg, alias = load_config(), server_alias()
        try:
            rc = ansible(playbook, cfg, alias)
        finally:
            wipe_sudo()
        sys.exit(rc)
    known = {"setup", "init", "seguridad", "security", "servidor", "server", "estado", "status", "backups", "update", "actualizar",
             "certificado", "certificate", "use", "usar", "olvidar", "forget", "alertas", "alerts", "ui",
             "zona", "timezone", "telegram", "servicios", "services"}
    if args[0] not in known:
        die(L(f"Comando desconocido: {args[0]}. Mira `andamio help`.", f"Unknown command: {args[0]}. See `andamio help`."))
    parser = argparse.ArgumentParser(prog="andamio", description=L(
        "andamio: prepara tu configuración y tu VPS.", "andamio: sets up your configuration and your VPS."))
    sub = parser.add_subparsers(dest="cmd", required=True)
    _add = sub.add_parser
    sub.add_parser = lambda *a, **kw: _add(*a, description=kw.get("help"), **kw)  # type: ignore[method-assign]
    p_setup = sub.add_parser("setup", help=L("deja tu máquina lista: instala lo que falta (una vez)",
                                             "gets your machine ready: installs what's missing (once)"))
    p_setup.set_defaults(func=cmd_setup)
    p_init = sub.add_parser("init", help=L("configuración guiada (parte 1, local)", "guided configuration (part 1, local)"))
    p_init.add_argument("--force", action="store_true",
                        help=L("completar una configuración existente", "fill in an existing configuration"))
    p_init.set_defaults(func=cmd_init)
    p_sec = sub.add_parser("seguridad", aliases=["security"],
                           help=L("solo blinda el VPS: llave, sin root, firewall, fail2ban (se puede repetir)",
                                  "only locks down the VPS: keys, no root, firewall, fail2ban (safe to repeat)"))
    p_sec.set_defaults(func=cmd_seguridad)
    p_srv = sub.add_parser("servidor", aliases=["server"],
                           help=L("prepara el VPS (parte 2; se puede repetir)", "sets up the VPS (part 2; safe to repeat)"))
    p_srv.set_defaults(func=cmd_servidor)
    p_st = sub.add_parser("estado", aliases=["status"],
                          help=L("chequeo de seguridad y salud del servidor", "security and health check of the server"))
    p_st.set_defaults(func=cmd_estado)
    p_bk = sub.add_parser("backups", help=L("backups diarios cifrados fuera del servidor (B2 o S3), con prueba",
                                            "daily encrypted off-server backups (B2 or S3), tested"))
    p_bk.add_argument("accion", nargs="?", choices=["now", "ahora", "list", "lista"],
                      help=L("now: un respaldo ya · list: los que hay", "now: a backup right now · list: the ones there are"))
    p_bk.set_defaults(func=cmd_backups)
    sub.add_parser("app", help=L("tus apps: create, secret, list, logs, rollback, destroy (andamio app para ver cómo)",
                                 "your apps: create, secret, list, logs, rollback, destroy (andamio app to see how)"))
    p_up = sub.add_parser("update", aliases=["actualizar"],
                          help=L("trae mejoras y parches de andamio sin tocar tu configuración ni tus apps",
                                 "brings in andamio's improvements and patches without touching your config or apps"))
    p_up.add_argument("--check", action="store_true", help=L("solo muestra qué cambiaría", "only show what would change"))
    p_up.add_argument("--from", dest="desde", metavar="URL",
                      help=L("repo de andamio de donde traer (por defecto, el oficial)",
                             "andamio repo to fetch from (default: the official one)"))
    p_up.set_defaults(func=cmd_update)
    p_cert = sub.add_parser("certificado", aliases=["certificate"],
                            help=L("tu propio certificado HTTPS: ver el actual o reemplazarlo",
                                   "your own HTTPS certificate: show the current one or replace it"))
    p_cert.add_argument("cert", nargs="?", help=L("certificado PEM (con los intermedios de tu CA)",
                                                  "PEM certificate (with your CA's intermediates)"))
    p_cert.add_argument("key", nargs="?", help=L("su llave privada PEM", "its PEM private key"))
    p_cert.set_defaults(func=cmd_certificado)
    p_use = sub.add_parser("use", aliases=["usar"],
                           help=L("con varios servidores: qué copia usa `andamio` fuera de sus carpetas",
                                  "with several servers: which copy `andamio` uses outside their folders"))
    p_use.add_argument("copia", nargs="?", metavar=L("carpeta|dominio", "folder|domain"),
                       help=L("la copia a usar; sin nada, la lista", "the copy to use; with nothing, the list"))
    p_use.set_defaults(func=cmd_use)
    p_al = sub.add_parser("alertas", aliases=["alerts"],
                          help=L("aviso al celular si un contenedor se cae o el disco se llena (ntfy, sin cuenta)",
                                 "phone notice if a container goes down or the disk fills up (ntfy, no account)"))
    p_al.add_argument("accion", nargs="?", choices=["prueba", "test"],
                      help=L("prueba: un aviso de prueba por todos los canales", "test: a test notice through every channel"))
    p_al.add_argument("--ntfy", metavar=L("nuevo|URL|quitar", "new|URL|off"),
                      help=L("sin preguntas: un tema nuevo en ntfy.sh, tu propio tema, o quitar ntfy",
                             "no questions: a new topic on ntfy.sh, your own topic, or remove ntfy"))
    p_al.set_defaults(func=cmd_alertas)
    p_tg = sub.add_parser("telegram", help=L("avisos al celular por Telegram, guiado (prueba | desactivar)",
                                             "phone notices through Telegram, guided (test | off)"))
    p_tg.add_argument("accion", nargs="?", choices=["prueba", "test", "desactivar", "off"])
    p_tg.add_argument("--chat", help=L("tu ID de chat (si no, se encuentra solo)", "your chat ID (otherwise it's found for you)"))
    p_tg.add_argument("--token-stdin", action="store_true", help=L("lee el token de la entrada (para el panel)", "read the token from stdin (for the panel)"))
    p_tg.set_defaults(func=cmd_telegram)
    p_tz = sub.add_parser("zona", aliases=["timezone"], help=L("la zona horaria de tus tareas programadas: verla o cambiarla",
                                                               "your scheduled tasks' time zone: see it or change it"))
    p_tz.add_argument("zona", nargs="?", help="America/Bogota, Europe/Madrid, UTC…")
    p_tz.set_defaults(func=cmd_zona)
    p_sv = sub.add_parser("servicios", aliases=["services"], help=L(
        "PostgreSQL y Redis compartidos: ver cómo están o cambiar su memoria, CPU y ajustes",
        "shared PostgreSQL and Redis: see how they're doing or change their memory, CPU and settings"))
    p_sv.add_argument("servicio", nargs="?", choices=["postgres", "redis", "mariadb"])
    p_sv.add_argument("--mem", help=L("memoria (ej. 512m, 2g; en Redis, la de los datos)", "memory (e.g. 512m, 2g; for Redis, the data's)"))
    p_sv.add_argument("--cpus", help=L("CPU (ej. 0.5, 1, 2)", "CPU (e.g. 0.5, 1, 2)"))
    p_sv.add_argument("--max-connections", help=L("PostgreSQL o MariaDB: conexiones máximas (20 a 1000)", "PostgreSQL or MariaDB: max connections (20 to 1000)"))
    p_sv.add_argument("--work-mem", help=L("PostgreSQL: memoria por consulta para ordenar y agrupar (ej. 4MB)",
                                           "PostgreSQL: memory per query to sort and group (e.g. 4MB)"))
    p_sv.add_argument("--policy", help=L("Redis: qué hace al llenarse (noeviction, allkeys-lru…)", "Redis: what it does when full (noeviction, allkeys-lru…)"))
    p_sv.add_argument("--engine", help=L("Redis: el motor (redis, valkey o dragonfly); cambiarlo copia los datos",
                                         "Redis: the engine (redis, valkey or dragonfly); switching copies the data"))
    p_sv.set_defaults(func=cmd_servicios)
    p_ui = sub.add_parser("ui", help=L("panel en tu navegador: ver y manejar tus apps (corre en tu máquina, no en el servidor)",
                                       "panel in your browser: see and manage your apps (runs on your machine, not the server)"))
    p_ui.add_argument("--port", type=int, default=0, help=L("puerto local (por defecto, uno libre al azar)",
                                                          "local port (default: a random free one)"))
    p_ui.add_argument("--desktop", action="store_true", help=L(
        "lo arranca la app de escritorio: se cierra cuando se cierra su entrada", "started by the desktop app: closes when its input closes"))
    p_ui.add_argument("--no-browser", action="store_true", help=L("no abrir el navegador; solo mostrar el link",
                                                                  "don't open the browser; just print the link"))
    p_ui.set_defaults(func=cmd_ui)
    p_forget = sub.add_parser("olvidar", aliases=["forget"],
                              help=L("borra ya la contraseña de sudo recordada", "wipes the remembered sudo password now"))
    p_forget.set_defaults(func=lambda _: (forget_sudo(), ok(L("Contraseña de sudo olvidada.", "Sudo password forgotten."))))
    ns = parser.parse_args(args)
    ns.func(ns)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:   # Ctrl+C: sin traza de Python
        sys.stdout.write("\033[?25h")   # por si se cortó dentro de un menú
        print(L("\n\n✗ Cancelado. Lo que ya estaba hecho se queda; vuelve a correr el comando cuando quieras: retoma donde quedó.",
                "\n\n✗ Cancelled. What was already done stays; run the command again whenever you want: it resumes where it stopped."),
              file=sys.stderr)
        sys.exit(130)
