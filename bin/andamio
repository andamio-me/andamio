#!/usr/bin/env python3
"""andamio: prepara tu configuración y tu VPS.

  andamio init      preguntas guiadas -> configuración, llave de cifrado y secretos
                    (parte 1: solo en tu máquina; no toca ningún servidor)
  andamio servidor  prepara el VPS: acceso SSH verificado, usuario propio, endurecimiento,
                    VPN, llave del repo, registro de imágenes y los stacks (parte 2; se puede repetir)
  andamio certificado [cert llave]
                    tu propio certificado HTTPS (homelab_tls: custom): sin argumentos
                    muestra el actual; con ellos lo valida y lo reemplaza (renovación)

Todo lo que genera queda en este repo (cifrado donde corresponde). Nada se sobreescribe:
si un archivo ya existe, se respeta.
"""
from __future__ import annotations

import argparse
import getpass
import ipaddress
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "ansible" / "group_vars" / "all.yml"
SOPS_CONFIG = ROOT / ".sops.yaml"
AGE_KEY = Path(os.environ.get("SOPS_AGE_KEY_FILE", Path.home() / ".config" / "sops" / "age" / "keys.txt"))
INVENTORY = ROOT / "ansible" / "inventory.yml"
AUTH_KEYS = ROOT / "host" / "ssh" / "authorized_keys"
SSH_DIR = Path.home() / ".ssh"
LOCAL_KEY = SSH_DIR / "id_ed25519"
DEFAULT_ALIAS = "andamio"
TLS_CERT = ROOT / "host" / "tls" / "cert.pem"          # público: va en claro
TLS_KEY = ROOT / "host" / "sops" / "tls-key.sops"      # privada: cifrada
CERT_WARN_DAYS = 30

# Herramientas que necesitas en TU máquina, y cómo instalarlas.
TOOLS = {
    "git": "sudo apt install git  |  brew install git",
    "ssh": "sudo apt install openssh-client",
    "ssh-keygen": "sudo apt install openssh-client",
    "sops": "https://github.com/getsops/sops/releases",
    "age-keygen": "sudo apt install age  |  brew install age",
    "ansible-playbook": "pipx install --include-deps ansible",
}


# ---------- salida ----------

def title(t: str) -> None:
    print(f"\n\033[1m{t}\033[0m")


def note(t: str) -> None:
    for line in t.strip("\n").splitlines():
        print(f"  \033[2m{line}\033[0m")


def ok(t: str) -> None:
    print(f"  \033[32m✓\033[0m {t}")


def warn(t: str) -> None:
    print(f"  \033[33m!\033[0m {t}")


def die(t: str) -> None:
    sys.stdout.flush()
    print(f"\n\033[31m✗ {t}\033[0m", file=sys.stderr)
    sys.exit(1)


def ask(question: str, default: str | None = None, check=None, hint: str = "") -> str:
    """Pregunta hasta tener una respuesta válida. check devuelve un error o None."""
    suffix = f" [{default}]" if default else ""
    while True:
        try:
            value = input(f"  {question}{suffix}: ").strip()
        except EOFError:
            die("Entrada terminada antes de responder todo.")
        value = value or (default or "")
        error = check(value) if check else (None if value else "No puede quedar vacío.")
        if not error:
            return value
        warn(error + (f" {hint}" if hint else ""))


def ask_yes(question: str, default: bool) -> bool:
    answer = ask(question, "s" if default else "n", lambda v: None if v.lower() in ("s", "si", "sí", "n", "no") else "Responde s o n.")
    return answer.lower().startswith("s")


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True, **kw)


# La forja de tus repos (GitHub hoy): todo pasa por bin/forge, nunca directo a su CLI.
def forge(*args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    return run([str(ROOT / "bin" / "forge"), *args], input=stdin)


def forge_out(*args: str) -> str:
    r = forge(*args)
    if r.returncode != 0:
        die(r.stderr.strip() or f"forge {args[0]} falló")
    return r.stdout.strip()


# ---------- validaciones ----------

def check_ip(v: str):
    try:
        ip = ipaddress.ip_address(v)
    except ValueError:
        return "No es una IP válida."
    if ip.version != 4 or ip.is_private or ip.is_loopback:
        return "Tiene que ser la IPv4 pública del VPS."
    return None


def check_domain(v: str):
    return None if re.fullmatch(r"(?=.{4,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}", v) else "Dominio inválido (ej. midominio.com)."


def check_email(v: str):
    return None if re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", v) else "Email inválido."


def check_user(v: str):
    if v == "root":
        return "No uses root: el punto es entrar con un usuario propio."
    return None if re.fullmatch(r"[a-z][a-z0-9-]{1,30}", v) else "Minúsculas, números y guiones (2-31)."


def check_port(v: str):
    if not v.isdigit() or not 1024 <= int(v) <= 65535:
        return "Entre 1024 y 65535."
    if int(v) in (8080, 51820):
        return "Ese puerto lo usa andamio (Traefik o la VPN)."
    return None


def http_get(url: str, token: str) -> tuple[int, dict, str]:
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}",
                                               "User-Agent": "andamio", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status, dict(r.headers), r.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), ""
    except OSError as e:
        return 0, {}, str(e)


def registry_token_problem(token: str) -> str | None:
    """None si el token sirve para bajar imágenes del registro (lo valida la forja)."""
    r = forge("registry-token-check", stdin=token)
    return None if r.returncode == 0 else (r.stderr.strip() or "No pude validar el token.")


def cloudflare_token_problem(token: str) -> str | None:
    code, _, body = http_get("https://api.cloudflare.com/client/v4/user/tokens/verify", token)
    if code == 200 and '"active"' in body:
        return None
    return "Cloudflare no reconoce ese token como activo (¿mal copiado o vencido?)."


def ask_secret(prompt: str, problem, tries: int = 3) -> str:
    """Pide un dato secreto (no se ve al escribir), lo verifica y repregunta."""
    for intento in range(tries):
        value = getpass.getpass(f"  {prompt}: ").strip()
        error = problem(value)
        if not error:
            return value
        warn(error + (f" ({tries - 1 - intento} intentos más)" if intento < tries - 1 else ""))
    die("No pude verificar el dato. Revísalo y vuelve a correr el comando: retoma donde quedó.")


def resolves_to(name: str) -> set[str]:
    try:
        return {a[4][0] for a in socket.getaddrinfo(name, None, socket.AF_INET)}
    except socket.gaierror:
        return set()


# ---------- certificado propio (homelab_tls: custom) ----------

def local_path(v: str) -> Path:
    """Ruta escrita por la persona; acepta rutas de Windows si corre en WSL (C:\\Users\\...)."""
    v = v.strip().strip("'\"")
    if re.match(r"^[A-Za-z]:\\", v) and shutil.which("wslpath"):
        v = run(["wslpath", "-u", v]).stdout.strip() or v
    return Path(v).expanduser()


def cert_info(cert: Path) -> dict:
    """Datos del primer certificado del archivo (el del servidor); {} si no es un PEM válido."""
    from datetime import datetime, timezone
    r = run(["openssl", "x509", "-in", str(cert), "-noout", "-subject", "-issuer", "-enddate",
             "-ext", "subjectAltName", "-nameopt", "RFC2253"])
    if r.returncode != 0:
        return {}
    field = lambda k: (re.search(rf"^{k}=(.*)$", r.stdout, re.M) or [None, ""])[1].strip()  # noqa: E731
    subject, issuer = field("subject"), field("issuer")
    expires = datetime.strptime(field("notAfter"), "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    cn = (re.search(r"CN=([^,]+)", subject) or [None, ""])[1]
    return {
        "cn": cn, "issuer": issuer, "self_signed": subject == issuer,
        "sans": [s.lower() for s in re.findall(r"DNS:([^,\s]+)", r.stdout)] or [cn.lower()],
        "expires": expires.strftime("%Y-%m-%d"), "days": (expires - datetime.now(timezone.utc)).days,
        "chain": cert.read_text(errors="ignore").count("BEGIN CERTIFICATE"),
        "cloudflare_origin": "cloudflare origin" in issuer.lower(),
    }


def covers(sans: list[str], name: str) -> bool:
    return any(s == name or (s.startswith("*.") and name.endswith(s[1:]) and name.count(".") == s.count("."))
               for s in sans)


def cert_problem(v: str) -> str | None:
    p = local_path(v)
    if not p.is_file():
        return f"No existe el archivo {p}."
    info = cert_info(p)
    if not info:
        return ("No es un certificado PEM (texto que empieza con -----BEGIN CERTIFICATE-----). Si es binario "
                "(.der/.cer): openssl x509 -inform der -in ARCHIVO -out cert.pem")
    if info["days"] < 0:
        return f"Ese certificado venció el {info['expires']}."
    return None


def key_problem(cert: Path, v: str) -> str | None:
    key = local_path(v)
    if not key.is_file():
        return f"No existe el archivo {key}."
    r = run(["openssl", "pkey", "-in", str(key), "-passin", "pass:", "-pubout"])
    if r.returncode != 0:
        if "ENCRYPTED" in key.read_text(errors="ignore"):
            return (f"La llave tiene contraseña. Quítasela (andamio la cifra con sops igual): "
                    f"openssl pkey -in {key} -out llave-sin-clave.key")
        return "No es una llave privada PEM (texto que empieza con -----BEGIN ... PRIVATE KEY-----)."
    if run(["openssl", "x509", "-in", str(cert), "-noout", "-pubkey"]).stdout.strip() != r.stdout.strip():
        return "Esa llave no corresponde al certificado (¿es la de otra solicitud o de otro dominio?)."
    return None


def cert_warnings(info: dict, domain: str) -> list[str]:
    """Problemas que no impiden usarlo, pero que la persona tiene que conocer."""
    out = []
    # El comodín se prueba con un nombre que nadie pondría en un certificado.
    missing = [n for n in (domain, f"*.{domain}") if not covers(info["sans"], n.replace("*", "andamio-x7q"))]
    if missing:
        out.append(f"No cubre {' ni '.join(missing)} (cubre: {', '.join(info['sans'])}). Las apps con "
                   "otros nombres mostrarán un error de certificado en el navegador.")
    if info["cloudflare_origin"]:
        out.append("Es un Origin Certificate de Cloudflare: solo lo aceptan los navegadores a través del "
                   "proxy de Cloudflare (nube naranja, SSL/TLS en modo Full (strict)). Tus paneles privados "
                   "(por la VPN) no pasan por Cloudflare y mostrarán un error de certificado. Si tu dominio "
                   "ya está en Cloudflare, el modo 'cloudflare' de andamio evita esto (gratis, se renueva solo).")
    elif info["self_signed"]:
        out.append("Es autofirmado: ningún navegador lo acepta.")
    elif info["chain"] < 2:
        out.append("Trae solo tu certificado, sin los intermedios de tu CA: algunos clientes lo rechazarán. "
                   "Usa el archivo 'fullchain' o 'bundle', o pega los intermedios debajo del tuyo.")
    if info["days"] < CERT_WARN_DAYS:
        out.append(f"Vence en {info['days']} días ({info['expires']}).")
    return out


def show_cert(info: dict) -> None:
    ok(f"{info['cn']}: cubre {', '.join(info['sans'])}")
    note(f"Emitido por: {info['issuer']}\nVence: {info['expires']} (en {info['days']} días)")


def ask_cert(domain: str) -> tuple[Path, Path]:
    """Pide certificado y llave, los valida y muestra lo que hay que saber antes de usarlos."""
    if not shutil.which("openssl"):
        die("Falta openssl para revisar tu certificado: sudo apt install openssl  |  brew install openssl")
    note("""
Necesitas dos archivos PEM (texto que empieza con -----BEGIN):
  certificado: el tuyo seguido de los intermedios de tu CA (fullchain o bundle)
  llave privada: la que generaste con la solicitud (CSR), o la que te dio Cloudflare
En WSL, tu carpeta Descargas de Windows está en /mnt/c/Users/<tu usuario>/Downloads
(también puedes pegar la ruta de Windows tal cual).""")
    while True:
        cert = local_path(ask("Ruta del certificado", check=cert_problem))
        key = local_path(ask("Ruta de la llave privada", check=lambda v: key_problem(cert, v)))
        info = cert_info(cert)
        show_cert(info)
        problems = cert_warnings(info, domain)
        for p in problems:
            warn(p)
        if not problems or ask_yes("¿Usarlo igual?", False):
            return cert, key


def install_cert(cert: Path, key: Path) -> None:
    """Copia el certificado al repo y cifra la llave con sops (sin copias en claro)."""
    TLS_CERT.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(cert, TLS_CERT)
    TLS_CERT.chmod(0o644)
    ok(f"{TLS_CERT.relative_to(ROOT)}")
    rel = TLS_KEY.relative_to(ROOT)
    r = run(["sops", "encrypt", "--input-type", "binary", "--output-type", "json",
             "--filename-override", str(rel), str(key)], cwd=ROOT)
    if r.returncode != 0:
        die(f"sops no pudo cifrar la llave: {r.stderr.strip()}")
    TLS_KEY.parent.mkdir(parents=True, exist_ok=True)
    TLS_KEY.write_text(r.stdout)
    ok(f"{rel} (cifrada)")
    warn(f"Ya está cifrada en el repo: borra la copia sin cifrar ({key}), también de tu carpeta Descargas.")


# ---------- pasos ----------

def check_tools() -> None:
    title("Herramientas en tu máquina")
    missing = [t for t in TOOLS if not shutil.which(t)]
    try:
        import yaml  # noqa: F401
    except ImportError:
        missing.append("python3-yaml")
        TOOLS["python3-yaml"] = "sudo apt install python3-yaml  |  pip install pyyaml"
    if not missing:   # forge lee la configuración con yaml
        forge_tools = dict(line.split("\t", 1) for line in forge_out("tools").splitlines())
        TOOLS.update(forge_tools)
        missing = [t for t in forge_tools if not shutil.which(t)]
    for t in missing:
        warn(f"Falta {t}: {TOOLS[t]}")
    if missing:
        die("Instala lo que falta y vuelve a correr andamio.")
    ok(f"git, ssh, sops, age, ansible y {', '.join(forge_tools)} disponibles")
    name = forge_out("name")
    if forge("auth-ok").returncode != 0:
        die(f"Tu CLI de {name} no tiene sesión iniciada ({', '.join(forge_tools)}): "
            f"{next(iter(forge_tools.values()))}")
    ok(f"Sesión iniciada en {name}")


def questions() -> dict:
    title("2. Tu servidor")
    note("""
La IP pública del VPS que compraste (la ves en el panel de tu proveedor).""")
    a = {"ip": ask("IP del VPS", check=check_ip)}

    title("3. Tu dominio")
    note("""
andamio publica cada app como <app>.tudominio. En el DNS de tu dominio necesitas dos
registros A apuntando a la IP del VPS: uno para el dominio y otro para *.dominio.""")
    a["domain"] = ask("Dominio", check=check_domain).lower()
    apex, wild = resolves_to(a["domain"]), resolves_to(f"andamio-check.{a['domain']}")
    if a["ip"] in apex and a["ip"] in wild:
        ok(f"{a['domain']} y *.{a['domain']} ya apuntan a {a['ip']}")
    else:
        warn(f"{a['domain']} -> {', '.join(apex) or 'nada'}; *.{a['domain']} -> {', '.join(wild) or 'nada'}")
        note(f"""
Crea en tu DNS:  A  {a['domain']}  ->  {a['ip']}   y   A  *.{a['domain']}  ->  {a['ip']}
Sin eso no habrá certificados HTTPS. Puedes seguir y corregirlo antes de preparar el servidor.""")

    title("4. Acceso seguro")
    note("""
andamio crea un usuario propio (root deja de poder entrar), SSH solo con llave y en un
puerto distinto del 22 (menos ruido de bots que prueban contraseñas).""")
    a["user"] = ask("Usuario de operación", "andamio", check_user)
    a["port"] = ask("Puerto SSH", str(secrets.choice(range(20000, 30000))), check_port)

    name, host = forge_out("name"), forge_out("ssh-host")
    title(f"5. {name}")
    note(f"""
Tus apps viven en repos de {name} y sus imágenes en {forge_out('registry-name')}. El CI construye y despliega.""")
    login = forge("whoami").stdout.strip()
    a["owner"] = ask(f"Usuario u organización de {name}", login or None)
    remote = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    m = re.search(rf"{re.escape(host)}[:/]([^/]+/[^/.]+)", remote)
    a["repo"] = ask("Repo de esta configuración (dueño/nombre)", m.group(1) if m else None,
                    lambda v: None if re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+", v) else "Formato dueño/nombre.")

    title("6. HTTPS")
    note("""
http (recomendado para empezar): un certificado de Let's Encrypt por app; funciona con
  cualquier DNS. Los nombres de tus apps (también las privadas) quedan en los registros
  públicos de certificados.
cloudflare: un solo certificado comodín; no publica los nombres. Necesita el DNS del
  dominio en Cloudflare y un token con permiso Zone:DNS:Edit para esa zona.
custom: tu propio certificado (de una CA comercial, o un Origin Certificate de Cloudflare).
  Nadie lo renueva solo: Grafana avisa antes de que venza y lo reemplazas con
  bin/andamio certificado.""")
    a["tls"] = ask("Modo (http/cloudflare/custom)", "http",
                   lambda v: None if v in ("http", "cloudflare", "custom") else "http, cloudflare o custom.")
    a["cf_token"] = (ask_secret("Token de Cloudflare (no se ve al escribir)", cloudflare_token_problem)
                     if a["tls"] == "cloudflare" else "")
    if a["cf_token"]:
        ok("Token de Cloudflare activo")
    a["cert"], a["key"] = ask_cert(a["domain"]) if a["tls"] == "custom" else (None, None)
    a["email"] = ("" if a["tls"] == "custom" else
                  ask("Email para Let's Encrypt (avisos de certificados)", check=check_email))

    title("7. Módulos")
    note("""
Monitoreo: "auto" elige según la RAM del VPS (completo con 3 GB o más: métricas, logs,
  Grafana con alertas y Uptime Kuma; mínimo: solo métricas, ~115 MiB).
Backups y alertas por Telegram necesitan cuentas en otros servicios: se activan después.
  Sin backups, tus datos solo viven en el VPS.""")
    a["monitoring"] = ask("Monitoreo (auto/minimo/completo)", "auto",
                          lambda v: None if v in ("auto", "minimo", "completo") else "auto, minimo o completo.")
    return a


def age_recipient() -> str:
    title("8. Llave de cifrado (age)")
    if AGE_KEY.exists():
        ok(f"Uso tu llave existente: {AGE_KEY}")
    else:
        AGE_KEY.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        r = run(["age-keygen", "-o", str(AGE_KEY)])
        if r.returncode != 0:
            die(f"age-keygen falló: {r.stderr.strip()}")
        AGE_KEY.chmod(0o600)
        ok(f"Llave creada: {AGE_KEY} (solo tú la puedes leer)")
        warn("Guárdala también en tu gestor de contraseñas: sin ella no se pueden descifrar tus secretos.")
    pub = run(["age-keygen", "-y", str(AGE_KEY)]).stdout.strip()
    if not pub.startswith("age1"):
        die("No pude leer la llave pública de age.")
    return pub


def write_if_missing(path: Path, content: str, mode: int = 0o644) -> bool:
    rel = path.relative_to(ROOT)
    if path.exists():
        warn(f"{rel} ya existe: no lo toco")
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)
    ok(f"{rel}")
    return True


def write_config(a: dict, recipient: str) -> None:
    title("9. Configuración")
    write_if_missing(SOPS_CONFIG, f"""# Secretos cifrados con sops + age. La llave privada vive solo en tu máquina
# ({AGE_KEY}) y en tu gestor de contraseñas.
creation_rules:
  - path_regex: \\.sops(\\.env)?$
    age: {recipient}
""")
    write_if_missing(CONFIG, f"""# Configuración de este servidor (generada por andamio init). Lo único propio:
# roles, plantillas y scripts la leen de aquí.
homelab_user: {a['user']}              # usuario de operación (SSH, docker)
homelab_uid: 1001
homelab_ssh_port: {a['port']}
homelab_ssh_host_key: ""           # la completa andamio init al conectar por primera vez
homelab_server_ip: {a['ip']}
homelab_hostname: {a['domain'].split('.')[0]}
homelab_domain: {a['domain']}
homelab_tls: {a['tls']}
homelab_acme_email: "{a['email']}"
homelab_forge: {forge_out('name').lower()}              # dónde viven tus repos (bin/forge)
homelab_registry: {forge_out('registry')}          # registro de las imágenes de tus apps
homelab_github_owner: {a['owner']}
homelab_repo: git@github-homelab-infra:{a['repo']}.git
homelab_monitoring: {a['monitoring']}
homelab_backups: false              # se activa con su configuración (destino de restic)
homelab_telegram: false             # se activa con su configuración (bot y chat)
""")


def encrypt(path: Path, values: dict[str, str]) -> None:
    """Cifra un .env con sops. El texto en claro vive solo en una carpeta 0700 y se borra."""
    rel = path.relative_to(ROOT)
    if path.exists():
        warn(f"{rel} ya existe: no lo toco")
        return
    tmp = Path(tempfile.mkdtemp(prefix="andamio-"))
    plain = tmp / "secrets.env"
    try:
        plain.write_text("".join(f"{k}={v}\n" for k, v in values.items()))
        plain.chmod(0o600)
        r = run(["sops", "encrypt", "--input-type", "dotenv", "--output-type", "dotenv",
                 "--filename-override", str(rel), str(plain)], cwd=ROOT)
        if r.returncode != 0:
            die(f"sops no pudo cifrar {rel}: {r.stderr.strip()}")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(r.stdout)
        ok(f"{rel} (cifrado)")
    finally:
        plain.write_bytes(b"\0" * 256)
        shutil.rmtree(tmp, ignore_errors=True)


def write_secrets(a: dict) -> None:
    title("10. Secretos de la plataforma (contraseñas aleatorias, cifradas)")
    pw = lambda: secrets.token_urlsafe(32).replace("-", "").replace("_", "")[:40]  # noqa: E731
    encrypt(ROOT / "stacks/proxy/secrets.sops.env", {"CF_DNS_API_TOKEN": a["cf_token"]})
    encrypt(ROOT / "stacks/data/secrets.sops.env",
            {"POSTGRES_USER": "andamio", "POSTGRES_PASSWORD": pw(), "REDIS_PASSWORD": pw()})
    encrypt(ROOT / "stacks/monitoring/secrets.sops.env",
            {"DOMAIN": a["domain"], "GF_ADMIN_PASSWORD": pw(), "TELEGRAM_TOKEN": "", "TELEGRAM_CHAT_ID": ""})
    for stack in ("uptime-kuma", "whoami"):
        encrypt(ROOT / f"stacks/{stack}/secrets.sops.env", {"DOMAIN": a["domain"]})
    note("""
La contraseña de Grafana (usuario admin):  sops decrypt stacks/monitoring/secrets.sops.env""")


def cmd_init(args: argparse.Namespace) -> None:
    print("\033[1mandamio init\033[0m: prepara la configuración de tu VPS (parte 1, solo en tu máquina).")
    if CONFIG.exists() and "homelab_server_ip:" in CONFIG.read_text() and not args.force:
        die(f"Ya hay una configuración en {CONFIG.relative_to(ROOT)}. No la sobreescribo (usa --force para "
            "completar lo que falte; lo existente se respeta igual).")
    check_tools()
    a = questions()
    recipient = age_recipient()
    write_config(a, recipient)
    write_secrets(a)
    if a["tls"] == "custom":
        title("11. Tu certificado")
        install_cert(a["cert"], a["key"])
    title("Listo. Próximos pasos")
    note(f"""
1. Sube tu configuración (va cifrada):
     git add -A && git commit -m "andamio: mi servidor" && git push

2. Si tu proveedor tiene firewall propio (Azure, AWS, Oracle, Google Cloud, y a veces
   Hetzner o DigitalOcean), ábrele estos puertos de entrada ANTES del paso 3:
     TCP {a['port']} (tu SSH nuevo), 80 y 443 (web)   ·   UDP 51820 (VPN)
   Deja también el 22 abierto hasta terminar: andamio entra primero por ahí.
   Si no lo haces, al mover SSH a tu puerto quedarías fuera del servidor.

3. Prepara el servidor:
     bin/andamio servidor""")


# ================= parte 2: el servidor =================

def load_config() -> dict:
    import yaml
    if not CONFIG.exists():
        die("Falta la configuración: corre primero `andamio init`.")
    cfg = yaml.safe_load(CONFIG.read_text()) or {}
    for k in ("homelab_user", "homelab_ssh_port", "homelab_server_ip", "homelab_repo", "homelab_github_owner"):
        if not cfg.get(k):
            die(f"Falta {k} en {CONFIG.relative_to(ROOT)}.")
    return cfg


def set_config(key: str, value: str) -> None:
    """Cambia una línea de la configuración (solo la usa para completar la llave de host)."""
    text = CONFIG.read_text()
    line = f'{key}: "{value}"'
    new, n = re.subn(rf"^{re.escape(key)}:.*$", line, text, flags=re.M)
    CONFIG.write_text(new if n else text.rstrip("\n") + "\n" + line + "\n")


def ssh_ok(target: list[str]) -> bool:
    """¿Entra por SSH sin pedir nada? (solo llave, sin preguntar huellas)."""
    r = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=yes", *target, "true"])
    return r.returncode == 0


def interactive(cmd: list[str], **kw) -> int:
    """Corre un comando que habla con la persona (contraseñas, confirmaciones)."""
    return subprocess.run(cmd, check=False, **kw).returncode


_SUDO_FILE: Path | None = None


def sudo_password_file(cfg: dict, alias: str) -> Path:
    """La contraseña de sudo de TU usuario: se pide una vez, se verifica contra el
    servidor y Ansible la lee de un archivo privado (0600) que se borra al salir.
    Nunca va en la línea de comandos."""
    global _SUDO_FILE
    if _SUDO_FILE:
        return _SUDO_FILE
    user = cfg["homelab_user"]
    note(f"""
Ansible necesita la contraseña de sudo de tu usuario '{user}' en el servidor
({cfg['homelab_server_ip']}): la que inventaste en el paso 3, cuando bootstrap la pidió dos
veces. Se pide una sola vez para todo lo que sigue.""")
    for intento in range(3):
        pw = getpass.getpass(f"  Contraseña de sudo de '{user}': ")
        if remote(alias, "sudo -S -p '' -v", stdin=pw + "\n").returncode == 0:
            ok("Contraseña correcta")
            tmp = Path(tempfile.mkdtemp(prefix="andamio-sudo-"))
            _SUDO_FILE = tmp / "become"
            _SUDO_FILE.write_text(pw)
            _SUDO_FILE.chmod(0o600)
            return _SUDO_FILE
        warn(f"No es la contraseña de sudo de '{user}' ({2 - intento} intentos más).")
    die(f"No pude verificar la contraseña de '{user}'. Si la perdiste: entra con la consola web de tu "
        f"proveedor como root y cámbiala con `passwd {user}`.")


def ansible(args: list[str], cfg: dict, alias: str) -> int:
    """ansible-playbook con la contraseña de sudo ya verificada (sin prompt genérico)."""
    env = dict(os.environ, ANSIBLE_BECOME_PASSWORD_FILE=str(sudo_password_file(cfg, alias)))
    return interactive(["ansible-playbook", *args], cwd=ROOT / "ansible", env=env)


def step_local_key() -> str:
    title("1. Tu llave SSH")
    pub = LOCAL_KEY.with_suffix(".pub")
    if not pub.exists():
        note("""
No tienes una llave ed25519: la creo ahora. Te pedirá una frase de paso (recomendado:
protege la llave si alguien copia tu disco). Enter dos veces = sin frase.""")
        SSH_DIR.mkdir(mode=0o700, exist_ok=True)
        if interactive(["ssh-keygen", "-t", "ed25519", "-f", str(LOCAL_KEY), "-C", f"andamio-{getpass.getuser()}"]) != 0:
            die("ssh-keygen falló.")
    key = pub.read_text().strip()
    ok(f"Uso {pub}")
    if not AUTH_KEYS.exists():
        AUTH_KEYS.parent.mkdir(parents=True, exist_ok=True)
        AUTH_KEYS.write_text(key + "\n")
        ok(f"{AUTH_KEYS.relative_to(ROOT)}: tu llave pública (la que podrá entrar al servidor)")
    elif key.split()[1] not in AUTH_KEYS.read_text():
        warn(f"Tu llave no está en {AUTH_KEYS.relative_to(ROOT)}: no podrías entrar con ella.")
        if ask_yes("¿Agregarla?", True):
            with AUTH_KEYS.open("a") as f:
                f.write(key + "\n")
            ok("Agregada")
    return str(pub)


def step_host_key(cfg: dict) -> None:
    title("2. ¿Es tu servidor?")
    ip, port = cfg["homelab_server_ip"], cfg["homelab_ssh_port"]
    known = cfg.get("homelab_ssh_host_key") or ""
    if known:
        ok("Llave del servidor ya verificada (homelab_ssh_host_key)")
        return
    note("""
La primera conexión es la delicada: si alguien se interpusiera en la red, te mostraría
su propia llave. Para comprobarla, mírala DENTRO del servidor por un camino que no sea
la red, y corre ahí:

    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub

  - Hetzner, DigitalOcean, Vultr, Linode, Contabo: la "Console" (consola web) del VPS.
  - Azure: la VM -> Operaciones -> Ejecutar comando -> RunShellScript.
  - AWS: EC2 -> Connect -> Session Manager (o "Get system log" de la instancia).

Tiene que dar exactamente la misma huella que ves abajo. Si no encuentras cómo, puedes
seguir: el riesgo es bajo, pero existe.""")
    r = run(["ssh-keyscan", "-t", "ed25519", "-p", "22", ip])
    lines = [l for l in r.stdout.splitlines() if l and not l.startswith("#")]
    if not lines:
        r = run(["ssh-keyscan", "-t", "ed25519", "-p", str(port), ip])
        lines = [l for l in r.stdout.splitlines() if l and not l.startswith("#")]
    if not lines:
        die(f"No responde SSH en {ip} (ni en el 22 ni en el {port}). ¿El VPS está encendido?")
    host_key = " ".join(lines[0].split()[1:3])
    fp = run(["ssh-keygen", "-lf", "-"], input=f"{ip} {host_key}\n").stdout.split()[1]
    print(f"\n    Huella del servidor:  {fp}\n")
    if not ask_yes("¿Coincide con la de tu proveedor (o decides seguir sin comprobarla)?", True):
        die("No sigo. Revisa la IP o pregunta a tu proveedor por la huella SSH (ED25519).")
    for host in (ip, f"[{ip}]:{port}"):
        run(["ssh-keygen", "-R", host])
    SSH_DIR.mkdir(mode=0o700, exist_ok=True)
    with (SSH_DIR / "known_hosts").open("a") as f:
        f.write(f"{ip} {host_key}\n[{ip}]:{port} {host_key}\n")
    set_config("homelab_ssh_host_key", host_key)
    ok("Guardada en known_hosts y en la configuración (el CI la usa para desplegar)")


def step_ssh_alias(cfg: dict) -> str:
    """Alias en ~/.ssh/config e inventario de Ansible. Respeta lo que exista."""
    import yaml
    alias = DEFAULT_ALIAS
    if INVENTORY.exists():
        inv = yaml.safe_load(INVENTORY.read_text()) or {}
        hosts = (((inv.get("all") or {}).get("children") or {}).get("homelab") or {}).get("hosts") or {}
        alias = next(iter(hosts), alias)
    else:
        INVENTORY.write_text(f"""# Host, usuario, puerto y llave salen de ~/.ssh/config (alias "{alias}").
all:
  children:
    homelab:
      hosts:
        {alias}:
""")
        ok(f"{INVENTORY.relative_to(ROOT)} (alias {alias})")
    cfg_file = SSH_DIR / "config"
    current = cfg_file.read_text() if cfg_file.exists() else ""
    if not re.search(rf"^Host\s+{re.escape(alias)}\s*$", current, re.M):
        with cfg_file.open("a") as f:
            f.write(f"""
Host {alias}
    HostName {cfg['homelab_server_ip']}
    User {cfg['homelab_user']}
    Port {cfg['homelab_ssh_port']}
    IdentityFile {LOCAL_KEY}
    IdentitiesOnly yes
    ServerAliveInterval 60
""")
        cfg_file.chmod(0o600)
        ok(f"~/.ssh/config: alias '{alias}' (ssh {alias})")
    return alias


def step_bootstrap(cfg: dict, alias: str, pub: str) -> None:
    title("3. Usuario propio y SSH en tu puerto")
    if ssh_ok([alias]):
        ok(f"Ya entras como {cfg['homelab_user']} por el puerto {cfg['homelab_ssh_port']}: bootstrap hecho")
        return
    ip = cfg["homelab_server_ip"]
    note("""
Con qué usuario te deja entrar tu proveedor: root en Hetzner, DigitalOcean, Vultr o
Contabo; azureuser en Azure; ubuntu en AWS y Oracle (o el que elegiste al crear el VPS).""")
    initial = ask("Usuario que te dio el proveedor para entrar", "root", check_user_initial)
    target = ["-p", "22", f"{initial}@{ip}"]
    if not ssh_ok(target):
        note(f"""
Tu llave todavía no entra como {initial}: tu proveedor te dio una contraseña. La instalo
con ssh-copy-id (escribes la contraseña UNA vez); desde ahí, solo llave.""")
        if interactive(["ssh-copy-id", "-i", pub, *target]) != 0 or not ssh_ok(target):
            die(f"No pude instalar tu llave en {initial}@{ip}. Revisa la contraseña o el usuario.")
    ok(f"Entras como {initial} con tu llave")
    extra = ["-e", f"ansible_user={initial}", "-e", "ansible_port=22"]
    become_file: Path | None = None
    if initial != "root":
        extra += ["--become"]
        if run(["ssh", "-o", "BatchMode=yes", *target, "sudo -n true"]).returncode == 0:
            ok(f"{initial} usa sudo sin contraseña (normal en Azure y AWS): no hace falta pedirla")
        else:
            note(f"""
{initial} necesita contraseña para sudo: la de {initial} que te dio tu proveedor (no la de
tu usuario nuevo, que todavía no existe).""")
            pw = ask_secret(f"Contraseña de sudo de '{initial}'",
                            lambda v: None if run(["ssh", "-o", "BatchMode=yes", *target, "sudo -S -p '' -v"],
                                                  input=v + "\n").returncode == 0
                            else f"No es la contraseña de sudo de '{initial}'.")
            tmp = Path(tempfile.mkdtemp(prefix="andamio-sudo-"))
            become_file = tmp / "become"
            become_file.write_text(pw)
            become_file.chmod(0o600)
            extra += ["--become-password-file", str(become_file)]
    note(f"""
Ahora bootstrap crea tu usuario '{cfg['homelab_user']}' y mueve SSH al puerto {cfg['homelab_ssh_port']}.
Te va a pedir una contraseña NUEVA para '{cfg['homelab_user']}': invéntala ahora (larga), escríbela
dos veces y guárdala en tu gestor. Es solo para sudo (para entrar sigue siendo tu llave),
y andamio te la pedirá en los pasos siguientes. La conexión se corta al final: es lo esperado.""")
    try:
        interactive(["ansible-playbook", "bootstrap.yml", *extra], cwd=ROOT / "ansible")
    finally:
        if become_file:   # la contraseña del usuario del proveedor: fuera apenas termina
            become_file.write_text("\0" * 64)
            shutil.rmtree(become_file.parent, ignore_errors=True)
    for _ in range(10):
        if ssh_ok([alias]):
            ok(f"Entras como {cfg['homelab_user']} por el puerto {cfg['homelab_ssh_port']}")
            return
        import time
        time.sleep(3)
    die(f"No logro entrar con `ssh {alias}`. Revisa el firewall de tu proveedor (el puerto {cfg['homelab_ssh_port']}).")


def check_user_initial(v: str):
    return None if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", v) else "Usuario inválido."


def step_repo_pushed() -> None:
    name = forge_out("name")
    title(f"4. Tu configuración en {name}")
    note(f"""
El servidor se configura desde tu repo en {name}: lo que no esté subido, no existe para él.""")
    if run(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout.strip():
        die("Hay cambios sin commit (la configuración, la llave del servidor...). Corre:\n"
            "    git add -A && git commit -m 'andamio: configuración' && git push\n"
            "y vuelve a correr `andamio servidor`: retoma donde quedó.")
    run(["git", "-C", str(ROOT), "fetch", "-q"])
    if run(["git", "-C", str(ROOT), "rev-parse", "HEAD"]).stdout != run(["git", "-C", str(ROOT), "rev-parse", "@{u}"]).stdout:
        die(f"Tus commits no están en {name}: corre `git push` y vuelve a correr `andamio servidor`.")
    ok("Todo subido")


def step_harden(cfg: dict, alias: str) -> None:
    title("5. Endurecimiento: SSH, firewall, parches, Docker y VPN")
    if ansible(["site.yml", "--tags", "base,ssh,firewall,docker,wireguard"], cfg, alias) != 0:
        die("El endurecimiento falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio servidor`.")
    ok("Servidor endurecido")


def remote(alias: str, script: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    """Corre en el servidor. Sin stdin: el script entra por la entrada estándar (bash -s).
    Con stdin (p. ej. un token): el script va como comando y stdin es solo ese dato."""
    if stdin is None:
        return run(["ssh", "-o", "BatchMode=yes", alias, "bash", "-s"], input=script)
    return run(["ssh", "-o", "BatchMode=yes", alias, script], input=stdin)


def step_repo_key(cfg: dict, alias: str) -> None:
    name = forge_out("name")
    title("6. Llave del servidor para leer tu repo")
    note(f"""
El servidor baja tu configuración de {name} con una llave propia, de SOLO LECTURA y solo
para ese repo. Se genera en el servidor: la privada nunca sale de ahí.""")
    m = re.search(r":([^/]+/[^/]+?)(\.git)?$", cfg["homelab_repo"])
    repo = m.group(1) if m else die("homelab_repo no tiene el formato git@github-homelab-infra:dueño/repo.git")
    host, known_hosts = forge_out("ssh-host"), forge_out("known-hosts")
    r = remote(alias, f"""set -e
umask 077
k=~/.ssh/id_ed25519_homelab_infra
[ -f $k ] || ssh-keygen -q -t ed25519 -N '' -C "andamio-server" -f $k
grep -q '^Host github-homelab-infra$' ~/.ssh/config 2>/dev/null || cat >> ~/.ssh/config <<'EOF'
Host github-homelab-infra
    HostName {host}
    User git
    IdentityFile ~/.ssh/id_ed25519_homelab_infra
    IdentitiesOnly yes
EOF
grep -q '^{host} ' ~/.ssh/known_hosts 2>/dev/null || cat >> ~/.ssh/known_hosts <<'EOF'
{known_hosts}
EOF
cat $k.pub
""")
    if r.returncode != 0 or "ssh-ed25519" not in r.stdout:
        die(f"No pude preparar la llave en el servidor: {r.stderr.strip()}")
    tmp = Path(tempfile.mkstemp(suffix=".pub")[1])
    try:
        tmp.write_text(r.stdout.strip().splitlines()[-1] + "\n")
        if forge("deploy-key-has", repo, "andamio-server", str(tmp)).returncode == 0:
            ok(f"Ya registrada en {name}")
        else:
            add = forge("deploy-key-add", repo, "andamio-server", str(tmp))
            if add.returncode != 0:
                die(f"{name} rechazó la llave: {add.stderr.strip()}")
            ok(f"Registrada en {repo} como deploy key de solo lectura")
    finally:
        tmp.unlink()


def registry(cfg: dict) -> tuple[str, str]:
    """(host del registro de imágenes, su nombre para mostrar)."""
    return cfg.get("homelab_registry") or forge_out("registry"), forge_out("registry-name")


def ask_registry_token(cfg: dict, alias: str) -> str | None:
    """Pide el token del registro al principio (antes de minutos de salida de Ansible, donde
    es fácil pegarlo a destiempo y que quede impreso). None si el servidor ya tiene login."""
    host, name = registry(cfg)
    title(f"4b. Acceso a tus imágenes ({name})")
    if remote(alias, f"grep -q '\"{host}\"' ~/.docker/config.json 2>/dev/null").returncode == 0:
        ok(f"El servidor ya puede bajar imágenes de {name}")
        return None
    note(forge_out("registry-token-help"))
    token = ask_secret("Token de solo lectura de imágenes (no se ve al escribir)", registry_token_problem)
    ok("Token válido: lo uso cuando Docker esté instalado (paso 7).")
    return token


def step_registry(cfg: dict, alias: str, token: str | None) -> None:
    host, name = registry(cfg)
    title(f"7. Login en {name}")
    if token is None:
        ok("Ya hecho")
        return
    r = remote(alias, f"docker login {host} -u {cfg['homelab_github_owner']} --password-stdin", stdin=token + "\n")
    if r.returncode != 0:
        die(f"docker login falló: {r.stderr.strip()}")
    ok(f"Login en {name} hecho (el token queda solo en el servidor)")


def step_platform(cfg: dict, alias: str) -> None:
    title("8. Plataforma: Traefik, datos, monitoreo")
    if ansible(["site.yml", "--tags", "homelab"], cfg, alias) != 0:
        die("La plataforma falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio servidor`.")
    ok("Plataforma arriba")


def cmd_servidor(args: argparse.Namespace) -> None:
    print("\033[1mandamio servidor\033[0m: prepara tu VPS (parte 2). Se puede volver a correr: retoma donde quedó.")
    check_tools()
    cfg = load_config()
    pub = step_local_key()
    step_host_key(cfg)
    cfg = load_config()
    alias = step_ssh_alias(cfg)
    step_bootstrap(cfg, alias, pub)
    step_repo_pushed()
    token = ask_registry_token(cfg, alias)
    title("4c. Contraseña de sudo")
    sudo_password_file(cfg, alias)
    try:
        step_harden(cfg, alias)
        step_repo_key(cfg, alias)
        step_registry(cfg, alias, token)
        step_platform(cfg, alias)
    finally:
        if _SUDO_FILE:
            _SUDO_FILE.write_text("\0" * 64)
            shutil.rmtree(_SUDO_FILE.parent, ignore_errors=True)
    title("Listo: tu VPS está seguro y preparado")
    note(f"""
VPN: importa ~/andamio-vpn/mi-pc.conf en WireGuard (paneles privados solo por VPN).
Grafana (si tu monitoreo es completo): https://grafana.{cfg.get('homelab_domain')} con la VPN.
Primera app:  bin/homelab app create <nombre> --repo <dueño/repo> --port <puerto> --health /ruta""")


def cmd_certificado(args: argparse.Namespace) -> None:
    cfg = load_config()
    if not args.cert:
        title("Tu certificado (homelab_tls: custom)")
        if not TLS_CERT.exists():
            die(f"No hay certificado propio en {TLS_CERT.relative_to(ROOT)}. Agrega uno con: "
                "bin/andamio certificado <certificado> <llave>")
        info = cert_info(TLS_CERT)
        show_cert(info)
        for p in cert_warnings(info, cfg.get("homelab_domain", "")):
            warn(p)
        if cfg.get("homelab_tls") != "custom":
            warn(f"Tu configuración usa homelab_tls: {cfg.get('homelab_tls')}: este certificado no se está usando.")
        return
    if not args.key:
        die("Falta la llave: bin/andamio certificado <certificado> <llave>")
    if not shutil.which("openssl"):
        die("Falta openssl: sudo apt install openssl  |  brew install openssl")

    title("1. Revisar el certificado nuevo")
    error = cert_problem(args.cert) or key_problem(local_path(args.cert), args.key)
    if error:
        die(error)
    cert, key = local_path(args.cert), local_path(args.key)
    info = cert_info(cert)
    show_cert(info)
    problems = cert_warnings(info, cfg.get("homelab_domain", ""))
    for p in problems:
        warn(p)
    if problems and not ask_yes("¿Usarlo igual?", False):
        die("Cancelado: no cambié nada.")

    title("2. Guardarlo en tu configuración")
    if cfg.get("homelab_tls") != "custom":
        warn(f"Hoy usas homelab_tls: {cfg.get('homelab_tls')} (Let's Encrypt).")
        if not ask_yes("¿Cambiar a tu certificado (homelab_tls: custom)?", False):
            die("Cancelado: no cambié nada.")
        set_config("homelab_tls", "custom")
        ok("homelab_tls: custom")
    install_cert(cert, key)

    title("Listo. Para usarlo en el servidor")
    note(f"""
git add {TLS_CERT.relative_to(ROOT)} {TLS_KEY.relative_to(ROOT)} {CONFIG.relative_to(ROOT)}
git commit -m "andamio: certificado nuevo (vence {info['expires']})" && git push
ansible/hl aplicar homelab
Traefik se reinicia solo para cargarlo (unos segundos sin servicio).""")


def main() -> None:
    parser = argparse.ArgumentParser(prog="andamio", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_init = sub.add_parser("init", help="configuración guiada (parte 1, local)")
    p_init.add_argument("--force", action="store_true", help="completar una configuración existente")
    p_init.set_defaults(func=cmd_init)
    p_srv = sub.add_parser("servidor", aliases=["server"], help="prepara el VPS (parte 2; se puede repetir)")
    p_srv.set_defaults(func=cmd_servidor)
    p_cert = sub.add_parser("certificado", aliases=["certificate"],
                            help="tu propio certificado HTTPS: ver el actual o reemplazarlo")
    p_cert.add_argument("cert", nargs="?", help="certificado PEM (con los intermedios de tu CA)")
    p_cert.add_argument("key", nargs="?", help="su llave privada PEM")
    p_cert.set_defaults(func=cmd_certificado)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
