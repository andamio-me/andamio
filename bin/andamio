#!/usr/bin/env python3
"""andamio: prepara tu configuración y tu VPS / sets up your configuration and your VPS.

  andamio setup     deja tu máquina lista: instala lo que falta, preguntando antes (una vez)
  andamio init      preguntas guiadas -> configuración, llave de cifrado y secretos
                    (parte 1: solo en tu máquina; no toca ningún servidor)
  andamio servidor  prepara el VPS: acceso SSH verificado, usuario propio, endurecimiento,
                    VPN, llave del repo, registro de imágenes y los stacks (parte 2; se puede repetir)
  andamio estado    chequeo de seguridad y salud: desde el servidor y desde Internet,
                    con el arreglo de cada problema (no cambia nada)
  andamio backups   backups diarios, cifrados y fuera del servidor (B2 o S3): los
                    configura, hace el primero y prueba que se puede restaurar
  andamio app ...   tus apps: create, secret (set/rm/list), apply, list, logs, stop/start,
                    rollback, destroy
  andamio update    trae las mejoras y parches de andamio (fusión de tres vías por
                    archivo) sin tocar tu configuración, tus apps ni tus secretos
  andamio certificado [cert llave]
                    tu propio certificado HTTPS (andamio_tls: custom): sin argumentos
                    muestra el actual; con ellos lo valida y lo reemplaza (renovación)
  andamio use [carpeta|dominio]
                    con varios servidores: qué copia usa `andamio` fuera de sus carpetas
                    (dentro de una, usa esa; `andamio` se instala en ~/.local/bin)

Todo lo que genera queda en este repo (cifrado donde corresponde). Nada se sobreescribe:
si un archivo ya existe, se respeta.

Idioma: español si ANDAMIO_LANG (o LANG) empieza con "es"; si no, inglés. Cada mensaje
tiene sus dos versiones juntas: L("español", "English").
"""
from __future__ import annotations

import argparse
import getpass
import ipaddress
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "ansible" / "group_vars" / "all.yml"
SOPS_CONFIG = ROOT / ".sops.yaml"
AGE_KEY = Path(os.environ.get("SOPS_AGE_KEY_FILE", Path.home() / ".config" / "sops" / "age" / "keys.txt"))
INVENTORY = ROOT / "ansible" / "inventory.yml"
AUTH_KEYS = ROOT / "host" / "ssh" / "authorized_keys"
SSH_DIR = Path.home() / ".ssh"
LOCAL_KEY = SSH_DIR / "id_ed25519"
DEFAULT_ALIAS = "andamio"
TLS_CERT = ROOT / "host" / "tls" / "cert.pem"          # público: va en claro
TLS_KEY = ROOT / "host" / "sops" / "tls-key.sops"      # privada: cifrada
CERT_WARN_DAYS = 30


# ---------- idioma ----------

def _lang() -> str:
    for var in ("ANDAMIO_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            return "es" if os.environ[var].lower().startswith("es") else "en"
    return "en"


LANG = _lang()
os.environ["ANDAMIO_LANG"] = LANG     # bin/forge y los scripts lo heredan
# Lo que instala `andamio setup` (sops, ansible por pipx) vive en ~/.local/bin, que la
# shell recién instalada a veces aún no tiene en el PATH.
os.environ["PATH"] = f"{Path.home() / '.local' / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}"


def L(es: str, en: str) -> str:
    return es if LANG == "es" else en


# Herramientas que necesitas en TU máquina, y cómo instalarlas.
TOOLS = {
    "git": "bin/andamio setup",
    "ssh": "bin/andamio setup",
    "ssh-keygen": "bin/andamio setup",
    "sops": "bin/andamio setup",
    "age-keygen": "bin/andamio setup",
    "ansible-playbook": "bin/andamio setup",
}


# ---------- salida ----------

# "ANDAMIO" en bloques con sombra (estilo ANSI Shadow), en el azul de la marca.
BANNER = r"""
 █████╗ ███╗   ██╗██████╗  █████╗ ███╗   ███╗██╗ ██████╗
██╔══██╗████╗  ██║██╔══██╗██╔══██╗████╗ ████║██║██╔═══██╗
███████║██╔██╗ ██║██║  ██║███████║██╔████╔██║██║██║   ██║
██╔══██║██║╚██╗██║██║  ██║██╔══██║██║╚██╔╝██║██║██║   ██║
██║  ██║██║ ╚████║██████╔╝██║  ██║██║ ╚═╝ ██║██║╚██████╔╝
╚═╝  ╚═╝╚═╝  ╚═══╝╚═════╝ ╚═╝  ╚═╝╚═╝     ╚═╝╚═╝ ╚═════╝
"""


def banner() -> None:
    """Solo en terminales (no en logs ni pipes) y con espacio; NO_COLOR: sin colores."""
    if not sys.stdout.isatty() or shutil.get_terminal_size((80, 24)).columns < 60:
        return
    color = not os.environ.get("NO_COLOR")
    truecolor = os.environ.get("COLORTERM", "") in ("truecolor", "24bit")
    blue = ("\033[38;2;36;95;212m" if truecolor else "\033[38;5;26m") if color else ""
    shadow = ("\033[38;2;120;150;210m" if truecolor else "\033[38;5;67m") if color else ""
    reset = "\033[0m" if color else ""
    for line in BANNER.strip("\n").splitlines():
        out = "".join(f"{blue}{c}{reset}" if c == "█" else f"{shadow}{c}{reset}" if c != " " else c for c in line)
        print("  " + out)
    print("  " + (f"\033[2m" if color else "") + L("el PaaS de un solo VPS, seguro por defecto",
                                                   "the single-VPS PaaS, secure by default") + reset + "\n")

def title(t: str) -> None:
    print(f"\n\033[1m{t}\033[0m")


def note(t: str) -> None:
    for line in t.strip("\n").splitlines():
        print(f"  \033[2m{line}\033[0m")


def ok(t: str) -> None:
    print(f"  \033[32m✓\033[0m {t}")


def warn(t: str) -> None:
    print(f"  \033[33m!\033[0m {t}")


def die(t: str) -> None:
    sys.stdout.flush()
    print(f"\n\033[31m✗ {t}\033[0m", file=sys.stderr)
    sys.exit(1)


def ask(question: str, default: str | None = None, check=None, hint: str = "") -> str:
    """Pregunta hasta tener una respuesta válida. check devuelve un error o None."""
    suffix = f" [{default}]" if default else ""
    while True:
        try:
            value = input(f"  {question}{suffix}: ").strip()
        except EOFError:
            die(L("Entrada terminada antes de responder todo.", "Input ended before all questions were answered."))
        value = value or (default or "")
        error = check(value) if check else (None if value else L("No puede quedar vacío.", "It can't be empty."))
        if not error:
            return value
        warn(error + (f" {hint}" if hint else ""))


def choose(question: str, options: list[tuple[str, str]], default: str) -> str:
    """Elegir entre opciones fijas con ↑/↓ y Enter. Sin terminal interactiva (pipes, pruebas),
    vuelve a la pregunta escrita, con las mismas opciones."""
    values = [v for v, _ in options]
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return ask(f"{question} ({'/'.join(values)})", default,
                   lambda v: None if v in values else L(f"Opciones: {', '.join(values)}.", f"Options: {', '.join(values)}."))
    import termios
    import tty
    i, width = values.index(default), max(len(v) for v in values)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)

    def draw(first: bool) -> None:
        if not first:
            sys.stdout.write(f"\033[{len(options) + 1}A")
        for n, (v, label) in enumerate(options):
            mark = "\033[36m❯\033[0m" if n == i else " "
            text = f"\033[1m{v:<{width}}\033[0m" if n == i else f"{v:<{width}}"
            sys.stdout.write(f"\r\033[K    {mark} {text}  \033[2m{label}\033[0m\n")
        sys.stdout.write("\r\033[K    \033[2m" + L("↑/↓ para moverte, Enter para elegir", "↑/↓ to move, Enter to choose") + "\033[0m\n")
        sys.stdout.flush()
    print(f"  {question}:")
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l")   # sin cursor mientras se elige
        draw(True)
        while True:
            key = os.read(fd, 3)
            if key in (b"\r", b"\n"):
                break
            if key in (b"\x1b[A", b"k"):
                i = (i - 1) % len(options)
            elif key in (b"\x1b[B", b"j"):
                i = (i + 1) % len(options)
            elif key == b"\x03":
                raise KeyboardInterrupt
            draw(False)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h")
    # Deja una sola línea con lo elegido, como las demás preguntas.
    sys.stdout.write(f"\033[{len(options) + 2}A\r\033[J  {question}: \033[36m{values[i]}\033[0m\n")
    sys.stdout.flush()
    return values[i]


def ask_yes(question: str, default: bool) -> bool:
    """Sí o no: con flechas en una terminal; escrito (s/n) en pipes y pruebas."""
    if sys.stdin.isatty() and sys.stdout.isatty():
        yes = L("sí", "yes")
        return choose(question, [(yes, ""), ("no", "")], yes if default else "no") == yes
    yes, no = L("s", "y"), "n"
    answer = ask(question, yes if default else no,
                 lambda v: None if v.lower() in ("s", "si", "sí", "y", "yes", "n", "no")
                 else L("Responde s o n.", "Answer y or n."))
    return answer.lower()[0] in ("s", "y")


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True, **kw)


# La forja de tus repos (GitHub hoy): todo pasa por bin/forge, nunca directo a su CLI.
def forge(*args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    return run([str(ROOT / "bin" / "forge"), *args], input=stdin)


def forge_out(*args: str) -> str:
    r = forge(*args)
    if r.returncode != 0:
        die(r.stderr.strip() or L(f"forge {args[0]} falló", f"forge {args[0]} failed"))
    return r.stdout.strip()


# ---------- validaciones ----------

def check_ip(v: str):
    try:
        ip = ipaddress.ip_address(v)
    except ValueError:
        return L("No es una IP válida.", "That's not a valid IP.")
    if ip.version != 4 or ip.is_private or ip.is_loopback:
        return L("Tiene que ser la IPv4 pública del VPS.", "It must be the VPS's public IPv4.")
    return None


def check_domain(v: str):
    return None if re.fullmatch(r"(?=.{4,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}", v) \
        else L("Dominio inválido (ej. midominio.com).", "Invalid domain (e.g. mydomain.com).")


def check_email(v: str):
    return None if re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", v) else L("Email inválido.", "Invalid email.")


def check_user(v: str):
    if v == "root":
        return L("No uses root: el punto es entrar con un usuario propio.",
                 "Don't use root: the point is to log in with your own user.")
    return None if re.fullmatch(r"[a-z][a-z0-9-]{1,30}", v) \
        else L("Minúsculas, números y guiones (2-31).", "Lowercase letters, digits and hyphens (2-31).")


def check_port(v: str):
    if not v.isdigit() or not 1024 <= int(v) <= 65535:
        return L("Entre 1024 y 65535.", "Between 1024 and 65535.")
    if int(v) in (8080, 51820):
        return L("Ese puerto lo usa andamio (Traefik o la VPN).", "andamio uses that port (Traefik or the VPN).")
    return None


def http_get(url: str, token: str) -> tuple[int, dict, str]:
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}",
                                               "User-Agent": "andamio", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status, dict(r.headers), r.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), ""
    except OSError as e:
        return 0, {}, str(e)


def registry_token_problem(token: str) -> str | None:
    """None si el token sirve para bajar imágenes del registro (lo valida la forja)."""
    r = forge("registry-token-check", stdin=token)
    return None if r.returncode == 0 else (r.stderr.strip() or L("No pude validar el token.", "Couldn't validate the token."))


def cloudflare_token_problem(token: str) -> str | None:
    code, _, body = http_get("https://api.cloudflare.com/client/v4/user/tokens/verify", token)
    if code == 200 and '"active"' in body:
        return None
    return L("Cloudflare no reconoce ese token como activo (¿mal copiado o vencido?).",
             "Cloudflare doesn't see that token as active (mistyped or expired?).")


def ask_secret(prompt: str, problem, tries: int = 3) -> str:
    """Pide un dato secreto (no se ve al escribir), lo verifica y repregunta."""
    for intento in range(tries):
        value = getpass.getpass(f"  {prompt}: ").strip()
        error = problem(value)
        if not error:
            return value
        left = tries - 1 - intento
        warn(error + (L(f" ({left} intentos más)", f" ({left} more tries)") if left else ""))
    die(L("No pude verificar el dato. Revísalo y vuelve a correr el comando: retoma donde quedó.",
          "Couldn't verify it. Check it and run the command again: it resumes where it stopped."))


def resolves_to(name: str) -> set[str]:
    try:
        return {a[4][0] for a in socket.getaddrinfo(name, None, socket.AF_INET)}
    except socket.gaierror:
        return set()


# ---------- certificado propio (andamio_tls: custom) ----------

def local_path(v: str) -> Path:
    """Ruta escrita por la persona; acepta rutas de Windows si corre en WSL (C:\\Users\\...)."""
    v = v.strip().strip("'\"")
    if re.match(r"^[A-Za-z]:\\", v) and shutil.which("wslpath"):
        v = run(["wslpath", "-u", v]).stdout.strip() or v
    return Path(v).expanduser()


def cert_info(cert: Path) -> dict:
    """Datos del primer certificado del archivo (el del servidor); {} si no es un PEM válido."""
    from datetime import datetime, timezone
    r = run(["openssl", "x509", "-in", str(cert), "-noout", "-subject", "-issuer", "-enddate",
             "-ext", "subjectAltName", "-nameopt", "RFC2253"])
    if r.returncode != 0:
        return {}
    field = lambda k: (re.search(rf"^{k}=(.*)$", r.stdout, re.M) or [None, ""])[1].strip()  # noqa: E731
    subject, issuer = field("subject"), field("issuer")
    expires = datetime.strptime(field("notAfter"), "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    cn = (re.search(r"CN=([^,]+)", subject) or [None, ""])[1]
    return {
        "cn": cn, "issuer": issuer, "self_signed": subject == issuer,
        "sans": [s.lower() for s in re.findall(r"DNS:([^,\s]+)", r.stdout)] or [cn.lower()],
        "expires": expires.strftime("%Y-%m-%d"), "days": (expires - datetime.now(timezone.utc)).days,
        "chain": cert.read_text(errors="ignore").count("BEGIN CERTIFICATE"),
        "cloudflare_origin": "cloudflare origin" in issuer.lower(),
    }


def covers(sans: list[str], name: str) -> bool:
    return any(s == name or (s.startswith("*.") and name.endswith(s[1:]) and name.count(".") == s.count("."))
               for s in sans)


def cert_problem(v: str) -> str | None:
    p = local_path(v)
    if not p.is_file():
        return L(f"No existe el archivo {p}.", f"File {p} doesn't exist.")
    info = cert_info(p)
    if not info:
        return L("No es un certificado PEM (texto que empieza con -----BEGIN CERTIFICATE-----). Si es binario "
                 "(.der/.cer): openssl x509 -inform der -in ARCHIVO -out cert.pem",
                 "Not a PEM certificate (text starting with -----BEGIN CERTIFICATE-----). If it's binary "
                 "(.der/.cer): openssl x509 -inform der -in FILE -out cert.pem")
    if info["days"] < 0:
        return L(f"Ese certificado venció el {info['expires']}.", f"That certificate expired on {info['expires']}.")
    return None


def key_problem(cert: Path, v: str) -> str | None:
    key = local_path(v)
    if not key.is_file():
        return L(f"No existe el archivo {key}.", f"File {key} doesn't exist.")
    r = run(["openssl", "pkey", "-in", str(key), "-passin", "pass:", "-pubout"])
    if r.returncode != 0:
        if "ENCRYPTED" in key.read_text(errors="ignore"):
            return L(f"La llave tiene contraseña. Quítasela (andamio la cifra con sops igual): "
                     f"openssl pkey -in {key} -out llave-sin-clave.key",
                     f"The key has a passphrase. Remove it (andamio encrypts it with sops anyway): "
                     f"openssl pkey -in {key} -out key-no-passphrase.key")
        return L("No es una llave privada PEM (texto que empieza con -----BEGIN ... PRIVATE KEY-----).",
                 "Not a PEM private key (text starting with -----BEGIN ... PRIVATE KEY-----).")
    if run(["openssl", "x509", "-in", str(cert), "-noout", "-pubkey"]).stdout.strip() != r.stdout.strip():
        return L("Esa llave no corresponde al certificado (¿es la de otra solicitud o de otro dominio?).",
                 "That key doesn't match the certificate (from another request, or another domain?).")
    return None


def cert_warnings(info: dict, domain: str) -> list[str]:
    """Problemas que no impiden usarlo, pero que la persona tiene que conocer."""
    out = []
    # El comodín se prueba con un nombre que nadie pondría en un certificado.
    missing = [n for n in (domain, f"*.{domain}") if not covers(info["sans"], n.replace("*", "andamio-x7q"))]
    if missing:
        out.append(L(f"No cubre {' ni '.join(missing)} (cubre: {', '.join(info['sans'])}). Las apps con "
                     "otros nombres mostrarán un error de certificado en el navegador.",
                     f"It doesn't cover {' or '.join(missing)} (it covers: {', '.join(info['sans'])}). Apps "
                     "with other names will show a certificate error in the browser."))
    if info["cloudflare_origin"]:
        out.append(L("Es un Origin Certificate de Cloudflare: solo lo aceptan los navegadores a través del "
                     "proxy de Cloudflare (nube naranja, SSL/TLS en modo Full (strict)). Tus paneles privados "
                     "(por la VPN) no pasan por Cloudflare y mostrarán un error de certificado. Si tu dominio "
                     "ya está en Cloudflare, el modo 'cloudflare' de andamio evita esto (gratis, se renueva solo).",
                     "It's a Cloudflare Origin Certificate: browsers only accept it through Cloudflare's "
                     "proxy (orange cloud, SSL/TLS mode Full (strict)). Your private panels (over the VPN) "
                     "don't go through Cloudflare and will show a certificate error. If your domain is "
                     "already on Cloudflare, andamio's 'cloudflare' mode avoids this (free, renews itself)."))
    elif info["self_signed"]:
        out.append(L("Es autofirmado: ningún navegador lo acepta.", "It's self-signed: no browser accepts it."))
    elif info["chain"] < 2:
        out.append(L("Trae solo tu certificado, sin los intermedios de tu CA: algunos clientes lo rechazarán. "
                     "Usa el archivo 'fullchain' o 'bundle', o pega los intermedios debajo del tuyo.",
                     "It only has your certificate, without your CA's intermediates: some clients will "
                     "reject it. Use the 'fullchain' or 'bundle' file, or paste the intermediates below yours."))
    if info["days"] < CERT_WARN_DAYS:
        out.append(L(f"Vence en {info['days']} días ({info['expires']}).",
                     f"It expires in {info['days']} days ({info['expires']})."))
    return out


def show_cert(info: dict) -> None:
    ok(L(f"{info['cn']}: cubre {', '.join(info['sans'])}", f"{info['cn']}: covers {', '.join(info['sans'])}"))
    note(L(f"Emitido por: {info['issuer']}\nVence: {info['expires']} (en {info['days']} días)",
           f"Issued by: {info['issuer']}\nExpires: {info['expires']} (in {info['days']} days)"))


def ask_cert(domain: str) -> tuple[Path, Path]:
    """Pide certificado y llave, los valida y muestra lo que hay que saber antes de usarlos."""
    if not shutil.which("openssl"):
        die(L("Falta openssl para revisar tu certificado: sudo apt install openssl  |  brew install openssl",
              "openssl is needed to check your certificate: sudo apt install openssl  |  brew install openssl"))
    note(L("""
Necesitas dos archivos PEM (texto que empieza con -----BEGIN):
  certificado: el tuyo seguido de los intermedios de tu CA (fullchain o bundle)
  llave privada: la que generaste con la solicitud (CSR), o la que te dio Cloudflare
En WSL, tu carpeta Descargas de Windows está en /mnt/c/Users/<tu usuario>/Downloads
(también puedes pegar la ruta de Windows tal cual).""", """
You need two PEM files (text starting with -----BEGIN):
  certificate: yours followed by your CA's intermediates (fullchain or bundle)
  private key: the one you generated with the request (CSR), or the one Cloudflare gave you
In WSL, your Windows Downloads folder is /mnt/c/Users/<your user>/Downloads
(you can also paste the Windows path as is)."""))
    while True:
        cert = local_path(ask(L("Ruta del certificado", "Certificate path"), check=cert_problem))
        key = local_path(ask(L("Ruta de la llave privada", "Private key path"), check=lambda v: key_problem(cert, v)))
        info = cert_info(cert)
        show_cert(info)
        problems = cert_warnings(info, domain)
        for p in problems:
            warn(p)
        if not problems or ask_yes(L("¿Usarlo igual?", "Use it anyway?"), False):
            return cert, key


def install_cert(cert: Path, key: Path) -> None:
    """Copia el certificado al repo y cifra la llave con sops (sin copias en claro)."""
    TLS_CERT.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(cert, TLS_CERT)
    TLS_CERT.chmod(0o644)
    ok(f"{TLS_CERT.relative_to(ROOT)}")
    rel = TLS_KEY.relative_to(ROOT)
    r = run(["sops", "encrypt", "--input-type", "binary", "--output-type", "json",
             "--filename-override", str(rel), str(key)], cwd=ROOT)
    if r.returncode != 0:
        die(L(f"sops no pudo cifrar la llave: {r.stderr.strip()}", f"sops couldn't encrypt the key: {r.stderr.strip()}"))
    TLS_KEY.parent.mkdir(parents=True, exist_ok=True)
    TLS_KEY.write_text(r.stdout)
    ok(L(f"{rel} (cifrada)", f"{rel} (encrypted)"))
    warn(L(f"Ya está cifrada en el repo: borra la copia sin cifrar ({key}), también de tu carpeta Descargas.",
           f"It's now encrypted in the repo: delete the unencrypted copy ({key}), from your Downloads folder too."))


# ---------- pasos ----------

def check_tools() -> None:
    title(L("Herramientas en tu máquina", "Tools on your machine"))
    missing = [t for t in TOOLS if not shutil.which(t)]
    try:
        import yaml  # noqa: F401
    except ImportError:
        missing.append("python3-yaml")
        TOOLS["python3-yaml"] = "bin/andamio setup"
    if not missing:   # forge lee la configuración con yaml
        forge_tools = dict(line.split("\t", 1) for line in forge_out("tools").splitlines())
        TOOLS.update(forge_tools)
        missing = [t for t in forge_tools if not shutil.which(t)]
    for t in missing:
        warn(L(f"Falta {t}: {TOOLS[t]}", f"Missing {t}: {TOOLS[t]}"))
    if missing:
        die(L("Falta preparar tu máquina: corre `bin/andamio setup` (lo instala todo, preguntando antes).",
              "Your machine isn't ready yet: run `bin/andamio setup` (it installs everything, asking first)."))
    ok(L(f"git, ssh, sops, age, ansible y {', '.join(forge_tools)} disponibles",
         f"git, ssh, sops, age, ansible and {', '.join(forge_tools)} available"))
    name = forge_out("name")
    if forge("auth-ok").returncode != 0:
        die(L(f"Tu CLI de {name} no tiene sesión iniciada ({', '.join(forge_tools)}): ",
              f"Your {name} CLI isn't logged in ({', '.join(forge_tools)}): ") + next(iter(forge_tools.values())))
    ok(L(f"Sesión iniciada en {name}", f"Logged in to {name}"))


# ---------- setup: tu máquina ----------

# Paquetes del sistema por herramienta (apt / brew). gh, sops y ansible van aparte.
APT_PKGS = {"git": "git", "ssh": "openssh-client", "ssh-keygen": "openssh-client", "age-keygen": "age",
            "curl": "curl", "openssl": "openssl", "pipx": "pipx"}
BREW_PKGS = {"git": "git", "age-keygen": "age", "gh": "gh", "sops": "sops", "ansible-playbook": "ansible"}
COLLECTIONS = ("community.sops", "ansible.posix", "community.general")


def has_yaml() -> bool:
    return run([sys.executable, "-c", "import yaml"]).returncode == 0


def missing_collections() -> list[str]:
    if not shutil.which("ansible-galaxy"):
        return list(COLLECTIONS)
    listed = run(["ansible-galaxy", "collection", "list"]).stdout
    return [c for c in COLLECTIONS if not re.search(rf"^{re.escape(c)}\s", listed, re.M)]


def install_sops() -> None:
    """La última versión oficial de sops, verificada contra el checksum de la misma release
    antes de instalarla en ~/.local/bin (sin sudo)."""
    import hashlib
    import json
    import platform
    import urllib.request
    arch = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine().lower())
    osname = "darwin" if sys.platform == "darwin" else "linux"
    if not arch:
        die(L(f"No hay sops para {platform.machine()}: instálalo a mano (https://github.com/getsops/sops/releases).",
              f"No sops build for {platform.machine()}: install it by hand (https://github.com/getsops/sops/releases)."))

    def get(url: str) -> bytes:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "andamio"}), timeout=60) as r:
            return r.read()
    tag = json.loads(get("https://api.github.com/repos/getsops/sops/releases/latest"))["tag_name"]
    name, base = f"sops-{tag}.{osname}.{arch}", f"https://github.com/getsops/sops/releases/download/{tag}/"
    sums = get(f"{base}sops-{tag}.checksums.txt").decode()
    expected = next((line.split()[0] for line in sums.splitlines() if line.endswith(f" {name}")), None)
    binary = get(base + name)
    if not expected or hashlib.sha256(binary).hexdigest() != expected:
        die(L(f"El binario de sops no coincide con su checksum oficial: no lo instalo ({name}).",
              f"The sops binary doesn't match its official checksum: not installing it ({name})."))
    dest = Path.home() / ".local" / "bin" / "sops"
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(binary)
    dest.chmod(0o755)
    ok(L(f"sops {tag} (checksum verificado) en {dest}", f"sops {tag} (checksum verified) in {dest}"))


def cmd_setup(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio setup\033[0m: deja tu máquina lista para usar andamio (una vez). Pregunta antes de instalar.",
            "\033[1mandamio setup\033[0m: gets your machine ready for andamio (once). Asks before installing."))
    title(L("1. Qué falta", "1. What's missing"))
    tools = ["git", "ssh", "ssh-keygen", "age-keygen", "openssl", "gh", "sops", "ansible-playbook"]
    missing = [t for t in tools if not shutil.which(t)] + ([] if has_yaml() else ["python3-yaml"])
    if sys.platform == "darwin":
        manager = "brew" if shutil.which("brew") else None
    else:
        osr = Path("/etc/os-release").read_text() if Path("/etc/os-release").exists() else ""
        manager = "apt" if re.search(r"^ID(_LIKE)?=.*\b(debian|ubuntu)\b", osr, re.M) and shutil.which("apt-get") else None
    for t in tools:
        (warn if t in missing else ok)(L(f"{t}: falta", f"{t}: missing") if t in missing else t)
    if "python3-yaml" in missing:
        warn(L("python3-yaml: falta", "python3-yaml: missing"))

    if missing:
        if not manager:
            die(L("No sé instalar en este sistema (andamio sabe con apt —Ubuntu/Debian/WSL— y con Homebrew en macOS). "
                  f"Instala a mano: {', '.join(missing)}",
                  "I don't know how to install on this system (andamio knows apt —Ubuntu/Debian/WSL— and Homebrew on "
                  f"macOS). Install by hand: {', '.join(missing)}"))
        note(L(f"Lo instalo con {manager}" + (" (te pedirá la contraseña de sudo de ESTA máquina)" if manager == "apt" else "")
               + ". sops viene de su release oficial y se verifica contra su checksum; ansible, con pipx.",
               f"Installing with {manager}" + (" (it asks for the sudo password of THIS machine)" if manager == "apt" else "")
               + ". sops comes from its official release, verified against its checksum; ansible, via pipx."))
        if not ask_yes(L("¿Instalo lo que falta?", "Install what's missing?"), True):
            die(L("No instalé nada.", "Nothing installed."))
        title(L("2. Instalando", "2. Installing"))
        if manager == "apt":
            pkgs = sorted({APT_PKGS[t] for t in missing if t in APT_PKGS}
                          | ({"python3-yaml"} if "python3-yaml" in missing else set())
                          | ({"pipx"} if "ansible-playbook" in missing and not shutil.which("pipx") else set())
                          | ({"curl"} if "gh" in missing and not shutil.which("curl") else set()))
            if pkgs and interactive(["sudo", "apt-get", "update", "-qq"]) + \
                    interactive(["sudo", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "-qq", *pkgs]) != 0:
                die(L("apt no pudo instalar: " + " ".join(pkgs), "apt couldn't install: " + " ".join(pkgs)))
            if "gh" in missing:   # repositorio oficial de GitHub CLI (firmado con su llave)
                if interactive(["sudo", "bash", "-c", """set -e
install -d -m 755 /etc/apt/keyrings
curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg
chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gh"""]) != 0:
                    die(L("No pude instalar gh.", "Couldn't install gh."))
            if "sops" in missing:
                install_sops()
            if "ansible-playbook" in missing:
                if interactive(["pipx", "install", "--include-deps", "ansible"]) != 0:
                    die(L("pipx no pudo instalar ansible.", "pipx couldn't install ansible."))
                interactive(["pipx", "ensurepath"])
        else:
            pkgs = sorted({BREW_PKGS[t] for t in missing if t in BREW_PKGS})
            if pkgs and interactive(["brew", "install", *pkgs]) != 0:
                die(L("brew no pudo instalar: " + " ".join(pkgs), "brew couldn't install: " + " ".join(pkgs)))
            if "python3-yaml" in missing:
                interactive([sys.executable, "-m", "pip", "install", "--user", "--break-system-packages", "pyyaml"])
        still = [t for t in tools if not shutil.which(t)] + ([] if has_yaml() else ["python3-yaml"])
        if still:
            die(L(f"Sigue faltando: {', '.join(still)}", f"Still missing: {', '.join(still)}"))
        ok(L("Herramientas instaladas", "Tools installed"))

    title(L("3. Colecciones de Ansible", "3. Ansible collections"))
    need = missing_collections()
    if need:
        if interactive(["ansible-galaxy", "collection", "install", "-r", str(ROOT / "ansible" / "requirements.yml")]) != 0:
            die(L("ansible-galaxy no pudo instalar las colecciones.", "ansible-galaxy couldn't install the collections."))
    ok(", ".join(COLLECTIONS))

    title(L("4. Tu identidad en git", "4. Your git identity"))
    name, email = (run(["git", "config", "--global", k]).stdout.strip() for k in ("user.name", "user.email"))
    if not (name and email):
        note(L("Para los commits que hace andamio (tu configuración, tus apps).",
               "For the commits andamio makes (your configuration, your apps)."))
        name = name or ask(L("Tu nombre", "Your name"))
        email = email or ask(L("Tu email", "Your email"), check=check_email)
        run(["git", "config", "--global", "user.name", name])
        run(["git", "config", "--global", "user.email", email])
    ok(f"{name} <{email}>")

    fname = forge_out("name")
    title(L(f"5. Tu cuenta de {fname}", f"5. Your {fname} account"))
    if forge("auth-ok").returncode != 0:
        note(L("""
Vas a iniciar sesión en GitHub. Elige SSH como protocolo y deja que suba tu llave SSH.
Si estás en WSL y no se abre el navegador: copia el código que te muestra, abre
https://github.com/login/device en tu navegador de Windows y pégalo (tienes unos minutos).""", """
You're about to log in to GitHub. Pick SSH as the protocol and let it upload your SSH key.
If you're on WSL and no browser opens: copy the code it shows, open
https://github.com/login/device in your Windows browser and paste it (you have a few minutes)."""))
        interactive(["gh", "auth", "login", "--git-protocol", "ssh"])
        if forge("auth-ok").returncode != 0:
            die(L("No quedó la sesión iniciada: vuelve a correr `bin/andamio setup`.",
                  "Not logged in yet: run `bin/andamio setup` again."))
    ok(L(f"Sesión iniciada en {fname} como {forge_out('whoami')}", f"Logged in to {fname} as {forge_out('whoami')}"))
    host = forge_out("ssh-host")
    # Las llaves de host oficiales (de la API de la forja), no "la primera que se presente".
    known = SSH_DIR / "known_hosts"
    if not run(["ssh-keygen", "-F", host]).stdout.strip():
        SSH_DIR.mkdir(mode=0o700, exist_ok=True)
        with known.open("a") as f:
            f.write(forge_out("known-hosts") + "\n")
        ok(L(f"Llaves de host oficiales de {host} en ~/.ssh/known_hosts", f"{host}'s official host keys in ~/.ssh/known_hosts"))
    probe = run(["ssh", "-T", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", f"git@{host}"])
    if "successfully authenticated" in probe.stdout + probe.stderr:
        ok(L(f"Tu llave SSH entra a {host} (andamio sube por ahí el CI de tus apps)",
             f"Your SSH key gets into {host} (andamio pushes your apps' CI through it)"))
    else:
        warn(L(f"Tu llave SSH todavía no entra a {host}. Agrégala:  gh ssh-key add ~/.ssh/id_ed25519.pub",
               f"Your SSH key can't get into {host} yet. Add it:  gh ssh-key add ~/.ssh/id_ed25519.pub"))
        note(L("(si no tienes llave: ssh-keygen -t ed25519; si gh pide permiso: gh auth refresh -s admin:public_key)",
               "(no key yet: ssh-keygen -t ed25519; if gh asks for permission: gh auth refresh -s admin:public_key)"))

    # Corriendo desde el andamio público (recién clonado): tu copia privada, desde el template.
    origin = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    upstream = re.sub(r"\.git$", "", UPSTREAM_DEFAULT.split("github.com/")[-1])
    next_dir = None
    if not UPSTREAM_DEFAULT.startswith("@") and re.search(rf"[:/]{re.escape(upstream)}(\.git)?$", origin):
        title(L("6. Tu copia privada de andamio", "6. Your private copy of andamio"))
        note(L("""
Este es el andamio público: tu configuración (cifrada) vive en una copia PRIVADA tuya,
creada desde este template. La creo y la clono.""", """
This is the public andamio: your (encrypted) configuration lives in a PRIVATE copy of
yours, created from this template. Creating and cloning it."""))
        owner = forge_out("whoami")
        repo_name = ask(L(f"Nombre de tu repo (en {owner}/)", f"Your repo's name (under {owner}/)"), "mi-andamio",
                        lambda v: None if re.fullmatch(r"[A-Za-z0-9._-]{1,100}", v) else L("Nombre inválido.", "Invalid name."))
        target = Path(ask(L("Dónde clonarlo", "Where to clone it"), str(Path.home() / repo_name))).expanduser()
        if target.exists():
            die(L(f"{target} ya existe.", f"{target} already exists."))
        full = f"{owner}/{repo_name}"
        if forge("repo-exists", full).returncode == 0:
            ok(L(f"{full} ya existe: lo clono", f"{full} already exists: cloning it"))
        else:
            r = forge("repo-create", full, upstream)
            if r.returncode != 0:
                die(L(f"No pude crear {full}: {r.stderr.strip()}", f"Couldn't create {full}: {r.stderr.strip()}"))
            ok(L(f"{full} creado (privado, desde {upstream})", f"{full} created (private, from {upstream})"))
        if interactive(["git", "clone", "-q", forge_out("clone-url", full), str(target)]) != 0:
            die(L(f"No pude clonar {full}.", f"Couldn't clone {full}."))
        ok(f"{target}")
        next_dir = target

    title(L("Listo: tu máquina está preparada", "Done: your machine is ready"))
    note((f"cd {next_dir}\n" if next_dir else "") + L("Siguiente:  bin/andamio init", "Next:  bin/andamio init"))
    if "ansible-playbook" in missing:
        note(L("(abre una terminal nueva para que tu shell vea ~/.local/bin)",
               "(open a new terminal so your shell sees ~/.local/bin)"))


def questions() -> dict:
    title(L("2. Tu servidor", "2. Your server"))
    note(L("""
La IP pública del VPS que compraste (la ves en el panel de tu proveedor).""", """
The public IP of the VPS you bought (shown in your provider's dashboard)."""))
    a = {"ip": ask(L("IP del VPS", "VPS IP"), check=check_ip)}

    title(L("3. Tu dominio", "3. Your domain"))
    note(L("""
andamio publica cada app como <app>.tudominio. En el DNS de tu dominio necesitas dos
registros A apuntando a la IP del VPS: uno para el dominio y otro para *.dominio.""", """
andamio publishes each app as <app>.yourdomain. Your domain's DNS needs two A records
pointing to the VPS's IP: one for the domain and one for *.domain."""))
    a["domain"] = ask(L("Dominio", "Domain"), check=check_domain).lower()
    apex, wild = resolves_to(a["domain"]), resolves_to(f"andamio-check.{a['domain']}")
    if a["ip"] in apex and a["ip"] in wild:
        ok(L(f"{a['domain']} y *.{a['domain']} ya apuntan a {a['ip']}",
             f"{a['domain']} and *.{a['domain']} already point to {a['ip']}"))
    else:
        nothing = L("nada", "nothing")
        warn(f"{a['domain']} -> {', '.join(apex) or nothing}; *.{a['domain']} -> {', '.join(wild) or nothing}")
        note(L(f"""
Crea en tu DNS:  A  {a['domain']}  ->  {a['ip']}   y   A  *.{a['domain']}  ->  {a['ip']}
Sin eso no habrá certificados HTTPS. Puedes seguir y corregirlo antes de preparar el servidor.""", f"""
Create in your DNS:  A  {a['domain']}  ->  {a['ip']}   and   A  *.{a['domain']}  ->  {a['ip']}
Without them there will be no HTTPS certificates. You can go on and fix it before setting up the server."""))

    title(L("4. Acceso seguro", "4. Secure access"))
    note(L("""
andamio crea un usuario propio (root deja de poder entrar), SSH solo con llave y en un
puerto distinto del 22 (menos ruido de bots que prueban contraseñas).""", """
andamio creates your own user (root can no longer log in), SSH with keys only, on a port
other than 22 (less noise from bots guessing passwords)."""))
    a["user"] = ask(L("Nombre del usuario de Linux que andamio crea para ti en el servidor (entras con él)",
                      "Name of the Linux user andamio creates for you on the server (you log in with it)"),
                    "andamio", check_user)
    a["port"] = ask(L("Puerto SSH", "SSH port"), str(secrets.choice(range(20000, 30000))), check_port)

    name, host = forge_out("name"), forge_out("ssh-host")
    title(f"5. {name}")
    note(L(f"""
Tus apps viven en repos de {name} y sus imágenes en {forge_out('registry-name')}. El CI construye y despliega.""", f"""
Your apps live in {name} repos and their images in {forge_out('registry-name')}. CI builds and deploys."""))
    login = forge("whoami").stdout.strip()
    a["owner"] = ask(L(f"Usuario u organización de {name}", f"{name} user or organization"), login or None)
    remote = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    m = re.search(rf"{re.escape(host)}[:/]([^/]+/[^/.]+)", remote)
    a["repo"] = ask(L("Repo de esta configuración (dueño/nombre)", "This configuration's repo (owner/name)"),
                    m.group(1) if m else None,
                    lambda v: None if re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+", v)
                    else L("Formato dueño/nombre.", "Format: owner/name."))

    title("6. HTTPS")
    note(L("""
http (recomendado para empezar): un certificado de Let's Encrypt por app; funciona con
  cualquier DNS. Los nombres de tus apps (también las privadas) quedan en los registros
  públicos de certificados.
cloudflare: un solo certificado comodín; no publica los nombres. Necesita el DNS del
  dominio en Cloudflare y un token con permiso Zone:DNS:Edit para esa zona.
custom: tu propio certificado (de una CA comercial, o un Origin Certificate de Cloudflare).
  Nadie lo renueva solo: Grafana avisa antes de que venza y lo reemplazas con
  bin/andamio certificado.""", """
http (recommended to start): one Let's Encrypt certificate per app; works with any DNS.
  Your apps' names (private ones too) end up in the public certificate logs.
cloudflare: a single wildcard certificate; names stay unpublished. Needs the domain's DNS
  on Cloudflare and a token with Zone:DNS:Edit permission for that zone.
custom: your own certificate (from a commercial CA, or a Cloudflare Origin Certificate).
  Nobody renews it for you: Grafana warns before it expires and you replace it with
  bin/andamio certificate."""))
    a["tls"] = choose(L("Modo de HTTPS", "HTTPS mode"), [
        ("http", L("Let's Encrypt, un certificado por app (recomendado para empezar)",
                   "Let's Encrypt, one certificate per app (recommended to start)")),
        ("cloudflare", L("Let's Encrypt comodín (necesita un token de Cloudflare)",
                         "Let's Encrypt wildcard (needs a Cloudflare token)")),
        ("custom", L("tu propio certificado (te pide los archivos)", "your own certificate (asks for the files)")),
    ], "http")
    a["cf_token"] = (ask_secret(L("Token de Cloudflare (no se ve al escribir)", "Cloudflare token (hidden while typing)"),
                                cloudflare_token_problem)
                     if a["tls"] == "cloudflare" else "")
    if a["cf_token"]:
        ok(L("Token de Cloudflare activo", "Cloudflare token active"))
    a["cert"], a["key"] = ask_cert(a["domain"]) if a["tls"] == "custom" else (None, None)
    a["email"] = ("" if a["tls"] == "custom" else
                  ask(L("Email para Let's Encrypt (avisos de certificados)", "Email for Let's Encrypt (certificate notices)"),
                      check=check_email))

    title(L("7. Módulos", "7. Modules"))
    note(L("""
Monitoreo: "auto" elige según la RAM del VPS (completo con 3 GB o más: métricas, logs,
  Grafana con alertas y Uptime Kuma; mínimo: solo métricas, ~115 MiB).
Backups: después de preparar el servidor, con bin/andamio backups (B2 o S3, guiado).
  Sin backups, tus datos solo viven en el VPS. Alertas por Telegram: se activan después.""", """
Monitoring: "auto" picks by the VPS's RAM (completo with 3 GB or more: metrics, logs,
  Grafana with alerts and Uptime Kuma; minimo: metrics only, ~115 MiB).
Backups: after setting up the server, with bin/andamio backups (B2 or S3, guided).
  Without backups, your data only lives on the VPS. Telegram alerts: turned on later."""))
    a["monitoring"] = choose(L("Monitoreo", "Monitoring"), [
        ("auto", L("según la RAM del VPS (recomendado)", "depending on the VPS's RAM (recommended)")),
        ("minimo", L("solo métricas, ~115 MiB", "metrics only, ~115 MiB")),
        ("completo", L("métricas, logs, Grafana con alertas, Uptime Kuma (3 GB+)",
                       "metrics, logs, Grafana with alerts, Uptime Kuma (3 GB+)")),
    ], "auto")
    return a


def age_recipient() -> str:
    title(L("8. Llave de cifrado (age)", "8. Encryption key (age)"))
    if AGE_KEY.exists():
        ok(L(f"Uso tu llave existente: {AGE_KEY}", f"Using your existing key: {AGE_KEY}"))
    else:
        AGE_KEY.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        r = run(["age-keygen", "-o", str(AGE_KEY)])
        if r.returncode != 0:
            die(L(f"age-keygen falló: {r.stderr.strip()}", f"age-keygen failed: {r.stderr.strip()}"))
        AGE_KEY.chmod(0o600)
        ok(L(f"Llave creada: {AGE_KEY} (solo tú la puedes leer)", f"Key created: {AGE_KEY} (only you can read it)"))
        warn(L("Guárdala también en tu gestor de contraseñas: sin ella no se pueden descifrar tus secretos.",
               "Also keep it in your password manager: without it your secrets can't be decrypted."))
    pub = run(["age-keygen", "-y", str(AGE_KEY)]).stdout.strip()
    if not pub.startswith("age1"):
        die(L("No pude leer la llave pública de age.", "Couldn't read the age public key."))
    return pub


def write_if_missing(path: Path, content: str, mode: int = 0o644) -> bool:
    rel = path.relative_to(ROOT)
    if path.exists():
        warn(L(f"{rel} ya existe: no lo toco", f"{rel} already exists: leaving it alone"))
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)
    ok(f"{rel}")
    return True


def write_config(a: dict, recipient: str) -> None:
    title(L("9. Configuración", "9. Configuration"))
    write_if_missing(SOPS_CONFIG, L(f"""# Secretos cifrados con sops + age. La llave privada vive solo en tu máquina
# ({AGE_KEY}) y en tu gestor de contraseñas.
""", f"""# Secrets encrypted with sops + age. The private key lives only on your machine
# ({AGE_KEY}) and in your password manager.
""") + f"""creation_rules:
  - path_regex: \\.sops(\\.env)?$
    age: {recipient}
""")
    c = {k: L(es, en) for k, (es, en) in {
        "head": ("# Configuración de este servidor (generada por andamio init). Lo único propio:\n"
                 "# roles, plantillas y scripts la leen de aquí.",
                 "# This server's configuration (generated by andamio init). The only thing that's yours:\n"
                 "# roles, templates and scripts read it from here."),
        "user": ("usuario de operación (SSH, docker)", "operator user (SSH, docker)"),
        "hostkey": ("la completa andamio servidor al conectar por primera vez",
                    "filled in by andamio server on first connection"),
        "forge": ("dónde viven tus repos (bin/forge)", "where your repos live (bin/forge)"),
        "registry": ("registro de las imágenes de tus apps", "registry for your apps' images"),
        "backups": ("se activa con bin/andamio backups", "turned on by bin/andamio backups"),
        "telegram": ("se activa con su configuración (bot y chat)", "turned on with its configuration (bot and chat)"),
    }.items()}
    write_if_missing(CONFIG, f"""{c['head']}
andamio_user: {a['user']}              # {c['user']}
andamio_uid: 1001
andamio_ssh_port: {a['port']}
andamio_ssh_host_key: ""           # {c['hostkey']}
andamio_server_ip: {a['ip']}
andamio_hostname: {a['domain'].split('.')[0]}
andamio_domain: {a['domain']}
andamio_tls: {a['tls']}
andamio_acme_email: "{a['email']}"
andamio_forge: {forge_out('name').lower()}              # {c['forge']}
andamio_registry: {forge_out('registry')}          # {c['registry']}
andamio_github_owner: {a['owner']}
andamio_repo: git@github-andamio:{a['repo']}.git
andamio_monitoring: {a['monitoring']}
andamio_backups: false              # {c['backups']}
andamio_telegram: false             # {c['telegram']}
""")


def encrypt(path: Path, values: dict[str, str]) -> None:
    """Cifra un .env con sops. El texto en claro vive solo en una carpeta 0700 y se borra."""
    rel = path.relative_to(ROOT)
    if path.exists():
        warn(L(f"{rel} ya existe: no lo toco", f"{rel} already exists: leaving it alone"))
        return
    tmp = Path(tempfile.mkdtemp(prefix="andamio-"))
    plain = tmp / "secrets.env"
    try:
        plain.write_text("".join(f"{k}={v}\n" for k, v in values.items()))
        plain.chmod(0o600)
        r = run(["sops", "encrypt", "--input-type", "dotenv", "--output-type", "dotenv",
                 "--filename-override", str(rel), str(plain)], cwd=ROOT)
        if r.returncode != 0:
            die(L(f"sops no pudo cifrar {rel}: {r.stderr.strip()}", f"sops couldn't encrypt {rel}: {r.stderr.strip()}"))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(r.stdout)
        ok(L(f"{rel} (cifrado)", f"{rel} (encrypted)"))
    finally:
        plain.write_bytes(b"\0" * 256)
        shutil.rmtree(tmp, ignore_errors=True)


def write_secrets(a: dict) -> None:
    title(L("10. Secretos de la plataforma (contraseñas aleatorias, cifradas)",
            "10. Platform secrets (random passwords, encrypted)"))
    pw = lambda: secrets.token_urlsafe(32).replace("-", "").replace("_", "")[:40]  # noqa: E731
    encrypt(ROOT / "stacks/proxy/secrets.sops.env", {"CF_DNS_API_TOKEN": a["cf_token"]})
    encrypt(ROOT / "stacks/data/secrets.sops.env",
            {"POSTGRES_USER": "andamio", "POSTGRES_PASSWORD": pw(), "REDIS_PASSWORD": pw()})
    encrypt(ROOT / "stacks/monitoring/secrets.sops.env",
            {"DOMAIN": a["domain"], "GF_ADMIN_PASSWORD": pw(), "TELEGRAM_TOKEN": "", "TELEGRAM_CHAT_ID": ""})
    for stack in ("uptime-kuma", "whoami"):
        encrypt(ROOT / f"stacks/{stack}/secrets.sops.env", {"DOMAIN": a["domain"]})
    note(L("""
La contraseña de Grafana (usuario admin):  sops decrypt stacks/monitoring/secrets.sops.env""", """
Grafana's password (user admin):  sops decrypt stacks/monitoring/secrets.sops.env"""))


def in_public_template() -> bool:
    """¿Este repo es un clon del andamio público (no tu copia privada)?"""
    if UPSTREAM_DEFAULT.startswith("@"):
        return False
    origin = run(["git", "-C", str(ROOT), "remote", "get-url", "origin"]).stdout.strip()
    upstream = re.sub(r"\.git$", "", UPSTREAM_DEFAULT.split("github.com/")[-1])
    return bool(re.search(rf"[:/]{re.escape(upstream)}(\.git)?$", origin))


def refuse_public_template() -> None:
    """Tu configuración nunca va en el template público (lo verían todos)."""
    if in_public_template():
        die(L("Este es el andamio público (el template): tu configuración no va aquí, iría a un repo "
              "que ve todo el mundo. Corre `bin/andamio setup`: crea tu copia privada y te dice a dónde ir.",
              "This is the public andamio (the template): your configuration doesn't go here, it would "
              "end up in a repo everyone sees. Run `bin/andamio setup`: it creates your private copy "
              "and tells you where to go."))


def cmd_init(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio init\033[0m: prepara la configuración de tu VPS (parte 1, solo en tu máquina).",
            "\033[1mandamio init\033[0m: prepares your VPS's configuration (part 1, only on your machine)."))
    refuse_public_template()
    if CONFIG.exists() and "andamio_server_ip:" in CONFIG.read_text() and not args.force:
        die(L(f"Ya hay una configuración en {CONFIG.relative_to(ROOT)}. No la sobreescribo (usa --force para "
              "completar lo que falte; lo existente se respeta igual).",
              f"There's already a configuration in {CONFIG.relative_to(ROOT)}. I won't overwrite it (use "
              "--force to fill in what's missing; existing files are kept anyway)."))
    check_tools()
    a = questions()
    recipient = age_recipient()
    write_config(a, recipient)
    write_secrets(a)
    if a["tls"] == "custom":
        title(L("11. Tu certificado", "11. Your certificate"))
        install_cert(a["cert"], a["key"])
    title(L("Listo. Próximos pasos", "Done. Next steps"))
    note(L(f"""
1. Sube tu configuración (va cifrada):
     git add -A && git commit -m "andamio: mi servidor" && git push

2. Si tu proveedor tiene firewall propio (Azure, AWS, Oracle, Google Cloud, y a veces
   Hetzner o DigitalOcean), ábrele estos puertos de entrada ANTES del paso 3:
     TCP {a['port']} (tu SSH nuevo), 80 y 443 (web)   ·   UDP 51820 (VPN)
   Deja también el 22 abierto hasta terminar: andamio entra primero por ahí.
   Si no lo haces, al mover SSH a tu puerto quedarías fuera del servidor.

3. Prepara el servidor:
     bin/andamio servidor""", f"""
1. Push your configuration (it's encrypted):
     git add -A && git commit -m "andamio: my server" && git push

2. If your provider has its own firewall (Azure, AWS, Oracle, Google Cloud, sometimes
   Hetzner or DigitalOcean), open these inbound ports in it BEFORE step 3:
     TCP {a['port']} (your new SSH), 80 and 443 (web)   ·   UDP 51820 (VPN)
   Also keep 22 open until the end: andamio first gets in through it.
   Otherwise, once SSH moves to your port, you'd be locked out of the server.

3. Set up the server:
     bin/andamio server"""))


# ================= parte 2: el servidor =================

def load_config() -> dict:
    import yaml
    refuse_public_template()
    if not CONFIG.exists():
        die(L("Falta la configuración: corre primero `andamio init`.", "No configuration yet: run `andamio init` first."))
    cfg = yaml.safe_load(CONFIG.read_text()) or {}
    for k in ("andamio_user", "andamio_ssh_port", "andamio_server_ip", "andamio_repo", "andamio_github_owner"):
        if not cfg.get(k):
            die(L(f"Falta {k} en {CONFIG.relative_to(ROOT)}.", f"{k} is missing in {CONFIG.relative_to(ROOT)}."))
    return cfg


def set_config(key: str, value: str) -> None:
    """Cambia una línea de la configuración (o la agrega si no está)."""
    text = CONFIG.read_text()
    line = f'{key}: "{value}"'
    new, n = re.subn(rf"^{re.escape(key)}:.*$", line, text, flags=re.M)
    CONFIG.write_text(new if n else text.rstrip("\n") + "\n" + line + "\n")


def ssh_ok(target: list[str]) -> bool:
    """¿Entra por SSH sin pedir nada? (solo llave, sin preguntar huellas)."""
    r = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=yes", *target, "true"])
    return r.returncode == 0


def interactive(cmd: list[str], **kw) -> int:
    """Corre un comando que habla con la persona (contraseñas, confirmaciones)."""
    sys.stdout.flush()   # lo que andamio ya imprimió va antes que lo del comando
    return subprocess.run(cmd, check=False, **kw).returncode


_SUDO_FILE: Path | None = None
# Recordar la contraseña entre comandos (como sudo): solo en memoria ($XDG_RUNTIME_DIR es
# tmpfs, privado y se borra al cerrar sesión), nunca en disco; vence tras N minutos sin uso.
SUDO_MINUTES = int(os.environ.get("ANDAMIO_SUDO_MINUTES") or 15)
SUDO_CACHE = Path(os.environ["XDG_RUNTIME_DIR"]) / "andamio" if os.environ.get("XDG_RUNTIME_DIR") else None


def sudo_cache_file(cfg: dict) -> Path | None:
    if not SUDO_CACHE or SUDO_MINUTES <= 0:
        return None
    import hashlib
    key = hashlib.sha256(f"{cfg['andamio_user']}@{cfg['andamio_server_ip']}".encode()).hexdigest()[:16]
    return SUDO_CACHE / f"sudo-{key}"


def sudo_remembered(cfg: dict, alias: str) -> str | None:
    """La contraseña recordada, si no venció y el servidor la sigue aceptando."""
    f = sudo_cache_file(cfg)
    try:
        if not f or not f.is_file() or time.time() - f.stat().st_mtime > SUDO_MINUTES * 60:
            forget_sudo(f)
            return None
        pw = f.read_text()
    except OSError:
        return None
    if remote(alias, "sudo -S -p '' -v", stdin=pw + "\n").returncode != 0:
        forget_sudo(f)   # la cambiaste en el servidor: se pide de nuevo
        return None
    f.touch()   # 15 minutos desde el último uso
    return pw


def remember_sudo(cfg: dict, pw: str) -> None:
    f = sudo_cache_file(cfg)
    if not f:
        return
    try:
        f.parent.mkdir(mode=0o700, exist_ok=True)
        f.parent.chmod(0o700)
        fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as out:
            out.write(pw)
    except OSError:
        pass


def forget_sudo(f: Path | None = None) -> None:
    """Borra la contraseña recordada (una, o todas si no se indica)."""
    for p in ([f] if f else list(SUDO_CACHE.glob("sudo-*")) if SUDO_CACHE and SUDO_CACHE.is_dir() else []):
        try:
            p.write_text("\0" * 64)
            p.unlink()
        except OSError:
            pass


def sudo_password_file(cfg: dict, alias: str) -> Path:
    """La contraseña de sudo de TU usuario: se pide una vez, se verifica contra el
    servidor y Ansible la lee de un archivo privado (0600) que se borra al salir.
    Nunca va en la línea de comandos. Se recuerda unos minutos (sudo_remembered)."""
    global _SUDO_FILE
    if _SUDO_FILE:
        return _SUDO_FILE
    pw = sudo_remembered(cfg, alias)
    if pw is not None:
        ok(L(f"Contraseña de sudo recordada (vence a los {SUDO_MINUTES} min sin uso; andamio olvidar la borra)",
             f"Sudo password remembered (expires after {SUDO_MINUTES} idle min; andamio forget wipes it)"))
        return sudo_temp_file(pw)
    user = cfg["andamio_user"]
    note(L(f"""
andamio necesita la contraseña de sudo de tu usuario '{user}' en el servidor
({cfg['andamio_server_ip']}): la que le pusiste al crearlo (si lo creó andamio servidor,
fue en su paso 3, donde se pidió dos veces). Se pide una sola vez para todo lo que sigue.""", f"""
andamio needs the sudo password of your user '{user}' on the server
({cfg['andamio_server_ip']}): the one you set when it was created (if andamio server created
it, that was in its step 3, where it was asked twice). It's asked only once for everything that follows."""))
    for intento in range(3):
        pw = getpass.getpass(L(f"  Contraseña de sudo de '{user}': ", f"  Sudo password for '{user}': "))
        if remote(alias, "sudo -S -p '' -v", stdin=pw + "\n").returncode == 0:
            ok(L("Contraseña correcta", "Password correct"))
            remember_sudo(cfg, pw)
            return sudo_temp_file(pw)
        warn(L(f"No es la contraseña de sudo de '{user}' ({2 - intento} intentos más).",
               f"That's not the sudo password for '{user}' ({2 - intento} more tries)."))
    die(L(f"No pude verificar la contraseña de '{user}'. Si la perdiste: entra con la consola web de tu "
          f"proveedor como root y cámbiala con `passwd {user}`.",
          f"Couldn't verify the password for '{user}'. If you lost it: log in as root through your "
          f"provider's web console and change it with `passwd {user}`."))


def sudo_temp_file(pw: str) -> Path:
    """El archivo que lee Ansible (ANSIBLE_BECOME_PASSWORD_FILE): privado y de este comando."""
    global _SUDO_FILE
    tmp = Path(tempfile.mkdtemp(prefix="andamio-sudo-"))
    _SUDO_FILE = tmp / "become"
    fd = os.open(_SUDO_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(pw)
    return _SUDO_FILE


def wipe_sudo() -> None:
    if _SUDO_FILE:
        _SUDO_FILE.write_text("\0" * 64)
        shutil.rmtree(_SUDO_FILE.parent, ignore_errors=True)


def remote_sudo(cfg: dict, alias: str, cmd: str) -> int:
    """Corre un comando con sudo en el servidor, mostrando su salida en vivo. La contraseña
    (ya verificada) entra por stdin, nunca en la línea de comandos. sudo limpia el entorno:
    el idioma se pasa explícito."""
    pw = sudo_password_file(cfg, alias).read_text()
    return subprocess.run(["ssh", "-o", "BatchMode=yes", alias, f"sudo -S -p '' env ANDAMIO_LANG={LANG} {cmd}"],
                          input=pw + "\n", text=True, check=False).returncode


ANSIBLE_LOG = Path(tempfile.gettempdir()) / "andamio-ansible.log"


def run_playbook(args: list[str], env: dict | None = None) -> int:
    """ansible-playbook sin su salida cruda (en español y de cientos de líneas): el log
    completo va a ANSIBLE_LOG y aquí se ve una línea de progreso, el resumen y, si falla,
    la tarea que falló con su error. ANDAMIO_VERBOSE=1: la salida tal cual."""
    cmd = ["ansible-playbook", *args]
    if os.environ.get("ANDAMIO_VERBOSE"):
        return interactive(cmd, cwd=ROOT / "ansible", env=env)
    sys.stdout.flush()
    tasks = changed = 0
    task, failure, recap = "", [], ""
    tty = sys.stdout.isatty()
    with ANSIBLE_LOG.open("a") as log:
        log.write(f"\n===== {' '.join(cmd)}\n")
        p = subprocess.Popen(cmd, cwd=ROOT / "ansible", env=env, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in p.stdout:
            log.write(line)
            if line.startswith(("TASK [", "RUNNING HANDLER [")):
                tasks += 1
                task = line.split("[", 1)[1].rsplit("]", 1)[0]
                if tty:
                    sys.stdout.write(f"\r  \033[2m… {tasks} {L('tareas', 'tasks')}\033[0m\033[K")
                    sys.stdout.flush()
            elif line.startswith("changed:"):
                changed += 1
            elif line.startswith(("fatal:", "failed:")) or ("UNREACHABLE!" in line):
                failure = [task, line.rstrip()]
            elif failure and len(failure) < 25 and line.strip() and not line.startswith(("TASK [", "PLAY ")):
                failure.append(line.rstrip())
            elif " : ok=" in line:
                recap = line
        rc = p.wait()
    if tty:
        sys.stdout.write("\r\033[K")
    if rc == 0:
        ok(L(f"{tasks} tareas, {changed} cambios", f"{tasks} tasks, {changed} changes"))
    else:
        import json
        warn(L(f"Falló la tarea: {failure[0] if failure else task}", f"Failed task: {failure[0] if failure else task}"))
        for x in failure[1:]:
            if " : ok=" in x:
                continue
            # "fatal: [host]: FAILED! => {...}": de ese JSON, solo lo que se lee (msg, stderr).
            detail = None
            if "=> {" in x:
                try:
                    d = json.loads(x.split("=> ", 1)[1])
                    detail = [str(d[k]).strip() for k in ("msg", "stderr", "module_stderr") if d.get(k)]
                except ValueError:
                    pass
            for y in (detail or [x])[:3]:
                print(f"    \033[2m{y[:400]}\033[0m")
        note(L(f"Log completo: {ANSIBLE_LOG}", f"Full log: {ANSIBLE_LOG}"))
    return rc


def ansible(args: list[str], cfg: dict, alias: str) -> int:
    """ansible-playbook con la contraseña de sudo ya verificada (sin prompt genérico)."""
    env = dict(os.environ, ANSIBLE_BECOME_PASSWORD_FILE=str(sudo_password_file(cfg, alias)))
    return run_playbook(args, env)


def new_sudo_password(user: str) -> str:
    """La contraseña nueva del usuario de operación: oculta, dos veces, mínimo 12 caracteres.
    Devuelve su hash (SHA-512, el formato de /etc/shadow): la contraseña no sale de aquí."""
    for _ in range(3):
        pw = getpass.getpass(L(f"  Contraseña nueva para '{user}' (mínimo 12 caracteres, no se ve): ",
                               f"  New password for '{user}' (at least 12 characters, hidden): "))
        if len(pw) < 12:
            warn(L("Muy corta: al menos 12 caracteres.", "Too short: at least 12 characters."))
            continue
        if getpass.getpass(L("  Otra vez, para confirmar: ", "  Once more, to confirm: ")) != pw:
            warn(L("No coinciden.", "They don't match."))
            continue
        r = run(["openssl", "passwd", "-6", "-stdin"], input=pw + "\n")
        if r.returncode != 0 or not r.stdout.startswith("$6$"):
            die(L("openssl no pudo cifrar la contraseña.", "openssl couldn't hash the password."))
        ok(L("Contraseña lista (guárdala en tu gestor)", "Password set (keep it in your password manager)"))
        return r.stdout.strip()
    die(L("No quedó definida la contraseña: vuelve a correr el comando.", "The password wasn't set: run the command again."))


def step_local_key() -> str:
    title(L("1. Tu llave SSH", "1. Your SSH key"))
    pub = LOCAL_KEY.with_suffix(".pub")
    if not pub.exists():
        note(L("""
No tienes una llave ed25519: la creo ahora. Te pedirá una frase de paso (recomendado:
protege la llave si alguien copia tu disco). Enter dos veces = sin frase.""", """
You don't have an ed25519 key: creating one now. It asks for a passphrase (recommended:
it protects the key if someone copies your disk). Enter twice = no passphrase."""))
        SSH_DIR.mkdir(mode=0o700, exist_ok=True)
        if interactive(["ssh-keygen", "-t", "ed25519", "-f", str(LOCAL_KEY), "-C", f"andamio-{getpass.getuser()}"]) != 0:
            die(L("ssh-keygen falló.", "ssh-keygen failed."))
    key = pub.read_text().strip()
    ok(L(f"Uso {pub}", f"Using {pub}"))
    if not AUTH_KEYS.exists():
        AUTH_KEYS.parent.mkdir(parents=True, exist_ok=True)
        AUTH_KEYS.write_text(key + "\n")
        ok(L(f"{AUTH_KEYS.relative_to(ROOT)}: tu llave pública (la que podrá entrar al servidor)",
             f"{AUTH_KEYS.relative_to(ROOT)}: your public key (the one allowed into the server)"))
    elif key.split()[1] not in AUTH_KEYS.read_text():
        warn(L(f"Tu llave no está en {AUTH_KEYS.relative_to(ROOT)}: no podrías entrar con ella.",
               f"Your key isn't in {AUTH_KEYS.relative_to(ROOT)}: you couldn't log in with it."))
        if ask_yes(L("¿Agregarla?", "Add it?"), True):
            with AUTH_KEYS.open("a") as f:
                f.write(key + "\n")
            ok(L("Agregada", "Added"))
    return str(pub)


def step_host_key(cfg: dict) -> None:
    title(L("2. ¿Es tu servidor?", "2. Is it your server?"))
    ip, port = cfg["andamio_server_ip"], cfg["andamio_ssh_port"]
    known = cfg.get("andamio_ssh_host_key") or ""
    if known:
        ok(L("Llave del servidor ya verificada (andamio_ssh_host_key)", "Server key already verified (andamio_ssh_host_key)"))
        return
    note(L("""
La primera conexión es la delicada: si alguien se interpusiera en la red, te mostraría
su propia llave. Para comprobarla, mírala DENTRO del servidor por un camino que no sea
la red, y corre ahí:

    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub

  - Hetzner, DigitalOcean, Vultr, Linode, Contabo: la "Console" (consola web) del VPS.
  - Azure: la VM -> Operaciones -> Ejecutar comando -> RunShellScript.
  - AWS: EC2 -> Connect -> Session Manager (o "Get system log" de la instancia).

Tiene que dar exactamente la misma huella que ves abajo. Si no encuentras cómo, puedes
seguir: el riesgo es bajo, pero existe.""", """
The first connection is the delicate one: if someone sat in the middle of the network,
they would show you their own key. To check it, look at it INSIDE the server through a
path other than the network, and run there:

    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub

  - Hetzner, DigitalOcean, Vultr, Linode, Contabo: the VPS's "Console" (web console).
  - Azure: the VM -> Operations -> Run command -> RunShellScript.
  - AWS: EC2 -> Connect -> Session Manager (or the instance's "Get system log").

It must give exactly the same fingerprint you see below. If you can't find how, you can
go on: the risk is low, but real."""))
    r = run(["ssh-keyscan", "-t", "ed25519", "-p", "22", ip])
    lines = [x for x in r.stdout.splitlines() if x and not x.startswith("#")]
    if not lines:
        r = run(["ssh-keyscan", "-t", "ed25519", "-p", str(port), ip])
        lines = [x for x in r.stdout.splitlines() if x and not x.startswith("#")]
    if not lines:
        die(L(f"No responde SSH en {ip} (ni en el 22 ni en el {port}). Lo más probable: el firewall de tu "
              f"proveedor (Azure, AWS, Oracle, Google Cloud...). Ábrele la entrada TCP 22 (la primera conexión) "
              f"y {port} (tu SSH nuevo). Si ya están abiertos, revisa que el VPS esté encendido.",
              f"No SSH answer at {ip} (neither on 22 nor on {port}). Most likely your provider's firewall "
              f"(Azure, AWS, Oracle, Google Cloud...): allow inbound TCP 22 (the first connection) and {port} "
              f"(your new SSH). If they're already open, check that the VPS is running."))
    host_key = " ".join(lines[0].split()[1:3])
    fp = run(["ssh-keygen", "-lf", "-"], input=f"{ip} {host_key}\n").stdout.split()[1]
    print(L(f"\n    Huella del servidor:  {fp}\n", f"\n    Server fingerprint:  {fp}\n"))
    if not ask_yes(L("¿Coincide con la de tu proveedor (o decides seguir sin comprobarla)?",
                     "Does it match your provider's (or do you choose to go on without checking)?"), True):
        die(L("No sigo. Revisa la IP o pregunta a tu proveedor por la huella SSH (ED25519).",
              "Stopping. Check the IP or ask your provider for the SSH fingerprint (ED25519)."))
    for host in (ip, f"[{ip}]:{port}"):
        run(["ssh-keygen", "-R", host])
    SSH_DIR.mkdir(mode=0o700, exist_ok=True)
    with (SSH_DIR / "known_hosts").open("a") as f:
        f.write(f"{ip} {host_key}\n[{ip}]:{port} {host_key}\n")
    set_config("andamio_ssh_host_key", host_key)
    ok(L("Guardada en known_hosts y en la configuración (el CI la usa para desplegar)",
         "Saved in known_hosts and in the configuration (CI uses it to deploy)"))


def step_ssh_alias(cfg: dict) -> str:
    """Alias en ~/.ssh/config e inventario de Ansible. Respeta lo que exista."""
    import yaml
    alias = DEFAULT_ALIAS
    if INVENTORY.exists():
        inv = yaml.safe_load(INVENTORY.read_text()) or {}
        hosts = (((inv.get("all") or {}).get("children") or {}).get("servers") or {}).get("hosts") or {}
        alias = next(iter(hosts), alias)
    else:
        INVENTORY.write_text(L(f'# Host, usuario, puerto y llave salen de ~/.ssh/config (alias "{alias}").\n',
                               f'# Host, user, port and key come from ~/.ssh/config (alias "{alias}").\n') + f"""all:
  children:
    servers:
      hosts:
        {alias}:
""")
        ok(f"{INVENTORY.relative_to(ROOT)} (alias {alias})")
    cfg_file = SSH_DIR / "config"
    current = cfg_file.read_text() if cfg_file.exists() else ""
    if not re.search(rf"^Host\s+{re.escape(alias)}\s*$", current, re.M):
        with cfg_file.open("a") as f:
            f.write(f"""
Host {alias}
    HostName {cfg['andamio_server_ip']}
    User {cfg['andamio_user']}
    Port {cfg['andamio_ssh_port']}
    IdentityFile {LOCAL_KEY}
    IdentitiesOnly yes
    ServerAliveInterval 60
""")
        cfg_file.chmod(0o600)
        ok(f"~/.ssh/config: alias '{alias}' (ssh {alias})")
    return alias


def step_bootstrap(cfg: dict, alias: str, pub: str) -> None:
    title(L("3. Usuario propio y SSH en tu puerto", "3. Your own user and SSH on your port"))
    user, port = cfg["andamio_user"], cfg["andamio_ssh_port"]
    if ssh_ok([alias]):
        ok(L(f"Ya entras como {user} por el puerto {port}: bootstrap hecho",
             f"You already log in as {user} on port {port}: bootstrap done"))
        return
    ip = cfg["andamio_server_ip"]
    # El usuario con el que cada proveedor deja entrar a un VPS nuevo.
    provider = choose(L("¿Dónde está tu VPS?", "Where is your VPS?"), [
        ("azure", "Azure (azureuser)"), ("aws", "AWS (ubuntu)"), ("oracle", "Oracle Cloud (ubuntu)"),
        ("gcp", L("Google Cloud (tu usuario de Google)", "Google Cloud (your Google user)")),
        ("hetzner", "Hetzner (root)"), ("digitalocean", "DigitalOcean (root)"),
        ("other", L("otro (Vultr, Linode, Contabo...: root)", "other (Vultr, Linode, Contabo...: root)")),
    ], "azure")
    default_user = {"azure": "azureuser", "aws": "ubuntu", "oracle": "ubuntu"}.get(provider, "root")
    note(L("(si al crear el VPS elegiste otro nombre de usuario, escríbelo)",
           "(if you picked another user name when creating the VPS, type it)"))
    initial = ask(L("Usuario con el que te deja entrar el proveedor", "User your provider lets you in with"),
                  default_user, check_user_initial)
    target = ["-p", "22", f"{initial}@{ip}"]
    if not ssh_ok(target):
        how = choose(L(f"Tu llave todavía no entra como {initial}. ¿Cómo te dio acceso el proveedor?",
                       f"Your key can't log in as {initial} yet. How did your provider give you access?"), [
            ("pem", L("un archivo de llave (.pem): lo normal en Azure, AWS y Oracle",
                      "a key file (.pem): the usual on Azure, AWS and Oracle")),
            ("password", L("una contraseña", "a password")),
        ], "pem" if provider in ("azure", "aws", "oracle") else "password")
        if how == "pem":
            note(L("En WSL, tu carpeta Descargas está en /mnt/c/Users/<tu usuario>/Downloads (o pega la ruta de Windows).",
                   "In WSL, your Downloads folder is /mnt/c/Users/<your user>/Downloads (or paste the Windows path)."))
            pem_src = local_path(ask(L("Ruta del archivo .pem", "Path to the .pem file"),
                                     check=lambda v: None if local_path(v).is_file()
                                     else L(f"No existe {local_path(v)}.", f"{local_path(v)} doesn't exist.")))
            # ssh rechaza llaves con permisos abiertos (las de /mnt/c lo son): una copia 0600, temporal.
            tmp = Path(tempfile.mkdtemp(prefix="andamio-pem-"))
            pem = tmp / "key.pem"
            try:
                pem.write_bytes(pem_src.read_bytes())
                pem.chmod(0o600)
                if run(["ssh", "-i", str(pem), "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
                        "-o", "ConnectTimeout=10", *target, "true"]).returncode != 0:
                    die(L(f"Ese archivo no entra como {initial}@{ip}: ¿es la llave de este VPS y el usuario correcto?",
                          f"That file can't log in as {initial}@{ip}: is it this VPS's key and the right user?"))
                ok(L("El archivo .pem entra: con él instalo tu llave (y no se vuelve a usar)",
                     "The .pem file gets in: installing your key with it (it isn't used again)"))
                # Sin ssh-copy-id: su chequeo "¿la llave ya entra?" entraría con el .pem y no instalaría nada.
                key = Path(pub).read_text().strip()
                done = run(["ssh", "-i", str(pem), "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes", *target,
                            'umask 077; mkdir -p ~/.ssh; k=$(cat); grep -qxF "$k" ~/.ssh/authorized_keys 2>/dev/null '
                            '|| printf "%s\\n" "$k" >> ~/.ssh/authorized_keys'], input=key + "\n").returncode == 0
            finally:
                shutil.rmtree(tmp, ignore_errors=True)
        else:
            note(L(f"Escribes la contraseña de {initial} UNA vez; desde ahí, solo llave.",
                   f"You type {initial}'s password ONCE; keys only from then on."))
            done = interactive(["ssh-copy-id", "-i", pub, *target]) == 0
        if not done or not ssh_ok(target):
            die(L(f"No pude instalar tu llave en {initial}@{ip}. Revisa el usuario y la llave o contraseña.",
                  f"Couldn't install your key for {initial}@{ip}. Check the user and the key or password."))
    ok(L(f"Entras como {initial} con tu llave", f"You log in as {initial} with your key"))
    extra = ["-e", f"ansible_user={initial}", "-e", "ansible_port=22"]
    become_file: Path | None = None
    if initial != "root":
        extra += ["--become"]
        if run(["ssh", "-o", "BatchMode=yes", *target, "sudo -n true"]).returncode == 0:
            ok(L(f"{initial} usa sudo sin contraseña (normal en Azure y AWS): no hace falta pedirla",
                 f"{initial} uses sudo without a password (normal on Azure and AWS): no need to ask for it"))
        else:
            note(L(f"""
{initial} necesita contraseña para sudo: la de {initial} que te dio tu proveedor (no la de
tu usuario nuevo, que todavía no existe).""", f"""
{initial} needs a password for sudo: {initial}'s, from your provider (not your new user's,
which doesn't exist yet)."""))
            pw = ask_secret(L(f"Contraseña de sudo de '{initial}'", f"Sudo password for '{initial}'"),
                            lambda v: None if run(["ssh", "-o", "BatchMode=yes", *target, "sudo -S -p '' -v"],
                                                  input=v + "\n").returncode == 0
                            else L(f"No es la contraseña de sudo de '{initial}'.",
                                   f"That's not the sudo password for '{initial}'."))
            tmp = Path(tempfile.mkdtemp(prefix="andamio-sudo-"))
            become_file = tmp / "become"
            become_file.write_text(pw)
            become_file.chmod(0o600)
            extra += ["--become-password-file", str(become_file)]
    note(L(f"""
Ahora creo tu usuario '{user}' y muevo SSH al puerto {port}. Inventa una contraseña NUEVA
para '{user}' (larga) y guárdala en tu gestor: es solo para sudo (para entrar sigue
siendo tu llave), y andamio te la pedirá en los pasos siguientes.""", f"""
Now I create your user '{user}' and move SSH to port {port}. Make up a NEW password for
'{user}' (long) and keep it in your password manager: it's only for sudo (you still log
in with your key), and andamio will ask for it in the next steps."""))
    # Va como hash, en un archivo privado que se borra: el playbook no la pregunta
    # (vars_prompt se salta cuando la variable ya viene definida).
    import json
    vars_dir = Path(tempfile.mkdtemp(prefix="andamio-boot-"))
    vars_file = vars_dir / "vars.json"
    vars_file.write_text(json.dumps({"bootstrap_password": new_sudo_password(user)}))
    vars_file.chmod(0o600)
    title(L("   Creando tu usuario y moviendo SSH (la conexión se corta al final: es lo esperado)",
            "   Creating your user and moving SSH (the connection drops at the end: that's expected)"))
    try:
        run_playbook(["bootstrap.yml", *extra, "-e", f"@{vars_file}"])
    finally:
        shutil.rmtree(vars_dir, ignore_errors=True)
        if become_file:   # la contraseña del usuario del proveedor: fuera apenas termina
            become_file.write_text("\0" * 64)
            shutil.rmtree(become_file.parent, ignore_errors=True)
    for _ in range(10):
        if ssh_ok([alias]):
            ok(L(f"Entras como {user} por el puerto {port}", f"You log in as {user} on port {port}"))
            return
        import time
        time.sleep(3)
    die(L(f"No logro entrar con `ssh {alias}`. Revisa el firewall de tu proveedor (el puerto {port}).",
          f"Can't log in with `ssh {alias}`. Check your provider's firewall (port {port})."))


def check_user_initial(v: str):
    return None if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", v) else L("Usuario inválido.", "Invalid user.")


def step_repo_pushed(cmd: str = "servidor") -> None:
    name = forge_out("name")
    rerun = f"andamio {L(cmd, {'servidor': 'server'}.get(cmd, cmd))}"
    title(L(f"4. Tu configuración en {name}", f"4. Your configuration on {name}"))
    note(L(f"""
El servidor se configura desde tu repo en {name}: lo que no esté subido, no existe para él.""", f"""
The server is configured from your repo on {name}: whatever isn't pushed doesn't exist for it."""))
    if run(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout.strip():
        die(L("Hay cambios sin commit (la configuración, la llave del servidor...). Corre:\n"
              "    git add -A && git commit -m 'andamio: configuración' && git push\n"
              f"y vuelve a correr `{rerun}`: retoma donde quedó.",
              "There are uncommitted changes (the configuration, the server key...). Run:\n"
              "    git add -A && git commit -m 'andamio: configuration' && git push\n"
              f"and run `{rerun}` again: it resumes where it stopped."))
    run(["git", "-C", str(ROOT), "fetch", "-q"])
    if run(["git", "-C", str(ROOT), "rev-parse", "HEAD"]).stdout != run(["git", "-C", str(ROOT), "rev-parse", "@{u}"]).stdout:
        die(L(f"Tus commits no están en {name}: corre `git push` y vuelve a correr `{rerun}`.",
              f"Your commits aren't on {name}: run `git push` and run `{rerun}` again."))
    ok(L("Todo subido", "Everything pushed"))


def step_harden(cfg: dict, alias: str) -> None:
    title(L("5. Endurecimiento: SSH, firewall, parches, Docker y VPN", "5. Hardening: SSH, firewall, patches, Docker and VPN"))
    if ansible(["site.yml", "--tags", "base,ssh,firewall,docker,wireguard"], cfg, alias) != 0:
        die(L("El endurecimiento falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio servidor`.",
              "Hardening failed (details above). Fix it and run `andamio server` again."))
    ok(L("Servidor endurecido", "Server hardened"))


def remote(alias: str, script: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    """Corre en el servidor. Sin stdin: el script entra por la entrada estándar (bash -s).
    Con stdin (p. ej. un token): el script va como comando y stdin es solo ese dato."""
    if stdin is None:
        return run(["ssh", "-o", "BatchMode=yes", alias, "bash", "-s"], input=script)
    return run(["ssh", "-o", "BatchMode=yes", alias, script], input=stdin)


def step_repo_key(cfg: dict, alias: str) -> None:
    name = forge_out("name")
    title(L("6. Llave del servidor para leer tu repo", "6. The server's key to read your repo"))
    note(L(f"""
El servidor baja tu configuración de {name} con una llave propia, de SOLO LECTURA y solo
para ese repo. Se genera en el servidor: la privada nunca sale de ahí.""", f"""
The server pulls your configuration from {name} with its own key, READ-ONLY and for that
repo only. It's generated on the server: the private key never leaves it."""))
    m = re.search(r":([^/]+/[^/]+?)(\.git)?$", cfg["andamio_repo"])
    repo = m.group(1) if m else die(L("andamio_repo no tiene el formato git@github-andamio:dueño/repo.git",
                                      "andamio_repo isn't in the git@github-andamio:owner/repo.git format"))
    host, known_hosts = forge_out("ssh-host"), forge_out("known-hosts")
    r = remote(alias, f"""set -e
umask 077
k=~/.ssh/id_ed25519_andamio
[ -f $k ] || ssh-keygen -q -t ed25519 -N '' -C "andamio-server" -f $k
grep -q '^Host github-andamio$' ~/.ssh/config 2>/dev/null || cat >> ~/.ssh/config <<'EOF'
Host github-andamio
    HostName {host}
    User git
    IdentityFile ~/.ssh/id_ed25519_andamio
    IdentitiesOnly yes
EOF
grep -q '^{host} ' ~/.ssh/known_hosts 2>/dev/null || cat >> ~/.ssh/known_hosts <<'EOF'
{known_hosts}
EOF
cat $k.pub
""")
    if r.returncode != 0 or "ssh-ed25519" not in r.stdout:
        die(L(f"No pude preparar la llave en el servidor: {r.stderr.strip()}",
              f"Couldn't prepare the key on the server: {r.stderr.strip()}"))
    tmp = Path(tempfile.mkstemp(suffix=".pub")[1])
    try:
        tmp.write_text(r.stdout.strip().splitlines()[-1] + "\n")
        if forge("deploy-key-has", repo, "andamio-server", str(tmp)).returncode == 0:
            ok(L(f"Ya registrada en {name}", f"Already registered on {name}"))
        else:
            add = forge("deploy-key-add", repo, "andamio-server", str(tmp))
            if add.returncode != 0:
                die(L(f"{name} rechazó la llave: {add.stderr.strip()}", f"{name} rejected the key: {add.stderr.strip()}"))
            ok(L(f"Registrada en {repo} como deploy key de solo lectura", f"Registered on {repo} as a read-only deploy key"))
    finally:
        tmp.unlink()


def registry(cfg: dict) -> tuple[str, str]:
    """(host del registro de imágenes, su nombre para mostrar)."""
    return cfg.get("andamio_registry") or forge_out("registry"), forge_out("registry-name")


def ask_registry_token(cfg: dict, alias: str) -> str | None:
    """Pide el token del registro al principio (antes de minutos de salida de Ansible, donde
    es fácil pegarlo a destiempo y que quede impreso). None si el servidor ya tiene login."""
    host, name = registry(cfg)
    title(L(f"4b. Acceso a tus imágenes ({name})", f"4b. Access to your images ({name})"))
    if remote(alias, f"grep -q '\"{host}\"' ~/.docker/config.json 2>/dev/null").returncode == 0:
        ok(L(f"El servidor ya puede bajar imágenes de {name}", f"The server can already pull images from {name}"))
        return None
    note(forge_out("registry-token-help"))
    token = ask_secret(L("Token de solo lectura de imágenes (no se ve al escribir)", "Read-only image token (hidden while typing)"),
                       registry_token_problem)
    ok(L("Token válido: lo uso cuando Docker esté instalado (paso 7).", "Token valid: used once Docker is installed (step 7)."))
    return token


def step_registry(cfg: dict, alias: str, token: str | None) -> None:
    host, name = registry(cfg)
    title(L(f"7. Login en {name}", f"7. Login to {name}"))
    if token is None:
        ok(L("Ya hecho", "Already done"))
        return
    r = remote(alias, f"docker login {host} -u {cfg['andamio_github_owner']} --password-stdin", stdin=token + "\n")
    if r.returncode != 0:
        die(L(f"docker login falló: {r.stderr.strip()}", f"docker login failed: {r.stderr.strip()}"))
    ok(L(f"Login en {name} hecho (el token queda solo en el servidor)", f"Logged in to {name} (the token stays only on the server)"))


def step_platform(cfg: dict, alias: str) -> None:
    title(L("8. Plataforma: Traefik, datos, monitoreo", "8. Platform: Traefik, data, monitoring"))
    if ansible(["site.yml", "--tags", "andamio"], cfg, alias) != 0:
        die(L("La plataforma falló (el detalle está arriba). Corrígelo y vuelve a correr `andamio servidor`.",
              "The platform failed (details above). Fix it and run `andamio server` again."))
    ok(L("Plataforma arriba", "Platform up"))


def cmd_servidor(args: argparse.Namespace) -> None:
    banner()
    print(L("\033[1mandamio servidor\033[0m: prepara tu VPS (parte 2). Se puede volver a correr: retoma donde quedó.",
            "\033[1mandamio server\033[0m: sets up your VPS (part 2). Safe to run again: it resumes where it stopped."))
    check_tools()
    cfg = load_config()
    pub = step_local_key()
    step_host_key(cfg)
    cfg = load_config()
    alias = step_ssh_alias(cfg)
    step_bootstrap(cfg, alias, pub)
    step_repo_pushed()
    token = ask_registry_token(cfg, alias)
    title(L("4c. Contraseña de sudo", "4c. Sudo password"))
    sudo_password_file(cfg, alias)
    try:
        step_harden(cfg, alias)
        step_repo_key(cfg, alias)
        step_registry(cfg, alias, token)
        step_platform(cfg, alias)
    finally:
        wipe_sudo()
    title(L("Listo: tu VPS está seguro y preparado", "Done: your VPS is secure and ready"))
    note(L(f"""
VPN: importa ~/andamio-vpn/mi-pc.conf en la app de WireGuard (paneles privados solo por VPN);
  celular: qrencode -t ansiutf8 < ~/andamio-vpn/mi-pc.conf y escanéalo con la app.
Grafana (si tu monitoreo es completo): https://grafana.{cfg.get('andamio_domain')} con la VPN.
Primera app:  bin/andamio app create <nombre> --repo <dueño/repo>   (queda en https://<nombre>.{cfg.get('andamio_domain')})
Chequeo de seguridad:  bin/andamio estado     Backups:  bin/andamio backups""", f"""
VPN: import ~/andamio-vpn/mi-pc.conf into the WireGuard app (private panels only over the VPN);
  phone: qrencode -t ansiutf8 < ~/andamio-vpn/mi-pc.conf and scan it with the app.
Grafana (if your monitoring is completo): https://grafana.{cfg.get('andamio_domain')} over the VPN.
First app:  bin/andamio app create <name> --repo <owner/repo>   (it lives at https://<name>.{cfg.get('andamio_domain')})
Security check:  bin/andamio status     Backups:  bin/andamio backups"""))


# ================= backups =================

RESTIC_ENV = ROOT / "host" / "sops" / "restic-env.sops"
RESTIC_PW = ROOT / "host" / "sops" / "restic-password.sops"
# La llave de B2 que crea andamio: un solo bucket y SIN deleteFiles. restic "oculta" en
# vez de borrar, así que quien tome el servidor no puede borrar tus backups (ADR 0014).
B2_CAPS = ["listBuckets", "listFiles", "readFiles", "writeFiles"]


def server_alias() -> str:
    """El alias SSH del servidor: el primer host del inventario (lo crea andamio servidor)."""
    import yaml
    if not INVENTORY.exists():
        die(L("Falta ansible/inventory.yml: corre primero `bin/andamio servidor`.",
              "ansible/inventory.yml is missing: run `bin/andamio server` first."))
    hosts = yaml.safe_load(INVENTORY.read_text())["all"]["children"]["servers"]["hosts"]
    return next(iter(hosts))


def sops_read(path: Path) -> str:
    r = run(["sops", "decrypt", "--input-type", "json", "--output-type", "binary", str(path)], cwd=ROOT)
    if r.returncode != 0:
        die(L(f"sops no pudo descifrar {path.relative_to(ROOT)}: {r.stderr.strip()}",
              f"sops couldn't decrypt {path.relative_to(ROOT)}: {r.stderr.strip()}"))
    return r.stdout


def encrypt_binary(path: Path, content: str) -> None:
    """Cifra un archivo entero con sops (como los demás secretos del host). El texto en claro
    vive solo en una carpeta 0700 y se sobreescribe antes de borrarse."""
    rel = path.relative_to(ROOT)
    tmp = Path(tempfile.mkdtemp(prefix="andamio-"))
    plain = tmp / "secreto"
    try:
        plain.write_text(content)
        plain.chmod(0o600)
        r = run(["sops", "encrypt", "--input-type", "binary", "--output-type", "json",
                 "--filename-override", str(rel), str(plain)], cwd=ROOT)
        if r.returncode != 0:
            die(L(f"sops no pudo cifrar {rel}: {r.stderr.strip()}", f"sops couldn't encrypt {rel}: {r.stderr.strip()}"))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(r.stdout)
        ok(L(f"{rel} (cifrado)", f"{rel} (encrypted)"))
    finally:
        plain.write_bytes(b"\0" * 256)
        shutil.rmtree(tmp, ignore_errors=True)


def b2_api(url: str, body: dict | None = None, token: str | None = None,
           basic: tuple[str, str] | None = None) -> tuple[int, dict]:
    import base64
    import json
    import urllib.error
    import urllib.request
    headers = {"User-Agent": "andamio"}
    if token:
        headers["Authorization"] = token
    if basic:
        headers["Authorization"] = "Basic " + base64.b64encode(f"{basic[0]}:{basic[1]}".encode()).decode()
    data = json.dumps(body).encode() if body is not None else None
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers), timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}
    except OSError as e:
        return 0, {"message": str(e)}


def b2_authorize(key_id: str, key: str) -> tuple[dict | None, str | None]:
    code, d = b2_api("https://api.backblazeb2.com/b2api/v3/b2_authorize_account", basic=(key_id, key))
    if code == 200:
        return d, None
    if code == 401:
        return None, L("Backblaze no reconoce ese keyID con esa llave (¿mal copiados, o es de otra cuenta?).",
                       "Backblaze doesn't recognize that keyID with that key (mistyped, or from another account?).")
    return None, L(f"No pude comprobarla con Backblaze ({code or d.get('message')}).",
                   f"Couldn't check it with Backblaze ({code or d.get('message')}).")


def ask_b2(cfg: dict) -> tuple[str, dict]:
    note(L("""
Backblaze B2: 10 GB gratis, luego unos 6 USD por TB al mes.
1. En https://secure.backblaze.com/b2_buckets.htm  → Create a Bucket:
     nombre único (ej. andamio-backups-<algo tuyo>), Files: Private,
     Object Lock: Enable (recomendado: protege los backups aunque alguien tome el servidor).
2. La llave que usará el servidor la puede crear andamio, SIN permiso de borrar y solo
   para ese bucket. Para eso necesita tu Master Application Key una vez (App Keys →
   Generate New Master Application Key): no se guarda y solo viaja a Backblaze.""", """
Backblaze B2: 10 GB free, then about 6 USD per TB per month.
1. At https://secure.backblaze.com/b2_buckets.htm  → Create a Bucket:
     unique name (e.g. andamio-backups-<something of yours>), Files: Private,
     Object Lock: Enable (recommended: protects backups even if someone takes the server).
2. andamio can create the key the server will use, WITHOUT delete permission and for
   that bucket only. For that it needs your Master Application Key once (App Keys →
   Generate New Master Application Key): it isn't stored and only travels to Backblaze."""))
    bucket = ask(L("Nombre del bucket", "Bucket name"),
                 check=lambda v: None if re.fullmatch(r"[A-Za-z0-9-]{6,50}", v)
                 else L("Entre 6 y 50 letras, números o guiones.", "6 to 50 letters, digits or hyphens."))
    if ask_yes(L("¿Creo la llave sin permiso de borrar con tu master key? (recomendado)",
                 "Create the key without delete permission using your master key? (recommended)"), True):
        master_id = ask(L("Master keyID (keyID de la master key)", "Master keyID (the master key's keyID)"))
        auth = {}

        def master_problem(k: str) -> str | None:
            d, error = b2_authorize(master_id, k)
            auth.update(d or {})
            return error
        ask_secret(L("Master applicationKey (no se ve al escribir)", "Master applicationKey (hidden while typing)"), master_problem)
        api, token = auth["apiInfo"]["storageApi"]["apiUrl"], auth["authorizationToken"]
        code, d = b2_api(f"{api}/b2api/v3/b2_list_buckets", {"accountId": auth["accountId"], "bucketName": bucket}, token)
        if code != 200 or not d.get("buckets"):
            die(L(f"No existe el bucket '{bucket}' en tu cuenta de Backblaze. Créalo y vuelve a correr `andamio backups`.",
                  f"Bucket '{bucket}' doesn't exist in your Backblaze account. Create it and run `andamio backups` again."))
        name = f"andamio-{cfg.get('andamio_hostname', 'server')}"
        code, key = b2_api(f"{api}/b2api/v3/b2_create_key", {
            "accountId": auth["accountId"], "keyName": name, "bucketId": d["buckets"][0]["bucketId"],
            "capabilities": B2_CAPS}, token)
        if code != 200:
            die(L(f"Backblaze no creó la llave: {key.get('message', code)}", f"Backblaze didn't create the key: {key.get('message', code)}"))
        auth.clear()
        ok(L(f"Llave '{name}' creada: solo el bucket {bucket}, sin permiso de borrar",
             f"Key '{name}' created: bucket {bucket} only, no delete permission"))
        key_id, app_key = key["applicationKeyId"], key["applicationKey"]
    else:
        note(L("""
Crea en App Keys → Add a New Application Key una llave con acceso SOLO a ese bucket.""", """
Create a key in App Keys → Add a New Application Key with access to that bucket ONLY."""))
        key_id = ask(L("keyID de esa llave", "That key's keyID"))
        caps: dict = {}

        def key_problem_b2(k: str) -> str | None:
            d, error = b2_authorize(key_id, k)
            caps.update((d or {}).get("apiInfo", {}).get("storageApi", {}))
            return error
        app_key = ask_secret(L("applicationKey (no se ve al escribir)", "applicationKey (hidden while typing)"), key_problem_b2)
        allowed = [b.get("name") for b in caps.get("allowed", {}).get("buckets") or []]
        if bucket not in allowed:
            seen = ", ".join(filter(None, allowed)) or L("todos", "all")
            warn(L(f"Esa llave no está limitada al bucket {bucket} (puede ver: {seen}).",
                   f"That key isn't limited to bucket {bucket} (it can see: {seen})."))
        if "deleteFiles" in caps.get("allowed", {}).get("capabilities", caps.get("capabilities", [])):
            warn(L("Esa llave PUEDE BORRAR: si alguien toma el servidor, puede borrar tus backups. "
                   "Mejor deja que andamio cree una sin ese permiso (vuelve a correr y responde s).",
                   "That key CAN DELETE: if someone takes the server, they can delete your backups. "
                   "Better let andamio create one without that permission (run again and answer y)."))
        if not ask_yes(L("¿Usarla igual?", "Use it anyway?"), False):
            die(L("Cancelado: no cambié nada.", "Cancelled: nothing changed."))
    return (f"b2:{bucket}:{cfg.get('andamio_hostname', 'andamio')}",
            {"B2_ACCOUNT_ID": key_id, "B2_ACCOUNT_KEY": app_key})


def ask_s3(cfg: dict) -> tuple[str, dict]:
    note(L("""
Cualquier almacenamiento compatible con S3. Crea un bucket PRIVADO y una llave de acceso
limitada a ese bucket (si el proveedor lo permite, sin permiso de borrar y con
versionado u Object Lock). Endpoints:
  AWS S3:         s3.<región>.amazonaws.com        (ej. s3.us-east-1.amazonaws.com)
  Cloudflare R2:  <id de tu cuenta>.r2.cloudflarestorage.com   (10 GB gratis)
  Wasabi:         s3.<región>.wasabisys.com
La llave se prueba desde tu servidor en el paso siguiente.""", """
Any S3-compatible storage. Create a PRIVATE bucket and an access key limited to that
bucket (if the provider allows it, without delete permission and with versioning or
Object Lock). Endpoints:
  AWS S3:         s3.<region>.amazonaws.com        (e.g. s3.us-east-1.amazonaws.com)
  Cloudflare R2:  <your account id>.r2.cloudflarestorage.com   (10 GB free)
  Wasabi:         s3.<region>.wasabisys.com
The key is tested from your server in the next step."""))
    endpoint = ask("Endpoint", check=lambda v: None if re.fullmatch(r"(https?://)?[A-Za-z0-9.-]+(:\d+)?/?", v)
                   else L("Solo el host (ej. s3.us-east-1.amazonaws.com).", "Just the host (e.g. s3.us-east-1.amazonaws.com)."))
    endpoint = re.sub(r"^https?://", "", endpoint).rstrip("/")
    bucket = ask(L("Nombre del bucket", "Bucket name"),
                 check=lambda v: None if re.fullmatch(r"[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]", v)
                 else L("Minúsculas, números, puntos y guiones (3-63).", "Lowercase letters, digits, dots and hyphens (3-63)."))
    m = re.match(r"s3[.-]([a-z0-9-]+)\.amazonaws\.com$", endpoint)
    region = ask(L("Región", "Region"), m.group(1) if m else "auto")
    key_id = ask("Access Key ID")
    secret = ask_secret(L("Secret Access Key (no se ve al escribir)", "Secret Access Key (hidden while typing)"),
                        lambda v: None if len(v) >= 16
                        else L("Muy corta para ser una Secret Access Key.", "Too short to be a Secret Access Key."))
    return (f"s3:https://{endpoint}/{bucket}/{cfg.get('andamio_hostname', 'andamio')}",
            {"AWS_ACCESS_KEY_ID": key_id, "AWS_SECRET_ACCESS_KEY": secret, "AWS_DEFAULT_REGION": region})


def restic_probe(alias: str, repo: str, env: dict, password: str) -> tuple[str, str]:
    """Prueba el destino DESDE el servidor (allí corre restic) y crea el repositorio si no
    existe. Los secretos van en el script por stdin: ni en disco ni en la línea de comandos."""
    import shlex
    exports = " ".join(f"{k}={shlex.quote(v)}" for k, v in {**env, "RESTIC_REPOSITORY": repo,
                                                           "RESTIC_PASSWORD": password}.items())
    r = remote(alias, f"""export {exports}
if out=$(timeout 60 restic cat config 2>&1 > /dev/null); then echo ANDAMIO:EXISTE; exit 0; fi
case "$out" in *"wrong password"*|*"no key found"*) echo ANDAMIO:CLAVE; exit 0 ;; esac
if out=$(timeout 120 restic init 2>&1); then echo ANDAMIO:CREADO; exit 0; fi
echo ANDAMIO:ERROR; printf '%s\\n' "$out" | tail -n 4
""")
    lines = (r.stdout + r.stderr).strip().splitlines()
    status = next((x.split(":", 1)[1] for x in lines if x.startswith("ANDAMIO:")), "ERROR")
    return status, "\n".join(x for x in lines if not x.startswith("ANDAMIO:"))


def cmd_backups(args: argparse.Namespace) -> None:
    print(L("\033[1mandamio backups\033[0m: backups diarios, cifrados y fuera del servidor. "
            "Se puede volver a correr: retoma donde quedó.",
            "\033[1mandamio backups\033[0m: daily, encrypted, off-server backups. "
            "Safe to run again: it resumes where it stopped."))
    check_tools()
    cfg = load_config()
    alias = server_alias()
    if not ssh_ok([alias]):
        die(L(f"No entro al servidor ({alias}) por SSH: corre primero `bin/andamio servidor`.",
              f"Can't reach the server ({alias}) over SSH: run `bin/andamio server` first."))
    note(L("""
Qué se guarda, cada noche (03:30 UTC): las bases de datos (PostgreSQL y Redis), los datos
de tus apps y la plataforma (/srv/andamio), y lo necesario para reconstruir el servidor
igual (llaves SSH, VPN, secretos del host). restic lo cifra EN el servidor antes de
enviarlo: el destino nunca ve tus datos. Se guardan 7 diarios, 4 semanales y 6 mensuales.""", """
What's saved, every night (03:30 UTC): the databases (PostgreSQL and Redis), your apps'
data and the platform (/srv/andamio), and what's needed to rebuild the same server
(SSH keys, VPN, host secrets). restic encrypts it ON the server before sending it: the
destination never sees your data. 7 daily, 4 weekly and 6 monthly are kept."""))

    if RESTIC_ENV.exists() and RESTIC_PW.exists():
        title(L("1-3. Destino", "1-3. Destination"))
        ok(L(f"Ya configurado ({RESTIC_ENV.relative_to(ROOT)})", f"Already configured ({RESTIC_ENV.relative_to(ROOT)})"))
    else:
        title(L("1. ¿Dónde se guardan?", "1. Where are they stored?"))
        kind = choose(L("Destino", "Destination"), [
            ("b2", L("Backblaze B2: 10 GB gratis; andamio crea una llave que no puede borrar",
                     "Backblaze B2: 10 GB free; andamio creates a key that can't delete")),
            ("s3", L("cualquier S3: AWS, Cloudflare R2, Wasabi, MinIO", "any S3: AWS, Cloudflare R2, Wasabi, MinIO")),
        ], "b2")
        repo, env = ask_b2(cfg) if kind == "b2" else ask_s3(cfg)

        title(L("2. Contraseña del repositorio", "2. Repository password"))
        if RESTIC_PW.exists():
            password = sops_read(RESTIC_PW).strip()
            ok(L(f"Uso la de {RESTIC_PW.relative_to(ROOT)}", f"Using the one in {RESTIC_PW.relative_to(ROOT)}"))
        else:
            password = secrets.token_urlsafe(32)
            note(L("""
Aleatoria y cifrada con sops en tu repo: no la ves ni la necesitas escribir. Para leerla
hace falta tu llave age, así que guarda esa llave fuera de esta máquina (gestor de
contraseñas): sin ella, nadie (tú tampoco) puede abrir los backups.""", """
Random and encrypted with sops in your repo: you don't see it or need to type it. Reading
it takes your age key, so keep that key off this machine too (password manager):
without it, nobody (you included) can open the backups."""))

        title(L("3. Probar el destino desde el servidor", "3. Testing the destination from the server"))
        status, detail = restic_probe(alias, repo, env, password)
        if status == "CLAVE":
            warn(L(f"Ya hay un repositorio de backups en {repo}, con otra contraseña.",
                   f"There's already a backup repository at {repo}, with another password."))
            if not ask_yes(L("¿Es tuyo (de una instalación anterior) y tienes su contraseña?",
                             "Is it yours (from a previous install) and do you have its password?"), False):
                die(L("Usa otro bucket (o borra ese repositorio) y vuelve a correr `andamio backups`.",
                      "Use another bucket (or delete that repository) and run `andamio backups` again."))
            password = ask_secret(L("Contraseña de ese repositorio (no se ve al escribir)",
                                    "That repository's password (hidden while typing)"),
                                  lambda p: None if restic_probe(alias, repo, env, p)[0] == "EXISTE"
                                  else L("No abre ese repositorio.", "It doesn't open that repository."))
            status = "EXISTE"
        if status == "ERROR":
            die(L(f"El servidor no pudo usar ese destino:\n{detail}\nRevisa el bucket y la llave, y vuelve a correr.",
                  f"The server couldn't use that destination:\n{detail}\nCheck the bucket and the key, and run again."))
        ok(L("Repositorio creado", "Repository created") if status == "CREADO"
           else L("Repositorio existente: se sigue usando", "Existing repository: it keeps being used"))
        encrypt_binary(RESTIC_PW, password + "\n")
        encrypt_binary(RESTIC_ENV, "".join(f"{k}={v}\n" for k, v in {
            "RESTIC_REPOSITORY": repo, "RESTIC_PASSWORD_FILE": "/etc/restic/password", **env}.items()))
        del password, env

    if str(cfg.get("andamio_backups")).lower() != "true":
        set_config("andamio_backups", "true")
        ok("andamio_backups: true")
    step_repo_pushed("backups")

    title(L("5. Activar en el servidor", "5. Turning it on in the server"))
    try:
        if ansible(["site.yml", "--tags", "andamio"], cfg, alias) != 0:
            die(L("No se pudo activar (el detalle está arriba). Corrígelo y vuelve a correr `andamio backups`.",
                  "Couldn't turn it on (details above). Fix it and run `andamio backups` again."))
        ok(L("Backup diario programado", "Daily backup scheduled"))

        title(L("6. Primer backup (ahora)", "6. First backup (now)"))
        note(L("Puede tardar unos minutos la primera vez.", "It can take a few minutes the first time."))
        if remote_sudo(cfg, alias, "systemctl start andamio-backup.service") != 0:
            remote_sudo(cfg, alias, "journalctl -u andamio-backup.service -n 25 --no-pager")
            die(L("El backup falló (el detalle está arriba).", "The backup failed (details above)."))
        ok(L("Primer backup hecho", "First backup done"))

        title(L("7. Prueba de restauración", "7. Restore test"))
        note(L("Restaura el backup en una base temporal y la compara con producción (no toca nada).",
               "Restores the backup into a temporary database and compares it with production (touches nothing)."))
        if remote_sudo(cfg, alias, f"{cfg.get('andamio_root', '/srv/andamio')}/infra/scripts/restore-check.sh") != 0:
            die(L("La prueba de restauración encontró diferencias (arriba). Tus backups existen, pero revísalo.",
                  "The restore test found differences (above). Your backups exist, but look into it."))
    finally:
        wipe_sudo()

    title(L("Listo: tus datos tienen copia fuera del servidor", "Done: your data has a copy off the server"))
    note(L(f"""
Cada noche a las 03:30 UTC. Con Telegram activado (andamio_telegram) te avisa del
resultado; si no, revísalo de vez en cuando:  ssh {alias} systemctl status andamio-backup
Para reconstruir todo en otro servidor: docs/runbooks/reconstruir-servidor.md""", f"""
Every night at 03:30 UTC. With Telegram on (andamio_telegram) you get the result; if not,
check it now and then:  ssh {alias} systemctl status andamio-backup
To rebuild everything on another server: docs/runbooks/reconstruir-servidor.md"""))


# ================= app: Dockerfile para el repo de una app =================
# Lo llama bin/andamio-app (andamio app create) con el repo de la app ya clonado.

DOCKERFILES = ROOT / "templates" / "dockerfiles"
KINDS = {"node": ("Node", "3000"), "python": ("Python", "8000"), "go": ("Go", "8080"),
         "static": (L("sitio estático", "static site"), "8080")}
DOCKERIGNORE = {
    "node": ".git\nnode_modules\n.next/cache\n.env*\nnpm-debug.log*\n",
    "python": ".git\n.venv\nvenv\n__pycache__\n*.pyc\n.pytest_cache\n.env*\n",
    "go": ".git\n.env*\n",
    "static": ".git\n.github\n.env*\nDockerfile\n.dockerignore\n",
}


def detect_kind(d: Path) -> str | None:
    if (d / "package.json").exists():
        return "node"
    if (d / "requirements.txt").exists() or (d / "pyproject.toml").exists():
        return "python"
    if (d / "go.mod").exists():
        return "go"
    if (d / "index.html").exists():
        return "static"
    return None


def render_dockerfile(kind: str, values: dict[str, str]) -> str:
    """La plantilla con sus valores; de los comentarios #es:/#en: queda el del idioma actual."""
    out = []
    for line in (DOCKERFILES / f"{kind}.Dockerfile").read_text().splitlines(keepends=True):
        if line[:5] in ("#es: ", "#en: "):
            if line[1:3] == LANG:
                out.append("# " + line[5:])
            continue
        out.append(line)
    text = "".join(out)
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", v)
    if "{{" in text:
        die(f"templates/dockerfiles/{kind}.Dockerfile: {re.findall(r'{{[A-Z_]+}}', text)}")
    return text


def node_values(d: Path) -> tuple[dict[str, str], str]:
    import json
    pkg = json.loads((d / "package.json").read_text())
    scripts, deps = pkg.get("scripts", {}), {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
    if (d / "pnpm-lock.yaml").exists():
        m = re.match(r"pnpm@(\d+)", pkg.get("packageManager", ""))
        pm, setup, manifests = "pnpm", f"RUN npm install -g pnpm@{m.group(1) if m else 10}\n", "package.json pnpm-lock.yaml"
        install, run, prune = "pnpm install --frozen-lockfile", "pnpm run", "RUN pnpm prune --prod"
    elif (d / "yarn.lock").exists():
        pm, setup, manifests = "yarn", "RUN corepack enable\n", "package.json yarn.lock"
        install, run = "yarn install --frozen-lockfile", "yarn run"
        prune = "RUN yarn install --production --frozen-lockfile --ignore-scripts"
    else:
        lock = (d / "package-lock.json").exists()
        pm, setup = "npm", ""
        manifests = "package.json package-lock.json" if lock else "package.json"
        install, run, prune = ("npm ci" if lock else "npm install"), "npm run", "RUN npm prune --omit=dev"
    test = scripts.get("test", "")
    start = scripts.get("start") or ("next start" if "next" in deps else f"node {pkg.get('main', 'index.js')}")
    return {
        "PM": pm, "NODE": "24", "PM_SETUP": setup, "MANIFESTS": manifests, "INSTALL": install,
        "BUILD": f"RUN {run} build" if "build" in scripts else "",
        "TEST": f"\nFROM build AS test\nRUN {run} test\n" if test and "no test specified" not in test else "",
        "PRUNE": prune,
    }, start


def python_values(d: Path) -> tuple[dict[str, str], str]:
    req = d / "requirements.txt"
    deps = (req.read_text() if req.exists() else (d / "pyproject.toml").read_text()).lower()
    install = ("COPY requirements.txt ./\nRUN pip install -r requirements.txt\nCOPY . ." if req.exists()
               else "COPY . .\nRUN pip install .")
    has_tests = (d / "tests").is_dir() or any(d.glob("test_*.py"))
    mod = "main" if (d / "main.py").exists() else "app" if (d / "app.py").exists() else "main"
    wsgi = next(iter(d.glob("*/wsgi.py")), None)
    if (d / "manage.py").exists() and wsgi:
        start, need = f"gunicorn {wsgi.parent.name}.wsgi --bind 0.0.0.0:$PORT", "gunicorn"
    elif "fastapi" in deps:
        start, need = f"uvicorn {mod}:app --host 0.0.0.0 --port $PORT", "uvicorn"
    elif "flask" in deps:
        start, need = f"gunicorn {mod}:app --bind 0.0.0.0:$PORT", "gunicorn"
    else:
        start, need = f"python {mod}.py", ""
    if need and need not in deps:
        warn(L(f"Para arrancar así hace falta {need} en tus dependencias (agrégalo a requirements.txt).",
               f"Starting it this way needs {need} in your dependencies (add it to requirements.txt)."))
    return {"PY": "3.13", "INSTALL": install,
            "TEST": "\nFROM build AS test\nRUN pip install pytest && python -m pytest -q\n" if has_tests else ""}, start


def go_values(d: Path) -> dict[str, str]:
    m = re.search(r"^go (\d+\.\d+)", (d / "go.mod").read_text(), re.M)
    mains = [p.parent for p in d.glob("cmd/*/main.go")]
    pkg = "." if (d / "main.go").exists() or not mains else f"./{mains[0].relative_to(d)}"
    return {"GO": m.group(1) if m else "1.27", "GOSUM": "go.sum " if (d / "go.sum").exists() else "", "PKG": pkg}


def cmd_scaffold(args: argparse.Namespace) -> None:
    """Interno: Dockerfile para el repo clonado de una app. Escribe el resultado en args.out
    (status=existing|generated|declined|unknown, port=...) para que bin/andamio-app siga."""
    d, out = Path(args.dir), Path(args.out)
    if (d / "Dockerfile").exists():
        ok(L("Tu repo ya tiene Dockerfile: lo uso tal cual.", "Your repo already has a Dockerfile: using it as is."))
        out.write_text(f"status=existing\nport={args.port}\n")
        return
    kind = detect_kind(d)
    if not kind:
        warn(L("Tu repo no tiene Dockerfile y no reconozco el lenguaje (busqué package.json, requirements.txt, "
               "pyproject.toml, go.mod, index.html). Escribe un Dockerfile y vuelve a correr.",
               "Your repo has no Dockerfile and I don't recognize the language (looked for package.json, "
               "requirements.txt, pyproject.toml, go.mod, index.html). Write a Dockerfile and run again."))
        out.write_text(f"status=unknown\nport={args.port}\n")
        return
    label, default_port = KINDS[kind]
    port = "8080" if kind == "static" else (args.port or default_port)
    note(L(f"Tu repo no tiene Dockerfile. Detecté: {label}. Te propongo uno listo para el pipeline "
           "(tests antes de desplegar, imagen final mínima y sin root).",
           f"Your repo has no Dockerfile. Detected: {label}. Here's one ready for the pipeline "
           "(tests before deploying, minimal final image, no root)."))
    values: dict[str, str] = {"PORT": port}
    if kind in ("node", "python"):
        extra, start = node_values(d) if kind == "node" else python_values(d)
        values.update(extra)
        print(L(f"  Tu app arrancará con:  \033[1m{start}\033[0m\n"
                f"  \033[2m(escucha en el puerto {port}: andamio le pasa $PORT={port})\033[0m",
                f"  Your app will start with:  \033[1m{start}\033[0m\n"
                f"  \033[2m(it listens on port {port}: andamio passes it $PORT={port})\033[0m"))
        if not ask_yes(L("¿Arranca así?", "Start it like this?"), True):
            while True:
                ans = ask(L("Comando que arranca tu app (como lo correrías en tu máquina; usa $PORT para el puerto)",
                            "Command that starts your app (as you'd run it locally; use $PORT for the port)"), "").strip()
                if ans.isdigit():   # respondieron un puerto: el comando sugerido ya usa $PORT
                    port = values["PORT"] = ans
                    ok(L(f"Puerto {port}, con el comando sugerido.", f"Port {port}, with the suggested command."))
                    break
                if ans:
                    start = ans
                    break
        values["START"] = start.replace("\\", "\\\\").replace('"', '\\"')
    elif kind == "go":
        values.update(go_values(d))
        note(L(f"Tu app tiene que escuchar en el puerto {port} (o leerlo de la variable PORT).",
               f"Your app must listen on port {port} (or read it from the PORT variable)."))
    text = render_dockerfile(kind, values)
    print("\n" + "\n".join(f"    \033[2m{x}\033[0m" for x in text.splitlines()) + "\n")
    if not ask_yes(L("¿Uso este Dockerfile? (se sube a tu repo al final, junto con el CI)",
                     "Use this Dockerfile? (it's pushed to your repo at the end, along with CI)"), True):
        out.write_text(f"status=declined\nport={args.port}\n")
        return
    (d / "Dockerfile").write_text(text)
    if not (d / ".dockerignore").exists():
        (d / ".dockerignore").write_text(DOCKERIGNORE[kind])
    out.write_text(f"status=generated\nport={port}\n")


# ================= update =================

# El extractor (tools/extraer-plataforma.py) pone aquí la URL del repo público de andamio.
UPSTREAM_DEFAULT = "https://github.com/Geovani29/andamio.git"
UPSTREAM_FILE = ROOT / ".andamio" / "upstream"
UPSTREAM_CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "andamio" / "upstream.git"
# Lo tuyo: andamio update nunca lo toca (fnmatch: * también cruza carpetas).
OWN = ["ansible/group_vars/*", "ansible/inventory.yml", "apps/*", "host/sops/*", "host/ssh/authorized_keys",
       "host/tls/*", ".sops.yaml", "*.sops", "*.sops.*", ".andamio/*"]


# Lo que corre en el servidor: si una actualización lo cambia, hay que aplicarla (andamio
# servidor). El resto (bin/, docs, plantillas de Dockerfile) es de tu máquina o del CI.
SERVER_SIDE = ("ansible/", "scripts/", "stacks/", "host/")


def git_bytes(*args: str, cwd: Path | None = None) -> bytes:
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, check=False)
    if r.returncode != 0:
        die(f"git {args[0]}: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def git_up(*args: str) -> str:
    return git_bytes(*args, cwd=UPSTREAM_CACHE).decode()


def is_platform(path: str) -> bool:
    import fnmatch
    return not any(fnmatch.fnmatch(path, pat) for pat in OWN)


def upstream_tree(sha: str) -> dict[str, tuple[str, str]]:
    """{ruta: (modo, blob)} de los archivos de la plataforma en ese commit de upstream."""
    out = {}
    for line in git_up("ls-tree", "-r", "--full-tree", sha).splitlines():
        meta, path = line.split("\t", 1)
        mode, kind, blob = meta.split()
        if kind == "blob" and is_platform(path):
            out[path] = (mode, blob)
    return out


_LOCAL: dict[str, str | None] = {}


def local_blob(path: str) -> str | None:
    """Hash git de tu archivo (como lo calcularía git), o None si no existe."""
    if path not in _LOCAL:
        f = ROOT / path
        _LOCAL[path] = git_bytes("hash-object", str(f)).decode().strip() if f.is_file() else None
    return _LOCAL[path]


def infer_base(commits: list[str]) -> str:
    """Repos creados desde el template no comparten historial con upstream: la base es el
    commit de upstream cuyos archivos más coinciden con los tuyos (empate: el más nuevo)."""
    best, score = commits[-1], -1
    for sha in commits:   # del más nuevo al más viejo
        tree = upstream_tree(sha)
        hits = sum(1 for p, (_, blob) in tree.items() if local_blob(p) == blob)
        if hits > score:
            best, score = sha, hits
    return best


def merge3(path: str, base_blob: str | None, new_blob: str) -> tuple[bytes, bool]:
    """Fusión de tres vías (tuyo, base, andamio). Devuelve (contenido, hubo_conflicto)."""
    tmp = Path(tempfile.mkdtemp(prefix="andamio-merge-"))
    try:
        files = {"tuyo": (ROOT / path).read_bytes(),
                 "base": git_bytes("cat-file", "blob", base_blob, cwd=UPSTREAM_CACHE) if base_blob else b"",
                 "andamio": git_bytes("cat-file", "blob", new_blob, cwd=UPSTREAM_CACHE)}
        if any(b"\0" in c for c in files.values()):   # binario: no se puede combinar
            return files["tuyo"], True
        for name, content in files.items():
            (tmp / name).write_bytes(content)
        r = subprocess.run(["git", "merge-file", "-p", "-L", L("tuyo", "yours"), "-L", "base", "-L", "andamio",
                            str(tmp / "tuyo"), str(tmp / "base"), str(tmp / "andamio")], capture_output=True, check=False)
        if r.returncode < 0:
            die(f"git merge-file {path}: {r.stderr.decode(errors='replace')}")
        return r.stdout, r.returncode > 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_update(args: argparse.Namespace) -> None:
    print(L("\033[1mandamio update\033[0m: trae las mejoras y los parches de andamio sin tocar tu "
            "configuración ni tus apps.",
            "\033[1mandamio update\033[0m: brings in andamio's improvements and patches without touching "
            "your configuration or your apps."))
    import yaml
    cfg = (yaml.safe_load(CONFIG.read_text()) or {}) if CONFIG.exists() else {}
    saved = dict(x.split(" ", 1) for x in UPSTREAM_FILE.read_text().splitlines() if " " in x) \
        if UPSTREAM_FILE.exists() else {}
    url = args.desde or cfg.get("andamio_upstream") or saved.get("url") or UPSTREAM_DEFAULT
    if url.startswith("@"):
        die(L("Este repo es la fuente de andamio (no viene de un template): no hay de dónde actualizar.",
              "This repo is andamio's source (it doesn't come from the template): nothing to update from."))
    if run(["git", "-C", str(ROOT), "status", "--porcelain"]).stdout.strip():
        die(L("Hay cambios sin commit (o archivos nuevos). Súbelos o descártalos antes: así `git diff` "
              "muestra solo lo que trae la actualización, y se puede deshacer entera.",
              "There are uncommitted changes (or new files). Commit or discard them first: that way "
              "`git diff` shows only what the update brings, and it can be undone entirely."))

    title(L("1. Traer la última versión de andamio", "1. Fetching the latest andamio"))
    if (UPSTREAM_CACHE / "HEAD").exists():
        git_up("remote", "set-url", "origin", url)
        git_up("fetch", "-q", "--prune", "origin", "+refs/heads/*:refs/heads/*")
    else:
        UPSTREAM_CACHE.parent.mkdir(parents=True, exist_ok=True)
        git_bytes("clone", "-q", "--bare", url, str(UPSTREAM_CACHE))
    new = git_up("rev-parse", "HEAD").strip()
    commits = git_up("rev-list", "HEAD").split()
    ok(f"{url} @ {new[:8]}")

    title(L("2. ¿De qué versión viene tu repo?", "2. Which version does your repo come from?"))
    base = saved.get("commit")
    if base not in commits:
        base = infer_base(commits)
        ok(L(f"{base[:8]} (deducida: es la versión que más se parece a tus archivos)",
             f"{base[:8]} (inferred: the version closest to your files)"))
    else:
        ok(f"{base[:8]} ({UPSTREAM_FILE.relative_to(ROOT)})")
    if base == new:
        ok(L("Ya estás al día.", "You're up to date."))
        return

    title(L("3. Qué trae", "3. What it brings"))
    for line in git_up("log", "--format=%h %s", f"{base}..{new}").splitlines()[:30]:
        mark = "\033[33m!\033[0m" if re.search(r"(?i)secur|segur|cve|vuln|fix|arregl", line) else " "
        print(f"  {mark} {line}")

    base_t, new_t = upstream_tree(base), upstream_tree(new)
    writes: dict[str, tuple[bytes | None, str]] = {}   # ruta -> (contenido o None = borrar, modo)
    report: dict[str, list[str]] = {k: [] for k in ("update", "add", "remove", "merged", "conflict", "kept")}
    for path in sorted(set(base_t) | set(new_t)):
        b, n, loc = base_t.get(path), new_t.get(path), local_blob(path)
        bb, nb = (b[1] if b else None), (n[1] if n else None)
        if loc == nb or bb == nb:          # ya está como upstream, o upstream no lo cambió (lo tuyo se respeta)
            continue
        if loc == bb:                      # no lo tocaste: va la versión nueva
            if nb is None:
                writes[path] = (None, "")
                report["remove"].append(path)
            else:
                writes[path] = (git_bytes("cat-file", "blob", nb, cwd=UPSTREAM_CACHE), n[0])
                report["add" if bb is None else "update"].append(path)
        elif nb is None or loc is None:    # lo cambiaste y andamio lo quitó, o lo borraste y andamio lo cambió
            report["kept"].append(path)
        else:                              # cambiaron los dos: combinar
            content, conflict = merge3(path, bb, nb)
            writes[path] = (content, n[0])
            report["conflict" if conflict else "merged"].append(path)

    labels = {
        "update": L("Actualizados", "Updated"), "add": L("Nuevos", "New"), "remove": L("Quitados", "Removed"),
        "merged": L("Combinados con tus cambios", "Merged with your changes"),
        "conflict": L("Con conflicto (tus cambios chocan con los de andamio)", "Conflicting (your changes clash with andamio's)"),
        "kept": L("Conservados como los tienes (andamio los quitó o tú los borraste)",
                  "Kept as you have them (andamio removed them or you deleted them)"),
    }
    title(L("4. Archivos", "4. Files"))
    for key, items in report.items():
        if items:
            print(f"  {labels[key]} ({len(items)}):")
            for p in items:
                print(f"      {p}")
    if not writes:
        ok(L("Nada que cambiar en tus archivos.", "Nothing to change in your files."))
    if args.check or (writes and not ask_yes(L("¿Aplicar?", "Apply?"), True)):
        note(L("No cambié nada.", "Nothing changed."))
        return

    for path, (content, mode) in writes.items():
        f = ROOT / path
        if content is None:
            f.unlink(missing_ok=True)
            continue
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_bytes(content)
        f.chmod(0o755 if mode == "100755" else 0o644)
    UPSTREAM_FILE.parent.mkdir(exist_ok=True)
    UPSTREAM_FILE.write_text(f"url {url}\ncommit {new}\n")

    title(L("Listo", "Done"))
    if report["conflict"]:
        warn(L("Resuelve los conflictos: busca las marcas <<<<<<< y >>>>>>> en los archivos de arriba y "
               "quédate con lo correcto de cada lado.",
               "Resolve the conflicts: look for the <<<<<<< and >>>>>>> markers in the files above and keep "
               "the right part of each side."))
    elif (how := choose(L("¿Lo subo ya? (commit y push; `git revert HEAD` lo deshace)",
                          "Push it now? (commit and push; `git revert HEAD` undoes it)"), [
            ("si", L(f"Sí, con el mensaje «andamio: actualización a {new[:8]}»",
                     f"Yes, with the message 'andamio: update to {new[:8]}'")),
            ("mensaje", L("Sí, escribo yo el mensaje", "Yes, I'll write the message")),
            ("no", L("No, primero lo reviso (git diff)", "No, I'll review it first (git diff)"))], "si")) != "no":
        msg = L(f"andamio: actualización a {new[:8]}", f"andamio: update to {new[:8]}")
        if how == "mensaje":
            msg = ask(L("Mensaje del commit", "Commit message"), msg)
        git = ["git", "-C", str(ROOT)]
        if (run([*git, "add", "-A"]).returncode == 0
                and run([*git, "commit", "-qm", msg]).returncode == 0
                and interactive([*git, "push", "-q"]) == 0):
            ok(L("Subido.", "Pushed."))
            server_side = [p for p in writes if p.startswith(SERVER_SIDE)]
            if server_side:
                note(L(f"Cambió lo que corre en el servidor ({len(server_side)} archivos, p. ej. {server_side[0]}): "
                       "aplícalo cuando quieras:  andamio servidor",
                       f"What runs on the server changed ({len(server_side)} files, e.g. {server_side[0]}): "
                       "apply it whenever you want:  andamio server"))
            else:
                note(L("Solo cambió andamio en tu máquina: no hay nada que aplicar en el servidor.",
                       "Only andamio on your machine changed: nothing to apply on the server."))
            return
        warn(L("No pude subirlo: hazlo a mano (abajo).", "Couldn't push it: do it by hand (below)."))
    note(L("""
Revisa lo que cambió y súbelo; después aplícalo en el servidor:
  git diff --stat          (git diff: el detalle; git reset --hard && git clean -fd: lo deshace todo)
  git add -A && git commit -m "andamio: actualización" && git push
  andamio servidor         (aplica lo nuevo)""", """
Review what changed and push it; then apply it on the server:
  git diff --stat          (git diff: details; git reset --hard && git clean -fd: undoes it all)
  git add -A && git commit -m "andamio: update" && git push
  andamio server           (applies what's new)"""))


# ================= estado =================

def port_open(ip: str, port: int, timeout: float = 3) -> bool:
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except OSError:
        return False


def tls_seen_from_internet(host: str) -> tuple[bool, str]:
    """El certificado como lo ve un navegador: cadena válida, nombre correcto y vigencia."""
    import ssl
    from datetime import datetime, timezone
    try:
        with socket.create_connection((host, 443), timeout=8) as s:
            with ssl.create_default_context().wrap_socket(s, server_hostname=host) as t:
                cert = t.getpeercert()
    except ssl.SSLCertVerificationError as e:
        return False, L(f"un navegador lo rechaza: {e.verify_message}", f"a browser rejects it: {e.verify_message}")
    except OSError as e:
        return False, L(f"no responde ({e})", f"no answer ({e})")
    expires = datetime.strptime(cert["notAfter"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    issuer = dict(x[0] for x in cert["issuer"]).get("organizationName", "?")
    days = (expires - datetime.now(timezone.utc)).days
    return True, L(f"válido para un navegador ({issuer}, {days} días)", f"valid for a browser ({issuer}, {days} days)")


def redirects_to_https(host: str) -> bool:
    import http.client
    try:
        c = http.client.HTTPConnection(host, 80, timeout=8)
        c.request("HEAD", "/")
        r = c.getresponse()
        return r.status in (301, 302, 307, 308) and (r.getheader("Location") or "").startswith("https://")
    except OSError:
        return False


def cmd_estado(args: argparse.Namespace) -> None:
    print(L("\033[1mandamio estado\033[0m: chequeo de seguridad y salud de tu servidor (no cambia nada).",
            "\033[1mandamio status\033[0m: security and health check of your server (changes nothing)."))
    cfg = load_config()
    alias = server_alias()
    if not ssh_ok([alias]):
        die(L(f"No entro al servidor ({alias}) por SSH: corre primero `bin/andamio servidor`.",
              f"Can't reach the server ({alias}) over SSH: run `bin/andamio server` first."))
    ip, ssh_port, domain = cfg["andamio_server_ip"], int(cfg["andamio_ssh_port"]), cfg["andamio_domain"]
    backups = str(cfg.get("andamio_backups", False)).lower() == "true"

    title(L("Desde el servidor", "From the server"))
    script = f"ANDAMIO_LANG={LANG} SSH_PORT={ssh_port} BACKUPS={'true' if backups else 'false'}\n" + \
        (ROOT / "scripts" / "security-check.sh").read_text()
    try:
        pw = sudo_password_file(cfg, alias).read_text()
        # sudo lee la primera línea (la contraseña); bash, el resto (el script). Nada en argv.
        r = run(["ssh", "-o", "BatchMode=yes", alias, "sudo -S -p '' bash -s"], input=pw + "\n" + script)
    finally:
        wipe_sudo()
    results, listening = [], []
    for line in r.stdout.splitlines():
        parts = line.split("|", 3)
        if parts[0] == "LISTEN":
            listening.append(int(parts[2]))
        elif parts[0] in ("OK", "WARN", "FAIL"):
            results.append((parts + ["", ""])[:4])
    if not results:
        die(L(f"El chequeo no corrió en el servidor: {r.stderr.strip()[-300:]}",
              f"The check didn't run on the server: {r.stderr.strip()[-300:]}"))

    # Desde Internet: lo que de verdad ve cualquiera (Docker puede saltarse UFW). Con la VPN
    # activa, tus conexiones entran por ella y el firewall las trata distinto: no valdrían.
    seen_as = remote(alias, 'echo "${SSH_CLIENT%% *}"').stdout.strip()
    on_vpn = seen_as.startswith("10.8.0.")
    if on_vpn:
        listening = []
    ssh_port_probe = not on_vpn
    net = []
    for port in sorted(set(listening) - {ssh_port, 80, 443}):
        if port_open(ip, port):
            net.append(["FAIL", "Internet", L(f"El puerto {port} responde desde Internet y andamio no lo usa",
                                              f"Port {port} answers from the internet and andamio doesn't use it"),
                        L(f"ciérralo: quita el servicio o su ports: en compose; ssh al servidor: sudo ss -tlnp 'sport = :{port}'",
                          f"close it: remove the service or its ports: in compose; on the server: sudo ss -tlnp 'sport = :{port}'")])
        else:
            net.append(["OK", "Internet", L(f"El puerto {port} escucha, pero el firewall lo bloquea desde Internet",
                                            f"Port {port} listens, but the firewall blocks it from the internet"), ""])
    if ssh_port != 22 and ssh_port_probe:
        net.append(["FAIL", "Internet", L("El puerto 22 responde desde Internet", "Port 22 answers from the internet"),
                    L("ciérralo en el firewall de tu proveedor (y revisa sudo ufw status)",
                      "close it in your provider's firewall (and check sudo ufw status)")]
                   if port_open(ip, 22) else
                   ["OK", "Internet", L("El puerto 22 está cerrado (SSH solo en el tuyo)",
                                        "Port 22 is closed (SSH only on yours)"), ""])
    # Let's Encrypt (modo http) valida por el 80, y la redirección a HTTPS vive ahí.
    if not port_open(ip, 80):
        net.append(["FAIL", "Internet", L("El puerto 80 no responde desde Internet: Let's Encrypt y la redirección a HTTPS lo necesitan",
                                          "Port 80 doesn't answer from the internet: Let's Encrypt and the HTTPS redirect need it"),
                    L("ábrelo en el firewall de tu proveedor (TCP 80); después: ssh " + alias + " docker restart traefik",
                      "open it in your provider's firewall (TCP 80); then: ssh " + alias + " docker restart traefik")])
    host = f"whoami.{domain}"
    good, msg = tls_seen_from_internet(host)
    net.append(["OK", "Internet", L(f"HTTPS de {host}: {msg}", f"HTTPS of {host}: {msg}"), ""] if good else
               ["FAIL", "Internet", L(f"HTTPS de {host}: {msg}", f"HTTPS of {host}: {msg}"),
                L("revisa el DNS (A y *.dominio) y docker logs traefik", "check the DNS (A and *.domain) and docker logs traefik")])
    net.append(["OK", "Internet", L("HTTP redirige a HTTPS", "HTTP redirects to HTTPS"), ""] if redirects_to_https(host) else
               ["WARN", "Internet", L("HTTP no redirige a HTTPS", "HTTP doesn't redirect to HTTPS"),
                L("revisa stacks/proxy/traefik.yml (entryPoint web)", "check stacks/proxy/traefik.yml (entryPoint web)")])

    icon = {"OK": "\033[32m✓\033[0m", "WARN": "\033[33m!\033[0m", "FAIL": "\033[31m✗\033[0m"}
    for i, (status, area, what, fix) in enumerate(results + net):
        if i == len(results):
            title(L("Desde Internet", "From the internet"))
            if on_vpn:
                warn(L("Tu PC está conectada a la VPN del servidor: las pruebas de puertos desde Internet no "
                       "serían reales. Desconéctala y vuelve a correr `andamio estado` para hacerlas.",
                       "Your PC is connected to the server's VPN: port tests from the internet wouldn't be "
                       "real. Disconnect it and run `andamio status` again to run them."))
        print(f"  {icon[status]} {area:<13} {what}")
        if fix and status != "OK":
            print(f"    \033[2m→ {fix}\033[0m")
    every = [x[0] for x in results + net]
    title(L(f"{every.count('OK')} bien · {every.count('WARN')} avisos · {every.count('FAIL')} problemas",
            f"{every.count('OK')} good · {every.count('WARN')} warnings · {every.count('FAIL')} problems"))
    if "FAIL" in every:
        sys.exit(1)


def cmd_certificado(args: argparse.Namespace) -> None:
    cfg = load_config()
    cmd = L("certificado", "certificate")
    if not args.cert:
        title(L("Tu certificado (andamio_tls: custom)", "Your certificate (andamio_tls: custom)"))
        if not TLS_CERT.exists():
            die(L(f"No hay certificado propio en {TLS_CERT.relative_to(ROOT)}. Agrega uno con: "
                  f"bin/andamio {cmd} <certificado> <llave>",
                  f"No custom certificate in {TLS_CERT.relative_to(ROOT)}. Add one with: "
                  f"bin/andamio {cmd} <certificate> <key>"))
        info = cert_info(TLS_CERT)
        show_cert(info)
        for p in cert_warnings(info, cfg.get("andamio_domain", "")):
            warn(p)
        if cfg.get("andamio_tls") != "custom":
            warn(L(f"Tu configuración usa andamio_tls: {cfg.get('andamio_tls')}: este certificado no se está usando.",
                   f"Your configuration uses andamio_tls: {cfg.get('andamio_tls')}: this certificate isn't in use."))
        return
    if not args.key:
        die(L(f"Falta la llave: bin/andamio {cmd} <certificado> <llave>", f"The key is missing: bin/andamio {cmd} <certificate> <key>"))
    if not shutil.which("openssl"):
        die(L("Falta openssl: sudo apt install openssl  |  brew install openssl",
              "openssl is missing: sudo apt install openssl  |  brew install openssl"))

    title(L("1. Revisar el certificado nuevo", "1. Checking the new certificate"))
    error = cert_problem(args.cert) or key_problem(local_path(args.cert), args.key)
    if error:
        die(error)
    cert, key = local_path(args.cert), local_path(args.key)
    info = cert_info(cert)
    show_cert(info)
    problems = cert_warnings(info, cfg.get("andamio_domain", ""))
    for p in problems:
        warn(p)
    if problems and not ask_yes(L("¿Usarlo igual?", "Use it anyway?"), False):
        die(L("Cancelado: no cambié nada.", "Cancelled: nothing changed."))

    title(L("2. Guardarlo en tu configuración", "2. Saving it in your configuration"))
    if cfg.get("andamio_tls") != "custom":
        warn(L(f"Hoy usas andamio_tls: {cfg.get('andamio_tls')} (Let's Encrypt).",
               f"You currently use andamio_tls: {cfg.get('andamio_tls')} (Let's Encrypt)."))
        if not ask_yes(L("¿Cambiar a tu certificado (andamio_tls: custom)?", "Switch to your certificate (andamio_tls: custom)?"), False):
            die(L("Cancelado: no cambié nada.", "Cancelled: nothing changed."))
        set_config("andamio_tls", "custom")
        ok("andamio_tls: custom")
    install_cert(cert, key)

    title(L("Listo. Para usarlo en el servidor", "Done. To use it on the server"))
    note(L(f"""
git add {TLS_CERT.relative_to(ROOT)} {TLS_KEY.relative_to(ROOT)} {CONFIG.relative_to(ROOT)}
git commit -m "andamio: certificado nuevo (vence {info['expires']})" && git push
ansible/hl aplicar andamio
Traefik se reinicia solo para cargarlo (unos segundos sin servicio).""", f"""
git add {TLS_CERT.relative_to(ROOT)} {TLS_KEY.relative_to(ROOT)} {CONFIG.relative_to(ROOT)}
git commit -m "andamio: new certificate (expires {info['expires']})" && git push
ansible/hl apply andamio
Traefik restarts by itself to load it (a few seconds of downtime)."""))


# ================= comando global =================

# `andamio` en cualquier carpeta: un lanzador en ~/.local/bin elige la copia (la de la carpeta
# actual, o la elegida con `andamio use`). Cada copia se anota sola al usarse.
COPIES_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "andamio"
COPIES, CURRENT = COPIES_DIR / "copias", COPIES_DIR / "actual"
GLOBAL_CMD = Path.home() / ".local" / "bin" / "andamio"
SHIM_MARK = "# andamio: comando global"
SHIM = f"""#!/usr/bin/env bash
{SHIM_MARK} (lo instala bin/andamio; se reescribe solo). Usa la copia de andamio de la
# carpeta donde estás (o de una carpeta de arriba); afuera de una, la elegida con `andamio use`.
d=$PWD
while [ "$d" != / ]; do
  if [ -x "$d/bin/andamio" ] && [ -f "$d/ansible/site.yml" ]; then exec "$d/bin/andamio" "$@"; fi
  d=$(dirname "$d")
done
c=$(cat "${{XDG_CONFIG_HOME:-$HOME/.config}}/andamio/actual" 2> /dev/null)
if [ -n "$c" ] && [ -x "$c/bin/andamio" ]; then exec "$c/bin/andamio" "$@"; fi
if [[ ${{ANDAMIO_LANG:-${{LANG:-}}}} == es* ]]; then
  echo "✗ No sé qué copia de andamio usar: entra a su carpeta, o corre ahí: bin/andamio use" >&2
else
  echo "✗ Don't know which andamio copy to use: cd into its folder, or run there: bin/andamio use" >&2
fi
exit 1
"""


def known_copies() -> list[Path]:
    paths = COPIES.read_text().splitlines() if COPIES.exists() else []
    return [Path(p) for p in dict.fromkeys(paths) if p and (Path(p) / "ansible" / "group_vars" / "all.yml").exists()]


def remember_copy() -> None:
    """Anota esta copia (si ya tiene configuración) e instala o pone al día el lanzador global."""
    try:
        if CONFIG.exists():
            COPIES_DIR.mkdir(parents=True, exist_ok=True)
            copies = known_copies()
            if ROOT not in copies:
                COPIES.write_text("".join(f"{p}\n" for p in [*copies, ROOT]))
            if not CURRENT.exists() or not (Path(CURRENT.read_text().strip()) / "bin" / "andamio").exists():
                CURRENT.write_text(f"{ROOT}\n")
        current = GLOBAL_CMD.read_text() if GLOBAL_CMD.exists() else None
        if current == SHIM or (current is not None and SHIM_MARK not in current):
            return   # ya está al día, o ese archivo no es nuestro: no se toca
        GLOBAL_CMD.parent.mkdir(parents=True, exist_ok=True)
        GLOBAL_CMD.write_text(SHIM)
        GLOBAL_CMD.chmod(0o755)
        if current is None:
            ok(L("Instalé el comando `andamio`: desde ahora funciona en cualquier carpeta (en una terminal nueva).",
                 "Installed the `andamio` command: it now works from any folder (in a new terminal)."))
    except OSError:
        pass   # sin el lanzador, bin/andamio sigue funcionando igual


def copy_label(p: Path) -> str:
    import yaml
    try:
        cfg = yaml.safe_load((p / "ansible" / "group_vars" / "all.yml").read_text()) or {}
    except (OSError, yaml.YAMLError):
        cfg = {}
    return f"{cfg.get('andamio_domain') or '?'}  ({cfg.get('andamio_server_ip') or '?'})"


def cmd_use(args: argparse.Namespace) -> None:
    copies = known_copies()
    current = Path(CURRENT.read_text().strip()) if CURRENT.exists() else None
    if args.copia:
        want = args.copia.rstrip("/")
        p = Path(want).expanduser()
        target = p.resolve() if (p / "ansible" / "group_vars" / "all.yml").exists() else next(
            (c for c in copies if want in (c.name, str(c)) or copy_label(c).split()[0] == want), None)
        if not target:
            die(L(f"No encuentro una copia de andamio en «{want}» (ni con ese dominio). Mira la lista: andamio use",
                  f"No andamio copy at '{want}' (nor with that domain). See the list: andamio use"))
        COPIES_DIR.mkdir(parents=True, exist_ok=True)
        CURRENT.write_text(f"{target}\n")
        if target not in copies:
            COPIES.write_text("".join(f"{c}\n" for c in [*copies, target]))
        ok(L(f"Fuera de sus carpetas, `andamio` usa {target}: {copy_label(target)}",
             f"Outside their folders, `andamio` uses {target}: {copy_label(target)}"))
        return
    if not copies:
        note(L("Todavía no hay copias con configuración (se anotan al correr bin/andamio init).",
               "No copies with a configuration yet (they're noted when you run bin/andamio init)."))
        return
    print(L("Tus copias de andamio (● = la que usa `andamio` fuera de sus carpetas):",
            "Your andamio copies (● = the one `andamio` uses outside their folders):"))
    for c in copies:
        print(f"  {'●' if c == current else ' '} {c}   {copy_label(c)}")
    note(L("Cambiar: andamio use <carpeta o dominio>. Dentro de la carpeta de una copia, andamio usa esa.",
           "Switch: andamio use <folder or domain>. Inside a copy's folder, andamio uses that one."))


def overview() -> None:
    """`andamio`, `andamio help`: todos los comandos, en el orden en que se usan."""
    banner()
    b = lambda t: f"\033[1m{t}\033[0m"   # noqa: E731
    d = lambda t: f"\033[2m{t}\033[0m"   # noqa: E731
    print(L(f"""{b('andamio')}: tu VPS seguro y tus apps desplegadas, desde este repo.

{b('Empezar')} {d('(una vez, en este orden)')}
  setup                        deja tu máquina lista: instala git, gh, sops, age, ansible...
  init                         preguntas guiadas: configuración, llave de cifrado, secretos (solo local)
  servidor                     prepara el VPS: usuario propio, SSH, firewall, VPN, Traefik, monitoreo
  backups                      backups diarios cifrados fuera del servidor (B2 o S3), con prueba

{b('Tus apps')} {d('(cada una queda en https://<app>.tudominio)')}
  app create <app> --repo <dueño/repo> [--public] [--db] [--redis] [--host <sub>|@] [--health /ruta]
                               la registra (una vez); desde ahí cada git push a main la despliega
                               {d('URL: <app>.tudominio · --host api → api.tudominio · --host @ → tudominio')}
                               {d('     otro dominio o más niveles (v2.api.tudominio): app domain add')}
  app list                     todas, con su URL y estado
  app logs <app>               logs en vivo
  app secret set|rm|list <app> [CLAVE]      variables y secretos (el valor se pide oculto)
                               {d('--later: guarda sin aplicar; después, una vez: app apply <app>')}
  app apply [<app>]            aplica lo pendiente en el servidor (y reintenta un deploy fallido)
  app domain add|rm|list <app> [dominio]    un dominio propio además de <app>.tudominio
  app cors add|rm|list <app> [origen]       frontend en otro lado (Vercel...)
  app stop|start <app>         apagarla sin borrar nada / volver
  app rollback <app>           volver al deploy anterior
  app destroy <app>            borrarla (respalda su base antes)

{b('Día a día')}
  estado                       chequeo de seguridad y salud, desde el servidor y desde Internet
  update [--check]             trae mejoras y parches de andamio sin tocar lo tuyo
  certificado [cert llave]     tu propio certificado HTTPS: ver o reemplazar
  servidor                     también sirve para reaplicar todo (se puede repetir)
  use [carpeta|dominio]        con varios servidores: cuál usa `andamio` fuera de sus carpetas
  olvidar                      borra ya tu contraseña de sudo (se recuerda 15 min sin uso, solo en memoria)

{d('`andamio` funciona en cualquier carpeta: dentro de una copia usa esa; afuera, la de `andamio use`.')}
{d('Detalle de un comando: andamio help <comando>     Idioma: ANDAMIO_LANG=es|en')}
{d('Los nombres en inglés también funcionan: server, status, certificate.')}""",
            f"""{b('andamio')}: your secure VPS and your deployed apps, from this repo.

{b('Getting started')} {d('(once, in this order)')}
  setup                        gets your machine ready: installs git, gh, sops, age, ansible...
  init                         guided questions: configuration, encryption key, secrets (local only)
  server                       sets up the VPS: own user, SSH, firewall, VPN, Traefik, monitoring
  backups                      daily encrypted off-server backups (B2 or S3), tested

{b('Your apps')} {d('(each one lives at https://<app>.yourdomain)')}
  app create <app> --repo <owner/repo> [--public] [--db] [--redis] [--host <sub>|@] [--health /path]
                               registers it (once); from then on every git push to main deploys it
                               {d('URL: <app>.yourdomain · --host api → api.yourdomain · --host @ → yourdomain')}
                               {d('     another domain or deeper (v2.api.yourdomain): app domain add')}
  app list                     all of them, with URL and status
  app logs <app>               live logs
  app secret set|rm|list <app> [KEY]        variables and secrets (the value is asked hidden)
                               {d('--later: save without applying; then, once: app apply <app>')}
  app apply [<app>]            applies what's pending on the server (and retries a failed deploy)
  app domain add|rm|list <app> [domain]     an own domain besides <app>.yourdomain
  app cors add|rm|list <app> [origin]       frontend hosted elsewhere (Vercel...)
  app stop|start <app>         turn it off without deleting anything / back on
  app rollback <app>           back to the previous deploy
  app destroy <app>            delete it (backs up its database first)

{b('Day to day')}
  status                       security and health check, from the server and from the internet
  update [--check]             brings in andamio's improvements and patches, never touching yours
  certificate [cert key]       your own HTTPS certificate: show or replace
  server                       also re-applies everything (safe to repeat)
  use [folder|domain]          with several servers: which one `andamio` uses outside their folders
  forget                       wipes your sudo password now (remembered 15 idle min, in memory only)

{d('`andamio` works from any folder: inside a copy it uses that one; elsewhere, the one from `andamio use`.')}
{d('Details of a command: andamio help <command>     Language: ANDAMIO_LANG=en|es')}
{d('Spanish names work too: servidor, estado, certificado.')}"""))


def main() -> None:
    args = sys.argv[1:]
    if not (args and args[0].startswith("_")):   # los internos los llama otro comando de andamio
        remember_copy()
    if not args or args[0] in ("help", "ayuda", "-h", "--help"):
        if len(args) < 2:
            overview()
            return
        args = [args[1], "--help"]   # andamio help <comando>
    # `andamio app ...`: el mini-PaaS de apps vive en bin/andamio-app (bash); se le pasa tal cual.
    if args[0] == "app":
        os.execv(str(ROOT / "bin" / "andamio-app"), [str(ROOT / "bin" / "andamio-app"), *args])
    if args[0] == "_scaffold":   # interno (andamio app create): _scaffold <dir> <puerto|""> <salida>
        cmd_scaffold(argparse.Namespace(dir=args[1], port=args[2], out=args[3]))
        return
    if args[0] == "_apply":      # interno (andamio app ...): aplica la plataforma en el servidor
        # Con una app: solo esa (segundos); sin ella, la plataforma entera.
        app = args[1] if len(args) > 1 else ""
        if app and not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", app):
            die(L(f"Nombre de app inválido: {app}", f"Invalid app name: {app}"))
        playbook = ["una-app.yml", "-e", f"andamio_app_name={app}"] if app else ["site.yml", "--tags", "andamio"]
        cfg, alias = load_config(), server_alias()
        try:
            rc = ansible(playbook, cfg, alias)
        finally:
            wipe_sudo()
        sys.exit(rc)
    known = {"setup", "init", "servidor", "server", "estado", "status", "backups", "update", "actualizar",
             "certificado", "certificate", "use", "usar", "olvidar", "forget"}
    if args[0] not in known:
        die(L(f"Comando desconocido: {args[0]}. Mira `andamio help`.", f"Unknown command: {args[0]}. See `andamio help`."))
    parser = argparse.ArgumentParser(prog="andamio", description=L(
        "andamio: prepara tu configuración y tu VPS.", "andamio: sets up your configuration and your VPS."))
    sub = parser.add_subparsers(dest="cmd", required=True)
    _add = sub.add_parser
    sub.add_parser = lambda *a, **kw: _add(*a, description=kw.get("help"), **kw)  # type: ignore[method-assign]
    p_setup = sub.add_parser("setup", help=L("deja tu máquina lista: instala lo que falta (una vez)",
                                             "gets your machine ready: installs what's missing (once)"))
    p_setup.set_defaults(func=cmd_setup)
    p_init = sub.add_parser("init", help=L("configuración guiada (parte 1, local)", "guided configuration (part 1, local)"))
    p_init.add_argument("--force", action="store_true",
                        help=L("completar una configuración existente", "fill in an existing configuration"))
    p_init.set_defaults(func=cmd_init)
    p_srv = sub.add_parser("servidor", aliases=["server"],
                           help=L("prepara el VPS (parte 2; se puede repetir)", "sets up the VPS (part 2; safe to repeat)"))
    p_srv.set_defaults(func=cmd_servidor)
    p_st = sub.add_parser("estado", aliases=["status"],
                          help=L("chequeo de seguridad y salud del servidor", "security and health check of the server"))
    p_st.set_defaults(func=cmd_estado)
    p_bk = sub.add_parser("backups", help=L("backups diarios cifrados fuera del servidor (B2 o S3), con prueba",
                                            "daily encrypted off-server backups (B2 or S3), tested"))
    p_bk.set_defaults(func=cmd_backups)
    sub.add_parser("app", help=L("tus apps: create, secret, list, logs, rollback, destroy (andamio app para ver cómo)",
                                 "your apps: create, secret, list, logs, rollback, destroy (andamio app to see how)"))
    p_up = sub.add_parser("update", aliases=["actualizar"],
                          help=L("trae mejoras y parches de andamio sin tocar tu configuración ni tus apps",
                                 "brings in andamio's improvements and patches without touching your config or apps"))
    p_up.add_argument("--check", action="store_true", help=L("solo muestra qué cambiaría", "only show what would change"))
    p_up.add_argument("--from", dest="desde", metavar="URL",
                      help=L("repo de andamio de donde traer (por defecto, el oficial)",
                             "andamio repo to fetch from (default: the official one)"))
    p_up.set_defaults(func=cmd_update)
    p_cert = sub.add_parser("certificado", aliases=["certificate"],
                            help=L("tu propio certificado HTTPS: ver el actual o reemplazarlo",
                                   "your own HTTPS certificate: show the current one or replace it"))
    p_cert.add_argument("cert", nargs="?", help=L("certificado PEM (con los intermedios de tu CA)",
                                                  "PEM certificate (with your CA's intermediates)"))
    p_cert.add_argument("key", nargs="?", help=L("su llave privada PEM", "its PEM private key"))
    p_cert.set_defaults(func=cmd_certificado)
    p_use = sub.add_parser("use", aliases=["usar"],
                           help=L("con varios servidores: qué copia usa `andamio` fuera de sus carpetas",
                                  "with several servers: which copy `andamio` uses outside their folders"))
    p_use.add_argument("copia", nargs="?", metavar=L("carpeta|dominio", "folder|domain"),
                       help=L("la copia a usar; sin nada, la lista", "the copy to use; with nothing, the list"))
    p_use.set_defaults(func=cmd_use)
    p_forget = sub.add_parser("olvidar", aliases=["forget"],
                              help=L("borra ya la contraseña de sudo recordada", "wipes the remembered sudo password now"))
    p_forget.set_defaults(func=lambda _: (forget_sudo(), ok(L("Contraseña de sudo olvidada.", "Sudo password forgotten."))))
    ns = parser.parse_args(args)
    ns.func(ns)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:   # Ctrl+C: sin traza de Python
        sys.stdout.write("\033[?25h")   # por si se cortó dentro de un menú
        print(L("\n\n✗ Cancelado. Lo que ya estaba hecho se queda; vuelve a correr el comando cuando quieras: retoma donde quedó.",
                "\n\n✗ Cancelled. What was already done stays; run the command again whenever you want: it resumes where it stopped."),
              file=sys.stderr)
        sys.exit(130)
