#!/usr/bin/env python3
"""forge: lo que andamio necesita de la forja donde viven tus repos (hoy GitHub).

Una operación por subcomando, con salida simple, para que la usen igual bin/andamio,
bin/andamio-app y Ansible. Para soportar otra forja (GitLab, Gitea...) basta con otra clase
con los mismos métodos y su pipeline de CI; nada más de andamio cambia.

  forge name                               su nombre para mostrar (p. ej. GitHub)
  forge tools                              herramientas que necesita, con cómo instalarlas
  forge auth-ok                            ¿la CLI de la forja tiene sesión iniciada?
  forge whoami                             tu usuario
  forge repo-exists DUEÑO/REPO             código de salida 0 si existe y tienes acceso
  forge repo-private DUEÑO/REPO            código de salida 0 si es privado
  forge repo-create DUEÑO/REPO PLANTILLA   repo privado desde una plantilla (espera a main)
  forge repo-create-empty DUEÑO/REPO       repo privado vacío (para subir una copia que ya existe)
  forge clone-url DUEÑO/REPO               URL SSH para clonar
  forge ssh-host                           host SSH de git (para ~/.ssh/config)
  forge known-hosts                        sus llaves de host SSH (para known_hosts)
  forge deploy-key-has DUEÑO/REPO TÍTULO [ARCHIVO.pub]   0 si ya la tiene (título o llave)
  forge deploy-key-add DUEÑO/REPO TÍTULO ARCHIVO.pub   deploy key de SOLO LECTURA
  forge secret-set DUEÑO/REPO NOMBRE       secreto de CI; el valor llega por stdin
  forge vars-get DUEÑO/REPO                variables de CI como JSON {nombre: valor}
  forge var-set DUEÑO/REPO NOMBRE VALOR    variable de CI (no secreta)
  forge ci-allow-reuse DUEÑO/REPO          permite que tus otros repos usen su pipeline
  forge default-branch DUEÑO/REPO          su rama principal (main, production…)
  forge pr-create DUEÑO/REPO BASE RAMA TÍTULO   abre un PR (el cuerpo por stdin) y dice su URL
  forge ci-snippet DUEÑO/REPO VERSIÓN [--branch B] [--app A --dir D [--context C] [--watch P]...] [--inherit]
                                           el archivo de CI que una app agrega para desplegar
                                           (con --app: una de varias apps del repo, en su carpeta;
                                           --inherit: secretos a la antigua, para app-build-v11 o antes)
  forge ci-watch [DUEÑO/REPO [SHA]]        sigue la corrida de ese commit (o la última)
  forge ci-last-failed DUEÑO/REPO          id de la última corrida de main si falló (si no, nada)
  forge ci-runs DUEÑO/REPO [N]             las últimas N corridas de main (deploys; 8), como JSON
  forge repos                              tus repos (nombre, privado, actualizado), como JSON
  forge ci-repin DIR DUEÑO/REPO SHA        el pipeline de la app clonada en DIR, a esa versión
  forge ci-rerun DUEÑO/REPO ID             la reintenta y la sigue
  forge ci-failure DUEÑO/REPO ID           por qué falló una corrida (pasos, últimas líneas, pistas), como JSON
  forge ci-jobs DUEÑO/REPO ID              sus jobs y pasos, con estado y tiempos (el progreso en vivo), como JSON
  forge registry                           registro de imágenes (p. ej. ghcr.io)
  forge registry-name                      su nombre para mostrar (p. ej. GHCR)
  forge registry-token-help                cómo crear un token de solo lectura de imágenes
  forge registry-token-check               valida el token (por stdin); el problema, si hay

Con varias apps en un repo, ci-watch, ci-last-failed y ci-runs aceptan --workflow ARCHIVO
(p. ej. andamio-api.yml): solo las corridas de esa app. ci-last-failed y ci-runs aceptan
--branch RAMA (la que despliega; main si no se dice).
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "ansible" / "group_vars" / "all.yml"


# Idioma: el que decidió bin/andamio (ANDAMIO_LANG), o el del sistema.
LANG = "es" if (os.environ.get("ANDAMIO_LANG") or os.environ.get("LANG") or "").lower().startswith("es") else "en"


def L(es: str, en: str) -> str:
    return es if LANG == "es" else en


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True, **kw)


def fail(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    sys.exit(code)


def watch_pattern(w: str) -> str:
    """Una ruta del repo como patrón de GitHub Actions: una carpeta (backend, packages/) cubre todo lo
    de adentro; un archivo (package.json) o un patrón con * quedan como están."""
    w = w.strip().lstrip("/")
    if "*" in w or (not w.endswith("/") and "." in w.rsplit("/", 1)[-1]):
        return w
    return w.rstrip("/") + "/**"


# Cómo el CI de una app le pasa sus secretos (la llave de deploy, los de build_secrets) al pipeline.
INHERIT_LINE = "    secrets: inherit"


def secrets_block() -> str:
    """Explícitos y no 'inherit': inherit no cruza de dueño (una app tuya con el pipeline público)."""
    return (f"""    # {L("La llave de deploy y los de build_secrets. Explícitos y no 'inherit': inherit no cruza de dueño.",
                 "The deploy key and the build_secrets ones. Explicit, not 'inherit': inherit doesn't cross owners.")}
    secrets:
      ANDAMIO_SECRETS: ${{{{ toJSON(secrets) }}}}""")


class GitHub:
    """GitHub con la CLI oficial `gh`. Imágenes en GHCR; pipeline en GitHub Actions."""

    name = "GitHub"
    tools = {"gh": "https://cli.github.com  (y luego: gh auth login)"}

    def gh(self, *args: str, **kw) -> subprocess.CompletedProcess:
        return run(["gh", *args], **kw)

    def auth_ok(self) -> bool:
        return self.gh("auth", "status").returncode == 0

    def whoami(self) -> str:
        return self.gh("api", "user", "-q", ".login").stdout.strip()

    def repo_exists(self, repo: str) -> bool:
        return self.gh("repo", "view", repo, "--json", "name").returncode == 0

    def repo_private(self, repo: str) -> bool:
        r = self.gh("repo", "view", repo, "--json", "visibility", "-q", ".visibility")
        return r.returncode == 0 and r.stdout.strip() != "PUBLIC"

    def repo_create(self, repo: str, template: str) -> None:
        r = self.gh("repo", "create", repo, "--private", "--template", template, "--clone=false")
        if r.returncode != 0:
            fail(r.stderr.strip())
        # GitHub copia la plantilla en segundo plano: esperar a que exista main.
        for _ in range(15):
            if self.gh("api", f"repos/{repo}/branches/main").returncode == 0:
                return
            time.sleep(2)
        fail(L(f"{repo} se creó, pero main no apareció en 30 s", f"{repo} was created, but main didn't show up in 30 s"))

    def repo_create_empty(self, repo: str) -> None:
        r = self.gh("repo", "create", repo, "--private", "--clone=false")
        if r.returncode != 0:
            fail(r.stderr.strip())

    def clone_url(self, repo: str) -> str:
        return f"git@github.com:{repo}.git"

    def ssh_host(self) -> str:
        return "github.com"

    def known_hosts(self) -> str:
        r = self.gh("api", "meta", "-q", '.ssh_keys[] | "github.com " + .')
        if "github.com ssh-" not in r.stdout:
            fail(L("No pude leer las llaves de host de GitHub (gh api meta).", "Couldn't read GitHub's host keys (gh api meta)."))
        return r.stdout.strip()

    def deploy_key_has(self, repo: str, title: str, pubfile: str | None = None) -> bool:
        """Por título, o por la llave misma si se pasa (aunque alguien la renombrara)."""
        r = self.gh("repo", "deploy-key", "list", "--repo", repo, "--json", "title,key")
        keys = json.loads(r.stdout or "[]") if r.returncode == 0 else []
        body = Path(pubfile).read_text().split()[1] if pubfile else None
        return any(k["title"] == title or (body and body in k["key"]) for k in keys)

    def deploy_key_add(self, repo: str, title: str, pubfile: str) -> None:
        # Sin --allow-write: la llave solo puede leer.
        r = self.gh("repo", "deploy-key", "add", pubfile, "--repo", repo, "--title", title)
        if r.returncode != 0:
            fail(r.stderr.strip())

    def secret_set(self, repo: str, name: str, value: str) -> None:
        r = self.gh("secret", "set", name, "--repo", repo, input=value)
        if r.returncode != 0:
            fail(r.stderr.strip())

    def vars_get(self, repo: str) -> dict[str, str]:
        r = self.gh("variable", "list", "--repo", repo, "--json", "name,value")
        if r.returncode != 0:
            fail(r.stderr.strip())
        return {v["name"]: v["value"] for v in json.loads(r.stdout or "[]")}

    def var_set(self, repo: str, name: str, value: str) -> None:
        r = self.gh("variable", "set", name, "--repo", repo, "--body", value)
        if r.returncode != 0:
            fail(r.stderr.strip())

    def ci_allow_reuse(self, repo: str) -> bool:
        """Un workflow reutilizable de un repo privado solo lo pueden usar tus otros repos
        si se permite en Settings → Actions → Access. True si hubo que cambiarlo."""
        if not self.repo_private(repo):
            return False
        api = f"repos/{repo}/actions/permissions/access"
        if self.gh("api", api, "-q", ".access_level").stdout.strip() != "none":
            return False
        r = self.gh("api", "-X", "PUT", api, "-f", "access_level=user")
        if r.returncode != 0:
            fail(r.stderr.strip())
        return True

    def pr_create(self, repo: str, base: str, head: str, title: str, body: str) -> str:
        r = self.gh("pr", "create", "--repo", repo, "--base", base, "--head", head, "--title", title, "--body", body)
        if r.returncode != 0:
            fail(r.stderr.strip())
        return r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ""

    def default_branch(self, repo: str) -> str:
        r = self.gh("repo", "view", repo, "--json", "defaultBranchRef", "-q", ".defaultBranchRef.name")
        return r.stdout.strip() or "main"

    def ci_snippet(self, repo: str, version: str, app: str = "", dir: str = "", context: str = "",
                   watch: list[str] | None = None, branch: str = "main", inherit: bool = False) -> str:
        """inherit: para versiones del pipeline anteriores a ANDAMIO_SECRETS (app-build-v11 y antes)."""
        if not app:
            head, image, extra = "andamio.yml", "${{ github.event.repository.name }}", ""
            on = f"""  push: {{ branches: [{branch}] }}
  pull_request: {{ branches: [{branch}] }}"""
        else:
            # Una de varias apps del repo: su carpeta, su imagen, su llave, y solo corre si cambió
            # algo suyo (o este archivo).
            # Su carpeta siempre; --watch suma otras rutas (packages/, un archivo). Si se construye desde
            # la raíz, también los manifiestos de la raíz: una dependencia compartida que cambia la redespliega.
            root = ["package.json", "pnpm-lock.yaml", "package-lock.json", "yarn.lock", "pnpm-workspace.yaml",
                    ".nvmrc", ".node-version", "go.work"] if context == "." else []
            paths = list(dict.fromkeys(watch_pattern(w) for w in [dir, *(watch or []), *root] if w and w != "."))
            paths.append(f".github/workflows/andamio-{app}.yml")
            plist = ", ".join(f'"{x}"' for x in paths)
            head, image = f"andamio-{app}.yml", app
            on = f"""  push: {{ branches: [{branch}], paths: [{plist}] }}
  pull_request: {{ branches: [{branch}], paths: [{plist}] }}"""
            extra = f"""
      dir: {dir}""" + (f"""
      context: {context}""" if context else "") + f"""
      deploy_key: DEPLOY_SSH_KEY_{app.upper().replace('-', '_')}"""
        return f"""# .github/workflows/{head}
name: {"CI/CD" if not app else f"CI/CD {app}"}
on:
{on}
jobs:
  build:
    uses: {repo}/.github/workflows/app-build.yml@{version}
    permissions: {{ contents: read, packages: write }}
    with:
      image: {image}{extra}
      deploy: true
      deploy_host: ${{{{ vars.DEPLOY_HOST }}}}
      deploy_port: ${{{{ vars.DEPLOY_PORT }}}}
      deploy_user: ${{{{ vars.DEPLOY_USER }}}}
      deploy_known_hosts: ${{{{ vars.DEPLOY_KNOWN_HOSTS }}}}
      runner: ${{{{ vars.RUNNER || 'ubuntu-24.04' }}}}       # self-hosted: un runner propio (solo repos privados)
      # {L("Secretos que el Dockerfile necesita AL CONSTRUIR (RUN --mount=type=secret,id=NOMBRE):",
           "Secrets the Dockerfile needs AT BUILD TIME (RUN --mount=type=secret,id=NAME):")}
      # build_secrets: NPM_TOKEN SENTRY_AUTH_TOKEN
""" + (INHERIT_LINE if inherit else secrets_block())

    def ci_watch(self, repo: str | None = None, sha: str | None = None, workflow: str = "") -> int:
        """Sigue la corrida de ese commit (recién empujado: espera hasta 1 min a que aparezca),
        o la última del repo."""
        where = ["--repo", repo] if repo else []
        query = [*where, *(["--commit", sha] if sha else []), *(["--workflow", workflow] if workflow else []),
                 "--limit", "1", "--json", "databaseId", "-q", ".[0].databaseId"]
        run_id = ""
        for _ in range(20 if sha else 1):
            run_id = self.gh("run", "list", *query).stdout.strip()
            if run_id:
                break
            time.sleep(3)
        if not run_id:
            fail(L("Ese repo no tiene corridas de CI (¿Actions desactivado?).", "That repo has no CI runs (Actions disabled?)."))
        return self.watch(run_id, where)

    def watch(self, run_id: str, where: list[str]) -> int:
        rc = subprocess.run(["gh", "run", "watch", run_id, *where, "--exit-status"], check=False).returncode
        if rc != 0:
            self.explain_run(run_id, where)
        return rc

    def ci_repin(self, d: str, uses_repo: str, sha: str) -> str:
        """Pone el pipeline de una app (clonada en d) en esa versión de app-build.yml (y sus
        secretos de 'inherit' a ANDAMIO_SECRETS, que la versión nueva entiende).
        Devuelve "viejo nuevo" si cambió algo, o vacío si ya estaba al día."""
        pat = re.compile(r"(uses:\s*)[\w.-]+/[\w.-]+(/\.github/workflows/app-build\.yml@)([0-9a-f]{40})[^\n]*")
        inherit = re.compile(r"^    secrets: inherit\b[^\n]*$", re.M)
        old = ""
        for f in sorted((Path(d) / ".github" / "workflows").glob("*.y*ml")):
            text = f.read_text()
            m = pat.search(text)
            if not m or (m.group(3) == sha and uses_repo in m.group(0) and not inherit.search(text)):
                continue
            old = m.group(3)
            text = pat.sub(lambda m: f"{m.group(1)}{uses_repo}{m.group(2)}{sha}", text)
            f.write_text(inherit.sub(lambda _: secrets_block(), text))
        return f"{old} {sha}" if old else ""

    def ci_last_failed(self, repo: str, workflow: str = "", branch: str = "main") -> str:
        """La última corrida de su rama, si terminó en falla (su id); si no, vacío."""
        r = self.gh("run", "list", "--repo", repo, "--branch", branch, "--limit", "1",
                    *(["--workflow", workflow] if workflow else []),
                    "--json", "databaseId,status,conclusion", "-q",
                    '.[0] | select(.status == "completed" and .conclusion == "failure") | .databaseId')
        return r.stdout.strip()

    def repos(self) -> list[dict]:
        """Tus repos (y los de tus organizaciones a los que tienes acceso), del más reciente al más viejo."""
        r = self.gh("repo", "list", "--limit", "200", "--json", "nameWithOwner,isPrivate,updatedAt,description")
        if r.returncode != 0:
            return []
        return [{"repo": x["nameWithOwner"], "private": x["isPrivate"], "updated": x["updatedAt"],
                 "description": x.get("description") or ""} for x in json.loads(r.stdout or "[]")]

    def ci_runs(self, repo: str, limit: int = 8, workflow: str = "", branch: str = "main") -> list[dict]:
        """Las últimas corridas de su rama (los deploys), de la más nueva a la más vieja."""
        # Solo los push: otras corridas en la rama (las de Dependabot, p. ej.) no son deploys ni tienen imagen.
        r = self.gh("run", "list", "--repo", repo, "--branch", branch, "--event", "push", "--limit", str(limit),
                    *(["--workflow", workflow] if workflow else []),
                    "--json", "databaseId,status,conclusion,displayTitle,headSha,createdAt,startedAt,updatedAt,url")
        if r.returncode != 0:
            return []
        # started/updated: cuánto tardó (una corrida terminada no se actualiza más).
        return [{"id": x["databaseId"], "status": x["status"], "conclusion": x["conclusion"] or "",
                 "title": x["displayTitle"], "sha": x["headSha"][:7], "full": x["headSha"],
                 "created": x["createdAt"], "started": x.get("startedAt") or "", "updated": x.get("updatedAt") or "",
                 "url": x["url"]}
                for x in json.loads(r.stdout or "[]")]

    def ci_rerun(self, repo: str, run_id: str) -> int:
        """Reintenta una corrida (con los secretos y variables de ahora) y la sigue."""
        if self.gh("run", "rerun", run_id, "--repo", repo).returncode != 0:
            fail(L("No pude reintentar la corrida.", "Couldn't re-run it."))
        time.sleep(3)
        return self.watch(run_id, ["--repo", repo])

    def ci_jobs(self, repo: str, run_id: str) -> list[dict]:
        """Los jobs de una corrida y sus pasos (estado, inicio y fin): el progreso de un deploy."""
        r = self.gh("api", f"repos/{repo}/actions/runs/{run_id}/jobs")
        try:
            jobs = json.loads(r.stdout).get("jobs") or []
        except ValueError:
            return []
        step = lambda s: {"name": s.get("name", ""), "status": s.get("status", ""), "conclusion": s.get("conclusion") or "",
                          "started": s.get("started_at") or "", "completed": s.get("completed_at") or ""}
        return [{**step(j), "name": j.get("name", "").split(" / ")[-1], "steps": [step(s) for s in j.get("steps") or []]}
                for j in jobs]

    def ci_failure(self, repo: str, run_id: str) -> dict:
        """Por qué falló una corrida, para mostrarlo sin ir a GitHub: los pasos que fallaron, las
        últimas líneas de su log y las pistas 💡 que deja el servidor al desplegar."""
        r = self.gh("run", "view", run_id, "--repo", repo, "--json", "url,jobs,conclusion,displayTitle")
        try:
            info = json.loads(r.stdout)
        except ValueError:
            return {"error": L("No pude leer esa corrida de GitHub", "Couldn't read that run from GitHub")}
        bad = [j for j in info.get("jobs") or [] if j.get("conclusion") == "failure"]
        failed = [{"job": j["name"], "steps": [s["name"] for s in j.get("steps") or [] if s.get("conclusion") == "failure"]} for j in bad]
        # El log de cada job que falló (la API directa: `gh run view --log-failed` vuelve vacío con
        # workflows reutilizables, como el de andamio), recortado alrededor del último error.
        lines: list[str] = []
        every: list[str] = []
        for j in bad[:2]:
            raw = self.gh("api", f"repos/{repo}/actions/jobs/{j['databaseId']}/logs").stdout.splitlines()
            clean = [re.sub(r"^\ufeff?\d{4}-\d\d-\d\dT[\d:.]+Z ?", "", l) for l in raw]
            every += clean
            last = max((i for i, l in enumerate(clean) if "##[error]" in l), default=len(clean) - 1)
            lines += clean[max(0, last - 50):last + 3]
        text = lambda l: re.sub(r"^##\[(error|warning|group|endgroup)\]", "", l).strip()
        hints = [text(l).split("💡", 1)[1].strip(" :") for l in every if "💡" in l and "echo" not in l]
        cause = next((text(l).split("❌", 1)[1].strip() for l in every if "❌" in l and "echo" not in l and "grep" not in l), "")
        return {"url": info.get("url", ""), "title": info.get("displayTitle", ""), "conclusion": info.get("conclusion", ""),
                "failed": failed, "cause": cause, "hints": list(dict.fromkeys(h for h in hints if h))[:6],
                "log": [text(l) if l.startswith("##[") else l for l in lines if not l.startswith("##[endgroup]")],
                "rejected": not info.get("jobs")}

    def explain_run(self, run_id: str, where: list[str]) -> None:
        """Por qué falló una corrida: el paso, sus últimas líneas de log y el link."""
        r = self.gh("run", "view", run_id, *where, "--json", "url,jobs")
        try:
            info = json.loads(r.stdout)
        except ValueError:
            return
        failed = [(j["name"], [s["name"] for s in j.get("steps") or [] if s.get("conclusion") == "failure"])
                  for j in info.get("jobs") or [] if j.get("conclusion") == "failure"]
        if not info.get("jobs"):
            print(L("  ✗ GitHub rechazó el workflow antes de empezar (no hay logs). Lo típico: un repo público "
                    "que usa el pipeline de tu repo privado de andamio; hazlo privado.",
                    "  ✗ GitHub rejected the workflow before starting (no logs). Usually: a public repo using "
                    "the pipeline from your private andamio repo; make it private."))
        for job, steps in failed:
            print(f"  ✗ {job}" + (f": {', '.join(steps)}" if steps else ""))
        if failed:
            log = self.gh("run", "view", run_id, *where, "--log-failed").stdout.splitlines()[-25:]
            print("\n".join("    " + line.split("\t", 2)[-1] for line in log))
        print(L(f"  Detalle: {info.get('url', '')}", f"  Details: {info.get('url', '')}"))

    def registry(self) -> str:
        return "ghcr.io"

    def registry_name(self) -> str:
        return "GHCR"

    def registry_token_help(self) -> str:
        return L("""Las imágenes de tus apps son privadas: el servidor necesita un token de GitHub de solo
lectura de paquetes. Créalo en  https://github.com/settings/tokens/new  (classic):
  - Note: andamio-server   - Expiration: la que prefieras
  - Scope: SOLO read:packages
y pégalo aquí (no se muestra ni queda en el historial).""", """Your apps' images are private: the server needs a GitHub token that can only read
packages. Create it at  https://github.com/settings/tokens/new  (classic):
  - Note: andamio-server   - Expiration: whatever you prefer
  - Scope: ONLY read:packages
and paste it here (it isn't shown or kept in your history).""")

    def registry_token_check(self, token: str) -> str | None:
        if not re.fullmatch(r"gh[pousr]_[A-Za-z0-9]{20,}", token):
            return L("Eso no parece un token de GitHub (empiezan con ghp_).", "That doesn't look like a GitHub token (they start with ghp_).")
        req = urllib.request.Request("https://api.github.com/user", headers={
            "Authorization": f"Bearer {token}", "User-Agent": "andamio", "Accept": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                scopes = resp.headers.get("X-OAuth-Scopes", "")
        except urllib.error.HTTPError as e:
            return (L("GitHub dice que ese token no es válido (¿revocado o mal copiado?).",
                      "GitHub says that token isn't valid (revoked or mistyped?).") if e.code == 401
                    else L(f"No pude comprobarlo con GitHub (HTTP {e.code}).", f"Couldn't check it with GitHub (HTTP {e.code})."))
        except OSError as e:
            return L(f"No pude comprobarlo con GitHub ({e}).", f"Couldn't check it with GitHub ({e}).")
        if not {s.strip() for s in scopes.split(",")} & {"read:packages", "write:packages"}:
            return L("Al token le falta el permiso read:packages.", "The token is missing the read:packages permission.")
        return None


FORGES = {"github": GitHub}


def current() -> GitHub:
    name = os.environ.get("ANDAMIO_FORGE")
    if not name and CONFIG.exists():
        import yaml
        name = (yaml.safe_load(CONFIG.read_text()) or {}).get("andamio_forge")
    name = name or "github"
    if name not in FORGES:
        fail(L(f"andamio_forge: {name} no está soportada (hoy: {', '.join(FORGES)}). GitLab está en la hoja de ruta.",
               f"andamio_forge: {name} isn't supported (today: {', '.join(FORGES)}). GitLab is on the roadmap."))
    return FORGES[name]()


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if args else 2)
    cmd, rest, f = args[0], args[1:], current()
    # Opciones --nombre valor (repetibles): --workflow, y las de ci-snippet.
    opts: dict[str, list[str]] = {}
    pos: list[str] = []
    it = iter(rest)
    for a in it:
        if a == "--inherit":
            opts["inherit"] = ["1"]
        elif a.startswith("--") and a[2:] in ("workflow", "app", "dir", "context", "watch", "branch"):
            v = next(it, None)
            if v is None:
                fail(L(f"falta el valor de {a}", f"missing value for {a}"), 2)
            opts.setdefault(a[2:], []).append(v)
        else:
            pos.append(a)
    rest = pos
    wf = (opts.get("workflow") or [""])[0]
    if wf and not re.fullmatch(r"[A-Za-z0-9._-]+\.ya?ml", wf):
        fail(L(f"--workflow inválido: {wf}", f"invalid --workflow: {wf}"), 2)
    br = (opts.get("branch") or ["main"])[0]
    if not re.fullmatch(r"[A-Za-z0-9._/-]{1,100}", br) or ".." in br:
        fail(L(f"--branch inválida: {br}", f"invalid --branch: {br}"), 2)

    def need(n: int) -> list[str]:
        if len(rest) != n:
            fail(L("uso", "usage") + f": forge {cmd} " + " ".join(["ARG"] * n), 2)
        return rest

    exit_bool = {
        "auth-ok": lambda: f.auth_ok(),
        "repo-exists": lambda: f.repo_exists(*need(1)),
        "repo-private": lambda: f.repo_private(*need(1)),
        "deploy-key-has": lambda: f.deploy_key_has(*rest) if len(rest) in (2, 3) else need(2),
    }
    printing = {
        "name": lambda: f.name,
        "tools": lambda: "\n".join(f"{t}\t{hint}" for t, hint in f.tools.items()),
        "whoami": lambda: f.whoami(),
        "clone-url": lambda: f.clone_url(*need(1)),
        "ssh-host": lambda: f.ssh_host(),
        "known-hosts": lambda: f.known_hosts(),
        "vars-get": lambda: json.dumps(f.vars_get(*need(1))),
        "ci-failure": lambda: json.dumps(f.ci_failure(*need(2))),
        "ci-jobs": lambda: json.dumps(f.ci_jobs(*need(2))),
        "ci-runs": lambda: json.dumps(f.ci_runs(rest[0], int(rest[1]), wf, br) if len(rest) == 2 and rest[1].isdigit()
                                      else f.ci_runs(*need(1), workflow=wf, branch=br)),
        "default-branch": lambda: f.default_branch(*need(1)),
        "repos": lambda: json.dumps(f.repos()),
        "ci-snippet": lambda: f.ci_snippet(*need(2), app=(opts.get("app") or [""])[0], dir=(opts.get("dir") or [""])[0],
                                           context=(opts.get("context") or [""])[0], watch=opts.get("watch"), branch=br,
                                           inherit="inherit" in opts),
        "registry": lambda: f.registry(),
        "registry-name": lambda: f.registry_name(),
        "registry-token-help": lambda: f.registry_token_help(),
    }
    if cmd in exit_bool:
        sys.exit(0 if exit_bool[cmd]() else 1)
    if cmd in printing:
        print(printing[cmd]())
    elif cmd == "repo-create":
        f.repo_create(*need(2))
    elif cmd == "repo-create-empty":
        f.repo_create_empty(*need(1))
    elif cmd == "deploy-key-add":
        f.deploy_key_add(*need(3))
    elif cmd == "secret-set":
        f.secret_set(*need(2), sys.stdin.read())
    elif cmd == "var-set":
        f.var_set(*need(3))
    elif cmd == "pr-create":
        print(f.pr_create(*need(4), sys.stdin.read()))
    elif cmd == "ci-allow-reuse":
        print("cambiado" if f.ci_allow_reuse(*need(1)) else "sin cambios")
    elif cmd == "ci-watch":
        sys.exit(f.ci_watch(*rest[:2], workflow=wf))
    elif cmd == "ci-repin":
        print(f.ci_repin(*need(3)))
    elif cmd == "ci-last-failed":
        print(f.ci_last_failed(*need(1), workflow=wf, branch=br))
    elif cmd == "ci-rerun":
        sys.exit(f.ci_rerun(*need(2)))
    elif cmd == "registry-token-check":
        problem = f.registry_token_check(sys.stdin.read().strip())
        if problem:
            fail(problem)
    else:
        fail(L(f"forge: subcomando desconocido '{cmd}' (forge --help)", f"forge: unknown subcommand '{cmd}' (forge --help)"), 2)


if __name__ == "__main__":
    main()
